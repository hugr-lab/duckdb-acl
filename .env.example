# duckdb-acl integration-test environment (specs/005)
# Copy to .env and adjust if the ports clash with something local.
# Used by docker/docker-compose.yml and the Makefile docker-* / test-integration targets.

# PostgreSQL (also serves as the DuckLake catalog database)
ACL_PG_HOST=localhost
ACL_PG_PORT=6432
ACL_PG_USER=acl
ACL_PG_PASS=aclpass
ACL_PG_DB=acltest
ACL_DUCKLAKE_CATALOG_DB=ducklake_catalog

# MySQL (scenarios skip automatically while mysql_scanner is disabled at the duckdb pin)
ACL_MYSQL_HOST=localhost
ACL_MYSQL_PORT=6433
ACL_MYSQL_USER=acl
ACL_MYSQL_PASS=aclpass
ACL_MYSQL_DB=acltest

# SQL Server (environment ready; duckdb-side scenarios deferred - see specs/005)
ACL_MSSQL_HOST=localhost
ACL_MSSQL_PORT=6434
ACL_MSSQL_USER=sa
ACL_MSSQL_PASS=TestPassword1
ACL_MSSQL_DB=acltest
