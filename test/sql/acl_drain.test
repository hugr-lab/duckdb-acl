# name: test/sql/acl_drain.test
# description: node drain (spec 066) - a draining node seats no new session while established ones
#   keep working; the operator enters, observes and leaves the state; a principal may do none of it
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme'), (2, 'globex');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('test/idp/d', '{"url": "test/idp/d", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"], "attributes": {"tid": "tenant"}}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders RLS 'tenant = acl_claim(''tenant'')';

statement ok
ACL ADMIN CREATE ROLE r;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r MAIN;

# --- serving is the starting state -------------------------------------------------------------------

query I
SELECT acl_drain_status();
----
serving

# resuming a node that already serves did nothing, and says so
query I
SELECT acl_resume();
----
false

# --- a session opened before the drain ---------------------------------------------------------------

statement ok
CREATE TABLE live AS SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9kIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJyIl0sInRpZCI6ImFjbWUifQ.aPBrtcgDKpBFx79Ko8KlU6Y7are0gcq2Y9vgEqT2Gf5nst5QaDZGzcw_t9vyi0EmBbnB8dgagSh6VsH7P7vqm08RdVAdVYqVolxtZWMxAk2FbCCEoOdGoZ-Fa9bV45HC70xIF1gxoe2GUA4APh3ZL19gmXXHYbjtzgC86sdZ4koOfo2juuGyddJ0dbxgnNqciGuIsVozV9jh5lKky6wrXAxCjxuXAiBGiwGs153I0uA30CjTjQT576A7gXz0qmaEkVj89UOG5yhNkMkJ1_Buskxu0EBCQMrKoLp_JNZFBRvKb_U8WiGt6-XJOklkhVX4HAwUma40fep-5rhuiNhsRw') AS handle;

query I
SELECT handle IS NOT NULL FROM live;
----
true

# --- drain: no new session, the old one keeps working ------------------------------------------------

# entering drain returns what remains to be drained: the one live session
query I
SELECT acl_drain();
----
1

query I
SELECT acl_drain_status();
----
draining

# the same, perfectly valid token that opened `live` is refused now - a draining node seats nobody new
query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9kIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJyIl0sInRpZCI6ImFjbWUifQ.aPBrtcgDKpBFx79Ko8KlU6Y7are0gcq2Y9vgEqT2Gf5nst5QaDZGzcw_t9vyi0EmBbnB8dgagSh6VsH7P7vqm08RdVAdVYqVolxtZWMxAk2FbCCEoOdGoZ-Fa9bV45HC70xIF1gxoe2GUA4APh3ZL19gmXXHYbjtzgC86sdZ4koOfo2juuGyddJ0dbxgnNqciGuIsVozV9jh5lKky6wrXAxCjxuXAiBGiwGs153I0uA30CjTjQT576A7gXz0qmaEkVj89UOG5yhNkMkJ1_Buskxu0EBCQMrKoLp_JNZFBRvKb_U8WiGt6-XJOklkhVX4HAwUma40fep-5rhuiNhsRw') IS NULL;
----
true

# the established session still composes: in-flight clients finish their work
query I
SELECT acl_session_sql((SELECT handle FROM live), 'SELECT * FROM orders')
     = 'ACL SESSION ''' || (SELECT handle FROM live) || ''' SELECT * FROM orders' FROM live;
----
true

# and the ops surface still watches it
query I
SELECT acl_session_count();
----
1

# draining a draining node is idempotent - it re-answers what remains
query I
SELECT acl_drain();
----
1

# --- resume: back to seating clients -----------------------------------------------------------------

query I
SELECT acl_resume();
----
true

query I
SELECT acl_drain_status();
----
serving

query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9kIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJyIl0sInRpZCI6ImFjbWUifQ.aPBrtcgDKpBFx79Ko8KlU6Y7are0gcq2Y9vgEqT2Gf5nst5QaDZGzcw_t9vyi0EmBbnB8dgagSh6VsH7P7vqm08RdVAdVYqVolxtZWMxAk2FbCCEoOdGoZ-Fa9bV45HC70xIF1gxoe2GUA4APh3ZL19gmXXHYbjtzgC86sdZ4koOfo2juuGyddJ0dbxgnNqciGuIsVozV9jh5lKky6wrXAxCjxuXAiBGiwGs153I0uA30CjTjQT576A7gXz0qmaEkVj89UOG5yhNkMkJ1_Buskxu0EBCQMrKoLp_JNZFBRvKb_U8WiGt6-XJOklkhVX4HAwUma40fep-5rhuiNhsRw') IS NOT NULL;
----
true

# --- a principal touches none of this ----------------------------------------------------------------

statement error
ACL ROLE "r" SELECT acl_drain();
----
<REGEX>:.*acl_drain.*not allowed.*

statement error
ACL ROLE "r" SELECT acl_resume();
----
<REGEX>:.*acl_resume.*not allowed.*

statement error
ACL ROLE "r" SELECT acl_drain_status();
----
<REGEX>:.*acl_drain_status.*not allowed.*
