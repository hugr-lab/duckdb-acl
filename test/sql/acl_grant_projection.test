# name: test/sql/acl_grant_projection.test
# description: a grant's own projection is probed where it is written (spec 026), so the metadata
#   describes what the role reads; since spec 158 a mask is cast to its column's type (a column's type never
#   depends on the role) and reads the object's columns, which may be ones the grant does not show
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.t(id INT, tenant VARCHAR, amount INT, ssn VARCHAR);

statement ok
INSERT INTO phys.main.t VALUES (1, 'acme', 10, 's1');

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.t AS phys.main.t;

statement ok
ACL ADMIN CREATE ROLE r CLAIMS (tenant = 'acme');

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r CAPS '{}' MAIN;

# a projection stated on the grant: one column as-is, one masked by NULL, one masked by an expression over a
# column of the object the role never sees (spec 158: each mask is cast to its column's type)
statement ok
ACL ADMIN GRANT TABLE c.t TO ROLE r WITH (select)
    COLUMNS (id, ssn, amount) MASK (ssn AS NULL, amount AS length(tenant));

# --- the two metadata surfaces agree, and both describe what the role reads -------------------------

query II
ACL ROLE "r" SELECT column_name, column_type FROM (DESCRIBE t) ORDER BY column_name;
----
amount	INTEGER
id	INTEGER
ssn	VARCHAR

query II
ACL ROLE "r" SELECT column_name, data_type FROM information_schema.columns
    WHERE table_name = 't' ORDER BY column_name;
----
amount	INTEGER
id	INTEGER
ssn	VARCHAR

# and that is what a SELECT * gives back - in the object's order, not the order the grant was
# written in (spec 037)
query III
ACL ROLE "r" SELECT * FROM t;
----
1	4	NULL

# the column the grant does not project is in neither surface
query I
ACL ROLE "r" SELECT count(*) FROM information_schema.columns
    WHERE table_name = 't' AND column_name = 'tenant';
----
0

# spec 158: a grant keeps no probed columns of its own - the listings above read the object's columns its test admits

# --- the two levels fold the way the resolver folds them -------------------------------------------------
# a bare name in a grant is the object's column, which the object's own projection may have renamed;
# spec 158: a mask reads the object's columns, never the physical row

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.renamed AS phys.main.t COLUMNS (id AS order_id, amount AS marker);

# the grant may only name what the object exposes (spec 029), and so may its mask: a column the object's projection
# dropped is not there to read
statement error
ACL ADMIN GRANT TABLE c.renamed TO ROLE r WITH (select)
    COLUMNS (order_id, marker) MASK (marker AS length(tenant));
----
<REGEX>:.*projection of the grant on "renamed" does not bind against it.*

statement ok
ACL ADMIN GRANT TABLE c.renamed TO ROLE r WITH (select)
    COLUMNS (order_id, marker) MASK (marker AS order_id + 100);

query II
ACL ROLE "r" SELECT * FROM renamed;
----
1	101

query II
ACL ROLE "r" SELECT column_name, data_type FROM information_schema.columns
    WHERE table_name = 'renamed' ORDER BY column_name;
----
marker	INTEGER
order_id	INTEGER

# --- a mask over a marker keeps its name ----------------------------------------------------------------
# the probe bakes `acl_claim(...)` into a NULL before binding, and the replacement used to drop the
# alias with it - so the projection stored a column with no name, which then appeared in every listing
# sharing an ordinal with the column it was supposed to be

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.marked AS phys.main.t;

statement ok
ACL ADMIN GRANT TABLE c.marked TO ROLE r WITH (select)
    COLUMNS (id, tenant) MASK (tenant AS acl_claim('tenant'));

# a claim is a string by construction, so the probe can type it - and every surface agrees
query III
ACL ROLE "r" SELECT column_name, data_type, column_index FROM duckdb_columns()
WHERE table_name = 'marked' ORDER BY column_index;
----
id	INTEGER	1
tenant	VARCHAR	2

query I
ACL ROLE "r" SELECT sql FROM duckdb_tables() WHERE table_name = 'marked';
----
CREATE TABLE "marked"("id" INTEGER, "tenant" VARCHAR);

# --- a column whose name is not a bare word ------------------------------------------------------------
# the probe builds `<source> AS <alias>`; unquoted, a name like `od''d` made the probe itself
# unparseable, so such a column could never be granted at all

statement ok
CREATE TABLE phys.main.odd(id INT, "od''d" VARCHAR);

statement ok
INSERT INTO phys.main.odd VALUES (1, 'x');

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.odd AS phys.main.odd;

# through the function form: the list is a SELECT list (spec 158), the name quoted as an identifier
statement ok
SELECT acl_grant_object('r', 'c', 'odd', '{"select": true}', '', 'id, "od''''d"');

query II
ACL ROLE "r" SELECT * FROM odd;
----
1	x

# --- a projection that cannot bind is refused where it is written ------------------------------------------
# the same rule spec 021 applies to a predicate: a grant that could never work is a mistake, not
# something to discover when someone reads

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE r WITH (select) COLUMNS (id, ssn) MASK (ssn AS nosuchcolumn);
----
<REGEX>:.*projection of the grant on "t" does not bind against it.*

# a name the object does not have is refused before its expression is even tried (spec 037)
statement error
ACL ADMIN GRANT TABLE c.t TO ROLE r WITH (select) COLUMNS (id, bad) MASK (bad AS tenant);
----
<REGEX>:.*lists "bad", which the object does not have.*

# ... but an object whose source is not attached cannot judge one, so it is accepted unchecked
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.later AS notyet.main.x;

statement ok
ACL ADMIN GRANT TABLE c.later TO ROLE r WITH (select) COLUMNS (id, z) MASK (z AS 1);

# --- a grant with no projection of its own is unaffected ------------------------------------------------

statement ok
ACL ADMIN CREATE ROLE plain;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE plain MAIN;

query I
ACL ROLE "plain" SELECT count(*) FROM information_schema.columns WHERE table_name = 't';
----
4

# --- rewriting the grant rewrites what was probed -------------------------------------------------------

statement ok
ACL ADMIN GRANT TABLE c.t TO ROLE r WITH (select) COLUMNS (id, amount);

query I
ACL ROLE "r" SELECT string_agg(column_name, ',' ORDER BY column_name) FROM information_schema.columns
    WHERE table_name = 't';
----
amount,id

# --- and revoking it takes the rows with it ---------------------------------------------------------------

statement ok
SELECT acl_revoke_catalog('r', 'c');

# dropping the object clears them too, whoever they belonged to
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r CAPS '{}' MAIN;

statement ok
ACL ADMIN GRANT TABLE c.t TO ROLE r WITH (select) COLUMNS (id, amount) MASK (amount AS length(tenant));

query I
SELECT count(*) FROM aclcat.acl.role_object_caps WHERE vname = 't';
----
1

statement ok
ACL ADMIN DROP VIRTUAL TABLE c.t;

query I
SELECT count(*) FROM aclcat.acl.role_object_caps WHERE vname = 't';
----
0
