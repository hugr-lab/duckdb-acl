# name: test/sql/acl_role_union_audit.test
# description: spec 146 - the union of a principal's roles is per object (rows OR-ed, column lists united
#   independently, spec 011): two roles that narrow one object differently unite into cells neither reads. Documented
#   and audited - one `policy` event `role_union_widens` names the object, every widening pair and its items, counted
#   at every resolution that computes it; nothing for roles that do not widen. The token names analyst and auditor
#   (test/idp/rs); the second one analyst, auditor and reader.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
SET GLOBAL acl_audit_level = 'decisions';

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, amount INTEGER, secret VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 10, 'S1'), (2, 20, 'S2');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"]}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.t AS phys.main.orders;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN CREATE ROLE auditor;

# the same row filter for both: the same rows, no cell beyond either role - no event
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN RLS (id > 0) COLUMNS (id, amount);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (select) MAIN RLS (id > 0);

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM t;

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE detail = 'role_union_widens';
----
0

# different rows, different columns: the analyst's row 2 with the auditor's `secret` - read, and audited
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN RLS (id = 2) COLUMNS (id, amount);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (select) MAIN RLS (id = 1);

query III
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM t ORDER BY id;
----
1	10	S1
2	20	S2

statement ok
SELECT acl_audit_flush();

query TTT
SELECT verdict, reason, objects::VARCHAR FROM acl_audit_events() WHERE detail = 'role_union_widens';
----
allowed	the union of roles analyst, auditor may show cells none of them reads: auditor's columns outside the lists read on analyst's rows	[{'name': c.t, 'capability': select}]

query I
SELECT sum(value)::INTEGER FROM acl_metrics() WHERE name = 'acl.policy.role_union_widens';
----
1

# a role without a row filter sees its columns on every row: nothing beyond it - no new event
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (select) MAIN COLUMNS (id, amount, secret);

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM t;

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE detail = 'role_union_widens';
----
1

# two narrowed lists: each pair's items are named (another object: one event per object and roles a minute)
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.t2 AS phys.main.orders;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (select) MAIN RLS (id = 1) COLUMNS (id, secret);

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM t2;

statement ok
SELECT acl_audit_flush();

query TT
SELECT reason, objects::VARCHAR FROM acl_audit_events() WHERE detail = 'role_union_widens' ORDER BY seq DESC LIMIT 1;
----
the union of roles analyst, auditor may show cells none of them reads: auditor's columns secret on analyst's rows; analyst's columns amount on auditor's rows	[{'name': c.t2, 'capability': select}]

# fields (spec 102) and masks: another catalog, read qualified
statement ok
CREATE TABLE phys.main.people(id INTEGER, address STRUCT(city VARCHAR, zip VARCHAR), secret VARCHAR);

statement ok
INSERT INTO phys.main.people VALUES (1, {'city': 'A', 'zip': '1'}, 'S1'), (2, {'city': 'B', 'zip': '2'}, 'S2');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG d;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE d.p AS phys.main.people;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE d.q AS phys.main.people;

# the analyst reads every row: its whole `address` covers the auditor's `address.zip`, the same mask on both sides
# covers itself - no event (with a row filter of its own, the analyst's `address.city` on the auditor's rows would
# widen the other way)
statement ok
ACL ADMIN GRANT CATALOG d TO ROLE analyst WITH (select) COLUMNS (id, address, secret = 'x');

statement ok
ACL ADMIN GRANT CATALOG d TO ROLE auditor WITH (select) RLS (id = 1) COLUMNS (id, address.zip, secret = 'x');

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM d.p;

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE detail = 'role_union_widens' AND objects[1].name = 'd.p';
----
0

# a field the analyst does not list, and a column the analyst only reads masked
statement ok
ACL ADMIN GRANT CATALOG d TO ROLE analyst WITH (select) RLS (id = 2) COLUMNS (id, address.city, secret = 'x');

statement ok
ACL ADMIN GRANT CATALOG d TO ROLE auditor WITH (select) RLS (id = 1) COLUMNS (id, address.zip, secret);

query III
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT id, address.zip, secret FROM d.q ORDER BY id;
----
1	1	S1
2	2	S2

statement ok
SELECT acl_audit_flush();

query T
SELECT reason FROM acl_audit_events() WHERE detail = 'role_union_widens' AND objects[1].name = 'd.q';
----
the union of roles analyst, auditor may show cells none of them reads: auditor's columns address.zip, secret on analyst's rows; analyst's columns address.city on auditor's rows

# a field masked under a column the other role reads whole is not read by the first in clear
statement ok
ACL ADMIN CREATE VIRTUAL TABLE d.s AS phys.main.people;

statement ok
ACL ADMIN GRANT CATALOG d TO ROLE analyst WITH (select) RLS (id = 2) COLUMNS (id, address, address.zip = 'x');

statement ok
ACL ADMIN GRANT CATALOG d TO ROLE auditor WITH (select) RLS (id = 1) COLUMNS (id, address);

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM d.s;

statement ok
SELECT acl_audit_flush();

query T
