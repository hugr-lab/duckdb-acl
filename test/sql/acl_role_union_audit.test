# a role without a filter but with a list reads every row of those columns only: the other role's columns on the rows
# it does not filter in are read by neither
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG g;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE g.t AS phys.main.orders COLUMNS (id, amount, secret);

statement ok
ACL ADMIN GRANT CATALOG g TO ROLE analyst WITH (select) COLUMNS (id);

statement ok
ACL ADMIN GRANT CATALOG g TO ROLE auditor WITH (select) RLS (id = 1) COLUMNS (id, secret);

query II
