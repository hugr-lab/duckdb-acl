# turned on after a resolution at `off`: the next one within the minute (a policy write empties the resolver's cache)
# is recorded - the floor counts recorded events only
statement ok
SET GLOBAL acl_audit_level = 'off';

statement ok
ACL ADMIN CREATE VIRTUAL TABLE g.late AS phys.main.orders;

