# a column the source exposes differently (a type fact, spec 099) is not the object's column list: the others widen
statement ok
CREATE TYPE phys.main.st AS ENUM ('x', 'y');

statement ok
CREATE TABLE phys.main.typed(id INTEGER, st phys.main.st, secret VARCHAR);

statement ok
INSERT INTO phys.main.typed VALUES (1, 'x', 'S1'), (2, 'y', 'S2');

statement ok
ACL ADMIN CREATE VIRTUAL TABLE g.typed AS phys.main.typed;

statement ok
