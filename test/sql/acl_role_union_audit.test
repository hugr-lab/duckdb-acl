the union of roles analyst, auditor may show cells none of them reads: auditor's columns address on analyst's rows

# one filter written two ways is one set of rows; a column an object that declares its columns does not have (a
# catalog-wide list) is no cell - of an object that declares none, the node knows no columns and names it
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG e;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE e.t AS phys.main.orders COLUMNS (id, amount, secret);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE e.u AS phys.main.orders;

statement ok
ACL ADMIN GRANT CATALOG e TO ROLE analyst WITH (select) RLS (id = 2) COLUMNS (id, amount, secret);

statement ok
ACL ADMIN GRANT CATALOG e TO ROLE auditor WITH (select) RLS (id=2) COLUMNS (id, amount);

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM e.t;

statement ok
