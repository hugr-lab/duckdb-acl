# --- the operator's surface ---------------------------------------------------------------------------

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst MAIN;

statement error
ACL ROLE "analyst" SELECT * FROM acl_jwks_cache();
----
<REGEX>:.*table function "acl_jwks_cache" is not allowed.*

statement error
ACL ROLE "analyst" SELECT acl_jwks_refresh();
----
<REGEX>:.*function "acl_jwks_refresh" is not allowed.*

statement error
ACL ROLE "analyst" SET GLOBAL acl_jwks_locations = '/';
----
<REGEX>:.*SET "acl_jwks_locations" is not permitted under ACL.*
