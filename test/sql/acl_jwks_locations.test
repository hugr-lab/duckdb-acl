# name: test/sql/acl_jwks_locations.test
# description: spec 071 under spec 095 - every location a node reads an issuer's keys from (its
#   discovery document, the JWKS it names, a secret's KEYS_FROM) is judged against
#   acl_jwks_locations, this node's setting, when it is read: refused locations are recorded and
#   audited, ".." is refused anywhere, a document cached from a location taken off the list is not
#   used, and the setting and the cache are the operator's, never a principal's.
# group: [sql]

require acl

statement ok
SET allow_parser_override_extension='fallback';

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INT, tenant VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme');

statement ok
SELECT acl_grant_table('analyst', 'orders', 'phys.main.orders', 'id', 'tenant = acl_claim(''tenant'')', 'select');

# the default list is https:// - a local discovery document is not read from here
query I
SELECT current_setting('acl_jwks_locations');
----
https://

statement ok
ACL ADMIN CREATE ISSUER 'test/idp/rs' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles' CLAIM MAP (tid => tenant);

statement ok
SET GLOBAL acl_audit_level='all';

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
----
<REGEX>:.*issuer "test/idp/rs" reads "test/idp/rs/.well-known/openid-configuration", which this node does not: "test/idp/rs/.well-known/openid-configuration" is outside acl_jwks_locations \(https://\) - list its prefix there.*

# the refusal is the cache row's last attempt, and a keys event
query III
SELECT allowed, keys IS NULL, error LIKE '%is outside acl_jwks_locations (https://)' FROM acl_jwks_cache();
----
false	true	true

statement ok
SELECT acl_audit_flush();

query IIII
SELECT detail, verdict, reason_code, reason LIKE '%is outside acl_jwks_locations%' FROM acl_audit_events() WHERE kind = 'keys' ORDER BY seq DESC LIMIT 1;
----
location_refused	denied	policy_error	true

# the setting is the operator's and global: a session-scoped value would be shown and ignored
statement error
SET acl_jwks_locations = '/';
----
<REGEX>:.*acl_jwks_locations is global - use SET GLOBAL.*

# --- the deployment vouches for its directory by name ------------------------------------------------

statement ok
SET GLOBAL acl_jwks_locations = 'https://, test/idp/';

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
----
1

query II
SELECT count(*), bool_and(allowed) FROM acl_jwks_cache();
----
2	true

# ".." walks out of any directory, so no location may carry it - whatever the list says
statement ok
ACL ADMIN CREATE ISSUER 'test/idp/../idp/rs2' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles';

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC8uLi9pZHAvcnMyIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUxIiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.TZKkLJjP2SqKxlECPgYVb7vXQ2go-yi6TSWpHqpD8FQl9wyZp4z4MLaQY0EmabgbHHkbKDfZNH0ysfUdpNBiHMWKHKQ0vcTlBeeR7ntS_2A48hGbsReKyuQNpA2bQHskWSSLmQAj9Brwd0NhpoeeYeb_UjGbTWI8L1ydDe0ElrVUN09qdqP7Wj4OCXjOq9HrtVukVfNJEknb05UoUC9t72NQwdSEz9XnX1D8YkCSg0Hogd2H73R9fpttYBrKiTwG5jhZHHkRwdM2K0UnWxpDIeLCX4mi0Rb2ugLb71ETi_hq9KX5Dg7LoCuW1ZPeTmES3iZROEFV28ppgEsRw4WwWg' SELECT 1;
----
<REGEX>:.*contains "..", which no location may.*

# --- a location taken off the list is not read from, cached or not -------------------------------------

statement ok
SET GLOBAL acl_jwks_locations = 'https://';

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
----
<REGEX>:.*is outside acl_jwks_locations \(https://\).*

# an empty list reads nothing at all
statement ok
SET GLOBAL acl_jwks_locations = '';

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
----
<REGEX>:.*is outside acl_jwks_locations \(\).*

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
