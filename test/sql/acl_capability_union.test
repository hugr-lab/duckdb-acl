# --- review 145: an upsert updates the row already there - the `update` capability, under its own policy -----------
statement ok
CREATE TABLE phys.main.keyed(id INTEGER PRIMARY KEY, tenant VARCHAR, amount INTEGER);

statement ok
INSERT INTO phys.main.keyed VALUES (1, 'globex', 10), (2, 'acme', 20);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.k AS phys.main.keyed;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE analyst;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE auditor;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, update) MAIN RLS (tenant = 'acme');

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (insert) MAIN;

# the conflict's update stays the analyst's: globex's row 1 is outside its slice (main: updated by the insert role)
statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' INSERT INTO k VALUES (1, 'globex', 0) ON CONFLICT (id) DO UPDATE SET amount = 666;

query III
SELECT * FROM phys.main.keyed ORDER BY id;
----
1	globex	10
2	acme	20

# an insert-only role updates nothing through ON CONFLICT DO UPDATE or INSERT OR REPLACE (main: both updated)
statement error
ACL ROLE 'auditor' INSERT INTO k VALUES (1, 'globex', 0) ON CONFLICT (id) DO UPDATE SET amount = 222;
----
update on

statement error
ACL ROLE 'auditor' INSERT OR REPLACE INTO k VALUES (1, 'globex', 555);
----
update on

# INSERT OR REPLACE has no SET to confine: refused under a row policy (main: it overwrote globex's row into acme's)
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, insert, update) MAIN RLS (tenant = 'acme');

statement error
ACL ROLE 'analyst' INSERT OR REPLACE INTO k (id, tenant, amount) VALUES (1, 'acme', 333);
----
INSERT OR REPLACE

query III
SELECT * FROM phys.main.keyed ORDER BY id;
----
1	globex	10
2	acme	20

# ... and allowed where the update is unconfined
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, insert, update) MAIN;

statement ok
ACL ROLE 'analyst' INSERT OR REPLACE INTO k VALUES (1, 'globex', 11);

query III
SELECT * FROM phys.main.keyed ORDER BY id;
----
1	globex	11
2	acme	20

# --- review 145: a role that may not read still sees only the columns its own lists keep -----------------------------
statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE analyst;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE auditor;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (insert, update) MAIN RLS (id = 2) COLUMNS (id, amount);

query T
ACL ROLE 'auditor' SELECT column_name FROM information_schema.columns WHERE table_name = 't' ORDER BY ordinal_position;
----
id
amount

# the operator's screen describes the role's own policy, not a read it may not make
query TT
SELECT rls, columns FROM acl_effective_rights('auditor', 'c', 't');
----
id = 2	[id, amount]

# --- review 145: a table function's call is a read - a role that may not call it lifts nothing ----------------------
statement ok
ACL ADMIN CREATE VIRTUAL TABLE FUNCTION c.f AS SELECT id, amount, secret FROM phys.main.orders;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE auditor;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN;

statement ok
ACL ADMIN GRANT TABLE c.f TO ROLE analyst RLS (id = 2) COLUMNS (id, amount);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (insert) MAIN;

query II
ACL ROLE 'analyst' SELECT * FROM f() ORDER BY id;
----
2	8

query II
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT * FROM f() ORDER BY id;
----
2	8

# --- review 145: a view, a DELETE and a MERGE follow the same rule -----------------------------------------------------
statement ok
CREATE TABLE phys.main.d(id INTEGER, amount INTEGER);

statement ok
INSERT INTO phys.main.d VALUES (1, 10), (2, 20);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.d AS phys.main.d;

statement ok
ACL ADMIN CREATE VIRTUAL VIEW c.v AS SELECT id, amount, secret FROM phys.main.orders;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE analyst;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE auditor;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, delete, merge) MAIN RLS (id = 2) COLUMNS (id, amount);

statement ok
