# --- review 145: a table a grant narrows by columns is a table - DROP drops it, RENAME renames it -------------------
statement ok
CREATE SCHEMA phys.lake;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c.vs FROM phys.lake;

statement ok
ACL ADMIN REVOKE CATALOG c FROM ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, insert) MAIN COLUMNS (id);

statement ok
ACL ADMIN GRANT SCHEMA c.vs TO ROLE analyst WITH (select, insert, create, drop);

statement ok
ACL ROLE 'analyst' CREATE TABLE vs.k(id INTEGER, y INTEGER);

statement ok
ACL ROLE 'analyst' ALTER TABLE vs.k RENAME TO k2;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'phys' AND schema_name = 'lake' AND table_name = 'k2';
----
1

statement ok
ACL ROLE 'analyst' DROP TABLE vs.k2;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'phys' AND schema_name = 'lake';
----
0
