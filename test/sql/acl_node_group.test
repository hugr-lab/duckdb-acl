# --- the grammar and the functions refuse what they do not know --------------------------------------

statement error
ACL ADMIN ALTER RESOURCE GROUP general SET LIMITS;
----
<REGEX>:.*expected default.*

statement error
ACL ADMIN ALTER RESOURCE GROUP nosuch SET DEFAULT;
----
<REGEX>:.*resource group "nosuch" does not exist.*

statement error
ACL ADMIN CREATE RESOURCE GROUP twice (max_sessions 1) DEFAULT DEFAULT;
----
<REGEX>:.*acl admin: unexpected trailing text.*

statement error
SELECT acl_alter_resource_group('general', 'limits', 'true');
----
<REGEX>:.*the property is 'default', true or false - got limits = true.*

statement error
SELECT acl_create_resource_group('maybe', '{}', '', 'perhaps');
----
<REGEX>:.*is_default is true or false, got "perhaps".*

# group names compare as written: `General` is not `general`
statement error
ACL ADMIN ALTER RESOURCE GROUP General DROP DEFAULT;
----
<REGEX>:.*resource group "General" does not exist.*

# --- more of DETACH's scope rules ----------------------------------------------------------------------

# a group's item over its OWN source of a name is not a dependent of the cluster's source of that name
statement ok
SELECT acl_cluster_attach('', 'src1', ':memory:', 'duckdb', '', '{}', '', '');

statement ok
SELECT acl_cluster_attach('interactive', 'src4', ':memory:', 'duckdb', '', '{}', 'src1', '');

query II
SELECT r.applied_here, r.note FROM (SELECT acl_cluster_detach('', 'src1', 'false', 'false') AS r);
----
false	cluster item overridden by resource group interactive's own on this node - not applied here

query I
SELECT string_agg(scope || ':' || name, ',' ORDER BY name) FROM acl_cluster_items() WHERE name IN ('src1', 'src4');
----
interactive:src1,interactive:src4

# a group's source with no cluster fallback keeps its group's dependents: refused, or cascaded
statement ok
SELECT acl_cluster_attach('interactive', 'src5', ':memory:', 'duckdb', '', '{}', '', '');

statement ok
SELECT acl_cluster_attach('interactive', 'src6', ':memory:', 'duckdb', '', '{}', 'src5', '');

statement error
SELECT acl_cluster_detach('interactive', 'src5', 'false', 'false');
----
<REGEX>:.*source "src6" of group interactive DEPENDS ON "src5" - detach it first, or DETACH src5 CASCADE.*

query II
SELECT r.applied_here, r.note FROM (SELECT acl_cluster_detach('interactive', 'src5', 'true', 'false') AS r);
----
true	detached with it: src6 (group interactive)

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name IN ('src5', 'src6');
----
0

# CASCADE to a fixpoint: etl's `a` falls back to the cluster's `a` only while the cluster keeps it - when
# the cascade takes the cluster's too, etl's `a` and what depends on it (etl's `c`) go
statement ok
SELECT acl_cluster_attach('', 'x', ':memory:', 'duckdb', '', '{}', '', '');

statement ok
SELECT acl_cluster_attach('', 'a', ':memory:', 'duckdb', '', '{}', 'x', '');

statement ok
SELECT acl_cluster_attach('etl', 'a', ':memory:', 'duckdb', '', '{}', 'x', '');

statement ok
SELECT acl_cluster_attach('etl', 'c', ':memory:', 'duckdb', '', '{}', 'a', '');

query II
SELECT r.applied_here, r.note LIKE '%c (group etl)%' FROM (SELECT acl_cluster_detach('', 'x', 'true', 'false') AS r);
----
true	true

query II
SELECT (SELECT count(*) FROM acl_cluster_items() WHERE name IN ('x', 'a', 'c')), (SELECT count(*) FROM store.acl.cluster_deps WHERE name IN ('a', 'c'));
----
0	0

query I
SELECT count(*) FROM duckdb_databases() WHERE database_name IN ('x', 'a');
----
0

# --- a group with profile items is not dropped from under them -----------------------------------------

statement error
ACL ADMIN DROP RESOURCE GROUP etl;
----
<REGEX>:.*resource group "etl" has cluster profile items \(setting threads, source etl_src\) - remove them.*

# --- a re-authentication takes no second seat (the node's cap as the group's) ---------------------------

statement ok
SET GLOBAL acl_node_group = '';

statement ok
SELECT acl_session_sweep();

query I
SELECT acl_session_count();
----
7

statement ok
SET GLOBAL acl_max_sessions = 7;

# conn-analyst authenticates again: its new session replaces its own, so the full node admits it...
