# one with no group, and no default group: refused
query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6ImEiLCJyb2xlcyI6WyJwbGFpbiJdfQ.a7leR6-nf1r8uq_fJ9N0h1hFJZhcn14DNjaXpIC21UrzwxgY1bZXZS33xdVwHM97g5BoXvJGV9Lg04MKb8PcwggFe5xUeZUHaojmiN9JWDFKxQQT_c-WqczCbcV_xq8W0D7VnCwX3ND0Z0wJWgCEJMHQ_aOEWbiEy_IO7XZef57hqEt1o6SFeD_Yt0RWCzAVfwuNGXa7Wn3kY3eT1V-V_FWoyDVtrwA0xT4UmL7f1zV2Wn5SFba5eA52HV_fzi9WBut8OmcXVTBZVZ58_MeHVTTIRf2CKiiYIbBLGzE_ZJ8tMxVoSVx-Dzb3BpLc5nnOhRTLCxahownp3zXq1nfOxw') IS NULL;
----
