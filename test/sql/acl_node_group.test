# name: test/sql/acl_node_group.test
# description: a node's resource group (spec 096) - membership by acl_node_group, placement of sessions
#   (a node of g serves principals that hold g, with g's limits only), the default group for principals
#   bound to none, an unknown group failing closed, the group's part of the cluster profile (written,
#   applied only on the group's nodes, acl_cluster_effective), and what the load report says.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

# --- memory mode has no groups: a node there with a group serves nobody new ----------------------

statement ok
ACL ADMIN CREATE ISSUER 'test/idp/s' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles';

statement ok
SELECT acl_define_role('analyst', '');

statement ok
SET GLOBAL acl_node_group = 'interactive';

query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6ImEiLCJyb2xlcyI6WyJhbmFseXN0Il19.RPD7WZXscyjtSETOfilmFNkrBXqC0P_SMLTmWOzAPxKydzv6BEnQud-W60LY1mixyyZvFI_-DjznCAWOZvm5C5wZR64ynr6RkbZxinJwWXWS6-NmTX4BANU7PFwTF9nSAESaMdbxJ-F_hpeAtnUikd_Hd1m5f6QhLjT4rRgotxRenvsxJmKSqNSqeLNlKXPz_-ZXOB-5vfxD_Vp4yxN9x9HMGGV7OTo1ZHJcZGSE0ZP6O6ZE5FIbiuUJ7nEJCD1Szcjqdeol8Y3ihnFgPeQUGq4vcZ_ETviwVJCr9awk0klK5fhGCys2wCaPA4W0b5tPwGzPJl5Orq_PkXcH8skW5g') IS NULL;
----
true

statement ok
SET GLOBAL acl_node_group = '';

query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6ImEiLCJyb2xlcyI6WyJhbmFseXN0Il19.RPD7WZXscyjtSETOfilmFNkrBXqC0P_SMLTmWOzAPxKydzv6BEnQud-W60LY1mixyyZvFI_-DjznCAWOZvm5C5wZR64ynr6RkbZxinJwWXWS6-NmTX4BANU7PFwTF9nSAESaMdbxJ-F_hpeAtnUikd_Hd1m5f6QhLjT4rRgotxRenvsxJmKSqNSqeLNlKXPz_-ZXOB-5vfxD_Vp4yxN9x9HMGGV7OTo1ZHJcZGSE0ZP6O6ZE5FIbiuUJ7nEJCD1Szcjqdeol8Y3ihnFgPeQUGq4vcZ_ETviwVJCr9awk0klK5fhGCys2wCaPA4W0b5tPwGzPJl5Orq_PkXcH8skW5g') IS NOT NULL;
----
true

# --- the catalog -------------------------------------------------------------------------------------

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SET GLOBAL acl_audit_level='all';

statement ok
ACL ADMIN CREATE ISSUER 'test/idp/s' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles';

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN CREATE ROLE loader;

statement ok
ACL ADMIN CREATE ROLE plain;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE plain MAIN;

statement ok
ACL ADMIN CREATE RESOURCE GROUP interactive (max_sessions 5, max_result_rows 100);

statement ok
ACL ADMIN CREATE RESOURCE GROUP etl (max_sessions 50, max_result_rows 0);

statement ok
ACL ADMIN GRANT RESOURCE GROUP interactive TO ROLE analyst;

statement ok
ACL ADMIN GRANT RESOURCE GROUP etl TO ROLE loader;

# --- a node without a group serves everyone (the single-node installation) -----------------------------

query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6ImEiLCJyb2xlcyI6WyJwbGFpbiJdfQ.a7leR6-nf1r8uq_fJ9N0h1hFJZhcn14DNjaXpIC21UrzwxgY1bZXZS33xdVwHM97g5BoXvJGV9Lg04MKb8PcwggFe5xUeZUHaojmiN9JWDFKxQQT_c-WqczCbcV_xq8W0D7VnCwX3ND0Z0wJWgCEJMHQ_aOEWbiEy_IO7XZef57hqEt1o6SFeD_Yt0RWCzAVfwuNGXa7Wn3kY3eT1V-V_FWoyDVtrwA0xT4UmL7f1zV2Wn5SFba5eA52HV_fzi9WBut8OmcXVTBZVZ58_MeHVTTIRf2CKiiYIbBLGzE_ZJ8tMxVoSVx-Dzb3BpLc5nnOhRTLCxahownp3zXq1nfOxw') IS NOT NULL AND acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6ImEiLCJyb2xlcyI6WyJsb2FkZXIiXX0.KBUJ0x6sTWEBPnV9XTyWa9QZfdpTOeW98-qnon42Mpov52h-0v5-Wf--4XhCZVme-y18Ypzkw4b2JKboR51ecQkIeJNRHjt7xI5CQ9a8CZ6zBNfLQZ-LbSr1v7v2g_t6u78loyJHm-5jYwo_ZWwZh-_1mwC8PpPD7Yi9pAkA0EfiG7QY_qr5Nu1mwFVW2FpAk0x4ZaKQvKiO9JvjaapvAeqPqGKNHWzp6LNKBh9mTEB6HV6FZTAaj9iTN0j2_A_JU-zynqs0g8j0jP41A0ZM13VFF_htNbr3q394J6Do2PKuYexmWA1Ds1juzbg5za4WLjKZW8WJmXfGzdgfoRfRyQ') IS NOT NULL;
