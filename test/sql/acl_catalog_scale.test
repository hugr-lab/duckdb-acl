# review: a cast mask is listed with the type the read binds (not as written), a masked item is named as the grant
# writes it, and a mask is bound as ONE expression - a FROM after it runs nothing while the listing binds
statement ok
CREATE TABLE phys.main.w(c0 INTEGER, c1 INTEGER, c2 VARCHAR, d DECIMAL(18, 3));

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG m;

statement ok
ACL ADMIN ADD TABLE FUNCTION m.fw MACRO 'SELECT * FROM phys.main.w';

statement ok
ACL ADMIN ADD TABLE FUNCTION m.fx MACRO 'SELECT * FROM phys.main.w';

statement ok
ACL ADMIN CREATE ROLE masker;

statement ok
ACL ADMIN GRANT CATALOG m TO ROLE masker WITH (select) MAIN COLUMNS (C0 = c0::INT8, c1 = c1::TEXT, c2, d = d::DECIMAL);

statement ok
SELECT acl_grant_object('masker', 'm', 'fx', '{"select": true}', '', 'c0 = j AS m FROM range(3) j --, c2');

