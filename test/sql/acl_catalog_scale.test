# name: test/sql/acl_catalog_scale.test
# description: spec 147 - what the big-catalog bench changed, pinned: the gateway's known roles cached per policy
#   version (a write is seen), the functions listing resolved in chunks and answered by a table function, a grant's
#   column list narrowing a function's declared columns without binding the read (masks by their text, a mask that
#   reads columns bound once), the oids the rows carry equal to the listings', and relations visible by a semi-join.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.t(c0 INTEGER, c1 INTEGER, c2 VARCHAR, tenant INTEGER);

statement ok
INSERT INTO phys.main.t VALUES (1, 10, 'a', 0), (2, 20, 'b', 1);

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin = true;

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"]}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.t AS phys.main.t;

# more functions than one resolution chunk (256)
statement ok
ACL ADMIN ADD TABLE FUNCTION c.f000 MACRO 'SELECT * FROM phys.main.t WHERE c0 >= acl_arg(1)';

