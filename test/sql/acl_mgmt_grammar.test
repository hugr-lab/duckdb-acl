# name: test/sql/acl_mgmt_grammar.test
# description: spec 150, stage 3 - the management statements read by rules of duckdb's parser: a family that moved
#   compiles to the acl_* call it always compiled to, a statement of a family that has not moved yet goes as its own
#   text to the management compiler, and a batch may hold both. First family: the operations of a node.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

# --- a family not moved yet: as its own text, as before ------------------------------------------------------------

statement ok
ACL ADMIN CREATE ROLE grammar_one;

statement ok
ACL ADMIN CREATE ROLE grammar_two; CREATE ROLE grammar_three;

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role LIKE 'grammar_%';
----
3

# --- the operations of a node: rules, the same calls ---------------------------------------------------------------

query I
ACL ADMIN DRAIN NODE;
----
0

query I
SELECT acl_drain_status();
----
draining

query I
ACL ADMIN RESUME NODE;
----
true

query I
ACL ADMIN KILL SESSION 'no-such-session';
----
false

query I
ACL ADMIN KILL SESSION "no-such-session";
----
false

query I
ACL ADMIN SET SESSION 'no-such-session' AUDIT LEVEL decisions;
----
false

query I
ACL ADMIN SET SESSION 'no-such-session' AUDIT LEVEL DEFAULT;
----
false

query I
ACL ADMIN PROFILE SESSION 'no-such-session' SAMPLED;
----
false

# the catalog is at the build's version already: the call answers so
statement ok
ACL ADMIN MIGRATE POLICY CATALOG aclcat.acl;

statement ok
ACL ADMIN MIGRATE POLICY CATALOG "aclcat"."acl";

# keywords in any case, a comment before the statement, the batch split by duckdb's grammar (a comment INSIDE the
# first statement still hides it from the text check that tells management from native SQL - the last PR of stage 3
# makes that a rule too)
query I
ACL ADMIN /* the operator's note */ drain node;
----
0

query I
ACL ADMIN RESUME NODE ;;
----
true

# a batch of a rule's statement and a compiler's
statement ok
ACL ADMIN CREATE ROLE grammar_four; DRAIN NODE; RESUME NODE;

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'grammar_four';
----
1

# --- a form that does not read as its rule says how it is written --------------------------------------------------

statement error
ACL ADMIN KILL SESSION;
----
write KILL SESSION '<id>'

statement error
ACL ADMIN KILL SESSION 'a' 'b';
----
write KILL SESSION '<id>'

statement error
ACL ADMIN KILL SESSION nobody;
----
expected a session id, quoted

statement error
ACL ADMIN KILL SESSION 'ab'
'cd';
----
expected a session id, quoted

statement error
ACL ADMIN SET SESSION 'x' AUDIT;
----
write SET SESSION '<id>' AUDIT LEVEL

statement error
ACL ADMIN PROFILE SESSION CURRENT LOUD;
----
PROFILE SESSION expects ON, ALL, SAMPLED or OFF, not "loud"

statement error
ACL ADMIN PROFILE SESSION CURRENT ON;
----
PROFILE SESSION CURRENT needs a session

statement error
ACL ADMIN MIGRATE POLICY aclcat;
----
write MIGRATE POLICY CATALOG

statement error
ACL ADMIN MIGRATE POLICY CATALOG order;
----
a name that is an SQL keyword in double quotes

statement error
ACL ADMIN KILL SESSION E'x';
----
expected a session id, quoted

statement error
ACL ADMIN KILL SESSION $$x$$;
----
expected a session id, quoted

statement error
ACL ADMIN PROFILE SESSION 'x' "on";
----
expected a profile level written as a word

# a form with more after it is that statement's refusal - the correct one before it is not blamed, and nothing runs
statement error
ACL ADMIN DRAIN NODE; KILL SESSION 'a' extra;
----
write KILL SESSION '<id>'

query I
SELECT acl_drain_status();
----
serving

# every statement is decided before any runs: a refused one leaves the first undone
statement error
ACL ADMIN CREATE ROLE never_made; KILL SESSION nobody;
----
expected a session id, quoted

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'never_made';
----
0

# a statement the tokenizer refuses is the compiler's to judge, in its own words; the rest of the batch is read by its
# rules as before
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG grammar_cat;

statement ok
ACL ADMIN ALTER VIRTUAL CATALOG grammar_cat SET COMMENT ""; RESUME NODE;

# a moved form's `""` is the tokenizer's zero-length identifier (`''` is the empty text)
statement error
ACL ADMIN ALTER ROLE grammar_one SET COMMENT "";
----
zero-length delimited identifier

statement ok
ACL ADMIN ALTER ROLE grammar_one SET COMMENT '';

# a batch the tokenizer refuses never runs without what it refused - an unterminated comment the split would drop
statement error
ACL ADMIN DRAIN NODE; /* never closed RESUME NODE;
----
unterminated

query I
SELECT acl_drain_status();
----
serving

statement error
ACL ADMIN CREATE ROLE made_anyway; /* a /* b */ DROP ROLE made_anyway;
----
unterminated

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'made_anyway';
----
0

# block comments nest, as duckdb's tokenizer reads them: a comment that holds one before the statement says nothing
query I
ACL ADMIN /* a /* b */ c */ DRAIN NODE;
----
0

statement ok
ACL ADMIN RESUME NODE;

statement error
ACL ADMIN PROFILE SESSION 'x' `on`;
----
expected a profile level written as a word

# a moved form the tokenizer refuses says the tokenizer's words
statement error
ACL ADMIN KILL SESSION 'unterminated;
----
unterminated

# the grammar never runs outside a management batch: duckdb has no DRAIN statement
statement error
DRAIN NODE;
----
syntax error

# --- roles, administration, view-as (stage 3b): rules, the same calls -----------------------------------------------

statement ok
ACL ADMIN CREATE ROLE tenant_reader CLAIMS (tenant = 'acme', region = 'eu, west');

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'tenant_reader' ORDER BY claim;
----
region	eu, west
tenant	acme

statement ok
ACL ADMIN CREATE OR REPLACE ROLE tenant_reader CLAIMS 'tenant=''globex''';

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'tenant_reader' ORDER BY claim;
----
tenant	globex

statement ok
ACL ADMIN CREATE ROLE IF NOT EXISTS tenant_reader;

statement ok
ACL ADMIN ALTER ROLE tenant_reader SET CLAIMS (tenant = 'initech');

query I
SELECT value FROM aclcat.acl.role_claims WHERE role = 'tenant_reader';
----
initech

statement ok
ACL ADMIN ALTER ROLE tenant_reader SET COMMENT 'reads one tenant';

query I
SELECT comment FROM aclcat.acl.roles WHERE role = 'tenant_reader';
----
reads one tenant

# a role named like a keyword, bare or quoted; a quoted name keeps its case and its dot
statement ok
ACL ADMIN CREATE ROLE select; CREATE ROLE "Mixed.Case";

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role IN ('select', 'Mixed.Case');
----
2

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE tenant_reader;

query I
SELECT scope FROM aclcat.acl.admins WHERE role = 'tenant_reader';
----
observe

statement ok
ACL ADMIN REVOKE ADMIN observe FROM ROLE tenant_reader;

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE tenant_reader; REVOKE ADMIN FROM ROLE tenant_reader;

query I
SELECT count(*) FROM aclcat.acl.admins WHERE role = 'tenant_reader';
----
0

statement ok
ACL ADMIN DROP ROLE IF EXISTS no_such_role;

statement error
ACL ADMIN DROP ROLE no_such_role;
----
no_such_role

statement ok
ACL ADMIN DROP ROLE "Mixed.Case";

# view-as needs a session of the client's own: the call answers so, from the rule
statement error
ACL ADMIN SET SESSION VIEW AS ROLE tenant_reader;
----
view

statement error
ACL ADMIN RESET SESSION VIEW AS;
----
view

# --- a role form that does not read as its rule says how it is written ---------------------------------------------

statement error
ACL ADMIN CREATE ROLE;
----
write CREATE [OR REPLACE] ROLE

statement error
ACL ADMIN CREATE ROLE "";
----
zero-length delimited identifier

statement error
ACL ADMIN GRANT ADMIN observe TO tenant_reader;
----
write GRANT ADMIN <scope> TO ROLE <role>

statement error
ACL ADMIN ALTER ROLE tenant_reader SET CLAIMS (tenant 'x');
----
a claim is written as name = 'value'

statement error
ACL ADMIN MAP GROUP admins FROM ISSUER corp TO ROLE tenant_reader;
----
expected external value, quoted
