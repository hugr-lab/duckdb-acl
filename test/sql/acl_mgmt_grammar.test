limit "WINDOW_MAX" is written twice

statement ok
ACL ADMIN DROP RESOURCE GROUP bare;

# --- the batch's classification (stage 3g-1): each statement's head on duckdb's tokens, never a text scan ---------

# a comment between a form's first words is gone, as duckdb's tokenizer reads it (the text scan sent these to duckdb)
statement ok
ACL ADMIN CREATE /* a note */ ROLE headed; DENY -- the deny
FUNCTION upper TO ROLE headed; ALTER /* x */ FUNCTION /* y */ CATEGORY base SET COMMENT 'base';

query III
SELECT (SELECT count(*) FROM aclcat.acl.roles WHERE role = 'headed'),
       (SELECT count(*) FROM aclcat.acl.function_grants WHERE role = 'headed' AND name = 'upper' AND NOT allowed),
       (SELECT comment FROM aclcat.acl.function_categories WHERE category = 'base');
----
1	1	base

# ... in a later statement's head too: a query batch holding one is the mixed batch
statement error
ACL ROLE "headed" SELECT 1; KILL /* k */ SESSION 'x';
----
a batch mixing management statements and queries

query I
ACL ADMIN SET SESSION /* c */ 'nosuch' AUDIT LEVEL all;
----
false

# a name with a leading digit (`1x`) is quoted after FUNCTION CATEGORY, as duckdb reads a name (spec 150 4a)
statement error
ACL ADMIN CREATE FUNCTION CATEGORY 1x;
----
write CREATE [OR REPLACE] FUNCTION CATEGORY

statement ok
ACL ADMIN CREATE FUNCTION CATEGORY "1x"; DROP FUNCTION CATEGORY "1x";

# duckdb's own forms that open like ours stay duckdb's: a macro named category, its DROP, a table named virtual
statement ok
ACL ADMIN CREATE OR REPLACE FUNCTION category(x) AS x + 1;

query I
SELECT category(1);
----
2

statement ok
ACL ADMIN DROP /* the macro */ FUNCTION category CASCADE;

statement error
SELECT category(1);
----
category

statement ok
CREATE TABLE virtual (a INTEGER);

statement ok
ACL ADMIN ANALYZE /* a note */ virtual;

statement ok
DROP TABLE virtual;

# an E'...' string with a backslash escape is one token, as duckdb reads it (the text split ended it at `\'`)
query I
ACL ROLE "headed" SELECT E'a\';GRANT CATALOG granted TO ROLE headed' AS s;
----
a';GRANT CATALOG granted TO ROLE headed

# a quoted name after ANALYZE VIRTUAL is ours (the scan read only a bare word there)
statement ok
ACL ADMIN ANALYZE VIRTUAL "granted".t;

# a string is one token: management words inside a query's literal are no statement of the batch
query I
ACL ROLE "headed" SELECT 'x; GRANT CATALOG granted TO ROLE headed' AS s;
----
x; GRANT CATALOG granted TO ROLE headed

# ... while a `;` ends a statement where duckdb ends one, inside parentheses too: the part after it is a statement
statement error
ACL ROLE "headed" SELECT (1; GRANT CATALOG granted TO ROLE headed);
----
a batch mixing management statements and queries

# a second prefix behind a comment is still a second prefix
statement error
ACL ADMIN DRAIN NODE; /* the next */ ACL ADMIN RESUME NODE;
----
one ACL prefix per batch

statement error
ACL ROLE "headed" ; ACL ADMIN DRAIN NODE;
----
one ACL prefix per batch

query I
SELECT acl_drain_status();
----
serving

statement ok
ACL ADMIN DROP ROLE headed;

# --- 3g-3c: a statement no rule reads is refused in its form's words, chosen by its head on duckdb's tokens ---------

# a comment between the head's words: the form's own words (the compiler's scanner read no comment)
statement error
ACL ADMIN GRANT /* c */ SOURCE;
----
<REGEX>:.*write GRANT SOURCE <database>\[\.<schema>\] TO ROLE <role>.*

statement error
ACL ADMIN CREATE OR VIRTUAL CATALOG x;
----
<REGEX>:.*write CREATE \[OR REPLACE\] VIRTUAL CATALOG.*

# under the ACL marker, a statement that is no management statement is refused as such - never compiled
statement error
ACL ADMIN ACL SELECT 1;
----
<REGEX>:.*unknown management statement "select".*

statement error
ACL ADMIN ACL CREATE TABLE t(a INT);
----
<REGEX>:.*CREATE TABLE is no management statement.*

statement error
ACL ADMIN ACL ALTER TABLE t ADD COLUMN b INT;
----
<REGEX>:.*ALTER TABLE is no management statement.*

statement error
ACL ADMIN ACL DROP TABLE t;
----
<REGEX>:.*DROP TABLE is no management statement.*

# duckdb's own CREATE FUNCTION (a macro) is no FUNCTION CATEGORY; a quoted noun is no word
statement error
ACL ADMIN ACL CREATE FUNCTION f(x) AS x;
----
<REGEX>:.*CREATE FUNCTION is no management statement.*

statement error
ACL ADMIN ACL DROP "t";
----
<REGEX>:.*unknown management statement "drop".*

# a batch is refused at its first statement no rule reads - a later statement's own refusal is never reached
statement error
ACL ADMIN GRANT SOURCE; KILL SESSION E'x';
----
<REGEX>:.*write GRANT SOURCE <database>\[\.<schema>\] TO ROLE <role>.*

