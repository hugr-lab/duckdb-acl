# name: test/sql/acl_mgmt_grammar.test
# description: spec 150, stage 3 - the management statements read by rules of duckdb's parser: a family that moved
#   compiles to the acl_* call it always compiled to, a statement of a family that has not moved yet goes as its own
#   text to the management compiler, and a batch may hold both. First family: the operations of a node.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

# --- a family not moved yet: as its own text, as before ------------------------------------------------------------

statement ok
ACL ADMIN CREATE RESOURCE GROUP grammar_one (window_max 8);

statement ok
ACL ADMIN CREATE RESOURCE GROUP grammar_two (window_max 8); CREATE RESOURCE GROUP grammar_three (window_max 8);

query I
SELECT count(*) FROM aclcat.acl.resource_groups WHERE "group" LIKE 'grammar_%';
----
3

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG grammar_one; CREATE ROLE grammar_one;

# --- the operations of a node: rules, the same calls ---------------------------------------------------------------

query I
ACL ADMIN DRAIN NODE;
----
0

query I
SELECT acl_drain_status();
----
draining

query I
ACL ADMIN RESUME NODE;
----
true

query I
ACL ADMIN KILL SESSION 'no-such-session';
----
false

query I
ACL ADMIN KILL SESSION "no-such-session";
----
false

query I
ACL ADMIN SET SESSION 'no-such-session' AUDIT LEVEL decisions;
----
false

query I
ACL ADMIN SET SESSION 'no-such-session' AUDIT LEVEL DEFAULT;
----
false

query I
ACL ADMIN PROFILE SESSION 'no-such-session' SAMPLED;
----
false

# the catalog is at the build's version already: the call answers so
statement ok
ACL ADMIN MIGRATE POLICY CATALOG aclcat.acl;

statement ok
ACL ADMIN MIGRATE POLICY CATALOG "aclcat"."acl";

# keywords in any case, a comment before the statement, the batch split by duckdb's grammar (a comment INSIDE the
# first statement still hides it from the text check that tells management from native SQL - the last PR of stage 3
# makes that a rule too)
query I
ACL ADMIN /* the operator's note */ drain node;
----
0

query I
ACL ADMIN RESUME NODE ;;
----
true

# a batch of a rule's statement and a compiler's
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG grammar_four; CREATE RESOURCE GROUP grammar_four (window_max 8); DRAIN NODE;
RESUME NODE;

query II
SELECT (SELECT count(*) FROM aclcat.acl.catalogs WHERE vcat = 'grammar_four'),
       (SELECT count(*) FROM aclcat.acl.resource_groups WHERE "group" = 'grammar_four');
----
1	1

# --- a form that does not read as its rule says how it is written --------------------------------------------------

statement error
ACL ADMIN KILL SESSION;
----
write KILL SESSION '<id>'

statement error
ACL ADMIN KILL SESSION 'a' 'b';
----
write KILL SESSION '<id>'

statement error
ACL ADMIN KILL SESSION nobody;
----
expected a session id, quoted

statement error
ACL ADMIN KILL SESSION 'ab'
'cd';
----
expected a session id, quoted

statement error
ACL ADMIN SET SESSION 'x' AUDIT;
----
write SET SESSION '<id>' AUDIT LEVEL

statement error
ACL ADMIN PROFILE SESSION CURRENT LOUD;
----
PROFILE SESSION expects ON, ALL, SAMPLED or OFF, not "loud"

statement error
ACL ADMIN PROFILE SESSION CURRENT ON;
----
PROFILE SESSION CURRENT needs a session

statement error
ACL ADMIN MIGRATE POLICY aclcat;
----
write MIGRATE POLICY CATALOG

statement error
ACL ADMIN MIGRATE POLICY CATALOG order;
----
a name that is an SQL keyword in double quotes

statement error
ACL ADMIN KILL SESSION E'x';
----
expected a session id, quoted

statement error
ACL ADMIN KILL SESSION $$x$$;
----
expected a session id, quoted

statement error
ACL ADMIN PROFILE SESSION 'x' "on";
----
expected a profile level written as a word

# a form with more after it is that statement's refusal - the correct one before it is not blamed, and nothing runs
statement error
ACL ADMIN DRAIN NODE; KILL SESSION 'a' extra;
----
write KILL SESSION '<id>'

query I
SELECT acl_drain_status();
----
serving

# every statement is decided before any runs: a refused one leaves the first undone
statement error
ACL ADMIN CREATE ROLE never_made; KILL SESSION nobody;
----
expected a session id, quoted

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'never_made';
----
0

# a statement the tokenizer refuses is the compiler's to judge, in its own words; the rest of the batch is read by its
# rules as before
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG grammar_cat;

statement ok
ACL ADMIN ALTER RESOURCE GROUP grammar_one SET COMMENT ""; RESUME NODE;

# ... and a moved form's `""` is the tokenizer's zero-length identifier (`''` is the empty text)
statement error
ACL ADMIN ALTER VIRTUAL CATALOG grammar_cat SET COMMENT "";
----
zero-length delimited identifier

statement error
ACL ADMIN ALTER ROLE grammar_one SET COMMENT "";
----
zero-length delimited identifier

statement ok
ACL ADMIN ALTER ROLE grammar_one SET COMMENT '';

# a batch the tokenizer refuses never runs without what it refused - an unterminated comment the split would drop
statement error
ACL ADMIN DRAIN NODE; /* never closed RESUME NODE;
----
unterminated

query I
SELECT acl_drain_status();
----
serving

statement error
ACL ADMIN CREATE ROLE made_anyway; /* a /* b */ DROP ROLE made_anyway;
----
unterminated

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'made_anyway';
----
0

# block comments nest, as duckdb's tokenizer reads them: a comment that holds one before the statement says nothing
query I
ACL ADMIN /* a /* b */ c */ DRAIN NODE;
----
0

statement ok
ACL ADMIN RESUME NODE;

statement error
ACL ADMIN PROFILE SESSION 'x' `on`;
----
expected a profile level written as a word

# a moved form the tokenizer refuses says the tokenizer's words
statement error
ACL ADMIN KILL SESSION 'unterminated;
----
unterminated

# the grammar never runs outside a management batch: duckdb has no DRAIN statement
statement error
DRAIN NODE;
----
syntax error

# --- roles, administration, view-as (stage 3b): rules, the same calls -----------------------------------------------

statement ok
ACL ADMIN CREATE ROLE tenant_reader CLAIMS (tenant = 'acme', region = 'eu, west');

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'tenant_reader' ORDER BY claim;
----
region	eu, west
tenant	acme

statement ok
ACL ADMIN CREATE OR REPLACE ROLE tenant_reader CLAIMS 'tenant=''globex''';

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'tenant_reader' ORDER BY claim;
----
tenant	globex

statement ok
ACL ADMIN CREATE ROLE IF NOT EXISTS tenant_reader;

statement ok
ACL ADMIN ALTER ROLE tenant_reader SET CLAIMS (tenant = 'initech');

query I
SELECT value FROM aclcat.acl.role_claims WHERE role = 'tenant_reader';
----
initech

statement ok
ACL ADMIN ALTER ROLE tenant_reader SET COMMENT 'reads one tenant';

query I
SELECT comment FROM aclcat.acl.roles WHERE role = 'tenant_reader';
----
reads one tenant

# a role named like a keyword, bare or quoted; a quoted name keeps its case and its dot
statement ok
ACL ADMIN CREATE ROLE select; CREATE ROLE "Mixed.Case";

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role IN ('select', 'Mixed.Case');
----
2

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE tenant_reader;

query I
SELECT scope FROM aclcat.acl.admins WHERE role = 'tenant_reader';
----
observe

statement ok
ACL ADMIN REVOKE ADMIN observe FROM ROLE tenant_reader;

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE tenant_reader; REVOKE ADMIN FROM ROLE tenant_reader;

query I
SELECT count(*) FROM aclcat.acl.admins WHERE role = 'tenant_reader';
----
0

statement ok
ACL ADMIN DROP ROLE IF EXISTS no_such_role;

statement error
ACL ADMIN DROP ROLE no_such_role;
----
no_such_role

statement ok
ACL ADMIN DROP ROLE "Mixed.Case";

# a comment inside a form past its first two words (the compiler's scanner read none; before the second word the text
# check that tells management from native SQL still misses it - 3g makes that a rule)
statement ok
ACL ADMIN CREATE ROLE /* the note */ commented_role -- and after
;

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'commented_role';
----
1

# a comment inside a claims list is no part of it: the list is its tokens, never its text as written
statement ok
ACL ADMIN CREATE ROLE commented_claims CLAIMS (region = 'eu' -- , tenant = 'globex'
);

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'commented_claims';
----
region	eu

statement ok
ACL ADMIN ALTER ROLE commented_claims SET CLAIMS (region = /* a ) and a ' */ 'us');

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'commented_claims';
----
region	us

# ... and the list is otherwise as written: a name or an unquoted value keeps what touches in it
statement ok
ACL ADMIN CREATE ROLE punctuated CLAIMS (custom:tenant = 'acme', cost-center = '42', level = -1, region = eu-west);

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'punctuated' ORDER BY claim;
----
cost-center	42
custom:tenant	acme
level	-1
region	eu-west

# a literal the compiler's reader would split otherwise than duckdb's tokenizer reads it is refused in a list (stage
# 4 makes the list a rule): `$$a, tenant = 'globex', b = $$` is one value to the tokenizer, three claims to the reader
statement error
ACL ADMIN CREATE ROLE split_list CLAIMS (region = $$a, tenant = 'globex', b = $$);
----
a claims list is written as name = 'value' items

statement error
ACL ADMIN CREATE ROLE split_list CLAIMS (region = E'a\'b', tenant = 'x');
----
a claims list is written as name = 'value' items

statement error
ACL ADMIN CREATE ROLE split_list CLAIMS (region = `a, tenant = 'globex', z = `);
----
a backtick name

# ... and a text the tokens do not tile (after a lone `$` the tokenizer places the next token at the `$`)
statement error
ACL ADMIN CREATE ROLE split_list CLAIMS (region = $, tenant = 'x');
----
a claims list is written as name = 'value' items

statement error
ACL ADMIN CREATE ROLE split_list CLAIMS (region = 'x', tenant = $);
----
a claims list is written as name = 'value' items

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'split_list';
----
0

# a name with a leading digit is one word, as the scanner read it - the tokenizer splits it (`9abc` is `9` `abc`)
statement ok
ACL ADMIN CREATE ROLE 9abc; CREATE ROLE 0x1F;

query I
SELECT role FROM aclcat.acl.roles WHERE role IN ('9abc', '0x1F') ORDER BY role;
----
0x1F
9abc

statement ok
ACL ADMIN DROP ROLE 9abc;

# ... and a word apart is another word
statement error
ACL ADMIN CREATE ROLE 9 abc;
----
write CREATE [OR REPLACE] ROLE

# a role mapping, both ways; an issuer's name of words joined by dots, `.2` too
statement ok
ACL ADMIN CREATE ISSUER "v1.2" URL 'test/idp/two';

statement ok
ACL ADMIN MAP GROUP 'g-read' FROM ISSUER v1.2 TO ROLE tenant_reader; MAP CLAIM "ops" FROM ISSUER v1 . 2 TO ROLE 0x1F;

query IIIII
SELECT scope_kind, scope_name, source, external_value, role FROM aclcat.acl.role_mappings ORDER BY role;
----
issuer	v1.2	claim-value	ops	0x1F
issuer	v1.2	group	g-read	tenant_reader

# a dotted name the tokenizer reads as numbers is the name as written (`v2.0.1` is `v2` `.0.1`): the mapping reaches
# the issuer's own check, every part a word
statement error
ACL ADMIN MAP GROUP 'g' FROM ISSUER v2.0.1 TO ROLE tenant_reader;
----
issuer "v2.0.1" does not exist

statement error
ACL ADMIN MAP GROUP 'g' FROM ISSUER 9.x TO ROLE tenant_reader;
----
issuer "9.x" does not exist

statement error
ACL ADMIN MAP GROUP 'g' FROM ISSUER a..b TO ROLE tenant_reader;
----
write MAP GROUP | CLAIM

statement ok
ACL ADMIN DROP MAP GROUP 'g-read' FROM ISSUER v1.2 TO ROLE tenant_reader;

query I
SELECT count(*) FROM aclcat.acl.role_mappings;
----
1

# view-as needs a session of the client's own: the call answers so, from the rule
statement error
ACL ADMIN SET SESSION VIEW AS ROLE tenant_reader;
----
view

statement error
ACL ADMIN RESET SESSION VIEW AS;
----
view

# --- a role form that does not read as its rule says how it is written ---------------------------------------------

statement error
ACL ADMIN CREATE ROLE;
----
write CREATE [OR REPLACE] ROLE

statement error
ACL ADMIN CREATE ROLE "";
----
zero-length delimited identifier

statement error
ACL ADMIN GRANT ADMIN observe TO tenant_reader;
----
write GRANT ADMIN <scope> TO ROLE <role>

statement error
ACL ADMIN ALTER ROLE tenant_reader SET CLAIMS (tenant 'x');
----
a claim is written as name = 'value'

statement error
ACL ADMIN MAP GROUP admins FROM ISSUER corp TO ROLE tenant_reader;
----
expected external value, quoted

# --- the virtual catalog's objects (stage 3c): CREATE VIRTUAL and the ADD forms, rules, the same calls ---------------

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.t (a INTEGER, b INTEGER, tenant VARCHAR);

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG objects COMMENT 'the objects of stage 3c';

# a comment anywhere inside a form; a list's comment is a space - an RLS predicate's line comment before its closing
# parenthesis no longer leaves an open comment in the stored predicate
statement ok
ACL ADMIN CREATE VIRTUAL TABLE /* the table */ objects.t AS phys.main.t COLUMNS (a, b -- not tenant
) RLS (a > 0 -- positive only
) COMMENT 'commented';

query III
SELECT phys, rls, comment FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 't';
----
phys.main.t	a > 0	commented

query I
SELECT string_agg(name, ',' ORDER BY pos) FROM aclcat.acl.relation_columns WHERE vcat = 'objects' AND vname = 't';
----
a,b

# a body inline runs to the end of the statement: its own comments are its own, one after its last token is not
statement ok
ACL ADMIN CREATE VIRTUAL VIEW objects.v AS SELECT a /* kept */ FROM phys.main.t -- not kept
;

query I
SELECT view_sql FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'v';
----
SELECT a /* kept */ FROM phys.main.t

# ... or one quoted string, its value - the whole body: a clause written after it is refused, never stored as the SQL
statement ok
ACL ADMIN ADD VIEW objects.q AS 'SELECT ''x'' AS s';

query I
SELECT view_sql FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'q';
----
SELECT 'x' AS s

statement error
ACL ADMIN CREATE VIRTUAL VIEW objects.late AS 'SELECT 1 AS a' COMMENT 'x';
----
is the whole body

statement error
ACL ADMIN ADD SCALAR objects.tag(x VARCHAR) MACRO 'acl_arg(1)' || 'x';
----
is the whole body

statement ok
ACL ADMIN CREATE VIRTUAL SCALAR objects.tag(x VARCHAR) AS concat('tag:', acl_arg(1));

query I
SELECT template FROM aclcat.acl.functions WHERE vcat = 'objects' AND vname = 'tag';
----
concat('tag:', acl_arg(1))

# a name with a leading digit, a part the tokenizer reads as a number, spaces around a dot
statement ok
ACL ADMIN CREATE VIRTUAL TABLE objects.9t AS phys . main . t; ADD TABLE phys.main.t AS objects.v1.2;

query II
SELECT vname, phys FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname IN ('9t', 'v1.2') ORDER BY vname;
----
9t	phys.main.t
v1.2	phys.main.t

# a reference between objects, the clauses in any order
statement ok
ACL ADMIN CREATE VIRTUAL REFERENCE objects.r FROM objects.t TO v ON (a = a) OPTIONAL CARDINALITY one_to_one COMMENT 'r';

query IIIII
SELECT from_vname, to_vname, to_kind, cardinality, comment FROM aclcat.acl.references WHERE vcat = 'objects';
----
t	v	relation	one_to_one	r

# a table function and a reference that substitutes its argument; ON EXPRESSION; an endpoint with its catalog
statement ok
ACL ADMIN ADD TABLE FUNCTION objects.tf(x INTEGER) RETURNS TABLE (a INTEGER) MACRO SELECT a FROM phys.main.t WHERE a = acl_arg(1);
CREATE VIRTUAL REFERENCE objects.rf FROM objects.t TO FUNCTION objects.tf(x => a) JOIN asof;
CREATE VIRTUAL REFERENCE objects.re FROM t TO objects.v ON EXPRESSION 't.a = v.a';

query IIIII
SELECT name, from_vname, to_vname, to_kind, coalesce(expr, '') FROM aclcat.acl.references WHERE vcat = 'objects'
    AND name IN ('rf', 're') ORDER BY name;
----
re	t	v	relation	t.a = v.a
rf	t	tf	function	(empty)

query II
SELECT "column", param FROM aclcat.acl.reference_columns WHERE vcat = 'objects' AND name = 'rf';
----
a	x

# schemas: the live alias (AS), the expansion (FROM, the legacy quoted path), the ADD form
statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA objects.live AS phys.main COMMENT 'l'; CREATE VIRTUAL SCHEMA objects.copy FROM 'phys.main';
ADD SCHEMA phys.main AS objects.old;

query III
SELECT path, coalesce(phys_path, '-'), coalesce(comment, '') FROM aclcat.acl.schemas WHERE vcat = 'objects' ORDER BY path;
----
copy	-	(empty)
live	phys.main	l
old	phys.main	(empty)

# aliases: ALIAS, ALIAS OF, a comment before and after it (the last one written wins)
statement ok
ACL ADMIN ADD SCALAR objects.lo ALIAS lower; ADD TABLE FUNCTION objects.rng ALIAS OF range;
CREATE VIRTUAL SCALAR objects.up COMMENT 'a' ALIAS OF upper COMMENT 'b';

query IIII
SELECT vname, form, target, coalesce(comment, '') FROM aclcat.acl.functions WHERE vcat = 'objects'
    AND vname IN ('lo', 'rng', 'up') ORDER BY vname;
----
lo	alias	lower	(empty)
rng	alias	range	(empty)
up	alias	upper	b

# the legacy quoted forms: a whole path, a columns list, an RLS predicate, a key
statement ok
ACL ADMIN CREATE VIRTUAL TABLE objects.lg AS 'phys.main.t' COLUMNS 'a, "b"' RLS 'a > 0' PRIMARY KEY 'a';

query II
SELECT phys, rls FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'lg';
----
phys.main.t	a > 0

query II
SELECT (SELECT string_agg(name, ',' ORDER BY pos) FROM aclcat.acl.relation_columns WHERE vcat = 'objects' AND vname = 'lg'),
       (SELECT string_agg("column", ',' ORDER BY pos) FROM aclcat.acl.keys WHERE vcat = 'objects' AND vname = 'lg');
----
a,b	a

# a view's declared columns, its key and comment in either order
statement ok
ACL ADMIN CREATE VIRTUAL VIEW objects.vk (a INTEGER) COMMENT 'c' PRIMARY KEY (a) AS SELECT a FROM phys.main.t;

query III
SELECT (SELECT string_agg(name || ' ' || type, ',') FROM aclcat.acl.object_columns WHERE vcat = 'objects' AND vname = 'vk'),
       (SELECT string_agg("column", ',') FROM aclcat.acl.keys WHERE vcat = 'objects' AND vname = 'vk'),
       (SELECT comment FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'vk');
----
a INTEGER	a	c

# the modes: IF NOT EXISTS keeps what is there, OR REPLACE overwrites, a plain CREATE refuses an existing one
statement ok
ACL ADMIN CREATE VIRTUAL TABLE IF NOT EXISTS objects.lg AS phys.main.t RLS (a > 5);

query I
SELECT rls FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'lg';
----
a > 0

statement ok
ACL ADMIN CREATE OR REPLACE VIRTUAL TABLE objects.lg AS phys.main.t RLS (a > 5);

query I
SELECT rls FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'lg';
----
a > 5

statement error
ACL ADMIN CREATE VIRTUAL TABLE objects.lg AS phys.main.t;
----
already exists

# a `$$…$$` string in a body is one literal, whatever it holds
statement ok
ACL ADMIN ADD VIEW objects.d AS SELECT $$a;b$$ AS x;

query I
SELECT view_sql FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'd';
----
SELECT $$a;b$$ AS x

# a quoted part keeps its case; a path written otherwise is no path
statement ok
ACL ADMIN CREATE VIRTUAL TABLE objects."Mixed Case" AS phys.main.t;

query I
SELECT vname FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'Mixed Case';
----
Mixed Case

# --- an object form that does not read as its rule says how it is written ------------------------------------------

statement error
ACL ADMIN CREATE VIRTUAL TABLE objects."a"b AS phys.main.t;
----
write CREATE [OR REPLACE] VIRTUAL TABLE

statement error
ACL ADMIN CREATE VIRTUAL TABLE objects..t AS phys.main.t;
----
write CREATE [OR REPLACE] VIRTUAL TABLE

statement error
ACL ADMIN CREATE VIRTUAL SCALAR objects.s RETURNS TABLE (x INTEGER) AS 1;
----
a scalar RETURNS one type

statement error
ACL ADMIN CREATE VIRTUAL SCALAR objects.s RETURNS TABLE (x INTEGER) ALIAS OF upper;
----
a scalar RETURNS one type

statement error
ACL ADMIN CREATE VIRTUAL CATALOG c2 COMMENT 'x' extra;
----
write CREATE [OR REPLACE] VIRTUAL CATALOG

statement error
ACL ADMIN CREATE VIRTUAL GADGET objects.g;
----
write CREATE [OR REPLACE] VIRTUAL CATALOG | REFERENCE

statement error
ACL ADMIN CREATE VIRTUAL TABLE objects.nothing;
----
write CREATE [OR REPLACE] VIRTUAL TABLE

statement error
ACL ADMIN ADD SCALAR objects.s RETURNS INTEGER;
----
write ADD SCALAR | TABLE FUNCTION

statement error
ACL ADMIN CREATE VIRTUAL TABLE FUNCTION objects.f() RETURNS TABLE () AS SELECT 1;
----
RETURNS TABLE needs a column list

statement error
ACL ADMIN CREATE VIRTUAL SCALAR objects.s() PRIMARY KEY (x) AS 1;
----
a scalar has no PRIMARY KEY

statement error
ACL ADMIN CREATE VIRTUAL TABLE t AS phys.main.t;
----
must be written as <catalog>.<name>

# a list the tokens do not tile (after a lone `$` the tokenizer places the next token at the `$`) is refused
statement error
ACL ADMIN CREATE VIRTUAL TABLE objects.dollar AS phys.main.t RLS (a = $, b > 0);
----
does not read as written

query I
SELECT count(*) FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname IN ('nothing', 'dollar', 'late');
----
0

# an alias form still judges what it does not store: a table function's RETURNS, a key written as a plain literal
statement error
ACL ADMIN CREATE VIRTUAL TABLE FUNCTION objects.fa RETURNS INTEGER ALIAS OF range;
----
RETURNS TABLE needs a column list

statement error
ACL ADMIN CREATE VIRTUAL TABLE FUNCTION objects.fa RETURNS TABLE (a INTEGER) PRIMARY KEY E'a' ALIAS OF range;
----
key columns

# a dollar-quoted string nobody closed is one literal to the end of the text to duckdb's tokenizer: it would take the
# statements after it into the body (`AS SELECT $x$ AS a; DROP ROLE …` stored the DROP as the view's SQL) - refused
statement error
ACL ADMIN CREATE VIRTUAL VIEW objects.dz AS SELECT $x$ AS a; DROP ROLE grammar_one;
----
an unterminated quoted string

query II
SELECT (SELECT count(*) FROM aclcat.acl.roles WHERE role = 'grammar_one'),
       (SELECT count(*) FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'dz');
----
1	0

# a line comment between two quoted strings ends the line as a line break does - they stay one string
statement ok
ACL ADMIN CREATE VIRTUAL TABLE objects.joined AS phys.main.t RLS (tenant = 'a' -- the first half
'b');

query I
SELECT rls = 'tenant = ''a''' || chr(10) || '''b''' FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'joined';
----
true

# a list our readers split takes '...' literals only: `$$x, b, y$$` is one literal to the tokenizer, three columns to
# the reader (an RLS predicate is SQL, read by duckdb's parser: any literal)
statement error
ACL ADMIN CREATE VIRTUAL TABLE objects.split AS phys.main.t COLUMNS (a, $$x, b, y$$);
----
a list is written with '...' literals

statement ok
ACL ADMIN CREATE VIRTUAL TABLE objects.dollar_rls AS phys.main.t RLS (tenant <> $$x, y$$);

# ... a line comment elsewhere is a space: a declared column's name and type stay apart
statement ok
ACL ADMIN CREATE VIRTUAL VIEW objects.nt (a -- the only column
INTEGER) AS SELECT 1 AS a;

query II
SELECT name, type FROM aclcat.acl.object_columns WHERE vcat = 'objects' AND vname = 'nt';
----
a	INTEGER

# an E'...' string without a backslash splits as written: a mask may be one
statement ok
ACL ADMIN CREATE VIRTUAL TABLE objects.masked AS phys.main.t COLUMNS (a, tenant = E'***');

# a statement the tokenizer refuses (`""`) is compiled from its text only when the split kept no `;` inside its
# parentheses - there duckdb's tokenizer ends a statement, and a body would take the next one into it
statement error
ACL ADMIN ALTER VIRTUAL VIEW objects.v SET AS SELECT (1 AS ""; DROP ROLE grammar_one);
----
zero-length delimited identifier

query II
SELECT (SELECT count(*) FROM aclcat.acl.roles WHERE role = 'grammar_one'),
       (SELECT view_sql FROM aclcat.acl.relations WHERE vcat = 'objects' AND vname = 'v');
----
1	SELECT a /* kept */ FROM phys.main.t

statement error
