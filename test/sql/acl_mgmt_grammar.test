заказы

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE größe;

statement ok
ACL ADMIN REVOKE ADMIN FROM ROLE größe;

statement ok
ACL ADMIN COMMENT ON VIRTUAL TABLE продажи.заказы IS 'orders';

query T
SELECT comment FROM aclcat.acl.relations WHERE vcat = 'продажи' AND vname = 'заказы';
----
orders

# a reserved word and a leading digit need quotes, as in duckdb; an unreserved keyword does not
statement error
ACL ADMIN CREATE ROLE from;
----

statement ok
ACL ADMIN CREATE ROLE "from";

statement error
ACL ADMIN CREATE ROLE 9ö;
----

statement ok
ACL ADMIN CREATE ROLE "9ö";

statement ok
ACL ADMIN CREATE ROLE user;

# backticks quote a name, as in duckdb
statement ok
ACL ADMIN CREATE ROLE `back tick`;

query T
SELECT role FROM aclcat.acl.roles WHERE role IN ('from', '9ö', 'user', 'back tick') ORDER BY 1;
----
9ö
back tick
from
user

# whatever duckdb's tokenizer keeps in a word is a bare name (an invisible U+034F too) - another name than without it
statement ok
ACL ADMIN CREATE ROLE admin͏;

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'admin͏';
----
1

# a revoke of nothing is refused: a name that only looks like the role's would answer success
statement error
ACL ADMIN REVOKE CATALOG продажи FROM ROLE отдел2;
----
<REGEX>:.*role "отдел2" holds no grant on catalog "продажи".*

# a renamed column in another script stays a rename (the relation writable), and may be the key; a parenthesised one
# is written as an expression and is not
statement ok
CREATE TABLE phys_4a_u(a INT, "größe" INT, b INT);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE продажи.u AS memory.main.phys_4a_u COLUMNS (a = a, x = größe) PRIMARY KEY (x);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE продажи.p AS memory.main.phys_4a_u COLUMNS (a = a, y = (b));

query TT
SELECT vname, form FROM aclcat.acl.relations WHERE vcat = 'продажи' AND vname IN ('u', 'p') ORDER BY 1;
----
p	subquery
u	alias

