2

statement ok
SELECT acl_revoke_function('fgrantee', 'system.main."||"'), acl_revoke_function('', '"read_csv" TABLE'),
       acl_revoke_function('', '"read_csv"');

statement ok
SELECT acl_grant_function('fgrantee', 'read_csv' || chr(10) || 'TABLE');

query I
SELECT kind FROM aclcat.acl.function_grants WHERE role = 'fgrantee' AND name = 'read_csv';
----
table

statement ok
SELECT acl_revoke_function('fgrantee', 'read_csv TABLE');

statement error
SELECT acl_deny_function('lo' || chr(9) || 'wer SCALAR');
----
holds no apostrophe, parenthesis or control character

statement error
SELECT acl_function_category_add('nosuch', 'it''s TABLE, lower TABLE');
----
holds no apostrophe, parenthesis

statement error
SELECT acl_deny_function('lower()');
----
holds no apostrophe, parenthesis

# a category's members are read by the same reader: a quoted part is its name, a trailing dot or an empty part refused
statement ok
ACL ADMIN CREATE FUNCTION CATEGORY quoted; ALTER FUNCTION CATEGORY quoted ADD (lower, "main"."upper", system.main."||");

query T
SELECT string_agg(name, ',' ORDER BY name) FROM aclcat.acl.function_category_members WHERE category = 'quoted';
----
lower,upper,||

statement ok
ACL ADMIN ALTER FUNCTION CATEGORY quoted DROP (system.main."lower", "system"."main"."upper", "||");

query I
SELECT count(*) FROM aclcat.acl.function_category_members WHERE category = 'quoted';
----
0

statement error
ACL ADMIN ALTER FUNCTION CATEGORY quoted ADD (lower.);
----
is no function name

statement error
ACL ADMIN ALTER FUNCTION CATEGORY quoted ADD (system..lower);
----
never empty

statement ok
ACL ADMIN ALTER FUNCTION CATEGORY quoted ADD (read_csv
TABLE);

query T
SELECT kind FROM aclcat.acl.function_category_members WHERE category = 'quoted' AND name = 'read_csv';
----
table

statement ok
ACL ADMIN DROP FUNCTION CATEGORY quoted;

# CATEGORY alone is no function's name: a category's name forgotten is refused, never a grant of `category`
statement error
ACL ADMIN DENY FUNCTION CATEGORY TO ALL ROLES;
----
FUNCTION CATEGORY names a category

statement error
ACL ADMIN REVOKE FUNCTION category FROM ROLE fgrantee;
----
FUNCTION CATEGORY names a category

# ALL ROLES is a function grant's: an object grant and a platform grant refuse it where read, so the batch runs
# nothing
statement error
ACL ADMIN CREATE ROLE never_seated; GRANT TABLE granted.t TO ALL ROLES;
----
an object grant names one role

statement error
ACL ADMIN CREATE ROLE never_seated; REVOKE VIEW platform.sessions FROM ALL ROLES;
----
a grant on the platform catalog names one role

statement error
ACL ADMIN CREATE ROLE never_seated; REVOKE TABLE granted.t FROM ALL ROLES;
----
an object grant names one role

statement error
ACL ADMIN CREATE ROLE never_seated; GRANT FUNCTION platform.drain TO ALL ROLES;
----
a grant on the platform catalog names one role

statement error
ACL ADMIN CREATE ROLE never_seated; DENY VIEW platform.sessions TO ALL ROLES;
----
a grant on the platform catalog names one role

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'never_seated';
----
0

# the forms' other spellings: OR REPLACE on a category, DROP () refused, a group without limits, a limit or COMMENT
# written twice refused
statement ok
ACL ADMIN CREATE OR REPLACE FUNCTION CATEGORY again; ALTER FUNCTION CATEGORY again ADD (lower);

statement error
ACL ADMIN ALTER FUNCTION CATEGORY again DROP ();
----
DROP takes the members in parentheses

statement ok
ACL ADMIN DROP FUNCTION CATEGORY again; CREATE RESOURCE GROUP bare;

