# a statement no rule reads yet goes to the compiler as its text, whose scanner knows '...' and "..." and whitespace
# only: a comment, a $$...$$ string, an E'...' one with a backslash or a backtick name would be read otherwise than
# written (before stage 3d, `GRANT CATALOG … WITH (select, /*, manage, */ insert)` granted manage) - refused until its
# family is a rule
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG hidden; CREATE ROLE hider;

statement error
ACL ADMIN CREATE RESOURCE GROUP hider_group (window_max 8 /* a note */);
----
a comment in a statement no rule reads yet

query I
SELECT count(*) FROM aclcat.acl.resource_groups WHERE "group" = 'hider_group';
----
0

# ... while a statement that does not compile keeps its own refusal
statement error
ACL ADMIN GRANT RESOURCE GROUP /* x */ grammar_one TO ROLE hider;
----
expected a group name

# a body is read as what it is - one statement, one expression - before anything of the batch runs: a `;` ends a
# statement wherever it stands outside a literal, so a body cut by one does not parse and is never stored, and the
# statements after it never run
statement error
ACL ADMIN CREATE VIRTUAL VIEW hidden.v AS SELECT (1; CREATE VIRTUAL VIEW hidden.w AS SELECT 2);
----
view SQL does not parse

statement error
ACL ADMIN CREATE VIRTUAL VIEW hidden.v AS SELECT [1; DROP VIRTUAL CATALOG hidden CASCADE; CREATE VIRTUAL VIEW hidden.w AS SELECT 2];
----
view SQL does not parse

statement error
ACL ADMIN ADD SCALAR hidden.s(x INTEGER) MACRO CASE WHEN acl_arg(1) > 0 THEN 1; DROP VIRTUAL CATALOG hidden CASCADE;
----
expression template does not parse

statement error
ACL ADMIN ALTER VIRTUAL VIEW hidden.nothing SET AS SELECT 1; SELECT 2;
----
a batch mixing management statements and queries

query II
SELECT (SELECT count(*) FROM aclcat.acl.relations WHERE vcat = 'hidden'),
       (SELECT count(*) FROM aclcat.acl.catalogs WHERE vcat = 'hidden');
----
0	1

# --- grants (stage 3d): GRANT / REVOKE CATALOG | SCHEMA | TABLE | VIEW | OBJECT, ALTER GRANT - rules, the same calls --

statement ok
CREATE SCHEMA phys.staging;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG granted; CREATE VIRTUAL TABLE granted.t AS phys.main.t;
CREATE VIRTUAL SCHEMA granted.s AS phys.main; CREATE ROLE grantee;

# a WITH list reads as written: a comment in it is no capability (the compiler read `/*, manage, */` as items)
statement ok
ACL ADMIN GRANT CATALOG granted TO ROLE grantee WITH (select, /*, manage, */ insert) MAIN;

query II
SELECT caps, is_main FROM aclcat.acl.role_catalogs WHERE role = 'grantee';
----
{"select": true, "insert": true}	true

# each item a word or a double-quoted name, quoted as JSON, and a capability's name is a word: an escape is no
# capability (the compiler pasted the text between the commas into the JSON, so `\u006danage` stored manage)
statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee WITH (select, \u006danage);
----
write GRANT CATALOG

statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee WITH (select, "\u006danage");
----
a capability's name is a word

# the same capability twice is one
statement ok
ACL ADMIN GRANT CATALOG granted TO ROLE grantee WITH (select, "Insert", SELECT, insert);

query I
SELECT caps FROM aclcat.acl.role_catalogs WHERE role = 'grantee';
----
{"select": true, "insert": true}

# a stored name a pasted rebuild would turn into another: REVOKE ADMIN rewrites the caps as JSON, so a name written
# `\u006danage` (planted directly - no write path takes it now) stays that name, never manage
statement ok
UPDATE aclcat.acl.role_catalogs SET caps = '{"select": true, "manage": true, "' || chr(92) || chr(92) || 'u006danage": true}'
WHERE role = 'grantee';

statement ok
ACL ADMIN REVOKE ADMIN FROM ROLE grantee;

query II
SELECT acl_platform_caps(caps).manage, acl_platform_caps(caps)."select" FROM aclcat.acl.role_catalogs WHERE role = 'grantee';
----
false	true

# CAPS JSON is read as a JSON reader reads it: a name twice (names compare case-insensitively) or a name that is no
# word (a NUL this reader reads up to, a quote a rewrite would paste) is refused where it is written
statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee CAPS '{"select": true, "manage": true, "manage": false}';
----
caps name "manage" twice

statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee CAPS '{"select": true, "Select": false}';
----
caps name "Select" twice

statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee CAPS '{"select": true, "manage\u0000x": true}';
----
a capability's name is a word

# the clauses in any order, each once: a repeated one would leave a reader the first while the last took effect
statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee WITH (select) RLS (tenant = 'x') MAIN RLS ();
----
RLS is written twice

statement error
ACL ADMIN GRANT CATALOG granted TO ROLE grantee CAPS '{"manage": true}' WITH (select);
----
CAPS is written twice

statement ok
ACL ADMIN GRANT CATALOG granted TO ROLE grantee MAIN COLUMNS (a, "b") WITH (select) RLS (a > 0);

query IIII
