ALTER VIRTUAL VIEW changes.v SET PRIMARY KEY (a);
ALTER VIRTUAL TABLE changes.t SET RLS (a > 0 -- positive only
); ALTER VIRTUAL TABLE changes.t SET COLUMNS (a, b, tenant = '***'); ALTER VIRTUAL TABLE changes.t SET TYPES (aliases = keep);
ALTER VIRTUAL TABLE changes.t SET PHYS phys.main.t;

