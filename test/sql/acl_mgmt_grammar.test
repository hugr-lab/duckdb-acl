ACL ADMIN DROP ROLE "9ö";

statement ok
ACL ADMIN DROP ROLE user;

statement ok
ACL ADMIN DROP ROLE `back tick`;

statement ok
ACL ADMIN DROP ROLE admin͏;

statement ok
ACL ADMIN DROP ROLE größe;

statement ok
ACL ADMIN DROP ROLE отдел2;

# nested schemas: a path of any depth, each part bare or quoted (a dot inside a quoted part is part of the name), a
# keyword after the first part as duckdb reads one; the keys, the read, the grants, the listing and the repair text
statement ok
CREATE SCHEMA phys."Raw.Data";

statement ok
CREATE TABLE phys."Raw.Data"."Order.Items"(id INT, tenant VARCHAR);

statement ok
INSERT INTO phys."Raw.Data"."Order.Items" VALUES (1, 'acme'), (2, 'other');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG "nn.catalog"; CREATE VIRTUAL CATALOG catalog; CREATE ROLE nest;

statement ok
ACL ADMIN GRANT CATALOG "nn.catalog" TO ROLE nest WITH (select) MAIN; GRANT CATALOG catalog TO ROLE nest WITH (select);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "nn.catalog"."parent.schema".child.sub."table.name" AS phys."Raw.Data"."Order.Items";

statement ok
ACL ADMIN CREATE VIRTUAL TABLE catalog.parent.child.sub.table AS phys.main.t;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE catalog . select . from . "x y" AS phys . main . t;

query TTT
SELECT vcat, vname, phys FROM aclcat.acl.relations WHERE vcat IN ('"nn.catalog"', 'catalog') ORDER BY ALL;
----
"nn.catalog"	"parent.schema".child.sub."table.name"	phys."Raw.Data"."Order.Items"
catalog	parent.child.sub.table	phys.main.t
catalog	select.from.x y	phys.main.t

# a reserved word first is refused, as duckdb refuses `FROM select.a.t`
statement error
ACL ADMIN CREATE VIRTUAL TABLE select.a.t AS phys.main.t;
----

query IT
ACL ROLE "nest" SELECT * FROM "nn.catalog"."parent.schema".child.sub."table.name" ORDER BY id;
----
1	acme
2	other

query I
ACL ROLE "nest" SELECT count(*) FROM catalog.parent.child.sub.table;
----
0

query TTT
ACL ROLE "nest" SELECT table_catalog, table_schema, table_name FROM information_schema.tables ORDER BY ALL;
----
catalog	parent.child.sub	table
catalog	select.from	x y
nn.catalog	"parent.schema".child.sub	table.name

statement ok
ACL ADMIN GRANT TABLE "nn.catalog"."parent.schema".child.sub."table.name" TO ROLE nest RLS (tenant = 'acme');

query IT
ACL ROLE "nest" SELECT * FROM "nn.catalog"."parent.schema".child.sub."table.name";
----
1	acme

statement ok
ACL ADMIN REVOKE TABLE "nn.catalog"."parent.schema".child.sub."table.name" FROM ROLE nest;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA "nn.catalog"."parent.schema".alias AS phys."Raw.Data";

statement ok
ACL ADMIN GRANT SCHEMA "nn.catalog"."parent.schema".alias TO ROLE nest WITH (select);

query I
ACL ROLE "nest" SELECT count(*) FROM "nn.catalog"."parent.schema".alias."Order.Items";
----
2

statement ok
ACL ADMIN REVOKE SCHEMA "nn.catalog"."parent.schema".alias FROM ROLE nest;

# the repair text names the object as it must be written back
statement ok
ALTER TABLE phys."Raw.Data"."Order.Items" RENAME TO gone;

query T
SELECT repair FROM acl_check_catalog('"nn.catalog"') WHERE problem = 'source_missing';
----
ALTER VIRTUAL TABLE "nn.catalog"."parent.schema".child.sub."table.name" SET PHYS <path>  -- or DROP VIRTUAL TABLE "nn.catalog"."parent.schema".child.sub."table.name"

statement ok
ACL ADMIN DROP VIRTUAL TABLE "nn.catalog"."parent.schema".child.sub."table.name"; DROP VIRTUAL SCHEMA "nn.catalog"."parent.schema".alias;

statement ok
ACL ADMIN DROP VIRTUAL TABLE catalog.parent.child.sub.table; DROP VIRTUAL TABLE catalog.select.from."x y";

statement ok
ACL ADMIN DROP VIRTUAL CATALOG "nn.catalog" CASCADE; DROP VIRTUAL CATALOG catalog CASCADE; DROP ROLE nest;

# --- 4a's reviews: names that are values, function names, renames, a revoke of nothing -----------------------------

statement ok
ACL ADMIN CREATE ROLE rev4a;

# a backtick name where a name is a value, as duckdb quotes one
statement ok
ACL ADMIN MAP GROUP 'g4a' FROM ISSUER `v1.2` TO ROLE rev4a;

statement ok
ACL ADMIN DROP MAP GROUP 'g4a' FROM ISSUER `v1.2` TO ROLE rev4a;

# words joined by dots, or one quoted name - never a word, a dot and a quoted part
statement error
ACL ADMIN MAP GROUP 'g4a' FROM ISSUER v1."2" TO ROLE rev4a;
----
write MAP GROUP | CLAIM

# a function's name as duckdb reads one: a keyword a function may have (`left`, `glob`) bare; as a qualifier it is
# no identifier
statement ok
ACL ADMIN GRANT FUNCTION left TO ROLE rev4a; GRANT FUNCTION glob TABLE TO ROLE rev4a;

query TT
SELECT name, kind FROM aclcat.acl.function_grants WHERE role = 'rev4a' ORDER BY name;
----
glob	table
left	scalar

statement ok
ACL ADMIN REVOKE FUNCTION left FROM ROLE rev4a; REVOKE FUNCTION glob TABLE FROM ROLE rev4a;

statement error
ACL ADMIN GRANT FUNCTION left.f TO ROLE rev4a;
----

statement ok
ACL ADMIN ADD SCALAR продажи.l ALIAS OF left;

# a backtick-quoted physical name is a computed reading, as a double-quoted one (a write would map the column to the
# name as written)
statement ok
SELECT acl_add_relation('продажи', 'bt', 'memory.main.phys_4a_u', 'a = a, x = `b`', '');

query T
SELECT form FROM aclcat.acl.relations WHERE vcat = 'продажи' AND vname = 'bt';
----
subquery

# a revoke of nothing is refused for every grant: a name that only looks like the role's would answer success
statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA продажи.s4a AS memory.main; CREATE RESOURCE GROUP g4a (window_max 8);

statement ok
ACL ADMIN CREATE FUNCTION CATEGORY c4a;

statement error
ACL ADMIN REVOKE SCHEMA продажи.s4a FROM ROLE rev4a;
----
<REGEX>:.*role "rev4a" holds no grant on schema "продажи.s4a" - nothing to revoke.*

statement error
ACL ADMIN REVOKE RESOURCE GROUP g4a FROM ROLE rev4a;
----
<REGEX>:.*role "rev4a" holds no resource group "g4a" - nothing to revoke.*

statement error
ACL ADMIN REVOKE FUNCTION CATEGORY c4a FROM ROLE rev4a;
----
<REGEX>:.*holds no grant of function category "c4a" - nothing to revoke.*

statement error
ACL ADMIN REVOKE FUNCTION lower FROM ROLE rev4a;
----
<REGEX>:.*holds no grant of scalar function "system.main.lower" - nothing to revoke.*

statement error
ACL ADMIN REVOKE VIEW platform.roles FROM ROLE rev4a;
----
<REGEX>:.*holds no grant on view "roles" - nothing to revoke.*

statement error
ACL ADMIN REVOKE SOURCE phys FROM ROLE rev4a;
----
<REGEX>:.*holds no grant on source "phys" - nothing to revoke.*

statement error
ACL ADMIN REVOKE ADMIN FROM ROLE rev4a;
----
<REGEX>:.*role "rev4a" holds no administration - nothing to revoke.*

# what is held is revoked as before
statement ok
ACL ADMIN GRANT SCHEMA продажи.s4a TO ROLE rev4a WITH (select); GRANT RESOURCE GROUP g4a TO ROLE rev4a;

statement ok
ACL ADMIN GRANT FUNCTION CATEGORY c4a TO ROLE rev4a; GRANT VIEW platform.roles TO ROLE rev4a; GRANT SOURCE phys TO ROLE rev4a;

statement ok
ACL ADMIN REVOKE SCHEMA продажи.s4a FROM ROLE rev4a; REVOKE RESOURCE GROUP g4a FROM ROLE rev4a;

statement ok
ACL ADMIN REVOKE FUNCTION CATEGORY c4a FROM ROLE rev4a; REVOKE VIEW platform.roles FROM ROLE rev4a;

statement ok
ACL ADMIN REVOKE SOURCE phys FROM ROLE rev4a;

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE rev4a;

statement ok
ACL ADMIN REVOKE ADMIN FROM ROLE rev4a;

query I
SELECT (SELECT count(*) FROM aclcat.acl.role_schemas WHERE role = 'rev4a') + (SELECT count(*) FROM aclcat.acl.role_resource_groups WHERE role = 'rev4a') + (SELECT count(*) FROM aclcat.acl.function_grants WHERE role = 'rev4a') + (SELECT count(*) FROM aclcat.acl.platform_grants WHERE role = 'rev4a') + (SELECT count(*) FROM aclcat.acl.admins WHERE role = 'rev4a');
----
0

statement ok
ACL ADMIN DROP FUNCTION CATEGORY c4a; DROP RESOURCE GROUP g4a; DROP VIRTUAL SCHEMA продажи.s4a; DROP ROLE rev4a;

# a refusal at a name that does not read bare says how it reads
statement error
ACL ADMIN CREATE ROLE full;
----
full is an SQL keyword: as a name it is written in double quotes ("full")

statement error
ACL ADMIN CHECK VIRTUAL CATALOG default;
----
default is an SQL keyword: as a name it is written in double quotes ("default")

statement error
ACL ADMIN CREATE ROLE 9abc;
----
as a name, a word that starts with a digit is written in double quotes ("9abc")

# no hint where no name was expected: the parse stopped at a keyword for another reason
statement error
ACL ADMIN CREATE ROLE r4a FULL;
----
<!REGEX>:.*SQL keyword.*

statement error
ACL ADMIN CREATE VIRTUAL TABLE 9cat.t AS phys.main.t;
----
as a name, a word that starts with a digit is written in double quotes ("9cat")

# an inherited schema row is its parent grant's: revoking it is refused, the parent's revoke takes it
statement ok
ACL ADMIN CREATE ROLE inh4a; CREATE VIRTUAL SCHEMA продажи.raw4a AS memory.main; GRANT SCHEMA продажи.raw4a TO ROLE inh4a WITH (select);

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA продажи.raw4a.eu AS memory.main;

statement error
ACL ADMIN REVOKE SCHEMA продажи.raw4a.eu FROM ROLE inh4a;
----
it inherits a parent schema's - revoke that one

statement ok
ACL ADMIN REVOKE SCHEMA продажи.raw4a FROM ROLE inh4a;

query I
SELECT count(*) FROM aclcat.acl.role_schemas WHERE role = 'inh4a';
----
0

# a source compares in any case, as the rights read it
statement ok
ACL ADMIN GRANT SOURCE PHYS TO ROLE inh4a; GRANT SOURCE phys TO ROLE inh4a;

query I
SELECT count(*) FROM aclcat.acl.platform_grants WHERE role = 'inh4a';
----
1

statement ok
ACL ADMIN REVOKE SOURCE Phys FROM ROLE inh4a;

statement ok
ACL ADMIN DROP VIRTUAL SCHEMA продажи.raw4a.eu; DROP VIRTUAL SCHEMA продажи.raw4a; DROP ROLE inh4a;

# --- stage 4b: a resource group's limits are a rule (a word, `=` or not, a value) ----------------------------------

# a comment is a space, a comma inside it no separator; `=` or not; a value bare (a number and its unit), signed, or
# quoted any way
statement ok
ACL ADMIN CREATE RESOURCE GROUP lim4b (window_max 8 /* a, b */, batch_bytes = 32MiB, queue_priority -1, max_sessions "3");

query IIII
SELECT window_max, batch_bytes, queue_priority, max_sessions FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b';
----
8	33554432	-1	3

statement ok
ACL ADMIN CREATE OR REPLACE RESOURCE GROUP lim4b (batch_bytes .5GB, window_start '16');

query II
SELECT batch_bytes, window_start FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b';
----
500000000	16

statement ok
ACL ADMIN CREATE OR REPLACE RESOURCE GROUP lim4b (batch_bytes 1e-3GB);

query I
SELECT batch_bytes FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b';
----
1000000

# an empty item is none, as before; SET names only what changes
statement ok
ACL ADMIN ALTER RESOURCE GROUP lim4b SET (, window_start `4`,);

query II
SELECT window_start, batch_bytes FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b';
----
4	1000000

statement ok
ACL ADMIN CREATE OR REPLACE RESOURCE GROUP lim4b ();

query II
SELECT window_start IS NULL, batch_bytes IS NULL FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b';
----
true	true

# a limit is a word and a value: anything else is refused in the form's words
statement error
ACL ADMIN CREATE RESOURCE GROUP lim4b2 (window_max);
----
write CREATE

statement error
ACL ADMIN CREATE RESOURCE GROUP lim4b2 (window_max 8 16);
----
write CREATE

statement error
ACL ADMIN CREATE RESOURCE GROUP lim4b2 ('window_max' 8);
----
write CREATE

# a value with a space is quoted (one value)
statement error
ACL ADMIN CREATE RESOURCE GROUP lim4b2 (batch_bytes 32 MiB);
----
write CREATE

statement error
ACL ADMIN CREATE RESOURCE GROUP lim4b2 (batch_bytes 1 . 5GB);
----
write CREATE

statement ok
ACL ADMIN CREATE RESOURCE GROUP lim4b2 (batch_bytes '32 MiB');

query I
SELECT batch_bytes FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b2';
----
33554432

# a value is one plain literal: a $$ string is not
statement error
ACL ADMIN ALTER RESOURCE GROUP lim4b2 SET (window_max $$8$$);
----
expected a limit's value, quoted ('...', "..." or `...`) as one plain literal

statement error
ACL ADMIN ALTER RESOURCE GROUP lim4b2 SET (window_max 8 16);
----
write ALTER RESOURCE GROUP

# the function judges the value and says which limit
statement error
ACL ADMIN ALTER RESOURCE GROUP lim4b2 SET (window_max '-');
----
window_max is a number, got "-"

statement error
ACL ADMIN ALTER RESOURCE GROUP lim4b2 SET (window_max 99999999999999999999);
----
window_max is out of range

# a size past int64 is refused naming the limit (a checked cast's internal error invalidated the database), and so is
# a JSON integer past int64 (it wrapped)
statement error
ACL ADMIN ALTER RESOURCE GROUP lim4b2 SET (batch_bytes 10000000TB);
----
batch_bytes is out of range

statement error
SELECT acl_alter_resource_group('lim4b2', 'limits', '{"queue_priority": 18446744073709551615}');
----
queue_priority is out of range

statement error
ACL ADMIN ALTER RESOURCE GROUP lim4b2 SET (batch_bytes 'none');
----
batch_bytes is a size

query I
SELECT batch_bytes FROM aclcat.acl.resource_groups WHERE "group" = 'lim4b2';
----
33554432

statement ok
ACL ADMIN DROP RESOURCE GROUP lim4b2;

statement ok
ACL ADMIN DROP RESOURCE GROUP lim4b;

# --- stage 4c: a client's lists are rules (a value a word, words joined by `.`, a number, quoted) --------------------

statement ok
ACL ADMIN CREATE ISSUER 'test/idp/d' AUDIENCES ('api://kc') ROLE CLAIM 'roles';

statement ok
ACL ADMIN CREATE CLIENT lists4c ISSUER 'test/idp/d' CLIENT ID 'lists4c' AUDIENCES ('api://a', , `b`) FLOWS (authcode, device)
ROLES FROM (realm_access.roles, 'groups', größe) SUBJECT (email, "sub")
REQUIRE (email_verified = TRUE, level IN (1, -2), 'admin' IN groups, sub LIKE 'x%', tier = gold, größe = 'x', "quoted.path" = 'v')
ATTRIBUTES (tenant = tid, mail = (upn, 'email'), org = CONSTANT 'acme', "Odd" = a.b);

query IIIII
SELECT audiences, flows, roles_from, subject, attributes FROM acl_clients() WHERE name = 'lists4c';
----
["api://a","b"]	["authcode","device"]	["realm_access.roles","groups","größe"]	["email","sub"]	[{"name":"tenant","paths":["tid"]},{"name":"mail","paths":["upn","email"]},{"name":"org","constant":"acme"},{"name":"Odd","paths":["a.b"]}]

query I
SELECT requires FROM acl_clients() WHERE name = 'lists4c';
----
[{"path":"email_verified","op":"eq","values":["true"]},{"path":"level","op":"in","values":["1","-2"]},{"path":"groups","op":"contains","values":["admin"]},{"path":"sub","op":"like","values":["x%"]},{"path":"tier","op":"eq","values":["gold"]},{"path":"größe","op":"eq","values":["x"]},{"path":"quoted.path","op":"eq","values":["v"]}]

# CLAIM MAP's sides are claim paths, the legacy JSON string stays; a legacy csv of audiences and one quoted SUBJECT path
statement ok
ACL ADMIN ALTER ISSUER 'test/idp/d' SET CLAIM MAP (tid => tenant, 'x.y' => "z", a.b => c);

query I
SELECT attributes FROM acl_clients() WHERE name = 'test/idp/d';
----
[{"name":"tenant","paths":["tid"]},{"name":"z","paths":["x.y"]},{"name":"c","paths":["a.b"]}]

statement ok
ACL ADMIN ALTER CLIENT lists4c SET AUDIENCES 'a,b' SUBJECT 'preferred_username' REQUIRE ();

query III
SELECT audiences, subject, requires IS NULL FROM acl_clients() WHERE name = 'lists4c';
----
["a","b"]	["preferred_username"]	true

# anything else is quoted - refused saying how a list's items are written
statement error
ACL ADMIN ALTER CLIENT lists4c SET REQUIRE (sub = svc-1);
----
a REQUIRE condition is path = value

statement error
ACL ADMIN ALTER CLIENT lists4c SET REQUIRE (sub ~ 'x');
----
a REQUIRE condition is path = value

statement error
ACL ADMIN ALTER CLIENT lists4c SET AUDIENCES (acme-prod);
----
audiences are a list of values

statement error
ACL ADMIN ALTER CLIENT lists4c SET ATTRIBUTES (tenant);
----
an attribute is name = path

statement error
ACL ADMIN ALTER ISSUER 'test/idp/d' SET CLAIM MAP (tid tenant);
----
a claim mapping is <jwt path> => <claim>

# a REQUIRE path is never single-quoted: `'v' …` is the contains form, `'admin' IN (groups)` no path admin
statement error
ACL ADMIN ALTER CLIENT lists4c SET REQUIRE ('admin' IN (groups));
----
a REQUIRE condition is path = value

statement error
ACL ADMIN ALTER CLIENT lists4c SET REQUIRE ('v' = x);
----
a REQUIRE condition is path = value

# CONSTANT with its value missing is no path (the constant would come from the token's claim `CONSTANT`)
statement error
ACL ADMIN ALTER CLIENT lists4c SET ATTRIBUTES (org = CONSTANT);
----
CONSTANT takes its value

# (an empty value is none, as the model takes it)
statement ok
ACL ADMIN ALTER CLIENT lists4c SET ATTRIBUTES (org = "constant") REQUIRE (t IN ('x', ''));

query II
SELECT attributes, requires FROM acl_clients() WHERE name = 'lists4c';
----
[{"name":"org","paths":["constant"]}]	[{"path":"t","op":"in","values":["x"]}]

# a list's value is trimmed inside its quotes, as the text reader took it; an attribute name in any script reads bare
statement ok
ACL ADMIN ALTER CLIENT lists4c SET ROLES CONSTANT (' r ') ATTRIBUTES (größe = 'g');

query II
SELECT roles_constant, attributes FROM acl_clients() WHERE name = 'lists4c';
----
["r"]	[{"name":"größe","paths":["g"]}]

# an attribute's name is one name: a dotted one in any script is quoted, a blank one none
statement error
ACL ADMIN ALTER CLIENT lists4c SET ATTRIBUTES (größe.x = 'x');
----
an attribute's name is one word or a quoted name

statement error
ACL ADMIN ALTER CLIENT lists4c SET ATTRIBUTES (' ' = 'x');
----
an attribute's name is one word or a quoted name

# two literals with no separator are no list
statement error
ACL ADMIN ALTER CLIENT lists4c SET AUDIENCES ('a' 'b');
----
audiences are a list of values

statement error
ACL ADMIN ALTER CLIENT lists4c SET AUDIENCES ($$x$$);
----
expected audiences, quoted ('...', "..." or `...`) as one plain literal

statement ok
ACL ADMIN ALTER CLIENT lists4c SET AUDIENCES ('acme-prod', 'custom:tenant' /* a comment beside it */);

query I
SELECT audiences FROM acl_clients() WHERE name = 'lists4c';
----
["acme-prod","custom:tenant"]

# the legacy CLAIM MAP JSON string stays
statement ok
ACL ADMIN ALTER ISSUER 'test/idp/d' SET CLAIM MAP '{"oid": "user_id"}';

query I
SELECT attributes FROM acl_clients() WHERE name = 'test/idp/d';
----
[{"name":"user_id","paths":["oid"]}]

statement ok
ACL ADMIN DROP CLIENT lists4c; DROP ISSUER 'test/idp/d';

# --- stage 4d: a role's claims are a rule (a name one word or quoted, a value a word, words joined by `.`, a number,
# quoted) ------------------------------------------------------------------------------------------------------------

statement ok
ACL ADMIN CREATE ROLE claims4d CLAIMS ("tenant id" = `v`, größe = 'g', size = 1.5, path = a.b, level = - 1, "t2" = "dq", , 'quoted' = ' sp ', flag = true, );

query II
SELECT claim, '[' || value || ']' FROM aclcat.acl.role_claims WHERE role = 'claims4d' ORDER BY claim;
----
flag	[true]
größe	[g]
level	[-1]
path	[a.b]
quoted	[ sp ]
size	[1.5]
t2	[dq]
tenant id	[v]

# a backtick value is one literal, read whole
statement ok
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (region = `a, tenant = 'globex', z = `, b = 'it''s', c = 'a,b');

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'claims4d' ORDER BY claim;
----
b	it's
c	a,b
region	a, tenant = 'globex', z = 

# a name is one name: a dotted bare one and a blank one are refused, as an attribute's are
statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (a.b = 'x');
----
a claims list is name = value items

statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (größe.x = 'x');
----
a claim's name is one word or a quoted name, got "größe.x"

statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS ('  ' = 'x');
----
a claim's name is one word or a quoted name

# ... and holds nothing the stored csv's reader splits at: `"a(" = 'x', b = 'y'` read back as one claim `a(`
statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS ("a(" = 'x', b = 'y');
----
a claim's name holds no =, comma, quote or parenthesis, got "a("

statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS ("a=b" = 'x');
----
a claim's name holds no =, comma, quote or parenthesis

# two literals with no separator, a value in parentheses, a `+` sign: no claims list
statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (a = 'x' 'y');
----
a claims list is name = value items

statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (a = (b));
----
a claims list is name = value items

statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (a = +1);
----
a claims list is name = value items

# the refusals left the claims as they were
query I
SELECT count(*) FROM aclcat.acl.role_claims WHERE role = 'claims4d';
----
3

# the quoted form and the function forms are the csv, read by one reader: an item that names no claim is refused
# (it was skipped - the claim went missing silently)
statement error
ACL ADMIN ALTER ROLE claims4d SET CLAIMS 'tenant';
----
a claim is written as name='value', got "tenant"

statement error
SELECT acl_alter_role('claims4d', 'a=''x'',=''y''');
----
a claim is written as name='value', got "='y'"

statement ok
SELECT acl_alter_role('claims4d', 'a=''x'',, b = ''y''');

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'claims4d' ORDER BY claim;
----
a	x
b	y

# an empty list and an empty quoted one clear them
statement ok
ACL ADMIN ALTER ROLE claims4d SET CLAIMS ();

query I
SELECT count(*) FROM aclcat.acl.role_claims WHERE role = 'claims4d';
----
0

statement ok
ACL ADMIN ALTER ROLE claims4d SET CLAIMS (a = 'x');

statement ok
ACL ADMIN ALTER ROLE claims4d SET CLAIMS '';

query I
SELECT count(*) FROM aclcat.acl.role_claims WHERE role = 'claims4d';
----
0

statement ok
ACL ADMIN DROP ROLE claims4d;

# from 4d's reviews: a claim named twice in any case is refused (the last won), at parse - the batch whole
statement error
ACL ADMIN CREATE ROLE twice4d; CREATE ROLE twice4d_b CLAIMS (tenant = 'a', "TENANT" = 'b');
----
claim "TENANT" is named twice

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role LIKE 'twice4d%';
----
0

# ... a quoted form that does not read, at parse too
statement error
ACL ADMIN CREATE ROLE loose4d; CREATE ROLE loose4d_b CLAIMS 'q';
----
a claim is written as name='value', got "q"

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role LIKE 'loose4d%';
----
0

statement error
ACL ADMIN CREATE ROLE loose4d CLAIMS 'a=''x'' y';
----
claim "a"'s quoted value is one '...' literal, got 'x' y

statement error
ACL ADMIN CREATE ROLE loose4d CLAIMS 'a=''x';
----
quoted value is one '...' literal

# a quoted name means the name it quotes; a space at its ends would be trimmed by the csv's reader - refused
statement error
ACL ADMIN CREATE ROLE padded4d CLAIMS (" t " = 'x');
----
a claim's name has no space at its ends, got " t "

statement error
ACL ADMIN CREATE ROLE padded4d CLAIMS '"Tenant"=''x''';
----
a claim's name holds no quote or parenthesis, got ""Tenant""

# the rest of what a name holds no more than the csv's reader can carry
statement error
ACL ADMIN CREATE ROLE odd4d CLAIMS ("a,b" = 'x');
----
holds no =, comma, quote or parenthesis

statement error
ACL ADMIN CREATE ROLE odd4d CLAIMS ("a'b" = 'x');
----
holds no =, comma, quote or parenthesis

statement error
ACL ADMIN CREATE ROLE odd4d CLAIMS ("a""b" = 'x');
----
holds no =, comma, quote or parenthesis

statement error
ACL ADMIN CREATE ROLE odd4d CLAIMS ("a)" = 'x');
----
holds no =, comma, quote or parenthesis

# a keyword is a name, as an attribute's; NULL is the text NULL, as before
statement ok
ACL ADMIN CREATE ROLE words4d CLAIMS (select = 'x', order = null);

query II
SELECT claim, value FROM aclcat.acl.role_claims WHERE role = 'words4d' ORDER BY claim;
----
order	null
select	x

statement ok
ACL ADMIN DROP ROLE words4d;

# --- 4e: a grant's column list is a rule - a mask is duckdb's expression, the stored list split on duckdb's tokens --

statement ok
CREATE TABLE cols4e (id INT, "a.b" INT, tags VARCHAR[], s STRUCT(x INT, y INT), "odd name" INT, m MAP(VARCHAR, INT),
    items STRUCT(price INT, q INT)[], note VARCHAR);

statement ok
INSERT INTO cols4e VALUES (1, 2, ['p', 'q'], {'x': 1, 'y': 2}, 5, MAP {'k': 1}, [{'price': 3, 'q': 4}], 'n');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c4e; CREATE VIRTUAL TABLE c4e.t AS memory.main.cols4e; CREATE ROLE r4e;
    GRANT CATALOG c4e TO ROLE r4e MAIN;

# a list, a struct, a MAP and a lambda in a mask: one item each, stored as written (a comment a space), read as duckdb
# reads them
statement ok
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, tags = ['m', /* c */ 'n'], s = {'x': 9, 'y': 8},
    m = MAP {'z': 0}, items = list_transform(items, lambda e: {'price': 0, 'q': e.q}));

query I
SELECT columns FROM aclcat.acl.role_object_caps WHERE role = 'r4e';
----
id, tags = ['m', 'n'], s = {'x': 9, 'y': 8}, m = MAP {'z': 0}, items = list_transform(items, lambda e: {'price': 0, 'q': e.q})

query IIIII
ACL ROLE "r4e" SELECT * FROM t;
----
1	[m, n]	{'x': 9, 'y': 8}	{z=0}	[{'price': 0, 'q': 4}]

# the differential at the SQL level: what the stored text reads back as (acl_platform_list, the platform views' split)
# is the items the rule read
query IIIII
SELECT len(l), l[2], l[3], l[4], l[5] FROM (SELECT acl_platform_list(columns) AS l FROM aclcat.acl.role_object_caps
    WHERE role = 'r4e');
----
5	tags = ['m', 'n']	s = {'x': 9, 'y': 8}	m = MAP {'z': 0}	items = list_transform(items, lambda e: {'price': 0, 'q': e.q})

# a path into a struct and through a list, a quoted name holding a dot (one column - quoted so it reads back as one),
# a name with a space, a keyword quoted
statement ok
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, "a.b", "odd name", s.x, items[].price);

query I
SELECT columns FROM aclcat.acl.role_object_caps WHERE role = 'r4e';
----
id, "a.b", s.x, odd name, items[].price

query IIIII
ACL ROLE "r4e" SELECT * FROM t;
----
1	2	{'x': 1}	5	[{'price': 3}]

# each part of a name is read as duckdb reads an identifier: a keyword is quoted, an expression is no name
statement error
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, order);
----
a grant's column list is items

statement error
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, s.x || 'y');
----
a grant's column list is items

statement error
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, tags = );
----
a grant's column list is items

statement error
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, tags = [1, 2] note);
----
a grant's column list is items

# a name the stored list would not read back bare is stored quoted (as "a.b" always was) - a column named `a,b` is
# grantable now, through every form; before, the rule-less reader refused it (`,` / `=`) or split it
statement ok
CREATE TABLE odd4e (id INT, "a,b" INT, "x=y" INT, "od'd" INT, "a--b" INT, secret INT);

statement ok
INSERT INTO odd4e VALUES (1, 2, 3, 4, 5, 99);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c4e.odd AS memory.main.odd4e;

statement ok
ACL ADMIN GRANT TABLE c4e.odd TO ROLE r4e WITH (select) COLUMNS ("od'd", "a,b", id, "x=y", "a--b");

query I
SELECT columns FROM aclcat.acl.role_object_caps WHERE role = 'r4e' AND vname = 'odd';
----
id, "a,b", "x=y", "od'd", "a--b"

query IIIII
ACL ROLE "r4e" SELECT * FROM odd;
----
1	2	3	4	5

statement ok
ACL ADMIN GRANT TABLE c4e.odd TO ROLE r4e WITH (select) COLUMNS 'id, "a,b", "od''d"';

query I
SELECT columns FROM aclcat.acl.role_object_caps WHERE role = 'r4e' AND vname = 'odd';
----
id, "a,b", "od'd"

statement ok
SELECT acl_grant_object('r4e', 'c4e', 'odd', '{"select": true}', '', 'id, "a--b"');

query II
ACL ROLE "r4e" SELECT * FROM odd;
----
1	5

# from the re-review: the operator's screens match a quoted name by its column - the check finds nothing wrong with a
# mask on `a,b` (it said mask_broken and its repair took the mask away), effective_rights shows the mask
statement ok
ACL ADMIN GRANT TABLE c4e.odd TO ROLE r4e WITH (select) COLUMNS (id, "a,b" = 0, "od'd");

query I
SELECT count(*) FROM acl_check_catalog('c4e') WHERE object = 'odd';
----
0

query I
SELECT masks FROM acl_effective_rights('r4e', 'c4e', 'odd');
----
['"a,b" = 0']

# a column named twice is refused where written (a catalog list's read let the bare item win over the mask)
statement error
ACL ADMIN GRANT CATALOG c4e TO ROLE r4e MAIN COLUMNS (id, "a,b", "a,b" = 0);
----
names "a,b" twice

statement error
SELECT acl_grant_catalog('r4e', 'c4e', '', true, '', 'id, note, "NOTE" = ''m''');
----
names "NOTE" twice

# the check's repair of a broken mask takes the column out whatever its spelling - never leaves it unmasked
statement ok
UPDATE aclcat.acl.role_object_caps SET columns = 'id, "a,b", "A,B" = nosuch(1)' WHERE role = 'r4e' AND vname = 'odd';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

query I
SELECT DISTINCT repair FROM acl_check_catalog('c4e') WHERE object = 'odd' AND kind = 'grant';
----
SELECT acl_grant_object('r4e', 'c4e', 'odd', '{"select": true}', '', 'id')

statement ok
ACL ADMIN DROP VIRTUAL TABLE c4e.odd;

# a REPAIR that would drop a column a grant masks under a quoted name is refused (spec 039), as for a bare one
statement ok
CREATE TABLE rep4e (id INT, k INT, ssn INT);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c4e.rep AS memory.main.rep4e COLUMNS (id, "a--b" = k, ssn);
    GRANT TABLE c4e.rep TO ROLE r4e WITH (select) COLUMNS ("a--b" = 0, id);

statement ok
ALTER TABLE rep4e DROP COLUMN k;

statement error
ACL ADMIN REPAIR VIRTUAL TABLE c4e.rep DROP MISSING COLUMNS;
----
would orphan the mask

statement ok
ACL ADMIN DROP VIRTUAL TABLE c4e.rep;

# a schema grant carries capabilities only - a list through the rule is refused as before
statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c4e.s4e AS memory.main;

statement error
ACL ADMIN GRANT SCHEMA c4e.s4e TO ROLE r4e COLUMNS (id);
----
capabilities only

# a quoted list holding a comment is refused, ALTER GRANT's too
statement error
ACL ADMIN GRANT CATALOG c4e TO ROLE r4e MAIN COLUMNS 'id -- x';
----
its reader would read it otherwise

statement error
ACL ADMIN ALTER GRANT CATALOG c4e TO ROLE r4e SET COLUMNS 'id -- x';
----
holds a comment

# a refused list refuses its batch whole
statement error
ACL ADMIN CREATE ROLE r4e_b; GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (id, order);
----
a grant's column list is items

query I
SELECT count(*) FROM aclcat.acl.roles WHERE role = 'r4e_b';
----
0

# empty items are none, as before; the catalog grant's list is the same rule
statement ok
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS (, id,, note = upper(note),);

query I
SELECT columns FROM aclcat.acl.role_object_caps WHERE role = 'r4e';
----
id, note = upper(note)

statement ok
ACL ADMIN GRANT CATALOG c4e TO ROLE r4e MAIN COLUMNS (id, tags = ['q'], note = concat(note, ',', note));

query I
SELECT columns FROM aclcat.acl.role_catalogs WHERE role = 'r4e';
----
id, tags = ['q'], note = concat(note, ',', note)

# the object grant's mask is the narrower level's (spec 011): what the role reads is upper(note)
query II
ACL ROLE "r4e" SELECT * FROM t;
----
1	N

# the legacy quoted form and the function form are read on the same tokens: a list mask is one item there too
statement ok
ACL ADMIN GRANT CATALOG c4e TO ROLE r4e MAIN;

statement ok
ACL ADMIN GRANT TABLE c4e.t TO ROLE r4e WITH (select) COLUMNS 'id, tags = [''a'', ''b'']';

query II
ACL ROLE "r4e" SELECT * FROM t;
----
1	[a, b]

statement ok
SELECT acl_grant_object('r4e', 'c4e', 't', '{"select": true}', '', 'id, s = {''x'': 1, ''y'': 2}');

query II
ACL ROLE "r4e" SELECT * FROM t;
----
1	{'x': 1, 'y': 2}

# a function form's text that ends with a line comment, or inside a comment, is refused (spec 148): the read leaves it
# out, the stored text would keep it
statement error
SELECT acl_grant_object('r4e', 'c4e', 't', '{"select": true}', '', 'id, note = upper(note) -- hidden');
----
spec 148

statement error
SELECT acl_grant_object('r4e', 'c4e', 't', '{"select": true}', '', 'id, note = ''x');
----
ends inside a literal

# from 4e's reviews: rows an older build stored read as they did - a name holding `--` or `/*` was stored as it is, and
# duckdb's tokens would read `a--b, c` as the column `a` (one the role was never granted) and a comment; a list that is
# only a comment named nothing and narrowed to nothing; `ssn=@ssn` is a mask, though the tokenizer joins `=@`
statement ok
SET GLOBAL acl_version_check_interval=0;

statement ok
CREATE TABLE old4e ("a--b" INT, a INT, c INT, ssn INT, "a/*b" INT);

statement ok
INSERT INTO old4e VALUES (1, 999, 3, 42, 5);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c4e.old AS memory.main.old4e; GRANT TABLE c4e.old TO ROLE r4e WITH (select) COLUMNS (c);

statement ok
UPDATE aclcat.acl.role_object_caps SET columns = 'a--b, c' WHERE role = 'r4e' AND vname = 'old';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

query II
ACL ROLE "r4e" SELECT * FROM old;
----
1	3

statement ok
UPDATE aclcat.acl.role_object_caps SET columns = 'c, a/*b' WHERE role = 'r4e' AND vname = 'old';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

query II
ACL ROLE "r4e" SELECT * FROM old;
----
3	5

statement ok
UPDATE aclcat.acl.role_object_caps SET columns = 'c, ssn=@ssn' WHERE role = 'r4e' AND vname = 'old';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

query II
ACL ROLE "r4e" SELECT * FROM old;
----
3	42

statement ok
UPDATE aclcat.acl.role_object_caps SET columns = '-- x' WHERE role = 'r4e' AND vname = 'old';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

statement error
ACL ROLE "r4e" SELECT ssn FROM old;
----

# a closer of another bracket ends nothing: the stored `x(]` keeps what follows inside its `(` as the text reader did
statement ok
UPDATE aclcat.acl.role_object_caps SET columns = 'c, x(], ssn' WHERE role = 'r4e' AND vname = 'old';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

query I
ACL ROLE "r4e" SELECT * FROM old;
----
3

# a `$$` string the text reader did not know: read as it read it - inside the `'` it opened
statement ok
UPDATE aclcat.acl.role_object_caps SET columns = 'c, $$''$$, ssn, x''' WHERE role = 'r4e' AND vname = 'old';

statement ok
UPDATE aclcat.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

query I
ACL ROLE "r4e" SELECT * FROM old;
----
3

# the rule writes such a name quoted, and it reads back as itself
statement ok
ACL ADMIN GRANT TABLE c4e.old TO ROLE r4e WITH (select) COLUMNS ("a--b", c);

query I
SELECT columns FROM aclcat.acl.role_object_caps WHERE role = 'r4e' AND vname = 'old';
----
"a--b", c

query II
ACL ROLE "r4e" SELECT * FROM old;
----
1	3

# a function form's list holding a comment is refused, a closed one too: no writer stores one any more
statement error
SELECT acl_grant_object('r4e', 'c4e', 'old', '{"select": true}', '', 'c /* kept */');
----
spec 148

statement ok
ACL ADMIN DROP ROLE r4e; DROP VIRTUAL CATALOG c4e;
