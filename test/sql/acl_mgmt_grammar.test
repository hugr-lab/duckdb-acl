# --- issuers and clients (stage 3e): CREATE / ALTER / DROP ISSUER | CLIENT - rules, the same calls ------------------

# the short form, a comment inside it; CLAIM MAP's sides are quoted as JSON, split at an `=>` outside quotes (they
# were pasted into the JSON, so a quoted side holding `", "` stored a second mapping)
statement ok
ACL ADMIN CREATE ISSUER 'test/idp/a' AUDIENCES ('api://a' /* the app */) ROLE CLAIM 'roles'
CLAIM MAP ('x' => 'a", "groups": "tenant', 'p=>q' => 'r') CLIENT ID 'acl-desktop';

query IIII
SELECT audiences, roles_from, attributes, client_id FROM acl_clients() WHERE name = 'test/idp/a';
----
["api://a"]	["roles"]	[{"name":"a\", \"groups\": \"tenant","paths":["x"]},{"name":"r","paths":["p=>q"]}]	acl-desktop

# a client and its clauses in any order, each once
statement ok
ACL ADMIN CREATE CLIENT svc ISSUER 'test/idp/a' AUDIENCES ('api://svc') AZP ('door') CLIENT ID 'svc'
REQUIRE (sub LIKE 'svc-%', level IN (1, 2)) ROLES FROM ('roles', 'groups')
ATTRIBUTES (tenant = 'tid', mail = ('upn', 'email'), org = CONSTANT 'acme') SUBJECT ('email', 'sub')
TOKEN TYPE 'at+jwt' FLOWS (password) UNMAPPED IGNORE;

query IIIIII
SELECT audiences, azp, roles_from, subject, token_type, flows FROM acl_clients() WHERE name = 'svc';
----
["api://svc"]	["door"]	["roles","groups"]	["email","sub"]	at+jwt	["password"]

query II
SELECT requires, attributes FROM acl_clients() WHERE name = 'svc';
----
[{"path":"sub","op":"like","values":["svc-%"]},{"path":"level","op":"in","values":["1","2"]}]	[{"name":"tenant","paths":["tid"]},{"name":"mail","paths":["upn","email"]},{"name":"org","constant":"acme"}]

statement ok
ACL ADMIN ALTER CLIENT svc SET AUDIENCES 'api://svc2,api://svc3' FLOWS ();

query II
SELECT audiences, flows FROM acl_clients() WHERE name = 'svc';
----
["api://svc2","api://svc3"]	NULL

statement ok
ACL ADMIN ALTER ISSUER 'test/idp/a' SET CLIENT ID 'acl-desktop-2';

query I
SELECT client_id FROM acl_clients() WHERE name = 'test/idp/a';
----
acl-desktop-2

# what is never written into the policy says where it goes; a clause twice; a form that does not read as its rule
statement error
ACL ADMIN CREATE ISSUER 'test/idp/b' KEYS '{}';
----
keys and algorithms are never written into the policy

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') CLIENT SECRET 's';
----
a client secret is never written into the policy

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') AUDIENCES ('y');
----
AUDIENCES is written twice

statement error
ACL ADMIN CREATE CLIENT never 'test/idp/a';
----
write CREATE [OR REPLACE] CLIENT

# each clause once by what it writes: ROLE CLAIM / ROLES FROM both name the role sources, ATTRIBUTES / CLAIM MAP
# both the attributes - the last took effect (CLAIM MAP read `tenant` from the token where ATTRIBUTES pinned it)
statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') ROLE CLAIM 'admins' ROLES FROM ('groups');
----
ROLE CLAIM / ROLES FROM is written twice

statement error
ACL ADMIN ALTER ISSUER 'test/idp/a' SET CLAIM MAP (tid => tenant) ATTRIBUTES (tenant = CONSTANT 'acme');
----
ATTRIBUTES / CLAIM MAP is written twice

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') ROLES FROM ('a') ROLES FROM ('b');
----
ROLE CLAIM / ROLES FROM is written twice

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') ROLES CONSTANT ('a') ROLES CONSTANT ('b');
----
ROLES CONSTANT is written twice

# a comment inside a clause is a space
statement ok
ACL ADMIN ALTER ISSUER 'test/idp/a' SET ROLE /* the claim */ CLAIM 'groups' CLAIM -- the map
MAP (tid => tenant);

query II
SELECT roles_from, attributes FROM acl_clients() WHERE name = 'test/idp/a';
----
["groups"]	[{"name":"tenant","paths":["tid"]}]

# IF NOT EXISTS keeps the client there
statement ok
ACL ADMIN CREATE CLIENT IF NOT EXISTS svc ISSUER 'test/idp/a' AUDIENCES ('api://other');

query I
SELECT audiences FROM acl_clients() WHERE name = 'svc';
----
["api://svc2","api://svc3"]

# REQUIRE and ATTRIBUTES take parentheses; a list's items are plain literals - a bare word outside a list, `""`, a
# $$…$$ string and a string continued on the next line (duckdb joins `'api://'⏎'x'`) refused
statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') REQUIRE 'sub = x';
----
REQUIRE takes its conditions in parentheses

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') ATTRIBUTES 'tenant = tid';
----
ATTRIBUTES takes its list in parentheses

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES api;
----
expected audiences, quoted

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') CLIENT ID "";
----
zero-length delimited identifier

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ($$x$$);
----
expected audiences, quoted

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') REQUIRE (sub = $$x$$);
----
expected a value, quoted

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('api://'
'x');
----
expected audiences, quoted

statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') ROLES FROM ('rol' -- a note
'es');
----
expected claim paths, quoted

statement error
ACL ADMIN CREATE ROLE never CLAIMS (tenant = 'ac'
'me');
----
expected a claim's value, quoted ('...', "..." or `...`) as one plain literal

# ALGS is a key's, a client secret is never written - in a client's ALTER it names FROM SECRET
statement error
ACL ADMIN CREATE CLIENT never ISSUER 'test/idp/a' AUDIENCES ('x') ALGS ('RS256');
----
keys and algorithms are never written into the policy

statement error
ACL ADMIN ALTER CLIENT svc SET CLIENT SECRET 's';
----
name that secret (FROM SECRET s)

statement ok
ACL ADMIN DROP CLIENT IF EXISTS nobody; DROP CLIENT svc; DROP ISSUER IF EXISTS 'nobody';

query I
SELECT count(*) FROM acl_clients() WHERE name IN ('svc', 'never');
----
0

# --- function grants and categories, platform's point grants, sources, resource groups (stage 3f) - rules, the same
# calls ---------------------------------------------------------------------------------------------------------------

statement ok
ACL ADMIN CREATE ROLE fgrantee;

# a category: created with its comment, members added and dropped as written (a comment in the list is a space),
# its comment set, granted, denied, revoked, dropped
statement ok
ACL ADMIN CREATE FUNCTION CATEGORY text_tools COMMENT 'string helpers';
ALTER FUNCTION CATEGORY text_tools ADD (lower, upper /* the other case */, read_csv TABLE, "||");
ALTER FUNCTION CATEGORY text_tools DROP (upper);
ALTER FUNCTION CATEGORY text_tools SET COMMENT 'text helpers';

query III
SELECT (SELECT comment FROM aclcat.acl.function_categories WHERE category = 'text_tools'),
       (SELECT string_agg(name || ':' || kind, ',' ORDER BY name) FROM aclcat.acl.function_category_members
        WHERE category = 'text_tools'),
       (SELECT count(*) FROM aclcat.acl.function_category_members WHERE category = 'text_tools' AND name = 'upper');
----
text helpers	lower:scalar,read_csv:table,||:scalar	0

statement error
ACL ADMIN ALTER FUNCTION CATEGORY text_tools ADD ();
----
ADD takes the members in parentheses

statement ok
ACL ADMIN GRANT FUNCTION CATEGORY text_tools TO ROLE fgrantee; DENY FUNCTION CATEGORY text_tools TO ALL ROLES;

query T
SELECT string_agg(role || '/' || allowed, ',' ORDER BY role) FROM aclcat.acl.function_grants
WHERE category = 'text_tools';
----
/false,fgrantee/true

statement ok
ACL ADMIN REVOKE FUNCTION CATEGORY text_tools FROM ALL ROLES; REVOKE FUNCTION CATEGORY text_tools FROM ROLE fgrantee;

query I
SELECT count(*) FROM aclcat.acl.function_grants WHERE category = 'text_tools';
----
0

# a function by name: a path, a kind written, an operator in double quotes; a deny; revoked
statement ok
ACL ADMIN GRANT FUNCTION read_csv TABLE TO ROLE fgrantee; GRANT FUNCTION system.main.lower TO ROLE fgrantee;
GRANT FUNCTION "||" TO ROLE fgrantee; DENY FUNCTION upper TO ROLE fgrantee;

query T
SELECT string_agg(name || ':' || kind || ':' || allowed, ',' ORDER BY name) FROM aclcat.acl.function_grants
WHERE role = 'fgrantee';
----
lower:scalar:true,read_csv:table:true,upper:scalar:false,||:scalar:true

statement ok
ACL ADMIN REVOKE FUNCTION read_csv TABLE FROM ROLE fgrantee; REVOKE FUNCTION upper FROM ROLE fgrantee;

query T
SELECT string_agg(name, ',' ORDER BY name) FROM aclcat.acl.function_grants WHERE role = 'fgrantee';
----
lower,||

statement ok
ACL ADMIN DROP FUNCTION CATEGORY text_tools; DROP FUNCTION CATEGORY IF EXISTS text_tools;

query I
SELECT count(*) FROM aclcat.acl.function_categories WHERE category = 'text_tools';
----
0

# a function or a view of the platform catalog: its point grant (spec 117), never with a kind; DENY VIEW is platform's
statement ok
ACL ADMIN GRANT FUNCTION platform.drain TO ROLE fgrantee; DENY VIEW platform.sessions TO ROLE fgrantee;
GRANT VIEW platform.main.issuers TO ROLE fgrantee;

query T
SELECT string_agg(kind || ':' || object || ':' || allowed, ',' ORDER BY object) FROM aclcat.acl.platform_grants
WHERE role = 'fgrantee';
----
function:drain:true,view:issuers:true,view:sessions:false

statement ok
ACL ADMIN REVOKE FUNCTION platform.drain FROM ROLE fgrantee; REVOKE VIEW platform.sessions FROM ROLE fgrantee;
REVOKE VIEW platform.issuers FROM ROLE fgrantee;

query I
SELECT count(*) FROM aclcat.acl.platform_grants WHERE role = 'fgrantee';
----
0

statement error
ACL ADMIN GRANT FUNCTION platform.drain TABLE TO ROLE fgrantee;
----
a function of the platform catalog is named without TABLE or SCALAR

statement error
ACL ADMIN DENY VIEW granted.t TO ROLE fgrantee;
----
DENY VIEW names a view of the platform catalog

statement error
ACL ADMIN GRANT VIEW platform.sessions TO ROLE fgrantee WITH (select);
----
a grant on a view of the platform catalog takes no WITH

# a source (spec 118.3): granted and revoked
statement ok
ACL ADMIN GRANT SOURCE phys.main TO ROLE fgrantee;

query T
SELECT string_agg(kind || ':' || object, ',') FROM aclcat.acl.platform_grants WHERE role = 'fgrantee';
----
source:phys.main

statement ok
ACL ADMIN REVOKE SOURCE phys.main FROM ROLE fgrantee;

query I
SELECT count(*) FROM aclcat.acl.platform_grants WHERE role = 'fgrantee';
----
0

# a resource group: its limits, DEFAULT and COMMENT in any order, each once; altered; granted, revoked, dropped
statement ok
ACL ADMIN CREATE RESOURCE GROUP rg_grammar WITH (window_max 16, batch_bytes '4MiB') COMMENT 'tests' DEFAULT;

query IIII
SELECT window_max, batch_bytes, comment, is_default FROM aclcat.acl.resource_groups WHERE "group" = 'rg_grammar';
----
16	4194304	tests	true

statement error
ACL ADMIN CREATE OR REPLACE RESOURCE GROUP rg_grammar (window_max 8) DEFAULT DEFAULT;
----
DEFAULT is written twice

statement ok
ACL ADMIN ALTER RESOURCE GROUP rg_grammar SET (window_max 32); ALTER RESOURCE GROUP rg_grammar SET COMMENT 'more';
ALTER RESOURCE GROUP rg_grammar DROP DEFAULT;

query IIII
SELECT window_max, batch_bytes, comment, is_default FROM aclcat.acl.resource_groups WHERE "group" = 'rg_grammar';
----
32	4194304	more	NULL

statement ok
ACL ADMIN GRANT RESOURCE GROUP rg_grammar TO ROLE fgrantee;

query I
SELECT count(*) FROM aclcat.acl.role_resource_groups WHERE "group" = 'rg_grammar' AND role = 'fgrantee';
----
1

statement ok
ACL ADMIN REVOKE RESOURCE GROUP rg_grammar FROM ROLE fgrantee; DROP RESOURCE GROUP rg_grammar;
DROP RESOURCE GROUP IF EXISTS rg_grammar;

query I
SELECT count(*) FROM aclcat.acl.resource_groups WHERE "group" = 'rg_grammar';
----
0

# a limit is a value: a string continued on the next line is refused (duckdb joins it - not one plain literal)
statement error
ACL ADMIN CREATE RESOURCE GROUP rg_never (batch_bytes '4'
'MiB');
----
expected a limit's value, quoted

# a form that does not read as its rule says how it is written
statement error
ACL ADMIN GRANT FUNCTION TO ROLE fgrantee;
----
write GRANT FUNCTION [CATEGORY]

statement error
ACL ADMIN ALTER RESOURCE GROUP rg_never SET;
----
write ALTER RESOURCE GROUP

statement error
ACL ADMIN DENY FUNCTION lower;
----
write DENY FUNCTION [CATEGORY]

# a function is read as duckdb reads a qualified name - each part a word or a double-quoted name (`""` a quote), a
# kind only outside quotes: what is written is what is stored (the old reader took `main."read_csv TABLE"` for the
# table function read_csv, kept a quote in a part, trimmed a part's edge space and dropped a trailing dot)
statement error
ACL ADMIN GRANT FUNCTION system.main."read_csv TABLE" TO ROLE fgrantee;
----
this node has no scalar function system.main.read_csv table

statement error
ACL ADMIN GRANT FUNCTION "system ".main.lower TO ROLE fgrantee;
----
never empty nor starts or ends with a space

statement error
ACL ADMIN GRANT FUNCTION " system".main.lower TO ROLE fgrantee;
----
never empty nor starts or ends with a space

statement ok
ACL ADMIN DENY FUNCTION "sys.tem".main.f TABLE TO ROLE fgrantee; DENY FUNCTION lake."a.b".f TABLE TO ROLE fgrantee;
DENY FUNCTION a."it's".f TABLE TO ROLE fgrantee; DENY FUNCTION "a""b" TABLE TO ROLE fgrantee;

query T
SELECT string_agg(database || '|' || schema || '|' || name || '|' || kind, ',' ORDER BY database, schema, name)
FROM aclcat.acl.function_grants WHERE role = 'fgrantee' AND NOT allowed AND kind = 'table';
----
a|it's|f|table,lake|a.b|f|table,sys.tem|main|f|table,system|main|a"b|table

statement ok
ACL ADMIN REVOKE FUNCTION "sys.tem".main.f TABLE FROM ROLE fgrantee; REVOKE FUNCTION lake."a.b".f TABLE FROM ROLE
fgrantee; REVOKE FUNCTION a."it's".f TABLE FROM ROLE fgrantee; REVOKE FUNCTION "a""b" TABLE FROM ROLE fgrantee;

# ... a name with a space that reads as written is kept, and SCALAR is a kind
statement ok
ACL ADMIN DENY FUNCTION lake."my schema".peek SCALAR TO ROLE fgrantee; DENY FUNCTION lake.main."my func" SCALAR
TO ROLE fgrantee; DENY FUNCTION system.main."IS DISTINCT FROM" TO ROLE fgrantee;

query T
SELECT string_agg(database || '|' || schema || '|' || name || '|' || kind, ',' ORDER BY name)
FROM aclcat.acl.function_grants WHERE role = 'fgrantee' AND NOT allowed AND kind = 'scalar';
----
system|main|is distinct from|scalar,lake|main|my func|scalar,lake|my schema|peek|scalar

# the function forms read the same: a quoted part, a kind after any space outside quotes; an unquoted part holds no
# apostrophe or parenthesis (one ended the csv split of a members list)
statement ok
SELECT acl_grant_function('fgrantee', 'system.main."||"'), acl_deny_function('"read_csv" TABLE');

query I
SELECT count(*) FROM aclcat.acl.function_grants WHERE (role = 'fgrantee' AND name = '||' AND allowed)
OR (role = '' AND name = 'read_csv' AND kind = 'table' AND NOT allowed);
