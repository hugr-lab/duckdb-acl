CREATE VIRTUAL VIEW changes.v AS SELECT a FROM phys.main.t; CREATE VIRTUAL REFERENCE changes.r FROM t TO v ON (a = a);
CREATE VIRTUAL SCALAR changes.s(x INTEGER) AS acl_arg(1) * 2;
CREATE VIRTUAL TABLE FUNCTION changes.f(x INTEGER) AS SELECT a FROM phys.main.t WHERE a = acl_arg(1);
CREATE VIRTUAL SCHEMA changes.live AS phys.main;

statement ok
ACL ADMIN ALTER VIRTUAL REFERENCE changes.r SET /* one side */ CARDINALITY many_to_one;
ALTER VIRTUAL REFERENCE changes.r SET OPTIONAL true; COMMENT ON VIRTUAL REFERENCE changes.r IS 'rc';
ALTER VIRTUAL CATALOG changes SET COMMENT 'the changes';

