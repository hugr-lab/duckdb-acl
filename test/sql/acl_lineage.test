statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO prices SELECT i.sku, i.price FROM (SELECT unnest(items) AS i FROM carts);

statement ok
SELECT acl_lineage_flush();

