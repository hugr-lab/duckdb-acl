false

# --- a PREPARE is no run; each execution of a prepared physical write is one ------------------------------

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
PREPARE load_sink AS INSERT INTO phys.main.sink VALUES (5, 'p');

statement ok
EXECUTE load_sink;

statement ok
EXECUTE load_sink;

statement ok
SELECT acl_lineage_flush();

query TI
SELECT event_type, count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) GROUP BY 1;
----
RUN_COMPLETE	2

# --- the SQL facet blanks a PIVOT's values ----------------------------------------------------------------

statement ok
SET GLOBAL acl_lineage_sql = 'normalized';

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO sink (a, b) SELECT 1, 'x' FROM (PIVOT src ON ssn IN ('pivot-secret') USING sum(total));

statement ok
SELECT acl_lineage_flush();

query II
SELECT count(*), count(*) FILTER (WHERE payload->>'sql' LIKE '%pivot-secret%')
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
1	0

statement ok
SET GLOBAL acl_lineage_sql = 'off';

# --- a grant on a catalog whose object drifted still succeeds, and the others still get their tags -------

statement ok
CREATE TABLE phys.main.drifting(id INTEGER, secret VARCHAR);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.drifting AS phys.main.drifting;

statement ok
ACL ADMIN GRANT TABLE c.drifting TO ROLE clerk COLUMNS (id, secret = NULL);

statement ok
ALTER TABLE phys.main.drifting DROP COLUMN secret;

statement ok
ACL ADMIN CREATE ROLE late;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE late WITH (select) MAIN;

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) > 0 FROM acl_lineage_events(), unnest(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'tags', '["JSON"]')) AS t(tag)
WHERE (tag->>'key') = 'acl.role.late';
----
true

