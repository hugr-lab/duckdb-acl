# name: test/sql/acl_lineage.test
# description: lineage facts (spec 107) - what the node defines and what it writes, as OpenLineage-shaped
#   payloads in acl_lineage_events(). This part: the static events of virtual DDL - a definition's
#   fields and their edges to the physical columns, the lifecycle, and nothing while lineage is off.
# group: [sql]

require acl

require json

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, customer INTEGER, amount DOUBLE, ssn VARCHAR, tenant VARCHAR);

statement ok
CREATE TABLE phys.main.customers(id INTEGER, name VARCHAR);

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

# --- off by default: a definition emits nothing -----------------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.quiet AS phys.main.customers;

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) FROM acl_lineage_events();
----
0

query T
SELECT acl_lineage_status();
----
off

statement ok
SET GLOBAL acl_lineage_level = 'on';

# spec 112: no namespace, no lineage - nothing guessed for the operator, the status says what is missing
query T
SELECT acl_lineage_status() LIKE 'no namespace:%';
----
true

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.unnamed AS phys.main.customers;

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) FROM acl_lineage_events();
----
0

statement ok
ACL ADMIN DROP VIRTUAL TABLE c.unnamed;

statement ok
SET GLOBAL acl_lineage_namespace = 'acl://test';

query T
SELECT acl_lineage_status();
----
on

# --- a table with declared columns: identity, a computed column, a mask, the predicate as a filter --------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders
    COLUMNS (id, total = amount * 2, ssn = NULL) RLS 'tenant = acl_claim(''tenant'')';

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT event_type, payload->'datasets'->(payload->'outputs'->>0)::INT->>'name',
    payload->'datasets'->(payload->'outputs'->>0)::INT->>'lifecycle'
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
DATASET	c.main.orders	CREATE

# the target's namespace is the virtual catalog's, its sources the attached source's
query TT
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'namespace',
    payload->'datasets'->(payload->'inputs'->>0)::INT->>'namespace'
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
acl://test	acl://test/source/phys

# the edges: id as it is, total transformed from amount, the mask has no source, the predicate filters
query TTTT
SELECT e->>'target_field', e->>'source_field', e->>'type', e->>'subtype'
FROM (SELECT unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq = (SELECT max(seq) FROM acl_lineage_events()))
ORDER BY 1, 2;
----
(empty)	tenant	INDIRECT	FILTER
id	id	DIRECT	IDENTITY
total	amount	DIRECT	TRANSFORMATION

# the target's schema names the fields the definition makes
query T
SELECT list_transform(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'schema', '[{"name":"VARCHAR"}]'), lambda f: f.name)
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
[id, total, ssn]

# spec 112 §7: ... with their types - the computed column's and the mask's as the definition makes them
query T
SELECT array_to_string(list_transform(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'schema', '[{"name":"VARCHAR","type":"VARCHAR"}]'), lambda f: f.name || ':' || coalesce(nullif(f.type, ''), '?')), ' ')
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
id:INTEGER total:DOUBLE ssn:?

# no literal, no claim, no predicate text anywhere in the payload
query I
SELECT count(*) FROM acl_lineage_events()
WHERE payload::VARCHAR LIKE '%acl_claim%' OR payload::VARCHAR LIKE '%tenant =%';
----
0

# --- a view over a join: the join keys are INDIRECT/JOIN on the whole view --------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL VIEW c.named AS
    SELECT o.id, upper(cu.name) AS customer_name FROM phys.main.orders o JOIN phys.main.customers cu ON o.customer = cu.id;

statement ok
SELECT acl_lineage_flush();

query TTTT
SELECT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'),
    e->>'type', e->>'subtype'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq = (SELECT max(seq) FROM acl_lineage_events()))
ORDER BY 1, 2;
----
(empty)	main.customers.id	INDIRECT	JOIN
(empty)	main.orders.customer	INDIRECT	JOIN
customer_name	main.customers.name	DIRECT	TRANSFORMATION
id	main.orders.id	DIRECT	IDENTITY

query T
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'type' FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
VIEW

# --- ALTER and DROP: the lifecycle, a drop without edges --------------------------------------------------

statement ok
ACL ADMIN ALTER VIRTUAL TABLE c.orders SET RLS 'amount > 0';

statement ok
SELECT acl_lineage_flush();

query TT
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'lifecycle',
    list_filter(from_json(payload->'edges', '["JSON"]'), lambda e: e->>'subtype' = 'FILTER')[1]->>'source_field'
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
ALTER	amount

statement ok
ACL ADMIN DROP RELATION c.orders;

statement ok
SELECT acl_lineage_flush();

query TI
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'lifecycle', json_array_length(payload->'edges')
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
DROP	0

# --- the audit stream never carries lineage --------------------------------------------------------------

query I
SELECT count(*) FROM acl_audit_events() WHERE kind = 'lineage';
----
0

# --- physical datasets can be turned off: the definition's sources go, and their edges with them ----------

statement ok
SET GLOBAL acl_lineage_physical = false;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.hidden_topology AS phys.main.customers;

statement ok
SELECT acl_lineage_flush();

query II
SELECT json_array_length(payload->'datasets'), json_array_length(payload->'edges')
FROM acl_lineage_events() ORDER BY seq DESC LIMIT 1;
----
1	0

statement ok
SET GLOBAL acl_lineage_physical = true;

# --- the settings are the node's: global only, and a choice is checked -----------------------------------

statement error
SET acl_lineage_level = 'on';
----
acl_lineage_level is global

statement error
SET GLOBAL acl_lineage_level = 'sometimes';
----
acl_lineage_level is one of off, on

# === runtime: a write under a principal, named in the principal's own (virtual) names ====================

statement ok
CREATE TABLE phys.main.sink(a INTEGER, b VARCHAR);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.sink AS phys.main.sink;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.src AS phys.main.orders COLUMNS (id, total = amount * 2, ssn = left(ssn, 1) || '***');

statement ok
SELECT acl_lineage_flush();

# a mask (an item over a column the source has) is masking=true; a computed column is not
query TTT
SELECT e->>'target_field', e->>'source_field', (e->>'masking')::BOOLEAN
FROM (SELECT unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq = (SELECT max(seq) FROM acl_lineage_events()))
WHERE e->>'type' = 'DIRECT' ORDER BY 1, 2;
----
id	id	false
ssn	ssn	true
total	amount	false

statement ok
ACL ADMIN CREATE ROLE w;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE w WITH (select, insert, update, delete) MAIN;

statement ok
INSERT INTO phys.main.orders VALUES (1, 1, 10, 'S1', 't1'), (2, 1, 20, 'S2', 't1');

statement ok
SELECT acl_lineage_flush();

statement ok
CREATE TEMP TABLE before AS SELECT coalesce(max(seq), 0) AS seq FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO sink (a, b) SELECT id, upper(total::VARCHAR) || coalesce(ssn, '') FROM src WHERE total > 5;

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT event_type, job_namespace, starts_with(job_name, 'sql:')
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
RUN_COMPLETE	acl://test/client/gateway	true

# the target and the sources are the VIRTUAL objects, never the physical tables behind them (that `ssn` is a
# mask is the static event's to say: src.ssn is masking=true there)
query TT
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'namespace',
    payload->'datasets'->(payload->'outputs'->>0)::INT->>'name'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
acl://test	c.main.sink

query TTTT
SELECT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'),
    e->>'type', e->>'subtype'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
ORDER BY 1, 2;
----
(empty)	c.main.src.total	INDIRECT	FILTER
a	c.main.src.id	DIRECT	IDENTITY
b	c.main.src.ssn	DIRECT	TRANSFORMATION
b	c.main.src.total	DIRECT	TRANSFORMATION

query I
SELECT count(*) FROM acl_lineage_events(), unnest(from_json(payload->'datasets', '["JSON"]')) AS t(d)
WHERE seq > (SELECT seq FROM before) AND (d->>'physical')::BOOLEAN;
----
0

# the identity facet: the roles (client level), no subject
query TT
SELECT payload->>'roles', payload->>'subject' FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
["w"]	NULL

# --- a plain SELECT is not a lineage event -----------------------------------------------------------------

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" SELECT * FROM src;

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
0

# --- spec 112 §6: a write in a client's transaction is a run when the transaction ends ---------------------

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
BEGIN;

statement ok
ACL ROLE "w" INSERT INTO sink VALUES (100, 'x');

statement ok
ACL ROLE "w" INSERT INTO sink VALUES (101, 'y');

statement ok
SELECT acl_lineage_flush();

# nothing yet: the transaction may still roll back
query I
SELECT count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
0

statement ok
ROLLBACK;

statement ok
SELECT acl_lineage_flush();

query TI
SELECT event_type, count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) GROUP BY ALL;
----
RUN_ABORT	2

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
BEGIN;

statement ok
ACL ROLE "w" INSERT INTO sink VALUES (102, 'z');

statement ok
COMMIT;

statement ok
SELECT acl_lineage_flush();

query TI
SELECT event_type, count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) GROUP BY ALL;
----
RUN_COMPLETE	1

# a failed statement is final at once; what the transaction did before it is aborted with it
statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
BEGIN;

statement ok
ACL ROLE "w" INSERT INTO sink VALUES (103, 'q');

statement error
ACL ROLE "w" INSERT INTO sink VALUES ('not a number', 'q');
----

statement ok
ROLLBACK;

statement ok
SELECT acl_lineage_flush();

query TI
SELECT event_type, count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) GROUP BY ALL ORDER BY 1;
----
RUN_ABORT	1
RUN_FAIL	1

statement ok
ACL ROLE "w" DELETE FROM sink WHERE a >= 100;

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

# --- spec 112 §3: a write into a schema alias (where dbt writes) has its target and its edges ------------

statement ok
CREATE SCHEMA phys.home;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c.home AS phys.home;

statement ok
ACL ADMIN GRANT SCHEMA c.home TO ROLE w WITH (select, insert, create, drop);

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" CREATE TABLE home.model AS SELECT id, total FROM src;

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT event_type, payload->'datasets'->(payload->'outputs'->>0)::INT->>'name', approximate
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
RUN_COMPLETE	c.home.model	false

query TTT
SELECT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'), e->>'type'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
ORDER BY 1, 2;
----
id	c.main.src.id	DIRECT
total	c.main.src.total	DIRECT

# the fields the run wrote, typed
query T
SELECT array_to_string(list_transform(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'schema', '[{"name":"VARCHAR","type":"VARCHAR"}]'), lambda f: f.name || ':' || coalesce(nullif(f.type, ''), '?')), ' ')
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
id:INTEGER total:DOUBLE

# an INSERT into the object the CTAS made, through the alias
statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO home.model SELECT id, total FROM src WHERE total > 5;

statement ok
SELECT acl_lineage_flush();

query TTTT
SELECT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'),
    e->>'type', payload->'datasets'->(payload->'outputs'->>0)::INT->>'name'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
ORDER BY 1, 2;
----
(empty)	c.main.src.total	INDIRECT	c.home.model
id	c.main.src.id	DIRECT	c.home.model
total	c.main.src.total	DIRECT	c.home.model

statement ok
ACL ROLE "w" DROP TABLE home.model;

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

# --- UPDATE: the field from its expression, the WHERE as a filter -----------------------------------------

statement ok
ACL ROLE "w" UPDATE sink SET b = lower(b) WHERE a = 1;

statement ok
SELECT acl_lineage_flush();

query TTTT
SELECT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'),
    e->>'type', e->>'subtype'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
ORDER BY 1, 2;
----
(empty)	c.main.sink.a	INDIRECT	FILTER
b	c.main.sink.b	DIRECT	TRANSFORMATION

# --- the SQL facet: off by default; normalized, it carries no literal --------------------------------------

query I
SELECT count(*) FROM acl_lineage_events() WHERE payload->>'sql' IS NOT NULL;
----
0

statement ok
SET GLOBAL acl_lineage_sql = 'normalized';

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO sink VALUES (42, 'a-secret-value');

statement ok
SELECT acl_lineage_flush();

query TT
SELECT payload->>'sql' LIKE '%a-secret-value%' OR payload->>'sql' LIKE '%42%', payload->>'dialect'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
false	duckdb

statement ok
SET GLOBAL acl_lineage_sql = 'off';

# === physical statements: the operator's own SQL, named physically (there is no rewrite to undo) ==========

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
INSERT INTO phys.main.sink SELECT id, ssn FROM phys.main.orders;

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT event_type, payload->'datasets'->(payload->'outputs'->>0)::INT->>'namespace',
    payload->'datasets'->(payload->'outputs'->>0)::INT->>'name'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
RUN_COMPLETE	acl://test/source/phys	main.sink

query TT
SELECT e->>'target_field', e->>'source_field'
FROM (SELECT unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
ORDER BY 1;
----
a	id
b	ssn

# a physical view: its body's lineage at CREATE, a DROP without edges

statement ok
CREATE VIEW phys.main.big_orders AS SELECT id, amount FROM phys.main.orders WHERE amount > 10;

statement ok
DROP VIEW phys.main.big_orders;

statement ok
SELECT acl_lineage_flush();

query TTI
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'type',
    payload->'datasets'->(payload->'outputs'->>0)::INT->>'lifecycle', json_array_length(payload->'edges')
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'DATASET' ORDER BY seq;
----
VIEW	CREATE	3
VIEW	DROP	0

# the node's own bookkeeping - the policy catalog's writes behind every ACL ADMIN above - is nobody's lineage
query I
SELECT count(*) FROM acl_lineage_events(), unnest(from_json(payload->'datasets', '["JSON"]')) AS t(d)
WHERE d->>'namespace' LIKE '%/source/store';
----
0

# === per-role visibility: tags on the canonical dataset, sent again when a grant changes ==================

statement ok
CREATE TABLE phys.main.people(id INTEGER, name VARCHAR, ssn VARCHAR, address STRUCT(city VARCHAR, zip VARCHAR));

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.people AS phys.main.people;

statement ok
SELECT acl_lineage_flush();

# spec 112 §7: a struct's fields are nested in its field
query TT
SELECT f->>'type', array_to_string(list_transform(from_json(f->'fields', '[{"name":"VARCHAR","type":"VARCHAR"}]'), lambda c: c.name || ':' || c.type), ' ')
FROM (SELECT unnest(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'schema', '["JSON"]')) AS f
      FROM acl_lineage_events()
      WHERE seq = (SELECT max(seq) FROM acl_lineage_events()
                   WHERE (payload->'datasets'->(payload->'outputs'->>0)::INT->>'name') = 'c.main.people'))
WHERE (f->>'name') = 'address';
----
STRUCT	city:VARCHAR zip:VARCHAR

statement ok
ACL ADMIN CREATE ROLE clerk;

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE clerk WITH (select) MAIN;

statement ok
ACL ADMIN GRANT TABLE c.people TO ROLE clerk COLUMNS (id, name, ssn = NULL, address.city);

statement ok
SELECT acl_lineage_flush();

# the newest event of c.people carries clerk's tags: what it reads, masked or plain, field by field
query TTT
SELECT t->>'key', coalesce(t->>'field', '-'), t->>'value'
FROM (SELECT unnest(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'tags', '["JSON"]')) AS t
      FROM acl_lineage_events()
      WHERE seq = (SELECT max(seq) FROM acl_lineage_events()
                   WHERE (payload->'datasets'->(payload->'outputs'->>0)::INT->>'name') = 'c.main.people'))
WHERE (t->>'key') = 'acl.role.clerk'
ORDER BY 2;
----
acl.role.clerk	-	select
acl.role.clerk	address.city	visible
acl.role.clerk	id	visible
acl.role.clerk	name	visible
acl.role.clerk	ssn	masked

# a grant change is no lifecycle change
query T
SELECT coalesce(payload->'datasets'->(payload->'outputs'->>0)::INT->>'lifecycle', '-')
FROM acl_lineage_events()
WHERE seq = (SELECT max(seq) FROM acl_lineage_events()
             WHERE (payload->'datasets'->(payload->'outputs'->>0)::INT->>'name') = 'c.main.people');
----
-

# === sources: ATTACH / DETACH register a namespace (the operator relates it to a real address) ==========

statement ok
ATTACH ':memory:' AS warehouse;

statement ok
DETACH warehouse;

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT payload->'datasets'->0->>'namespace', payload->'datasets'->0->>'type', payload->'datasets'->0->>'lifecycle'
FROM acl_lineage_events() WHERE event_type = 'NAMESPACE' ORDER BY seq DESC LIMIT 2;
----
acl://test/source/warehouse	DUCKDB	DROP
acl://test/source/warehouse	DUCKDB	CREATE

# === spec 112 §9: a source's identity - the name everyone else knows it by ==============================

statement ok
ATTACH ':memory:' AS dwh;

statement ok
CREATE TABLE dwh.main.facts(id INTEGER, v DOUBLE);

statement ok
SELECT acl_lineage_source('dwh', 'postgres://db.corp:5432/analytics');

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.facts AS dwh.main.facts;

statement ok
SELECT acl_lineage_flush();

# the source dataset is named as the source's own (OpenLineage's postgres naming), not by the alias
query TT
SELECT payload->'datasets'->(payload->'inputs'->>0)::INT->>'namespace',
    payload->'datasets'->(payload->'inputs'->>0)::INT->>'name'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'DATASET';
----
postgres://db.corp:5432	analytics.main.facts

# an identity is a name, never a credential; and it describes an attached database
statement error
SELECT acl_lineage_source('dwh', 'postgres://u:secret@db.corp:5432/analytics');
----
never a credential

statement error
SELECT acl_lineage_source('dwh', 'db.corp');
----
<scheme>://

statement error
SELECT acl_lineage_source('system', 'postgres://db.corp:5432/x');
----
no attached source

# a DETACH ends it: the same alias attached again is named by its alias until declared again
statement ok
ACL ADMIN DROP VIRTUAL TABLE c.facts;

statement ok
DETACH dwh;

statement ok
ATTACH ':memory:' AS dwh;

statement ok
CREATE TABLE dwh.main.facts(id INTEGER, v DOUBLE);

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.facts AS dwh.main.facts;

statement ok
SELECT acl_lineage_flush();

query TT
SELECT payload->'datasets'->(payload->'inputs'->>0)::INT->>'namespace',
    payload->'datasets'->(payload->'inputs'->>0)::INT->>'name'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'DATASET';
----
acl://test/source/dwh	main.facts

# declared before its ATTACH (a bootstrap's order is its own): it names the attachment it meets
statement ok
ACL ADMIN DROP VIRTUAL TABLE c.facts;

statement ok
DETACH dwh;

statement ok
SELECT acl_lineage_source('dwh', 'postgres://db.corp:5432/analytics');

statement ok
ATTACH ':memory:' AS dwh;

statement ok
CREATE TABLE dwh.main.facts(id INTEGER, v DOUBLE);

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.facts AS dwh.main.facts;

statement ok
SELECT acl_lineage_flush();

query TT
SELECT payload->'datasets'->(payload->'inputs'->>0)::INT->>'namespace',
    payload->'datasets'->(payload->'inputs'->>0)::INT->>'name'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'DATASET';
----
postgres://db.corp:5432	analytics.main.facts

# NULL clears a declaration
query T
SELECT acl_lineage_source('dwh', NULL);
----
(empty)

statement ok
SELECT acl_lineage_resend('c');

statement ok
SELECT acl_lineage_flush();

query T
SELECT payload->'datasets'->(payload->'inputs'->>0)::INT->>'namespace'
FROM acl_lineage_events() WHERE event_type = 'DATASET'
    AND (payload->'datasets'->(payload->'outputs'->>0)::INT->>'name') = 'c.main.facts' ORDER BY seq DESC LIMIT 1;
----
acl://test/source/dwh

statement ok
ACL ADMIN DROP VIRTUAL TABLE c.facts;

statement ok
DETACH dwh;

# --- ATTACH … LINEAGE '<identity>': the same, written where the source is attached ---------------------

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ATTACH ':memory:' AS mart (READ_ONLY false) LINEAGE 'mysql://mart.corp:3306/sales';

statement ok
SELECT acl_lineage_flush();

# the NAMESPACE event of the ATTACH already names the source as itself
query TT
SELECT payload->'datasets'->0->>'namespace', payload->'datasets'->0->>'lifecycle'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'NAMESPACE';
----
mysql://mart.corp:3306	CREATE

statement ok
DETACH mart;

# a failed ATTACH declares nothing: the call after it never runs
statement error
ATTACH 'no/such/dir/x.db' AS lost LINEAGE 'postgres://lost:5432';
----

statement ok
ATTACH ':memory:' AS lost;

statement ok
CREATE TABLE lost.main.t(i INTEGER);

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.lost AS lost.main.t;

statement ok
SELECT acl_lineage_flush();

query T
SELECT payload->'datasets'->(payload->'inputs'->>0)::INT->>'namespace'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'DATASET';
----
acl://test/source/lost

statement ok
ACL ADMIN DROP VIRTUAL TABLE c.lost;

statement ok
DETACH lost;

# the marker names the alias it describes, ends an ATTACH, and is a literal; a batch keeps its order
statement error
ATTACH ':memory:' LINEAGE 'postgres://x:5432';
----
write AS <alias>

statement error
SELECT 1 LINEAGE 'postgres://x:5432';
----

statement ok
ATTACH ':memory:' AS m1 LINEAGE 'postgres://m1:5432'; CREATE TABLE m1.main.t AS SELECT 1 AS i;

query I
SELECT count(*) FROM m1.main.t;
----
1

statement ok
DETACH m1;

# a word in a literal or a comment is no marker
query T
SELECT 'ATTACH x LINEAGE ''y''' -- LINEAGE 'z'
;
----
ATTACH x LINEAGE 'y'

# under ACL NATIVE (passthrough) the same sugar
statement ok
ACL ADMIN ACL NATIVE ATTACH ':memory:' AS m2 LINEAGE 'postgres://m2:5432';

query T
SELECT acl_lineage_source('m2', 'postgres://m2:5432/other');
----
postgres://m2:5432/other

statement ok
DETACH m2;

# a principal neither declares an identity nor reads the status: acl_* is the never set
statement error
ACL ROLE "w" SELECT acl_lineage_source('phys', 'postgres://x:5432');
----
acl_lineage_source

statement error
ACL ROLE "w" SELECT acl_lineage_status();
----
acl_lineage_status

# === the client's context: a step of an external job (OPENLINEAGE_PARENT_ID's format) ====================

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.load_sink/01929e3a-0000-7000-8000-000000000001' ROOT 'airflow/daily_load/01929e3a-0000-7000-8000-0000000000ff' JOB 'dbt.sink_model' INSERT INTO sink VALUES (7, 'x');

statement ok
SELECT acl_lineage_flush();

query TTTT
SELECT job_name, payload->'parent'->>'namespace', payload->'parent'->>'job', payload->'parent'->>'run_id'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
dbt.sink_model	airflow	daily_load.load_sink	01929e3a-0000-7000-8000-000000000001

query T
SELECT payload->'root_parent'->>'run_id' FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
01929e3a-0000-7000-8000-0000000000ff

# a read is emitted only as a declared step: its inputs, no target, no edges
statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT id, total FROM src;

statement ok
SELECT acl_lineage_flush();

query TTII
SELECT event_type, payload->'datasets'->(payload->'inputs'->>0)::INT->>'name',
    json_array_length(payload->'outputs'), json_array_length(payload->'edges')
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
RUN_COMPLETE	c.main.src	0	0

# spec 112 §5: what reads nothing is no step - a catalog refresh, a description, a probe of no rows
statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT * FROM duckdb_tables();

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT table_name FROM information_schema.tables;

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' DESCRIBE src;

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT * FROM src WHERE 1=0;

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT 1 FROM src WHERE false;

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT id FROM src LIMIT 0;

statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT 1;

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
0

# ... while a read of rows, even next to a surface, still is
statement ok
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load.extract/01929e3a-0000-7000-8000-000000000002' SELECT s.id FROM src s, duckdb_tables() t WHERE t.table_name = 'x' LIMIT 1;

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
1

# each marker once, and the value quoted
statement error
ACL ROLE "w" LINEAGE PARENT 'a/b/01929e3a-0000-7000-8000-000000000001' LINEAGE JOB 'x' SELECT 1;
----
ACL LINEAGE may be written once

# spec 109: a parent is <namespace>/<job>/<runId> with a UUID runId - refused where it enters, never
# dropped downstream; the message echoes no part of the value
statement error
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load/0190-run' INSERT INTO sink VALUES (1, 'x');
----
ACL LINEAGE PARENT: expected <namespace>/<job>/<runId>, the runId a UUID

statement error
ACL ROLE "w" LINEAGE PARENT 'daily_load/01929e3a-0000-7000-8000-000000000001' INSERT INTO sink VALUES (1, 'x');
----
ACL LINEAGE PARENT: expected <namespace>/<job>/<runId>

statement error
ACL ROLE "w" LINEAGE PARENT 'airflow/daily_load/01929e3a-0000-7000-8000-000000000001' ROOT 'airflow//01929e3a-0000-7000-8000-000000000001' INSERT INTO sink VALUES (1, 'x');
----
ACL LINEAGE ROOT: expected <namespace>/<job>/<runId>

statement error
ACL ROLE "w" LINEAGE PARENT 'airflow/secret-job-name/not-a-uuid' SELECT 1;
----
<REGEX>:.*ACL LINEAGE PARENT: expected <namespace>/<job>/<runId>, the runId a UUID \(OPENLINEAGE_PARENT_ID's form\).*

# a value over the 512-byte bound is refused whole - cut there, it would lose its runId
statement error
ACL ROLE "w" LINEAGE PARENT 'acl:-0000-7000-8000-000000000001' SELECT 1;
----
at most 512 bytes

# a job is free text
statement ok
ACL ROLE "w" LINEAGE JOB 'anything goes here' INSERT INTO sink VALUES (2, 'y');

# the session settings: refused at the SET
statement error
SET acl_lineage_parent = 'airflow/daily_load/0190-run';
----
acl_lineage_parent: expected <namespace>/<job>/<runId>, the runId a UUID

statement error
SET acl_lineage_root_parent = 'nope';
----
acl_lineage_root_parent: expected <namespace>/<job>/<runId>

statement ok
SET acl_lineage_parent = 'airflow/daily_load/01929e3a-0000-7000-8000-000000000001';

statement ok
RESET acl_lineage_parent;

statement error
ACL ROLE "w" LINEAGE PARENT a/b/c SELECT 1;
----
ACL LINEAGE PARENT requires a quoted value

# === the static picture again, for a transport that starts on an empty catalog ==========================

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

query I
SELECT acl_lineage_resend('c') > 0;
----
true

statement ok
SELECT acl_lineage_flush();

query I
SELECT count(*) > 0 FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'DATASET';
----
true

# === review regressions (spec 107) ==========================================================================

# --- VALUES read nothing: the run is exact, not approximate -------------------------------------------------

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO sink VALUES (8, 'v');

statement ok
SELECT acl_lineage_flush();

query TT
SELECT payload->>'approximate', json_array_length(payload->'outputs')
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before);
----
false	1

# --- a sink grant: a role that may insert but not read still names its target and its fields ---------------

statement ok
ACL ADMIN CREATE ROLE sinker;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE sinker WITH (insert) MAIN;

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "sinker" INSERT INTO sink (a, b) VALUES (9, 'w');

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'name',
    list_sort(list_transform(from_json(payload->'datasets'->(payload->'outputs'->>0)::INT->'schema', '[{"name":"VARCHAR"}]'), lambda f: f.name))::VARCHAR,
    payload->>'approximate'
FROM acl_lineage_events() WHERE seq > (SELECT seq FROM before) AND event_type = 'RUN_COMPLETE';
----
c.main.sink	[a, b]	false

# --- a name written with its catalog binds in the scratch mirror as it did on the node ----------------------

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO c.sink (a, b) SELECT id, ssn FROM c.src;

statement ok
SELECT acl_lineage_flush();

query TTTT
SELECT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'),
    payload->'datasets'->(payload->'outputs'->>0)::INT->>'name', payload->>'approximate'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
ORDER BY 1, 2;
----
a	c.main.src.id	c.main.sink	false
b	c.main.src.ssn	c.main.sink	false

# --- MERGE: the INSERT branch writes its fields too (the binder leaves its column map empty) ---------------

statement ok
ACL ADMIN CREATE ROLE merger;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE merger WITH (select, insert, update, delete, merge) MAIN;

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "merger" MERGE INTO sink USING (SELECT id, ssn FROM src) AS s ON sink.a = s.id
    WHEN MATCHED THEN UPDATE SET b = s.ssn WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.ssn);

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT DISTINCT e->>'target_field', (payload->'datasets'->(e->>'source')::INT->>'name') || '.' || (e->>'source_field'),
    e->>'type'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before) AND event_type = 'RUN_COMPLETE')
WHERE e->>'type' = 'DIRECT'
ORDER BY 1, 2;
----
a	c.main.src.id	DIRECT
b	c.main.src.ssn	DIRECT

# --- DELETE: the target, its filter ----------------------------------------------------------------------

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" DELETE FROM sink WHERE a = 9;

statement ok
SELECT acl_lineage_flush();

query TTT
SELECT payload->'datasets'->(payload->'outputs'->>0)::INT->>'name', e->>'source_field', e->>'subtype'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before));
----
c.main.sink	a	FILTER

# --- a field read from an unnested list is the list's element: items[].price ------------------------------

statement ok
CREATE TABLE phys.main.carts(id INTEGER, items STRUCT(sku VARCHAR, price DOUBLE)[]);

statement ok
CREATE TABLE phys.main.prices(sku VARCHAR, price DOUBLE);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.carts AS phys.main.carts;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.prices AS phys.main.prices;

statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO prices SELECT i.sku, i.price FROM (SELECT unnest(items) AS i FROM carts);

statement ok
SELECT acl_lineage_flush();

query TT
SELECT e->>'target_field', e->>'source_field'
FROM (SELECT payload, unnest(from_json(payload->'edges', '["JSON"]')) AS e FROM acl_lineage_events()
      WHERE seq > (SELECT seq FROM before))
WHERE e->>'type' = 'DIRECT' ORDER BY 1;
----
price	items[].price
sku	items[].sku

