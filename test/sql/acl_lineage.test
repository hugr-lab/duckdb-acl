statement ok
SELECT acl_lineage_flush();

statement ok
DELETE FROM before;

statement ok
INSERT INTO before SELECT coalesce(max(seq), 0) FROM acl_lineage_events();

statement ok
ACL ROLE "w" INSERT INTO sink (a, b) SELECT id, ssn FROM src WHERE id IN (SELECT a FROM sink);

