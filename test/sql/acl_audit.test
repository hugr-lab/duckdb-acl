# name: test/sql/acl_audit.test
# description: the audit base (spec 069) - the session lifecycle as events at the levels that record
#   it, the counters and gauges behind acl_metrics(), the ring's bound, the JSON-lines sink, the
#   operator's per-session level, and the whole surface refused to a principal
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR);

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('test/idp/s', '{"url": "test/idp/s", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"], "attributes": {"tid": "tenant"}}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN;

statement ok
SET GLOBAL acl_node_id='node-under-test';

# --- the session lifecycle: an opened session is `all`, a refused one is a denial -----------------

statement error
SET GLOBAL acl_audit_level='loud';
----
<REGEX>:.*unknown level.*

statement ok
SET GLOBAL acl_audit_level='decisions';

query I
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.C2rTehH2D3jptrk0TWAepMNA5XjhgHBCEYVr1NzJm7xa7ygxGtgCV9NpejZV3FFT2ex7QaC5xaoFHy59n5VbOw8I9t5_5qUvGkbDuSvyEYCLBlzdSczLOn7Su7k9rSIsMVvmbamtp_IhgyF1_ct0e1hm03Q2Vrm509omfcDvs9W8AyV9aPHUWui8bC-7hzw__gyiiZsRH8PEqZr3JqSPL5FdHp54d7YdGkgMZAR-TkB68NhjvcEmIaNG4Dr2ncL78Brj21nwtTIo3HbeNmhKzUbEp0uwH_-XkV2kxkKQXc2Tysjble9-G50jiFYfciBfmh6rGkct3o-XcVwdC3YV1A') IS NOT NULL;
----
true

query I
SELECT acl_session_open('not-a-jwt') IS NULL;
----
true

statement ok
SELECT acl_audit_flush();

# at `decisions` the open is not recorded, the refusal (a denial) is
query IIII
SELECT kind, detail, verdict, reason_code FROM acl_audit_events() WHERE kind = 'session' ORDER BY seq;
----
session	refused	denied	principal

statement ok
SET GLOBAL acl_audit_level='all';

statement ok
SET VARIABLE h = (SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.C2rTehH2D3jptrk0TWAepMNA5XjhgHBCEYVr1NzJm7xa7ygxGtgCV9NpejZV3FFT2ex7QaC5xaoFHy59n5VbOw8I9t5_5qUvGkbDuSvyEYCLBlzdSczLOn7Su7k9rSIsMVvmbamtp_IhgyF1_ct0e1hm03Q2Vrm509omfcDvs9W8AyV9aPHUWui8bC-7hzw__gyiiZsRH8PEqZr3JqSPL5FdHp54d7YdGkgMZAR-TkB68NhjvcEmIaNG4Dr2ncL78Brj21nwtTIo3HbeNmhKzUbEp0uwH_-XkV2kxkKQXc2Tysjble9-G50jiFYfciBfmh6rGkct3o-XcVwdC3YV1A'));

statement ok
SELECT acl_session_close(getvariable('h'));

statement ok
SELECT acl_audit_flush();

# the open and the close, with who, where and how; the close carries how long it lived
query IIIIII
SELECT kind, detail, verdict, door, subject, duration_us >= 0
FROM acl_audit_events() WHERE kind = 'session' AND detail IN ('opened', 'client') ORDER BY seq;
----
session	opened	allowed	session	u	NULL
session	client	allowed	session	u	true

# every event names the node and carries the level it belongs to; roles ride as a list, and the
# issuer that vouched for the subject stands beside it (two IdPs' subjects never merge)
query IIII
SELECT node, level, roles, issuer FROM acl_audit_events() WHERE detail = 'opened';
----
node-under-test	all	[analyst]	test/idp/s

# --- the counters are a state of the node: they count whatever the level recorded -----------------
# three opens succeeded (one unrecorded at `decisions`), one was refused

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.sessions.opened' AND attributes = '{"door":"session"}';
----
2

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.sessions.refused' AND attributes LIKE '%"reason_code":"principal"%';
----
1

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.sessions.closed' AND attributes LIKE '%"how":"client"%';
----
1

# the gauges: states read from the store, not occurrences; the live sessions are per door, and the
# base's doors are listed at zero rather than missing
query III
SELECT name, attributes, value FROM acl_metrics()
WHERE name IN ('acl.sessions.live', 'acl.node.draining', 'acl.sessions.max') ORDER BY name, attributes;
----
acl.node.draining	{}	0
acl.sessions.live	{"door":"flight"}	0
acl.sessions.live	{"door":"quack"}	0
acl.sessions.live	{"door":"session"}	1
acl.sessions.max	{}	1000

query I
SELECT value >= 0 FROM acl_metrics() WHERE name = 'acl.policy.version';
----
true

# the node's own states: up for a while, one build, no door serving in this test
query III
SELECT name, attributes LIKE '{"version":%', value >= 0 FROM acl_metrics()
WHERE name IN ('acl.node.info', 'acl.node.uptime') ORDER BY name;
----
acl.node.info	true	true
acl.node.uptime	false	true

# the audit contract this build speaks, and the registry it audits on: the instance's shared one -
# `private` would mean an extension built from another acl_audit.hpp created it first (acl_audit.hpp)
query II
SELECT attributes, value >= 1 FROM acl_metrics() WHERE name = 'acl.audit.contract';
----
{"registry":"shared"}	true

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.door.state' AND attributes = '{"door":"quack"}';
----
0

# every JWT verification is counted by its result: the two opens above verified, not-a-jwt is not
# a JWT (the dev stub, nothing to verify)
query I
SELECT value FROM acl_metrics() WHERE name = 'acl.jwt.verifications' AND attributes = '{"result":"ok"}';
----
2

# every attribute key is from the bounded sets - a row naming a role, a subject or an object here is a
# cardinality leak
query I
SELECT count(*) FROM acl_metrics()
WHERE attributes SIMILAR TO '.*"(role|subject|object|tenant|claim)".*';
----
0

query I
SELECT acl_audit_dropped();
----
0

# --- the operator's per-session level: that session's later events follow it ---------------------

statement ok
SET VARIABLE h2 = (SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.C2rTehH2D3jptrk0TWAepMNA5XjhgHBCEYVr1NzJm7xa7ygxGtgCV9NpejZV3FFT2ex7QaC5xaoFHy59n5VbOw8I9t5_5qUvGkbDuSvyEYCLBlzdSczLOn7Su7k9rSIsMVvmbamtp_IhgyF1_ct0e1hm03Q2Vrm509omfcDvs9W8AyV9aPHUWui8bC-7hzw__gyiiZsRH8PEqZr3JqSPL5FdHp54d7YdGkgMZAR-TkB68NhjvcEmIaNG4Dr2ncL78Brj21nwtTIo3HbeNmhKzUbEp0uwH_-XkV2kxkKQXc2Tysjble9-G50jiFYfciBfmh6rGkct3o-XcVwdC3YV1A'));

statement ok
SELECT acl_audit_flush();

statement ok
SET VARIABLE id2 = (SELECT session FROM acl_audit_events() WHERE detail = 'opened' ORDER BY seq DESC LIMIT 1);

query I
SELECT acl_session_audit_level(getvariable('id2'), 'off');
----
true

query I
SELECT acl_session_audit_level('no-such-session', 'all');
----
false

statement error
SELECT acl_session_audit_level(getvariable('id2'), 'loud');
----
<REGEX>:.*unknown level.*

statement ok
SELECT acl_session_close(getvariable('h2'));

statement ok
SELECT acl_audit_flush();

# the close of a session at `off` is counted but not recorded
query I
SELECT count(*) FROM acl_audit_events() WHERE detail = 'client' AND session = getvariable('id2');
----
0

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.sessions.closed' AND attributes LIKE '%"how":"client"%';
----
2

# --- the ring is bounded, and what falls off it is counted --------------------------------------

statement ok
SET GLOBAL acl_audit_buffer=2;

statement ok
SELECT acl_session_open('not-a-jwt');

statement ok
SELECT acl_session_open('not-a-jwt');

statement ok
SELECT acl_session_open('not-a-jwt');

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events();
----
2

query I
SELECT acl_audit_dropped() > 0;
----
true

statement ok
SET GLOBAL acl_audit_buffer=10000;

# --- the JSON-lines sink: every field a column, no claim values ---------------------------------

statement ok
SET GLOBAL acl_audit_sink='__TEST_DIR__/audit.jsonl';

statement ok
SELECT acl_session_open('not-a-jwt');

statement ok
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.C2rTehH2D3jptrk0TWAepMNA5XjhgHBCEYVr1NzJm7xa7ygxGtgCV9NpejZV3FFT2ex7QaC5xaoFHy59n5VbOw8I9t5_5qUvGkbDuSvyEYCLBlzdSczLOn7Su7k9rSIsMVvmbamtp_IhgyF1_ct0e1hm03Q2Vrm509omfcDvs9W8AyV9aPHUWui8bC-7hzw__gyiiZsRH8PEqZr3JqSPL5FdHp54d7YdGkgMZAR-TkB68NhjvcEmIaNG4Dr2ncL78Brj21nwtTIo3HbeNmhKzUbEp0uwH_-XkV2kxkKQXc2Tysjble9-G50jiFYfciBfmh6rGkct3o-XcVwdC3YV1A');

statement ok
SELECT acl_audit_flush();

# one JSON object per line (read back without the json extension: the shape is what is pinned here,
# a consumer with the extension loaded reads it with read_json_auto): the refusal, then the open
query IIII
SELECT content LIKE '{"ts_us":%',
       content LIKE '%"kind":"session","statement":"","objects":[],"verdict":"denied","reason_code":"principal"%',
       content LIKE '%"subject":"u","issuer":"test/idp/s","roles":["analyst"],"kind":"session"%',
       content LIKE '%"detail":"opened"}' || chr(10)
FROM read_text('__TEST_DIR__/audit.jsonl');
----
true	true	true	true

# never a claim value: the token carries tid=acme, the file does not
query II
SELECT content LIKE '%acme%', content LIKE '%"claims"%' FROM read_text('__TEST_DIR__/audit.jsonl');
----
false	false

# an unwritable path counts drops and the node keeps deciding
statement ok
SET GLOBAL acl_audit_sink='/nonexistent-dir-for-acl/audit.jsonl';

statement ok
SELECT acl_session_open('not-a-jwt');

statement ok
SELECT acl_audit_flush();

query I
SELECT value > 0 FROM acl_metrics() WHERE name = 'acl.audit.sink_errors' AND attributes = '{"sink":"file"}';
----
true

statement ok
SET GLOBAL acl_audit_sink='';

# --- statement decisions: who, what, which objects with which capability, and why not ------------

statement ok
SET GLOBAL acl_audit_level='decisions';

statement ok
SELECT acl_audit_flush();

statement ok
SET VARIABLE seq0 = (SELECT coalesce(max(seq), 0) FROM acl_audit_events());

query I
ACL ROLE "analyst" SELECT count(*) FROM c.orders;
----
0

statement error
ACL ROLE "analyst" INSERT INTO c.orders VALUES (1, 'x');
----
<REGEX>:.*insert on "c.orders" is not allowed.*

statement error
ACL ROLE "analyst" SELECT * FROM c.nothing;
----
<REGEX>:.*no access to object.*

statement error
ACL TOKEN 'not-a-jwt' SELECT 1;
----
<REGEX>:.*verification failed.*

statement error
ACL ROLE "analyst" SELEC 1;
----
<REGEX>:.*

statement ok
ACL ROLE "analyst" TRACE 'req-42' PARENT '00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01' SELECT 1;

statement ok
ACL ADMIN CREATE ROLE reporter;

statement ok
ACL ADMIN SELECT 1;

statement ok
SELECT acl_audit_flush();

# one event per statement decided: the class, the objects with the capability the decision needed
# (named even when it was refused), and the code a denial counts under
query IIIIII
SELECT kind, statement, door, verdict, reason_code, objects
FROM acl_audit_events() WHERE seq > getvariable('seq0') AND kind IN ('statement', 'admin') ORDER BY seq;
----
statement	select	gateway	allowed	NULL	[{'name': c.orders, 'capability': select}]
statement	insert	gateway	denied	capability	[{'name': c.orders, 'capability': insert}]
statement	select	gateway	denied	no_access	[]
statement	NULL	gateway	denied	principal	[]
statement	NULL	gateway	denied	parse	[]
statement	select	gateway	allowed	NULL	[]
admin	manage	admin	allowed	NULL	[{'name': acl_define_role, 'capability': manage}]
admin	native	admin	allowed	NULL	[]

# a denial carries our refusal text; a decision carries what it cost; the roles ride on both
query IIII
SELECT reason LIKE '%insert on "c.orders" is not allowed%', rewrite_us >= 0, roles, subject
FROM acl_audit_events() WHERE seq > getvariable('seq0') AND statement = 'insert';
----
true	true	[analyst]	NULL

# the trace the prefix carried is on the event, and on nothing else
query II
SELECT correlation_id, traceparent FROM acl_audit_events() WHERE seq > getvariable('seq0') AND correlation_id IS NOT NULL;
----
req-42	00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01

query I
SELECT count(*) FROM acl_audit_events() WHERE seq > getvariable('seq0') AND kind = 'statement' AND correlation_id IS NULL;
----
5

# a parse refusal records no text of the statement: the parser echoes the text at or near the error,
# and a literal in it could be a secret
query I
SELECT reason FROM acl_audit_events() WHERE seq > getvariable('seq0') AND reason_code = 'parse';
----
acl_rewrite: the statement did not parse (its text is not recorded)

# the issuer of a token nobody verified is the caller's to make up: quoted values of a principal
# refusal are blanked before the event
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ldmlsIiwic3ViIjoieCIsImV4cCI6NDEwMjQ0NDgwMCwicm9sZXMiOlsiYW5hbHlzdCJdfQ.qir1xcw6ys7UpdQ_nz8miZb8edHl28ZcY7-V5anPClz0ci5EyAe0foHL8rgBpNLB_5FQ6v5IaHJpqIVl4Z8NP4B2qNsa0T6oybvBNYPZVIN-bjbWLgkL6e9vHtThYUQKHgZTFtOn238Jadz_1n91R2OsEzSxv0-xbZ1zGYu2LQ6k1GSMIOl-CEbpAZaTMkHdBLnUFx4P5XAlQJrP20OKFULJTzmj1Cm5nYM9PqOv1AsuL9G8SvH4PzRJkKKUY6YMfMyM42jbqxs3eUMiNh7DyDQC_w0MsYKrK2N_tajiU-DYQEOgH6mg8mfoymPOBOhfPKbgWHAvseB-Zy0ZEmBGEQ' SELECT 1;
----
<REGEX>:.*unknown issuer.*

statement ok
SELECT acl_audit_flush();

query II
SELECT reason LIKE '%unknown issuer ""%', reason LIKE '%evil%'
FROM acl_audit_events() WHERE reason_code = 'principal' ORDER BY seq DESC LIMIT 1;
----
true	false

# each trace marker is written once: the one the door composed is the statement's, and a second one
# in the SQL text behind it must not replace it
statement error
ACL ROLE "analyst" TRACE 'mine' TRACE 'yours' SELECT 1;
----
<REGEX>:.*TRACE may be written once.*

# the counters: decisions by verdict/kind/door/class, denials by code, admin statements by scope
query I
SELECT value FROM acl_metrics() WHERE name = 'acl.decisions'
  AND attributes LIKE '%"door":"gateway"%' AND attributes LIKE '%"kind":"statement"%'
  AND attributes LIKE '%"statement":"select"%' AND attributes LIKE '%"verdict":"allowed"%';
----
2

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.denials' AND attributes = '{"reason_code":"capability","door":"gateway"}';
----
1

# the four anonymous management statements of the setup, and the two above
query I
SELECT sum(value) FROM acl_metrics() WHERE name = 'acl.admin.statements' AND attributes LIKE '%"scope":"anonymous"%';
----
6

# at `denied` an allowed decision is counted but not recorded
statement ok
SET GLOBAL acl_audit_level='denied';

query I
ACL ROLE "analyst" SELECT count(*) FROM c.orders;
----
0

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE seq > getvariable('seq0') AND kind = 'statement' AND verdict = 'allowed';
----
2

query I
SELECT value FROM acl_metrics() WHERE name = 'acl.decisions'
  AND attributes LIKE '%"door":"gateway"%' AND attributes LIKE '%"kind":"statement"%'
  AND attributes LIKE '%"statement":"select"%' AND attributes LIKE '%"verdict":"allowed"%';
----
3

statement ok
SET GLOBAL acl_audit_level='decisions';

# --- the trace a door composes: the caller's own settings, in the prefix it writes ---------------

statement ok
SET acl_correlation_id = 'corr-7';

statement ok
SET VARIABLE h3 = (SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.C2rTehH2D3jptrk0TWAepMNA5XjhgHBCEYVr1NzJm7xa7ygxGtgCV9NpejZV3FFT2ex7QaC5xaoFHy59n5VbOw8I9t5_5qUvGkbDuSvyEYCLBlzdSczLOn7Su7k9rSIsMVvmbamtp_IhgyF1_ct0e1hm03Q2Vrm509omfcDvs9W8AyV9aPHUWui8bC-7hzw__gyiiZsRH8PEqZr3JqSPL5FdHp54d7YdGkgMZAR-TkB68NhjvcEmIaNG4Dr2ncL78Brj21nwtTIo3HbeNmhKzUbEp0uwH_-XkV2kxkKQXc2Tysjble9-G50jiFYfciBfmh6rGkct3o-XcVwdC3YV1A'));

query I
SELECT acl_session_sql(getvariable('h3'), 'SELECT 1') LIKE 'ACL SESSION ''%'' TRACE ''corr-7'' SELECT 1';
----
true

statement ok
SET acl_traceparent = '00-abc-def-01';

query I
SELECT acl_session_sql(getvariable('h3'), 'SELECT 1') LIKE '%'' TRACE ''corr-7'' PARENT ''00-abc-def-01'' SELECT 1';
----
true

statement ok
RESET acl_correlation_id;

statement ok
RESET acl_traceparent;

query I
SELECT acl_session_sql(getvariable('h3'), 'SELECT 1') LIKE 'ACL SESSION ''%'' SELECT 1';
----
true

# a per-statement prefix runs on a connection the gateway shares: a principal may not SET the trace
# there (spec 068's rule); on a session of its own it may (acl_client_settings.test, the C++ session test)
statement error
ACL ROLE "analyst" SET acl_correlation_id = 'mine';
----
<REGEX>:.*SET.*

# --- a flood of cheap refusals from one source is counted, but not recorded past the limit --------

statement ok
SET GLOBAL acl_audit_denials_per_second=1;

statement ok
SELECT acl_audit_flush();

statement ok
SET VARIABLE seq2 = (SELECT coalesce(max(seq), 0) FROM acl_audit_events());

# a source of its own (a role nobody granted), so the second's budget is not already spent by the
# refusals above
statement error
ACL ROLE "flooder" SELECT * FROM c.nothing;
----
<REGEX>:.*no access.*

statement error
ACL ROLE "flooder" SELECT * FROM c.nothing;
----
<REGEX>:.*no access.*

statement error
ACL ROLE "flooder" SELECT * FROM c.nothing;
----
<REGEX>:.*no access.*

statement error
ACL ROLE "flooder" SELECT * FROM c.nothing;
----
<REGEX>:.*no access.*

statement ok
SELECT acl_audit_flush();

# one per second per source is recorded (two if a second boundary fell between them); the rest are
# dropped where=rate_limit - and every one of the four is still counted as a denial
query I
SELECT count(*) BETWEEN 1 AND 2 FROM acl_audit_events() WHERE seq > getvariable('seq2') AND reason_code = 'no_access';
----
true

query I
SELECT value >= 2 FROM acl_metrics() WHERE name = 'acl.audit.dropped' AND attributes = '{"where":"rate_limit"}';
----
true

query I
SELECT value >= 5 FROM acl_metrics() WHERE name = 'acl.denials' AND attributes = '{"reason_code":"no_access","door":"gateway"}';
----
true

statement ok
SET GLOBAL acl_audit_denials_per_second=100;

# --- the policy source and the keys: what the node adopted, wrote, or could not read -------------

statement ok
SET GLOBAL acl_audit_level='all';

statement ok
SET GLOBAL acl_version_check_interval=0;

statement ok
SELECT acl_audit_flush();

statement ok
SET VARIABLE seq1 = (SELECT coalesce(max(seq), 0) FROM acl_audit_events());

statement ok
ACL ADMIN CREATE ROLE auditor;

query I
ACL ROLE "analyst" SELECT count(*) FROM c.orders;
----
0

statement ok
SELECT acl_audit_flush();

# a management write commits (`written`); the next resolve adopts the new version (`reloaded`)
query II
SELECT detail, count(*) FROM acl_audit_events() WHERE seq > getvariable('seq1') AND kind = 'policy'
GROUP BY detail ORDER BY detail;
----
reloaded	1
written	1

query I
SELECT value >= 1 FROM acl_metrics() WHERE name = 'acl.policy.reloads';
----
true

# an issuer's keys found by its discovery (specs 023, 095): each document read - the discovery
# document, then the JWKS it names - is a `keys` event naming the issuer
statement ok
