# name: test/sql/acl_columns_followups.test
# description: spec 170 - spec 158 stage 1's follow-ups: DROP RELATION of a name a live alias's object shares while
#   object grants are on it is refused (kept, a relation's grant became the alias object's; deleted, the alias object
#   lost its COLUMNS and MASK) - a principal's record takes them with it; acl_object_grants() shows masks and versions;
#   platform.check_grant with no caps answers no caps row; a COLUMNS that leaves no column is said in the grant's words.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.t (id INTEGER, ssn VARCHAR, note VARCHAR);

statement ok
INSERT INTO phys.main.t VALUES (1, '123-45-6789', 'n');

statement ok
CREATE TABLE phys.main.t2 (id INTEGER, ssn VARCHAR, note VARCHAR);

statement ok
INSERT INTO phys.main.t2 VALUES (2, '987-65-4321', 'm');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin = true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c; CREATE ROLE r; CREATE ROLE boss;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r MAIN; GRANT ADMIN policy TO ROLE boss;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c.raw AS phys.main;

# the alias's object raw.t, narrowed and masked by its object grant
statement ok
ACL ADMIN GRANT TABLE c.raw.t TO ROLE r COLUMNS (id, ssn) MASK (ssn AS '***');

query IT
ACL ROLE "r" SELECT * FROM raw.t;
----
1	***

# a relation of the same name shadows it; its drop is refused while the name holds object grants - neither keeping
# them (a relation's grant would become the alias object's) nor dropping them (the alias object would lose its COLUMNS
# and MASK) is the drop's to decide
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.raw.t AS phys.main.t2;

query IT
ACL ROLE "r" SELECT * FROM raw.t;
----
2	***

statement error
ACL ADMIN DROP RELATION c.raw.t;
----
holds object grants (role r) that the live schema alias's object of that name would take over

statement ok
ACL ADMIN REVOKE TABLE c.raw.t FROM ROLE r;

statement ok
ACL ADMIN DROP RELATION c.raw.t;

statement ok
ACL ADMIN GRANT TABLE c.raw.t TO ROLE r COLUMNS (id, ssn) MASK (ssn AS '***');

query IT
ACL ROLE "r" SELECT * FROM raw.t;
----
1	***

# a relation-only grant is not handed to the alias's object either: the role named by it reads nothing there
statement ok
ACL ADMIN CREATE ROLE outsider; CREATE VIRTUAL TABLE c.raw.pub2 AS phys.main.t2;

statement ok
ACL ADMIN GRANT TABLE c.raw.pub2 TO ROLE outsider WITH (select);

statement error
ACL ADMIN DROP RELATION c.raw.pub2;
----
holds object grants (role outsider)

# a principal's own record takes its grants with it (spec 151): the reader's grant does not land on what comes next
statement ok
CREATE TABLE phys.main.hr (id INTEGER, salary INTEGER);

statement ok
INSERT INTO phys.main.hr VALUES (1, 100000);

statement ok
ACL ADMIN CREATE ROLE dev; CREATE ROLE ana; GRANT CATALOG c TO ROLE dev WITH (select) MAIN; GRANT CATALOG c TO ROLE ana CAPS '{}' MAIN; GRANT SCHEMA c.raw TO ROLE dev WITH (select, create, drop);

statement ok
ACL ROLE "dev" CREATE VIEW raw.v AS SELECT id FROM raw.t2;

statement ok
ACL ADMIN GRANT VIEW c.raw.v TO ROLE ana WITH (select);

statement ok
ACL ROLE "dev" DROP VIEW raw.v;

statement ok
ACL ROLE "dev" CREATE TABLE raw.v AS SELECT * FROM raw.hr;

statement error
ACL ROLE "ana" SELECT * FROM raw.v;
----

# --- acl_object_grants() shows what spec 158 / 167 store -----------------------------------------------------------

query TTT
SELECT vname, columns, masks FROM acl_object_grants() WHERE role = 'r' AND vname = 'raw.t';
----
raw.t	id, ssn	ssn AS CAST(('***') AS VARCHAR)

query T
SELECT count(*) FROM acl_grants() WHERE role = 'r' AND versions IS NULL;
----
1

# --- platform.check_grant: no caps given, no caps row --------------------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.o AS phys.main.t;

query I
ACL ROLE "boss" SELECT count(*) FROM platform.check_grant('r', 'c', 'o', '', 'id', '') WHERE item = 'caps';
----
0

# --- a COLUMNS that leaves no column ----------------------------------------------------------------------------

statement error
ACL ADMIN GRANT TABLE c.o TO ROLE r COLUMNS (* EXCLUDE (id, ssn, note));
----
the grant's COLUMNS leaves no column of "o"

# --- a principal's view never shadows an object its live alias's source holds (review): its record's drop or undo
#     would take the operator's grant on that object (COLUMNS, MASK) with it

statement ok
CREATE TABLE phys.main.pub (id INTEGER);

statement ok
ACL ADMIN GRANT TABLE c.raw.t TO ROLE r COLUMNS (id, ssn) MASK (ssn AS '***');

statement ok
ACL ROLE "dev" BEGIN;

statement error
ACL ROLE "dev" CREATE VIEW raw.t AS SELECT id FROM raw.pub;
----
is already an object of its live schema alias

statement ok
ACL ROLE "dev" ROLLBACK;

statement error
ACL ROLE "dev" CREATE VIEW raw.t AS SELECT id FROM raw.pub;
----
is already an object of its live schema alias

query IT
ACL ROLE "r" SELECT * FROM raw.t;
----
1	***
