# name: test/sql/integration/acl_postgres.test
# description: ACL over a live PostgreSQL source (specs/005) - virtual names resolve into an attached postgres catalog
# group: [integration]

require acl

require postgres_scanner

require-env ACL_PG_DSN

statement ok
ATTACH '${ACL_PG_DSN}' AS pg (TYPE postgres);

statement ok
SET allow_parser_override_extension='fallback';

statement ok
SELECT acl_define_role('analyst', 'tenant=acme');

# SUBQUERY form over a postgres table: projection + RLS with the baked tenant claim
statement ok
SELECT acl_grant_table('analyst', 'orders', 'pg.public.orders', 'id,amount', 'tenant = acl_claim(''tenant'')', 'select');

query II
ACL ROLE "analyst" SELECT id, amount FROM orders ORDER BY id;
----
1	100
3	300

# masked column over postgres; the dropped column is structurally absent
statement ok
SELECT acl_grant_table('analyst', 'employees', 'pg.public.employees', 'id,name,ssn=NULL', '', 'select');

query III
ACL ROLE "analyst" SELECT id, name, ssn FROM employees ORDER BY id;
----
1	alice	NULL
2	bob	NULL

statement error
ACL ROLE "analyst" SELECT salary FROM employees;
----
<REGEX>:.*salary.*

# RENAME form is writable end-to-end into postgres
statement ok
SELECT acl_grant_table('analyst', 'audit', 'pg.public.audit_log', '', '', 'select,insert,update,delete');

statement ok
ACL ROLE "analyst" INSERT INTO audit VALUES (1, 'created');

statement ok
ACL ROLE "analyst" UPDATE audit SET note = 'updated' WHERE id = 1;

query II
ACL ROLE "analyst" SELECT id, note FROM audit;
----
1	updated

statement ok
ACL ROLE "analyst" DELETE FROM audit WHERE id = 1;

query I
ACL ADMIN SELECT count(*) FROM pg.public.audit_log;
----
0

# a direct physical name is not a mapped virtual name -> denied
statement error
ACL ROLE "analyst" SELECT * FROM pg.public.orders;
----
<REGEX>:.*no access to object "pg.public.orders".*

# source readers stay gated even with the source attached
statement error
ACL ROLE "analyst" SELECT * FROM postgres_query('pg', 'SELECT * FROM orders');
----
<REGEX>:.*not allowed.*

statement error
ACL ROLE "analyst" SELECT * FROM postgres_scan('${ACL_PG_DSN}', 'public', 'orders');
----
<REGEX>:.*not allowed.*
