# name: test/sql/integration/acl_quack_ingest_denied.test
# description: streamed ingest through the quack door must not write around the policy, on the layout
#   where the accident that used to stop it is absent (specs 041, 042).
#
#   quack generates its ingest INSERT on the server, unprefixed, naming the schema and table the client
#   sent. Unprefixed statements run natively - the parser override is consulted, not obeyed - so that
#   INSERT resolves in the server's *default* catalog with the operator's rights. Where a physical table
#   sits there under the name the object publishes, and the published width matches, the rows land: 5000
#   rows carrying a tenant this role's own predicate forbids were written this way before spec 041
#   refused it.
#
#   Spec 042 lets the write through when the principal can be recovered from the stream id - so what this
#   file now pins is that the enforcement, and not the accident, is what stops it: the grant here confines
#   the role with a predicate but states no columns, so there is no publish order to write positionally
#   against, and an unnamed column has no value for the predicate to judge.
# group: [integration]

require acl

require httpfs

require quack

statement ok
ATTACH ':memory:' AS store;

# the dangerous layout: the physical table is in the DEFAULT catalog, schema main, named exactly as the
# object publishes it, and the object publishes its full width
statement ok
CREATE TABLE orders(id INTEGER, tenant VARCHAR);

statement ok
INSERT INTO orders VALUES (1, 'acme');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('https://issuer.test/s',
    '{"keys":[{"kty":"oct","k":"YWNsLXRlc3QtaHMyNTYtc2VjcmV0"}]}',
    'api://acl-test', 'HS256', 'roles', '{"tid": "tenant"}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS memory.main.orders;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, insert) MAIN;

# the role is confined to its own tenant, so a bypass shows up as rows this predicate forbids
statement ok
ACL ADMIN GRANT TABLE c.orders TO ROLE analyst CAPS '{"select": true, "insert": true}' RLS 'tenant = acl_claim(''tenant'')';

statement ok
SET GLOBAL acl_allow_anonymous_admin=false;

statement ok
SELECT acl_quack_serve('quack:localhost:31578', 'integration-server-token');

statement ok
ATTACH 'quack:localhost:31578' AS remote (TYPE quack,
    TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3MiLCJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwic3ViIjoidSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.c_RJ0X6_Gj5O5Z273KOaB9e11XFXVgQkEbtTCayEzJc');

# the read is the principal's slice, so the door is genuinely serving this client
query II
SELECT * FROM remote.main.orders;
----
1	acme

statement ok
CREATE TABLE bulk AS SELECT i AS id, 'INJECTED' AS tenant FROM range(5000) t(i);

# the probe: a bulk insert goes down quack's SEND_DATA path, and is refused by the write policy rather
# than by anything about the transport
statement error
INSERT INTO remote.main.orders SELECT * FROM bulk;
----
<REGEX>:.*must name its columns.*

# nothing was written, and in particular no row carries a tenant the predicate forbids
query II
SELECT count(*), count(*) FILTER (WHERE tenant = 'INJECTED') FROM orders;
----
1	0

# --- with a door open, an unprefixed drain is ours to judge -------------------------------------------
# The fence applies only while a door of ours is serving (spec 043) - here one is, so a generated
# statement whose principal cannot be recovered is refused rather than run with the operator's rights.

statement error
SELECT * FROM scan_data_from_quack_client('someone-elses-stream');
----
<REGEX>:.*names no connection.*

statement error
INSERT INTO orders SELECT * FROM scan_data_from_quack_client('conn-never:1');
----
<REGEX>:.*has no session.*

# a quoted identifier is the same call, read the same way
statement error
SELECT * FROM "scan_data_from_quack_client"('someone-elses-stream');
----
<REGEX>:.*names no connection.*

# two streams in one statement is not a shape the door generates, so not one it accepts
statement error
SELECT * FROM scan_data_from_quack_client('a:1'), scan_data_from_quack_client('a:2');
----
<REGEX>:.*not one this door opened.*

# a small insert still goes through the statement path, so it is enforced rather than refused: the
# tenant is the claim's, not the client's, and the row lands
statement ok
SELECT * FROM quack_query('quack:localhost:31578',
    'INSERT INTO orders (id, tenant) VALUES (7, ''acme'')',
    token := 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3MiLCJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwic3ViIjoidSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.c_RJ0X6_Gj5O5Z273KOaB9e11XFXVgQkEbtTCayEzJc');

query II
SELECT count(*), count(*) FILTER (WHERE tenant = 'acme') FROM orders;
----
2	2

statement ok
DETACH remote;

statement ok
SELECT acl_quack_stop('quack:localhost:31578');
