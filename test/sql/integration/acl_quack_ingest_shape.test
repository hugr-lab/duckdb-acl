# name: test/sql/integration/acl_quack_ingest_shape.test
# description: a drained stream is read by POSITION (spec 042), and `SendDataRequestMessage` carries no
#   column list - so what the client's own column list does to the chunks it sends is load-bearing, not
#   a detail. Both columns are VARCHAR on purpose: a swapped pair could not be caught by a type error,
#   only by being right.
#
#   Measured here, and the reason the positional reading is sound: the client's plan re-orders into the
#   table's column order before sending, and fills an unnamed column with NULL at full width. So neither
#   a permutation nor a subset reaches the server as a shifted or narrowed stream.
# group: [integration]

require acl

require httpfs

require quack

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS store;

statement ok
CREATE TABLE pairs(a VARCHAR, b VARCHAR);

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('test/idp/s', '{"url": "test/idp/s", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"], "attributes": {"tid": "tenant"}}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.pairs AS memory.main.pairs;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, insert) MAIN;

statement ok
ACL ADMIN GRANT TABLE c.pairs TO ROLE analyst CAPS '{"select": true, "insert": true}' COLUMNS 'a,b';

statement ok
SET GLOBAL acl_allow_anonymous_admin=false;

statement ok
SELECT acl_quack_serve('quack:localhost:31580', 'integration-server-token');

statement ok
ATTACH 'quack:localhost:31580' AS remote (TYPE quack,
    TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9zIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.C2rTehH2D3jptrk0TWAepMNA5XjhgHBCEYVr1NzJm7xa7ygxGtgCV9NpejZV3FFT2ex7QaC5xaoFHy59n5VbOw8I9t5_5qUvGkbDuSvyEYCLBlzdSczLOn7Su7k9rSIsMVvmbamtp_IhgyF1_ct0e1hm03Q2Vrm509omfcDvs9W8AyV9aPHUWui8bC-7hzw__gyiiZsRH8PEqZr3JqSPL5FdHp54d7YdGkgMZAR-TkB68NhjvcEmIaNG4Dr2ncL78Brj21nwtTIo3HbeNmhKzUbEp0uwH_-XkV2kxkKQXc2Tysjble9-G50jiFYfciBfmh6rGkct3o-XcVwdC3YV1A');

statement ok
CREATE TABLE src AS SELECT 'A' || i AS av, 'B' || i AS bv FROM range(5000) t(i);

# --- a client that names its columns in the other order ------------------------------------------------

statement ok
INSERT INTO remote.main.pairs (b, a) SELECT bv, av FROM src;

# every row kept its own column: nothing was written into the neighbouring one
query III
SELECT count(*), count(*) FILTER (WHERE a LIKE 'A%'), count(*) FILTER (WHERE a LIKE 'B%') FROM pairs;
----
5000	5000	0

statement ok
DELETE FROM pairs;

# --- a client that names only one of them --------------------------------------------------------------

statement ok
INSERT INTO remote.main.pairs (a) SELECT av FROM src;

# the stream arrives at full width with NULL in the position nobody named, so the value still lands in
# its own column rather than sliding into the first one
query III
SELECT count(*), count(*) FILTER (WHERE a LIKE 'A%'), count(*) FILTER (WHERE b IS NULL) FROM pairs;
----
5000	5000	5000

statement ok
DETACH remote;

statement ok
SELECT acl_quack_stop('quack:localhost:31580');
