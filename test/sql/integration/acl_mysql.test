# name: test/sql/integration/acl_mysql.test
# description: ACL over a live MySQL source (specs/005). Skips while mysql_scanner is disabled at the
#   duckdb submodule pin ("patches do not apply") - see extension_config.cmake; the environment and
#   this scenario are ready for the moment the pin re-enables it.
# group: [integration]

require acl

require mysql_scanner

require-env ACL_MYSQL_DSN

statement ok
ATTACH '${ACL_MYSQL_DSN}' AS my (TYPE mysql);

statement ok
SET allow_parser_override_extension='fallback';

statement ok
SELECT acl_define_role('analyst', 'tenant=acme');

# SUBQUERY form over a mysql table: projection + RLS with the baked tenant claim
statement ok
SELECT acl_grant_table('analyst', 'orders', 'my.acltest.orders', 'id,amount', 'tenant = acl_claim(''tenant'')', 'select');

query II
ACL ROLE "analyst" SELECT id, amount FROM orders ORDER BY id;
----
1	100
3	300

# RENAME form is writable end-to-end into mysql
statement ok
SELECT acl_grant_table('analyst', 'audit', 'my.acltest.audit_log', '', '', 'select,insert,update,delete');

statement ok
ACL ROLE "analyst" INSERT INTO audit VALUES (1, 'created');

query II
ACL ROLE "analyst" SELECT id, note FROM audit;
----
1	created

statement ok
ACL ROLE "analyst" DELETE FROM audit WHERE id = 1;

# a direct physical name is not a mapped virtual name -> denied
statement error
ACL ROLE "analyst" SELECT * FROM my.acltest.orders;
----
<REGEX>:.*no access to object "my.acltest.orders".*

# source readers stay gated even with the source attached
statement error
ACL ROLE "analyst" SELECT * FROM mysql_query('my', 'SELECT * FROM orders');
----
<REGEX>:.*not allowed.*
