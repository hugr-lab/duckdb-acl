# name: test/sql/acl_listing_truth.test
# description: spec 065 - refusals and listings judged from catalog facts alone: the declared-shape
#   refusal names nothing physical, a grant's COLUMNS list is judged where it is written, the tables
#   listing never carries a NULL sql, is_insertable_into follows the grant, and a quoted COLUMNS
#   item means the name it quotes.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(pk INTEGER, internal_tenant VARCHAR, "odd name" VARCHAR);

statement ok
CREATE TABLE phys.main.audit(id INTEGER, note VARCHAR);

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

# a declared shape: the resolver knows these columns from the catalog, no probe anywhere
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders COLUMNS (pk AS id, internal_tenant AS tenant, "odd name" AS "odd name");

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.audit AS phys.main.audit COLUMNS (id AS id, note AS note);

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN CREATE ROLE poor;

# --- a grant's COLUMNS list is judged where it is written (every shape here is declared) ----------
# spec 158: a catalog grant takes no COLUMNS at all, whatever the list names (both forms)
statement error
ACL ADMIN GRANT CATALOG c TO ROLE poor WITH (select) MAIN COLUMNS (ghost);
----
a catalog grant takes no COLUMNS

statement error
SELECT acl_grant_catalog('poor', 'c', '{"select": true}', true, '', 'ghost, phantom');
----
a catalog grant takes no column list

# an object grant's list names columns the object has (the grammar and the function form)
statement error
ACL ADMIN GRANT TABLE c.orders TO ROLE poor WITH (select) COLUMNS (ghost);
----
<REGEX>:.*grant on "orders" lists "ghost", which the object does not have.*

statement error
SELECT acl_grant_object('poor', 'c', 'audit', '{"select": true}', '', 'ghost, phantom');
----
<REGEX>:.*grant on "audit" lists "ghost", which the object does not have.*

statement error
SELECT acl_grant_object('poor', 'c', 'orders', '{"select": true}', '', 'ghost');
----
<REGEX>:.*grant on "orders" lists "ghost".*

# a list that names one real column is accepted, and the quoted item means the name it quotes
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select, insert) MAIN;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE poor WITH (select) MAIN;

statement ok
ACL ADMIN GRANT TABLE c.orders TO ROLE poor WITH (select) COLUMNS ("odd name");

statement ok
SET allow_parser_override_extension='fallback';

# --- the quoted grant column reads exactly that column --------------------------------------------
query I
ACL ROLE "poor" SELECT * FROM orders LIMIT 0;
----

query I
ACL ROLE "poor" SELECT count(*) FROM information_schema.columns WHERE table_name = 'orders';
----
1

# --- the declared-shape refusal names nothing physical --------------------------------------------
# poor reads only "odd name" of orders and note of audit; then orders drops "odd name" (spec 158: a grant that leaves
# no column is refused where written, so it is the object that changes under the grant)
statement ok
ACL ADMIN GRANT TABLE c.audit TO ROLE poor WITH (select) COLUMNS (note);

statement ok
ACL ADMIN ALTER VIRTUAL TABLE c.orders SET COLUMNS (pk AS id, internal_tenant AS tenant);

statement error
ACL ROLE "poor" SELECT * FROM orders;
----
<REGEX>:.*acl_rewrite: object "orders" exposes no readable columns.*

# and the message carries no physical name and none of the rewriter's internals
statement error
ACL ROLE "poor" SELECT * FROM orders;
----
<!REGEX>:.*(pk|internal_tenant|list_filter|__acl_col).*

# --- an object with no visible column is not listed, so `sql` is never NULL ------------------------
query I
ACL ROLE "poor" SELECT table_name FROM duckdb_tables() ORDER BY 1;
----
audit

query I
ACL ROLE "poor" SELECT count(*) FROM duckdb_tables() WHERE sql IS NULL;
----
0

# the readable object's DDL parses and describes what the role reads
query I
ACL ROLE "poor" SELECT sql LIKE 'CREATE TABLE %note%' FROM duckdb_tables() WHERE table_name = 'audit';
----
true

# (orders declares "odd name" again for the rest)
statement ok
ACL ADMIN ALTER VIRTUAL TABLE c.orders SET COLUMNS (pk AS id, internal_tenant AS tenant, "odd name" AS "odd name");

# --- is_insertable_into follows the grant, not the physical row ------------------------------------
# orders answers NO with insert granted: its quoted-identifier mapping makes it the read-only
# SUBQUERY form on the resolution path, and the listing reports the same authority - the INSERT
# really is refused there. audit (bare renames, the alias form) is the writable one.
query II
ACL ROLE "analyst" SELECT table_name, is_insertable_into FROM information_schema.tables ORDER BY 1;
----
audit	YES
orders	NO

# poor holds select only: nothing is insertable, whatever the physical table says
query II
ACL ROLE "poor" SELECT table_name, is_insertable_into FROM information_schema.tables ORDER BY 1;
----
audit	NO
orders	NO

# --- a shape-less object: spec 158 judges the grant against the columns its source has (the write-time judgment
# no longer steps aside), and a catalog grant takes no list to alter
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.bare AS phys.main.audit;

statement error
ACL ADMIN GRANT TABLE c.bare TO ROLE poor WITH (select) COLUMNS (ghost);
----
<REGEX>:.*grant on "bare" lists "ghost", which the object does not have.*

statement error
ACL ADMIN ALTER GRANT CATALOG c TO ROLE poor SET COLUMNS 'ghost'
----
a catalog grant takes no column list

# --- review regressions (the self-review's findings, each pinned) ---------------------------------

# the unrestricted role reads the quoted-name object: the emitters quote the bare stored name
query I
ACL ROLE "analyst" SELECT "odd name" FROM orders LIMIT 0;
----

# a quoted name in an object's list reads unquoted
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.nn AS phys.main.orders COLUMNS ("odd name", pk AS id);

query I
ACL ROLE "analyst" SELECT "odd name" FROM nn LIMIT 0;
----

# a masked relation is the read-only form and answers NO whatever the caps say - and the same under
# a schema-qualified stored name, which the listing must key by the stored form, not a reconstruction
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.masked AS phys.main.orders COLUMNS (pk AS id, upper(internal_tenant) AS who);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.main.mx AS phys.main.orders COLUMNS (pk AS id, upper(internal_tenant) AS who);

query II
ACL ROLE "analyst" SELECT table_name, is_insertable_into FROM information_schema.tables WHERE table_name IN ('masked', 'mx') ORDER BY 1;
----
masked	NO
mx	NO

# spec 150 4f: an object's list is read on duckdb's tokens, so a quoted name holding ',' or '=' is the name it quotes
# (the text reader split it, and refused it for that); one holding '.' is refused - the list reads it as a path
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.audit COLUMNS (id AS "a,b", note AS "x=y");

query II
SELECT name, expr FROM store.acl.relation_columns WHERE vcat = 'c' AND vname = 'bad' ORDER BY pos;
----
a,b	id
x=y	note

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad2 AS phys.main.audit COLUMNS (id AS "a.b");
----
holds no '.' or '['

statement ok
ACL ADMIN DROP VIRTUAL TABLE c.bad;

# spec 158: "a grant written before any object exists is not judgeable" is gone - a catalog grant takes no list, and
# an object grant names an object that exists
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c2;

statement ok
ACL ADMIN CREATE ROLE writer;

statement ok
ACL ADMIN GRANT CATALOG c2 TO ROLE writer WITH (select, insert) MAIN;

statement error
ACL ADMIN GRANT TABLE c2.t TO ROLE writer WITH (select) COLUMNS (id);
----
does not exist

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c2.t AS phys.main.audit COLUMNS (id AS id, note AS note);

# a mask of a column the grant shows passes, and a computed column through a grant is refused - naming, computing
# and ordering belong to the virtual catalog (spec 037)
statement ok
SELECT acl_grant_object('writer', 'c2', 't', '{"select": true}', '', 'note', '', 'note AS upper(note)');

query T
SELECT masks FROM store.acl.role_object_caps WHERE vcat = 'c2' AND role = 'writer';
----
note AS CAST((upper(note)) AS VARCHAR)

statement error
SELECT acl_grant_object('writer', 'c2', 't', '{"select": true}', '', 'initials', '', 'initials AS substr(note, 1, 1)');
----
<REGEX>:.*naming, computing and ordering belong to the virtual catalog.*

# altering an unrelated field of the catalog grant passes after its object is gone
statement ok
ACL ADMIN DROP RELATION c2.t;

statement ok
ACL ADMIN ALTER GRANT CATALOG c2 TO ROLE writer SET MAIN true;
