# name: test/sql/acl_object_list_star.test
# description: spec 158 stage 2 - a star in an object's own column list (`*`, `* EXCLUDE`, `* REPLACE`, `* RENAME`,
#   `COLUMNS(…)`) is read live by duckdb, a grant goes over that read, the listing keeps the snapshot of the write /
#   ANALYZE, the object is read-only; negative tests for the forms a list refuses and for a source column that comes
#   to share a named item's name (it never takes the item's mask).
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.p (id INTEGER, name VARCHAR, ssn VARCHAR, salary INTEGER, tenant VARCHAR);

statement ok
INSERT INTO phys.main.p VALUES (1, 'ann', '123-45-6789', 1000, 't1'), (2, 'bob', '987-65-4321', 2000, 't2');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin = true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c; CREATE ROLE a; CREATE ROLE m; CREATE ROLE r;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE a MAIN; GRANT CATALOG c TO ROLE m MAIN; GRANT CATALOG c TO ROLE r MAIN;

# --- the forms ---------------------------------------------------------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.ex AS phys.main.p COLUMNS (* EXCLUDE (ssn, salary), '***-' || right(ssn, 4) AS ssn_tail);

query T
SELECT string_agg(coalesce(name, '<star>') || '=' || expr, ' | ' ORDER BY pos) FROM store.acl.relation_columns WHERE vname = 'ex';
----
<star>=* EXCLUDE (salary, ssn) | ssn_tail=('***-' || "right"(ssn, 4))

query ITTT
ACL ROLE "a" SELECT * FROM ex ORDER BY id;
----
1	ann	t1	***-6789
2	bob	t2	***-4321

query T
ACL ROLE "a" SELECT string_agg(column_name || ':' || data_type, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_name = 'ex';
----
id:INTEGER,name:VARCHAR,tenant:VARCHAR,ssn_tail:VARCHAR

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.rep AS phys.main.p COLUMNS (* EXCLUDE (ssn) REPLACE (upper(name) AS name));

query ITIT
ACL ROLE "a" SELECT * FROM rep ORDER BY id;
----
1	ANN	1000	t1
2	BOB	2000	t2

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.ren AS phys.main.p COLUMNS (* EXCLUDE (ssn, salary) RENAME (tenant AS org));

query T
ACL ROLE "a" SELECT string_agg(column_name, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_name = 'ren';
----
id,name,org

query IT
ACL ROLE "a" SELECT id, org FROM ren ORDER BY id;
----
1	t1
2	t2

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.rx AS phys.main.p COLUMNS (id, COLUMNS('^(name|tenant)$'));

query ITT
ACL ROLE "a" SELECT * FROM rx ORDER BY id;
----
1	ann	t1
2	bob	t2

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.lm AS phys.main.p COLUMNS (COLUMNS(lambda c: c NOT IN ('ssn', 'salary')));

query T
ACL ROLE "a" SELECT string_agg(column_name, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_name = 'lm';
----
id,name,tenant

# --- a grant over a star list: the test and the masks by duckdb, the RLS reads the source ------------------------

statement ok
ACL ADMIN GRANT TABLE c.ex TO ROLE m RLS (tenant = 't1') COLUMNS (* EXCLUDE (name)) MASK (ssn_tail AS 'hidden');

query ITT
ACL ROLE "m" SELECT * FROM ex;
----
1	t1	hidden

query T
ACL ROLE "m" SELECT string_agg(column_name, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_name = 'ex';
----
id,tenant,ssn_tail

statement error
ACL ROLE "m" SELECT name FROM ex;
----
name

# --- the source gains and loses columns: the read follows at once, the listing at ANALYZE ------------------------

statement ok
ALTER TABLE phys.main.p ADD COLUMN email VARCHAR DEFAULT 'x@y';

query ITTTT
ACL ROLE "a" SELECT * FROM ex ORDER BY id;
----
1	ann	t1	x@y	***-6789
2	bob	t2	x@y	***-4321

query TTT
SELECT kind, problem, repair FROM acl_check_catalog('c') WHERE object = 'ex';
----
table	schema_stale	ANALYZE VIRTUAL TABLE c.ex

statement ok
ACL ADMIN ANALYZE VIRTUAL TABLE c.ex;

query T
ACL ROLE "a" SELECT string_agg(column_name, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_name = 'ex';
----
id,name,tenant,email,ssn_tail

# a source column that comes to share a named item's name: duckdb would suffix one of them (`ssn_tail_1`) where the
# grant's test and mask name only the first - every read refuses instead, and the check names it (review)

statement ok
ALTER TABLE phys.main.p ADD COLUMN ssn_tail VARCHAR DEFAULT 'raw';

statement error
ACL ROLE "m" SELECT * FROM ex;
----
reads a column name twice

statement error
ACL ROLE "a" SELECT id FROM ex;
----
reads a column name twice

query TT
SELECT problem, repair FROM acl_check_catalog('c') WHERE object = 'ex';
----
column_duplicate	ALTER VIRTUAL TABLE c.ex SET COLUMNS (<the list, the name EXCLUDEd from the star or the other column renamed>)

# an ALTER of another field is not refused for it (only a write of the list or its source is judged)
statement ok
ACL ADMIN COMMENT ON VIRTUAL TABLE c.ex IS 'people';

statement ok
ALTER TABLE phys.main.p DROP COLUMN ssn_tail;

query I
ACL ROLE "a" SELECT count(*) FROM ex;
----
2

# a star that makes a name twice by itself (a RENAME onto a column it passes) is refused where written

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* EXCLUDE (salary) RENAME (name AS ssn));
----
reads "ssn" twice

# a marker in the star does not hide a duplicate from the write's probe (review)

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* REPLACE (CASE WHEN acl_has_role('hr') THEN salary END AS salary), '***' AS ssn);
----
reads "ssn" twice

# an object written while its source does not bind is judged where it is read: the duplicate refuses

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.late AS phys.main.q COLUMNS (*, '***-' || right(ssn, 4) AS ssn);

statement ok
CREATE TABLE phys.main.q AS SELECT * FROM phys.main.p;

statement ok
ACL ADMIN GRANT TABLE c.late TO ROLE m MASK (ssn AS 'hidden');

statement error
ACL ROLE "m" SELECT * FROM late;
----
reads a column name twice

query T
SELECT problem FROM acl_check_catalog('c') WHERE object = 'late';
----
column_duplicate

# a list that does not bind over a source that does is refused where written

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (id, * EXCLUDE (nosuch));
----
does not bind over

# --- refused where written ----------------------------------------------------------------------------------------

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (*, *);
----
holds a second star

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (p.*);
----
no qualified name

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* REPLACE (upper(main.p.name) AS name));
----
no qualified name

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* EXCLUDE (p.ssn));
----
no qualified name

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (COLUMNS(lambda c: acl_has_role('m') OR c <> 'ssn'));
----
reads a marker

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* LIKE 'n%');
----
COLUMNS('<regex>')

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (id, upper(COLUMNS('name')) AS u);
----
a star stands alone in the list

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* REPLACE ((SELECT max(name) FROM phys.main.p) AS name));
----
no subquery

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (*, upper(name) AS name);
----
reads "name" twice

statement error
ACL ADMIN CREATE VIRTUAL TABLE c.bad AS phys.main.p COLUMNS (* EXCLUDE (ssn) AS everything);
----
names a star

statement error
ACL ADMIN REPAIR VIRTUAL TABLE c.ex REMAP (* AS x);
----
REMAP

# --- read-only ----------------------------------------------------------------------------------------------------

statement error
ACL ROLE "a" INSERT INTO ex (id) VALUES (3);
----
read-only

# --- a star list read with the session's RLS of its own (the object's RLS reads the source) ----------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.own AS phys.main.p COLUMNS (* EXCLUDE (ssn)) ;

statement ok
ACL ADMIN ALTER VIRTUAL TABLE c.own SET RLS 'salary > 1500';

query IT
ACL ROLE "r" SELECT id, name FROM own;
----
2	bob

# DROP MISSING COLUMNS keeps the star (it names no column of its own)

statement ok
ALTER TABLE phys.main.p ADD COLUMN gone INTEGER;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.dm AS phys.main.p COLUMNS (* EXCLUDE (ssn), gone AS g2);

statement ok
ALTER TABLE phys.main.p DROP COLUMN gone;

statement ok
ACL ADMIN REPAIR VIRTUAL TABLE c.dm DROP MISSING COLUMNS;

query T
SELECT string_agg(coalesce(name, '<star>'), ',' ORDER BY pos) FROM store.acl.relation_columns WHERE vname = 'dm';
----
<star>

query T
ACL ROLE "a" SELECT string_agg(column_name, ',' ORDER BY ordinal_position) FROM information_schema.columns WHERE table_name = 'dm';
----
id,name,salary,tenant,email

# a column a star's REPLACE computes is computed to a key, as a named expression is (review)

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.k1 AS phys.main.p COLUMNS (* REPLACE (nullif(name, 'ann') AS name));

statement error
ACL ADMIN ALTER VIRTUAL TABLE c.k1 SET PRIMARY KEY (name);
----
computed by an expression

# a mask over a star object is read as the object's column's type, by column (spec 099 casts; review)

statement ok
CREATE TYPE mood AS ENUM ('ok', 'sad');

statement ok
CREATE TABLE phys.main.e (id INTEGER, m mood, name VARCHAR);

statement ok
INSERT INTO phys.main.e VALUES (1, 'ok', 'ann');

statement ok
SET GLOBAL acl_enum_types = 'varchar';

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.er AS phys.main.e COLUMNS (* RENAME (m AS mood, name AS m));

statement ok
ACL ADMIN GRANT TABLE c.er TO ROLE m MASK (mood AS 'ok');

query TT
ACL ROLE "a" SELECT typeof(mood), typeof(m) FROM er;
----
VARCHAR	VARCHAR

query TT
ACL ROLE "m" SELECT typeof(mood), typeof(m) FROM er;
----
VARCHAR	VARCHAR

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.ep AS phys.main.e COLUMNS (* REPLACE (length(m::VARCHAR) AS m));

statement ok
ACL ADMIN GRANT TABLE c.ep TO ROLE m MASK (m AS 0);

query T
ACL ROLE "m" SELECT typeof(m) FROM ep;
----
BIGINT

statement ok
SET GLOBAL acl_enum_types = 'keep';
