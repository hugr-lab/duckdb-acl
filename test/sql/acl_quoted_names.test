# name: test/sql/acl_quoted_names.test
# description: spec 116 - a virtual catalog, schema, table, view, function and the physical name it
#   points at may be named the way SQL allows (any case, spaces, a dot or a quote inside a part), and
#   compare case-insensitively as duckdb's catalog does. Memory mode first, then a policy catalog.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE SCHEMA phys."Raw Data";

statement ok
CREATE TABLE phys."Raw Data"."Order Items"(id INTEGER, "Qty" INTEGER, tenant VARCHAR);

statement ok
INSERT INTO phys."Raw Data"."Order Items" VALUES (1, 10, 'acme'), (2, 20, 'acme'), (3, 30, 'other');

statement ok
CREATE TABLE phys.main.u(v VARCHAR);

statement ok
INSERT INTO phys.main.u VALUES ('upper');

statement ok
CREATE SCHEMA phys.ab;

statement ok
CREATE TABLE phys.ab.t(s VARCHAR);

statement ok
INSERT INTO phys.ab.t VALUES ('the schema a.b');

statement ok
CREATE TABLE phys.main.nested(s VARCHAR);

statement ok
INSERT INTO phys.main.nested VALUES ('the path a.b');

# --- memory mode: the legacy wrappers take a name as a key, the maps compare case-insensitively ------

statement ok
SELECT acl_define_role('m', '');

statement ok
SELECT acl_grant_table('m', 'mart.Order Items', 'phys."Raw Data"."Order Items"', '', '', 'select,insert');

statement ok
SELECT acl_grant_scalar('m', 'Shout-It', 'upper(acl_arg(1))');

query II
ACL ROLE "m" SELECT id, "Qty" FROM mart."Order Items" ORDER BY id;
----
1	10
2	20
3	30

query I
ACL ROLE "m" SELECT count(*) FROM MART."order items";
----
3

query T
ACL ROLE "m" SELECT "Shout-It"('x');
----
X

# the whole path in one identifier is one name, not the path - and the refusal names it, once quoted
statement error
ACL ROLE "m" SELECT * FROM "mart.Order Items";
----
<REGEX>:.*no access to object "mart.Order Items"\s*

# a view, a table function, a mask: names as keys, read in any case
statement ok
SELECT acl_grant_view('m', '"Raw Data"."x-y"', 'SELECT 1 AS v');

query I
ACL ROLE "m" SELECT v FROM "raw data"."X-Y";
----
1

statement ok
SELECT acl_grant_table_function('m', 'Top Items', 'SELECT 42 AS id');

query I
ACL ROLE "m" SELECT id FROM "top items"();
----
42

statement ok
SELECT acl_grant_table('m', 'mart.Masked', 'phys."Raw Data"."Order Items"', 'id,Qty=0', '', 'select');

query II
ACL ROLE "m" SELECT id, "Qty" FROM mart."MASKED" ORDER BY id;
----
1	0
2	0
3	0

# one name in any case is one object: a second grant under another case replaces it, never a sibling
statement ok
SELECT acl_grant_table('m', 'MART.masked', 'phys.main.u', '', '', 'select');

query T
ACL ROLE "m" SELECT v FROM mart.Masked;
----
upper

query T
ACL ROLE "m" SELECT column_name FROM (DESCRIBE mart."Order Items") ORDER BY ALL;
----
Qty
id
tenant

# the memory store lists nothing: the metadata surfaces stay denied there, whatever the names
statement error
ACL ROLE "m" SELECT * FROM information_schema.tables;
----
<REGEX>:.*(not available|cannot enumerate).*

statement ok
ACL ROLE "m" INSERT INTO mart."Order Items" VALUES (4, 40, 'acme');

query I
SELECT count(*) FROM phys."Raw Data"."Order Items";
----
4

statement ok
DELETE FROM phys."Raw Data"."Order Items" WHERE id = 4;

# --- a policy catalog -------------------------------------------------------------------------------

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG "Sales Mart";

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE ROLE r;

statement ok
ACL ADMIN GRANT CATALOG "Sales Mart" TO ROLE r MAIN;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."Order Items" AS phys."Raw Data"."Order Items" PRIMARY KEY (id);

# stored as the canonical key: a part quoted only when it holds a `.` or a `"`
query TTT
SELECT vcat, vname, phys FROM store.acl.relations ORDER BY vname;
----
Sales Mart	Order Items	phys.Raw Data.Order Items

query II
ACL ROLE "r" SELECT id, "Qty" FROM "Sales Mart"."Order Items" ORDER BY id;
----
1	10
2	20
3	30

# case-insensitive, as duckdb's catalog: the catalog, the object, written any way
query I
ACL ROLE "r" SELECT count(*) FROM "sales mart"."ORDER ITEMS";
----
3

query I
ACL ROLE "r" SELECT count(*) FROM "Order Items";
----
3

query I
ACL ROLE "r" SELECT count(*) FROM "Sales Mart".main."Order Items";
----
3

statement error
ACL ROLE "r" SELECT * FROM "Sales Mart.Order Items";
----
<REGEX>:.*no access to object "Sales Mart.Order Items"\s*

# DML through the writable alias
statement ok
ACL ROLE "r" INSERT INTO "Sales Mart"."Order Items" VALUES (4, 40, 'acme');

statement ok
ACL ROLE "r" UPDATE "sales mart"."order items" SET "Qty" = 41 WHERE id = 4;

query I
SELECT "Qty" FROM phys."Raw Data"."Order Items" WHERE id = 4;
----
41

statement ok
ACL ROLE "r" DELETE FROM "Order Items" WHERE id = 4;

# --- "Upper": stored as written, read as upper / UPPER ---------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."Upper" AS phys.main.u;

query T
ACL ROLE "r" SELECT v FROM "Sales Mart".upper;
----
upper

query T
ACL ROLE "r" SELECT v FROM UPPER;
----
upper

# --- "a.b" is one schema, beside the path a.b --------------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA "Sales Mart"."a.b" AS phys.ab;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart".a.b AS phys.main.nested;

query T
ACL ROLE "r" SELECT s FROM "Sales Mart"."a.b".t;
----
the schema a.b

query T
ACL ROLE "r" SELECT s FROM "Sales Mart".a.b;
----
the path a.b

query TT
SELECT path, phys_path FROM store.acl.schemas ORDER BY path;
----
"a.b"	phys.ab

# --- "x-y", "q""uote", a nested c."Raw Data".sub."T", a view ------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL VIEW "Sales Mart"."x-y" AS SELECT 1 AS v;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."q""uote" AS phys.main.u;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c."Raw Data".sub."T" AS phys."Raw Data"."Order Items";

query I
ACL ROLE "r" SELECT v FROM "x-y";
----
1

query T
ACL ROLE "r" SELECT v FROM "Sales Mart"."q""uote";
----
upper

query I
ACL ROLE "r" SELECT count(*) FROM c."raw data".SUB.t;
----
3

query TT
SELECT vcat, vname FROM store.acl.relations ORDER BY vcat, vname;
----
Sales Mart	"q""uote"
Sales Mart	Order Items
Sales Mart	Upper
Sales Mart	a.b
Sales Mart	x-y
c	Raw Data.sub.T

# --- an expanded schema with a quoted name, and a physical name stored the old way -----------------

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c."Raw Data" FROM phys."Raw Data";

query T
SELECT vname FROM store.acl.relations WHERE vcat = 'c' ORDER BY vname;
----
Raw Data.Order Items
Raw Data.sub.T

query I
ACL ROLE "r" SELECT count(*) FROM c."Raw Data"."Order Items";
----
3

# a physical name written whole in single quotes (the legacy string form) is read as a key too
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.legacy AS 'phys."Raw Data"."Order Items"';

query T
SELECT phys FROM store.acl.relations WHERE vname = 'legacy';
----
phys.Raw Data.Order Items

query I
ACL ROLE "r" SELECT count(*) FROM c.legacy;
----
3

# --- a table function and a scalar with quoted names -------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE FUNCTION "Sales Mart"."Top Items"(n INTEGER) RETURNS TABLE (id INTEGER) AS SELECT id FROM phys."Raw Data"."Order Items" ORDER BY "Qty" DESC LIMIT acl_arg(1);

statement ok
ACL ADMIN CREATE VIRTUAL SCALAR "Sales Mart"."Shout-It"(s VARCHAR) AS upper(acl_arg(1));

query I
ACL ROLE "r" SELECT id FROM "Sales Mart"."Top Items"(1);
----
3

query I
ACL ROLE "r" SELECT id FROM "top items"(1);
----
3

# duckdb's transformer lowercases a function name, quoted or not: a stored "Shout-It" is still found
query TT
ACL ROLE "r" SELECT "Shout-It"('x'), "Sales Mart"."SHOUT-IT"('y');
----
X	Y

# --- a reference, a key, grants with masks -------------------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL REFERENCE "Sales Mart"."Items To Upper" FROM "Order Items" TO "Upper" ON (tenant = v);

query TTT
ACL ROLE "r" SELECT vcat, from_object, to_object FROM acl_references();
----
Sales Mart	Order Items	Upper

# a column of the pair written as a quoted identifier means the name it quotes
statement ok
ACL ADMIN CREATE VIRTUAL REFERENCE "Sales Mart"."Self" FROM "Order Items" TO "Order Items" ON ("Qty" = "Qty");

query TT
ACL ROLE "r" SELECT from_columns, to_columns FROM acl_references() WHERE name = 'Self';
----
Qty	Qty

query TTI
ACL ROLE "r" SELECT vcat, object, key_sequence FROM acl_keys();
----
Sales Mart	Order Items	1

statement ok
ACL ADMIN CREATE ROLE masked;

statement ok
ACL ADMIN GRANT CATALOG "Sales Mart" TO ROLE masked MAIN WITH (select) RLS (tenant = 'acme');

statement ok
ACL ADMIN GRANT TABLE "SALES MART"."order items" TO ROLE masked COLUMNS (id, "Qty" = 0);

statement ok
ACL ADMIN GRANT SCHEMA "Sales Mart"."A.B" TO ROLE masked WITH (select);

query TT
SELECT vcat, vname FROM store.acl.role_object_caps WHERE role = 'masked';
----
Sales Mart	Order Items

query TT
SELECT vcat, schema_path FROM store.acl.role_schemas WHERE role = 'masked';
----
Sales Mart	"a.b"

query II
ACL ROLE "masked" SELECT * FROM "Order Items" ORDER BY id;
----
1	0
2	0

# --- metadata: each name as duckdb shows it ---------------------------------------------------------

query TTT
ACL ROLE "r" SELECT table_catalog, table_schema, table_name FROM information_schema.tables WHERE table_catalog = 'Sales Mart' ORDER BY ALL;
----
Sales Mart	"a.b"	t
Sales Mart	a	b
Sales Mart	main	Order Items
Sales Mart	main	Upper
Sales Mart	main	q"uote
Sales Mart	main	x-y

query TTT
ACL ROLE "r" SELECT table_catalog, table_schema, table_name FROM information_schema.tables WHERE table_catalog = 'c' ORDER BY ALL;
----
c	Raw Data	Order Items
c	Raw Data.sub	T
c	main	legacy

query TT
ACL ROLE "r" SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'Order Items' AND table_catalog = 'Sales Mart' ORDER BY ordinal_position;
----
id	INTEGER
Qty	INTEGER
tenant	VARCHAR

query T
ACL ROLE "r" SELECT column_name FROM (DESCRIBE "Sales Mart"."Order Items") ORDER BY ALL;
----
Qty
id
tenant

query T
ACL ROLE "r" SHOW TABLES;
----
Order Items
Upper
q"uote
x-y

query TTT
ACL ROLE "r" SELECT database_name, schema_name, parent_schema FROM duckdb_schemas() WHERE database_name = 'c' ORDER BY ALL;
----
c	Raw Data	NULL
c	main	NULL
c	sub	Raw Data

query TTT
ACL ROLE "r" SELECT database_name, schema_name, function_name FROM duckdb_functions() WHERE database_name = 'Sales Mart' ORDER BY ALL;
----
Sales Mart	main	Shout-It
Sales Mart	main	Top Items

query TT
ACL ROLE "r" SELECT current_database(), current_schema();
----
Sales Mart	main

# the operator's check names the objects in the grammar's form
statement ok
DROP TABLE phys.main.nested;

query TTT
SELECT kind, object, repair FROM acl_check_catalog('sales mart') WHERE problem = 'source_missing';
----
table	a.b	ALTER VIRTUAL TABLE "Sales Mart".a.b SET PHYS <path>  -- or DROP VIRTUAL TABLE "Sales Mart".a.b

statement ok
CREATE TABLE phys.main.nested(s VARCHAR);

# --- spec 113 DDL in a quoted home ------------------------------------------------------------------

statement ok
ACL ADMIN GRANT SCHEMA c."Raw Data" TO ROLE r WITH (select, create, drop);

statement ok
ACL ROLE "r" CREATE TABLE c."Raw Data"."New One" AS SELECT 7 AS i;

query I
SELECT i FROM phys."Raw Data"."New One";
----
7

query I
ACL ROLE "r" SELECT i FROM c."RAW DATA"."new one";
----
7

query T
SELECT vname FROM store.acl.relations WHERE vcat = 'c' AND vname LIKE '%New One';
----
Raw Data.New One

statement ok
ACL ROLE "r" DROP TABLE c."raw data"."New One";

statement error
SELECT * FROM phys."Raw Data"."New One";
----
<REGEX>:.*does not exist.*

# --- negative: a name differing only by case from an existing one is refused, each kind -----------

statement error
ACL ADMIN CREATE VIRTUAL CATALOG "SALES MART";
----
<REGEX>:.*catalog "SALES MART" differs only by case from the existing "Sales Mart".*

statement error
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."order items" AS phys.main.u;
----
<REGEX>:.*name "order items" differs only by case from the existing "Order Items".*

statement error
ACL ADMIN CREATE OR REPLACE VIRTUAL VIEW "Sales Mart"."X-Y" AS SELECT 2 AS v;
----
<REGEX>:.*differs only by case.*

statement error
ACL ADMIN CREATE VIRTUAL SCHEMA "Sales Mart"."A.B" AS phys.ab;
----
<REGEX>:.*differs only by case.*

statement error
ACL ADMIN CREATE VIRTUAL SCALAR "Sales Mart"."SHOUT-IT"(s VARCHAR) AS lower(acl_arg(1));
----
<REGEX>:.*differs only by case.*

statement error
ACL ADMIN CREATE VIRTUAL TABLE FUNCTION "Sales Mart"."top items"(n INTEGER) AS SELECT 1 AS id;
----
<REGEX>:.*differs only by case.*

statement error
ACL ADMIN CREATE VIRTUAL REFERENCE "Sales Mart"."items to upper" FROM "Order Items" TO "Upper" ON (tenant = v);
----
<REGEX>:.*reference "items to upper" differs only by case.*

# IF NOT EXISTS keeps the one there, whatever case it was written in
statement ok
ACL ADMIN CREATE VIRTUAL TABLE IF NOT EXISTS "Sales Mart"."ORDER ITEMS" AS phys.main.u;

query I
SELECT count(*) FROM store.acl.relations WHERE lower(vname) = 'order items';
----
1

# a parent written in another case lands under the stored one
statement ok
ACL ADMIN CREATE VIRTUAL TABLE C."raw data".SUB.second AS phys.main.u;

query T
SELECT vcat || ' / ' || vname FROM store.acl.relations WHERE vname LIKE '%second';
----
c / Raw Data.sub.second

# --- negative: what is not a name -------------------------------------------------------------------

statement error
ACL ADMIN CREATE VIRTUAL CATALOG "";
----
<REGEX>:.*an empty quoted identifier.*

statement error
ACL ADMIN CREATE VIRTUAL CATALOG "abc;
----
<REGEX>:.*unterminated quoted identifier.*

statement error
SELECT acl_add_relation('c', 'a..b', 'phys.main.u', '', '');
----
<REGEX>:.*is not a name: an empty part.*

statement error
SELECT acl_create_catalog('a.b');
----
<REGEX>:.*a catalog is one identifier.*

# a catalog with a dot is written quoted, and is one name
statement ok
SELECT acl_create_catalog('"x.y"');

query T
SELECT vcat FROM store.acl.catalogs WHERE vcat LIKE '%x.y%';
----
"x.y"

# roles stay values: compared exactly (a quoted role name is its text)
statement ok
ACL ADMIN CREATE ROLE "Mixed Role";

query T
SELECT role FROM store.acl.roles WHERE role LIKE 'Mixed%';
----
Mixed Role

# --- case siblings across kinds: one spelling per name in a catalog, whatever kind holds it ---------

statement error
ACL ADMIN CREATE VIRTUAL SCALAR "Sales Mart"."ORDER ITEMS"(s VARCHAR) AS upper(acl_arg(1));
----
<REGEX>:.*acl admin: name "ORDER ITEMS" differs only by case from the existing "Order Items" - names compare case-insensitively, as duckdb's catalog does \(spec 116\).*

statement error
ACL ADMIN CREATE VIRTUAL SCHEMA "Sales Mart"."order items" AS phys.ab;
----
<REGEX>:.*acl admin: name "order items" differs only by case from the existing "Order Items".*

# --- one fold everywhere: ASCII, as duckdb's catalog - `Öl` and `öl` are two names ----------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."Öl" AS phys.main.u;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."öl" AS phys.ab.t;

query TT
ACL ROLE "r" SELECT (SELECT v FROM "Öl"), (SELECT s FROM "öl");
----
upper	the schema a.b

query T
ACL ROLE "r" SELECT v FROM "ÖL";
----
upper

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c."Ä" AS phys."Raw Data"."Order Items";

statement error
ACL ADMIN GRANT TABLE c."ä" TO ROLE r WITH (select);
----
<REGEX>:.*object "c.ä" does not exist.*

statement error
ACL ROLE "r" SELECT * FROM c."ä";
----
<REGEX>:.*no access to object "c.ä".*

# a mask on c."Ä" is never widened by a sibling c."ä" - two objects, two grants
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c."ä" AS phys."Raw Data"."Order Items";

statement ok
ACL ADMIN CREATE ROLE m2;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE m2 WITH (select) MAIN;

statement ok
ACL ADMIN GRANT TABLE c."Ä" TO ROLE m2 COLUMNS (id, "Qty" = 0);

query II
ACL ROLE "m2" SELECT (SELECT sum("Qty") FROM "Ä"), (SELECT sum("Qty") FROM "ä");
----
0	60

# a principal's DDL creating vs."ä" beside the operator's vs."Ä" makes a second object: the reads of
# vs."Ä" keep its own predicate
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c."Raw Data"."Ä" AS phys."Raw Data"."Order Items" RLS (tenant = 'acme');

statement ok
ACL ROLE "r" CREATE TABLE c."Raw Data"."ä" AS SELECT 99 AS id, 'other' AS tenant;

query I
ACL ROLE "r" SELECT count(*) FROM c."Raw Data"."Ä";
----
2

query I
ACL ROLE "r" SELECT id FROM c."Raw Data"."ä";
----
99

statement ok
ACL ROLE "r" DROP TABLE c."Raw Data"."ä";

# --- a schema alias's tail is cut by parts, never by bytes ----------------------------------------------

statement ok
CREATE SCHEMA phys.lake;

statement ok
CREATE SCHEMA phys.lake_priv;

statement ok
CREATE TABLE phys.lake.t AS SELECT 'ok' AS s;

statement ok
CREATE TABLE phys.lake_priv.secret AS SELECT 'leak' AS s;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c."STRAẞE" AS phys.lake;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c.ik AS phys.lake;

query T
ACL ROLE "r" SELECT s FROM c."STRAẞE".t;
----
ok

statement error
ACL ROLE "r" SELECT * FROM c."straße"._priv.secret;
----
<REGEX>:.*no access to object.*

# `iK` (a Kelvin sign, U+212A): Unicode lower() made it `ik` (one byte shorter) and the cut fell inside it
statement error
ACL ROLE "r" SELECT * FROM c."iK"._priv.secret;
----
<REGEX>:.*no access to object.*

query T
ACL ROLE "r" SELECT s FROM c.IK.t;
----
ok

# --- RLS over a quoted column ------------------------------------------------------------------------

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Sales Mart"."Big Items" AS phys."Raw Data"."Order Items" RLS ("Qty" > 15);

query I
ACL ROLE "r" SELECT count(*) FROM "big items";
----
2

# --- spec 113: RENAME in a quoted home moves the record and the physical table ----------------------

statement ok
ACL ROLE "r" CREATE TABLE c."Raw Data"."Old Name" AS SELECT 1 AS i;

statement ok
ACL ROLE "r" ALTER TABLE c."raw data"."old name" RENAME TO "New Name";

query T
SELECT vname FROM store.acl.relations WHERE vcat = 'c' AND vname LIKE '%Name';
----
Raw Data.New Name

query I
SELECT i FROM phys."Raw Data"."New Name";
----
1

statement ok
ACL ROLE "r" DROP TABLE c."Raw Data"."New Name";

# --- argument filters compare as names compare ----------------------------------------------------------

query I
ACL ROLE "r" SELECT (SELECT count(*) FROM acl_function_columns('sales mart', 'MAIN')) = (SELECT count(*) FROM acl_function_columns('Sales Mart', 'main')) AND (SELECT count(*) FROM acl_function_columns('Sales Mart')) > 0;
----
true

query T
ACL ROLE "r" SELECT DISTINCT function_name FROM acl_function_columns('SALES MART', 'main', 'top items');
----
Top Items

query T
ACL ROLE "r" SELECT name FROM acl_references('order items') ORDER BY 1;
----
Items To Upper
Self

query TI
ACL ROLE "r" SELECT object, key_sequence FROM acl_keys('ORDER ITEMS');
----
Order Items	1

query T
ACL ROLE "r" SHOW TABLES FROM "sales mart".MAIN;
----
Big Items
Order Items
Upper
q"uote
x-y
Öl
öl

# --- the audit names one object one way: the policy's own name, however it was written --------------

statement ok
ACL ROLE "r" SELECT count(*) FROM "sales mart"."ORDER ITEMS";

query T
SELECT objects FROM acl_audit_events() WHERE kind = 'statement' AND verdict = 'allowed' ORDER BY seq DESC LIMIT 1;
----
[{'name': Sales Mart.Order Items, 'capability': select}]

# --- the operator's repair statements parse and run as written ------------------------------------------

statement ok
CREATE TABLE phys."Raw Data"."a.b" AS SELECT 1 AS i;

statement ok
CREATE TABLE phys."Raw Data"."q""x" AS SELECT 1 AS i;

query T
SELECT repair FROM acl_check_catalog('c') WHERE problem = 'expansion_stale';
----
ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH

statement ok
ACL ADMIN ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH;

query T
SELECT vname FROM store.acl.relations WHERE vcat = 'c' AND vname IN ('Raw Data."a.b"', 'Raw Data."q""x"') ORDER BY 1;
----
Raw Data."a.b"
Raw Data."q""x"

# a part with a dot or a quote is its own name to the check and to PRUNE: nothing stale, nothing pruned
query I
SELECT count(*) FROM acl_check_catalog('c') WHERE problem = 'expansion_stale';
----
0

statement ok
ACL ADMIN ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH PRUNE;

query I
SELECT count(*) FROM store.acl.relations WHERE vcat = 'c' AND vname IN ('Raw Data."a.b"', 'Raw Data."q""x"');
----
2

statement ok
ACL ADMIN ANALYZE VIRTUAL CATALOG "Sales Mart";

statement ok
CREATE TABLE phys.main.g(id INTEGER, gone INTEGER);

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG "Q Cat";

statement ok
ACL ADMIN CREATE VIRTUAL TABLE "Q Cat".g AS phys.main.g;

statement ok
ACL ADMIN GRANT CATALOG "Q Cat" TO ROLE "Mixed Role" COLUMNS (id, gone);

statement ok
ALTER TABLE phys.main.g DROP COLUMN gone;

query T
SELECT repair FROM acl_check_catalog('q cat') WHERE problem = 'grant_column_missing';
----
ALTER GRANT CATALOG "Q Cat" TO ROLE "Mixed Role" SET COLUMNS 'id'

statement ok
ACL ADMIN ALTER GRANT CATALOG "Q Cat" TO ROLE "Mixed Role" SET COLUMNS 'id';

query I
SELECT count(*) FROM acl_check_catalog('q cat') WHERE problem = 'grant_column_missing';
----
0

# --- verification pass: one fold for column and field names too ---------------------------------------

statement ok
CREATE TABLE phys.main.ux(id INTEGER, "äx" INTEGER, "Äx" INTEGER);

statement ok
INSERT INTO phys.main.ux VALUES (1, 10, 20);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.ux AS phys.main.ux;

statement ok
ACL ADMIN GRANT TABLE c.ux TO ROLE m2 WITH (select) COLUMNS (id, "äx");

# the hidden "Äx" is neither read nor listed: SQL's lower() made it "äx"
query T
ACL ROLE "m2" SELECT column_name FROM (DESCRIBE SELECT * FROM c.ux) ORDER BY ALL;
----
id
äx

query T
ACL ROLE "m2" SELECT column_name FROM information_schema.columns WHERE table_catalog = 'c' AND table_name = 'ux' ORDER BY ALL;
----
id
äx

statement ok
CREATE TABLE phys.main.st(id INTEGER, s STRUCT("äx" INTEGER, "Äx" INTEGER));

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.st AS phys.main.st;

statement ok
ACL ADMIN GRANT TABLE c.st TO ROLE m2 WITH (select, insert) COLUMNS (id, s."äx");

# a written value carrying the hidden field is refused, not folded into the visible one
statement error
ACL ROLE "m2" INSERT INTO c.st VALUES (1, {'äx': 1, 'Äx': 2});
----
<REGEX>:.*

query I
SELECT count(*) FROM phys.main.st;
----
0

# --- verification pass: a subtree is measured in SQL, never by a C++ byte count -------------------------

statement ok
CREATE SCHEMA phys.raw;

statement ok
CREATE SCHEMA phys.eu;

statement ok
CREATE TABLE phys.eu.orders AS SELECT 1 AS id;

statement ok
ACL ADMIN CREATE ROLE g;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE g CAPS '{}' MAIN;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c."Größe" FROM phys.raw;

statement ok
ACL ADMIN GRANT SCHEMA c."Größe" TO ROLE g WITH (select);

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c."Größe".eu FROM phys.eu;

query TT
SELECT schema_path, inherited FROM store.acl.role_schemas WHERE role = 'g' ORDER BY 1;
----
Größe	false
Größe.eu	true

query I
ACL ROLE "g" SELECT id FROM c."Größe".eu.orders;
----
1

statement ok
ACL ADMIN REVOKE SCHEMA c."Größe" FROM ROLE g;

query I
SELECT count(*) FROM store.acl.role_schemas WHERE role = 'g';
----
0

statement error
ACL ROLE "g" SELECT id FROM c."Größe".eu.orders;
----
<REGEX>:.*not allowed.*

# a schema whose expansion holds records goes only with CASCADE, and then with them
statement error
ACL ADMIN DROP VIRTUAL SCHEMA c."Größe";
----
<REGEX>:.*CASCADE.*

statement ok
ACL ADMIN DROP VIRTUAL SCHEMA c."Größe" CASCADE;

query I
SELECT count(*) FROM store.acl.relations WHERE vcat = 'c' AND vname LIKE 'Größe%';
----
0

# --- verification pass: no second spelling of a held name, from the source or from a principal ---------

statement ok
ACL ADMIN CREATE VIRTUAL VIEW c."Raw Data"."Report" AS SELECT 1 AS v;

# refused BEFORE the physical CREATE: nothing is left behind for a REFRESH to record
statement error
ACL ROLE "r" CREATE TABLE c."Raw Data".report AS SELECT 2 AS v;
----
<REGEX>:.*name "Raw Data.report" differs only by case from the existing "Raw Data.Report".*

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'phys' AND schema_name = 'Raw Data' AND table_name = 'report';
----
0

# the source gains the same name in other spellings - an object, and one that collides with a schema
statement ok
CREATE TABLE phys."Raw Data".REPORT AS SELECT 3 AS v;

statement ok
CREATE TABLE phys."Raw Data".SUB AS SELECT 4 AS v;

statement ok
ACL ADMIN ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH;

query T
SELECT vname FROM store.acl.relations WHERE vcat = 'c' AND (lower(vname) = 'raw data.report' OR vname = 'Raw Data.SUB') ORDER BY 1;
----
Raw Data.Report

# every role still reads the operator's object - no `ambiguous name`
query I
ACL ROLE "r" SELECT v FROM c."Raw Data".REPORT;
----
1

query T
SELECT detail FROM acl_check_catalog('c') WHERE problem = 'case_sibling' ORDER BY 1;
----
the source object "REPORT" differs only by case from a name the catalog holds - it is not recorded
the source object "SUB" differs only by case from a name the catalog holds - it is not recorded

# --- verification pass: an engine function's key is folded as it is stored (ASCII) ----------------------

statement ok
CREATE MACRO "Äx"(a) AS a + 1;

# the node has it: the check read it with the same fold the key was written with
statement ok
SELECT acl_grant_function('r', 'memory.main.Äx');

query I
ACL ROLE "r" SELECT "Äx"(1);
----
2

query T
ACL ROLE "r" SELECT function_name FROM duckdb_functions() WHERE function_name = 'Äx';
----
Äx

# --- second verification pass: a physical name is stored as the engine spells it ----------------------

statement ok
CREATE SCHEMA phys.s2;

statement ok
CREATE TABLE phys.s2.e AS SELECT 5 AS n;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.plain AS PHYS.MAIN.U;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c.live AS PHYS.S2;

query TT
SELECT vname, phys FROM store.acl.relations WHERE vcat = 'c' AND vname = 'plain' UNION ALL SELECT path, phys_path FROM store.acl.schemas WHERE vcat = 'c' AND path = 'live';
----
plain	phys.main.u
live	phys.s2

# listed like any other: the exact joins on the engine's catalog match the stored spelling
query TT
ACL ROLE "r" SELECT table_schema, table_name FROM information_schema.tables WHERE table_catalog = 'c' AND table_name IN ('plain', 'e') ORDER BY ALL;
----
live	e
main	plain

query T
ACL ROLE "r" SELECT column_name FROM information_schema.columns WHERE table_catalog = 'c' AND table_schema = 'live';
----
n

query I
SELECT count(*) FROM acl_check_catalog('c') WHERE problem = 'schema_missing' AND object = 'live';
----
0

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA c.exp2 FROM PHYS.S2;

statement ok
ACL ADMIN GRANT SCHEMA c.exp2 TO ROLE r WITH (select, create) VIRTUAL ONLY;

statement ok
CREATE TABLE phys.s2.e3 AS SELECT 6 AS n;

# VIRTUAL ONLY registers what exists: `E3` is the existing phys.s2.e3, recorded as the engine spells it
statement ok
ACL ROLE "r" CREATE TABLE c.exp2.E3 AS SELECT 1 AS n;

query T
SELECT phys FROM store.acl.relations WHERE vcat = 'c' AND vname = 'exp2.E3';
----
phys.s2.e3

query I
ACL ROLE "r" SELECT n FROM c.exp2.E3;
----
6

# --- second verification pass: a RENAME's undo never makes a second spelling ----------------------------

statement ok
CREATE TABLE phys."Raw Data".mover AS SELECT 1 AS i;

statement ok
ACL ADMIN ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH;

statement ok con1
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok con1
BEGIN;

statement ok con1
ACL ROLE "r" ALTER TABLE c."Raw Data".mover RENAME TO moved;

# meanwhile the operator declares the old name in another case
statement ok con2
ACL ADMIN CREATE VIRTUAL TABLE c."Raw Data"."MOVER" AS phys.main.u;

statement ok con1
ROLLBACK;

query T
SELECT vname FROM store.acl.relations WHERE vcat = 'c' AND (lower(vname) = 'raw data.mover' OR vname = 'Raw Data.moved') ORDER BY 1;
----
Raw Data.MOVER
Raw Data.moved

query T
ACL ROLE "r" SELECT v FROM c."Raw Data".mover;
----
upper

# the source's mover stays out, reported with a repair that runs
query T
SELECT repair FROM acl_check_catalog('c') WHERE problem = 'case_sibling' AND detail LIKE '%"mover"%';
----
DROP VIRTUAL TABLE c."Raw Data".MOVER; ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH  -- or rename the source object

statement ok
ACL ADMIN DROP VIRTUAL TABLE c."Raw Data".MOVER; ALTER VIRTUAL SCHEMA c."Raw Data" REFRESH;

query I
ACL ROLE "r" SELECT i FROM c."Raw Data".mover;
----
1

# --- the v20 migration: refuses while one name is spelled several ways ---------------------------------

statement ok
ATTACH ':memory:' AS old;

statement ok
SELECT acl_use_db('old', 'acl', true);

query T
SELECT value FROM old.acl.meta WHERE key = 'min_reader_version';
----
20

statement ok
INSERT INTO old.acl.relations(vcat, vname, form, phys) VALUES ('c', 'Orders', 'alias', 'phys.main.u'), ('c', 'orders', 'alias', 'phys.main.u'), ('c', 'S.a', 'alias', 'phys.main.u'), ('c', 's.b', 'alias', 'phys.main.u');

statement ok
UPDATE old.acl.meta SET "value" = '19' WHERE "key" = 'schema_version';

statement ok
UPDATE old.acl.meta SET "value" = '18' WHERE "key" = 'min_reader_version';

statement error
SELECT acl_migrate_catalog('old', 'acl');
----
<REGEX>:.*step v20 failed.*spelled several ways.*name c.Orders / c.orders; name c.S / c.s.*

statement ok
DELETE FROM old.acl.relations WHERE vname IN ('orders', 's.b');

# a catalog, a reference spelled two ways, and a stored name that is no key at all: each refuses
statement ok
INSERT INTO old.acl.catalogs VALUES ('Mart', NULL), ('mart', NULL);

statement ok
INSERT INTO old.acl."references"(vcat, name, from_vname, to_vname) VALUES ('c', 'Link', 'Orders', 'Orders'), ('c', 'link', 'Orders', 'Orders');

statement ok
INSERT INTO old.acl.relations(vcat, vname, form, phys) VALUES ('c', 'a"b', 'alias', 'phys.main.u'), ('c', 'x..y', 'alias', 'phys.main.u');

statement error
SELECT acl_migrate_catalog('old', 'acl');
----
<REGEX>:.*step v20 failed.*catalog Mart / mart.*reference c.Link / c.link.*unreadable name c / a"b.*unreadable name c / x..y.*

statement ok
DELETE FROM old.acl.catalogs WHERE vcat = 'mart';

statement ok
DELETE FROM old.acl."references" WHERE name = 'link';

statement ok
DELETE FROM old.acl.relations WHERE vname IN ('a"b', 'x..y');

query T
SELECT acl_migrate_catalog('old', 'acl');
----
"old"."acl" migrated from schema version 19 to 20 (readable from build 20 on)

query T
SELECT value FROM old.acl.meta WHERE key = 'min_reader_version';
----
20
