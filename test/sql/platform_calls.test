# name: test/sql/platform_calls.test
# description: the platform catalog's management functions (spec 117) - every one at the top level
#   (`SELECT platform.f(…)` / `CALL platform.f(…)`, named and positional arguments, typed ones
#   converted), refused anywhere else (in FROM, a subquery, per row of another selection, in a WHERE, a
#   CTE, a batch beside a query); one admin audit event per call; the grammar and the call give the
#   same result and the same refusal. A parameter where authorization is carried is refused, elsewhere
#   it binds: test/cpp/test_acl_params_passthrough.cpp (sqllogictest has no parameter binding).
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR, amount INTEGER);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme', 10), (2, 'globex', 20);

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
ACL ADMIN CREATE ROLE root;

statement ok
ACL ADMIN CREATE ROLE pol;

statement ok
ACL ADMIN CREATE ROLE cat;

statement ok
ACL ADMIN CREATE ROLE obs;

statement ok
ACL ADMIN GRANT ADMIN passthrough TO ROLE root;

statement ok
ACL ADMIN GRANT ADMIN policy TO ROLE pol;

statement ok
ACL ADMIN GRANT ADMIN observe TO ROLE obs;

# --- every function at the top level, under the policy bundle --------------------------------------------

query T
ACL ROLE "pol" SELECT platform.create_catalog('sales', comment := 'the sales mart');
----
true

query TT
SELECT vcat, comment FROM store.acl.catalogs;
----
sales	the sales mart

query T
ACL ROLE "pol" SELECT platform.main.alter_catalog(catalog := 'sales', comment := 'renamed');
----
true

query T
ACL ROLE "pol" CALL platform.add_relation('sales', 'orders', 'phys.main.orders', columns := ['id', 'tenant', 'amount']);
----
true

query TT
SELECT vname, phys FROM store.acl.relations WHERE vcat = 'sales';
----
orders	phys.main.orders

statement ok
ACL ROLE "pol" SELECT platform.add_view('sales', 'big', 'SELECT 1 AS x', comment := 'a view');

statement ok
ACL ROLE "pol" SELECT platform.add_schema_alias('sales', 'raw', 'phys.main');

statement ok
ACL ROLE "pol" SELECT platform.alter_schema_alias('sales', 'raw', 'phys.main');

statement ok
ACL ROLE "pol" SELECT platform.drop_schema_alias('sales', 'raw');

statement ok
ACL ROLE "pol" SELECT platform.expand_schema('sales', 'lake', 'phys.main');

query I
ACL ROLE "pol" SELECT platform.refresh_schema_objects('sales', 'lake', prune := true);
----
0

statement ok
ACL ROLE "pol" SELECT platform.add_table_function('sales', 'report', 'SELECT id FROM phys.main.orders WHERE amount >= acl_arg(1)', params := 'threshold INTEGER');

statement ok
ACL ROLE "pol" SELECT platform.add_table_function_alias('sales', 'seq', 'range', params := 'n BIGINT', returns := 'range BIGINT', comment := 'a sequence');

statement ok
ACL ROLE "pol" SELECT platform.add_scalar('sales', 'twice', 'acl_arg(1) * 2', params := 'x INTEGER');

statement ok
ACL ROLE "pol" SELECT platform.add_scalar_alias('sales', 'up', 'upper', params := 'x VARCHAR', returns := 'VARCHAR', comment := 'upper');

statement ok
ACL ROLE "pol" SELECT platform.alter_function('sales', 'twice', 'scalar', 'macro', 'acl_arg(1) * 3');

statement ok
ACL ROLE "pol" SELECT platform.drop_function('sales', 'up', 'scalar');

statement ok
ACL ROLE "pol" SELECT platform.alter_relation('sales', 'orders', 'rls', 'amount > 0');

statement ok
ACL ROLE "pol" SELECT platform.comment('sales', 'orders', 'relation', '', 'the orders');

statement ok
ACL ROLE "pol" SELECT platform.comment('sales', 'orders', column_name := 'amount', comment := 'in cents');

query T
SELECT comment FROM store.acl.object_columns WHERE vcat = 'sales' AND vname = 'orders' AND name = 'amount';
----
in cents

statement ok
ACL ROLE "pol" SELECT platform.refresh_schema('sales');

statement ok
ACL ROLE "pol" SELECT platform.set_key('sales', 'orders', 'relation', 'id');

statement ok
ACL ROLE "pol" SELECT platform.add_reference('sales', 'self', 'orders', 'orders', pairs := 'id = id');

statement ok
ACL ROLE "pol" SELECT platform.drop_reference('sales', 'self');

statement ok
ACL ROLE "pol" SELECT platform.rematerialize_schema_caps('sales');

query I
ACL ROLE "pol" SELECT platform.repair_relation('sales', 'orders', 'drop_missing');
----
0

statement ok
ACL ROLE "pol" SELECT platform.create_role('analyst', claims := 'tenant=acme');

statement ok
ACL ROLE "pol" SELECT platform.alter_role('analyst', 'tenant=acme,unit=eu');

query TT
SELECT claim, value FROM store.acl.role_claims WHERE "role" = 'analyst' ORDER BY ALL;
----
tenant	acme
unit	eu

# a typed argument: a capability list is the caps the grant stores, a BOOLEAN its flag
statement ok
ACL ROLE "pol" SELECT platform.grant_catalog('analyst', 'sales', caps := ['select', 'insert'], main := true);

query TT
SELECT caps, is_main FROM store.acl.role_catalogs WHERE "role" = 'analyst';
----
{"select": true, "insert": true}	true

query I
ACL ROLE "analyst" SELECT count(*) FROM orders;
----
2

statement ok
ACL ROLE "pol" SELECT platform.grant_object('analyst', 'sales', 'orders', caps := ['select'], columns := ['id', 'tenant']);

query T
SELECT columns FROM store.acl.role_object_caps WHERE "role" = 'analyst';
----
id, tenant

statement ok
ACL ROLE "pol" SELECT platform.alter_grant('analyst', 'sales', 'main', 'true');

statement ok
ACL ROLE "pol" SELECT platform.grant_schema('analyst', 'sales', 'lake', caps := '{"select": true}');

statement ok
ACL ROLE "pol" SELECT platform.revoke_schema('analyst', 'sales', 'lake');

statement ok
ACL ROLE "pol" SELECT platform.create_catalog('scratch');

statement ok
ACL ROLE "pol" SELECT platform.drop_catalog('scratch', cascade := true);

statement ok
ACL ROLE "pol" SELECT platform.drop_relation('sales', 'big');

statement ok
ACL ROLE "pol" SELECT platform.define_issuer('kc', '{"url": "test/idp/two"}');

statement ok
ACL ROLE "pol" SELECT platform.define_client('door', 'kc', '{"audiences": ["api://acl-test"], "roles_from": ["roles"]}');

statement ok
ACL ROLE "pol" SELECT platform.alter_client('door', '{"azp": ["acl-door"]}');

statement ok
ACL ROLE "pol" SELECT platform.map_role('client', 'door', 'claim-value', 'fin', 'analyst');

statement ok
ACL ROLE "pol" SELECT platform.drop_role_mapping('client', 'door', 'claim-value', 'fin', 'analyst');

statement ok
ACL ROLE "pol" SELECT platform.drop_client('door');

statement ok
ACL ROLE "pol" SELECT platform.alter_issuer('kc', '{"url": "test/idp/two"}');

statement ok
ACL ROLE "pol" SELECT platform.drop_issuer('kc');

statement ok
ACL ROLE "pol" SELECT platform.create_function_category('mine', comment := 'my functions');

statement ok
ACL ROLE "pol" SELECT platform.function_category_add('mine', ['lower', 'upper']);

statement ok
ACL ROLE "pol" SELECT platform.function_category_remove('mine', 'upper');

query T
SELECT list(name ORDER BY name) FROM store.acl.function_category_members WHERE category = 'mine';
----
