query II
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3NoYXBlcyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicjEiLCJyMiJdfQ.LZIn69DGDCUAENLaRnas2hSqkyZRGGgM08M6uROZbqU'
SELECT column_name, count(*) FROM duckdb_columns() WHERE database_name = 'm' GROUP BY 1 ORDER BY 1;
----
id	1
ssn	1
tag	1

query I
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3NoYXBlcyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicjEiLCJyMiJdfQ.LZIn69DGDCUAENLaRnas2hSqkyZRGGgM08M6uROZbqU'
SELECT column_count FROM duckdb_tables() WHERE database_name = 'm';
