# information_schema.columns has 45 columns and they are inherited from the real surface; what this
# pins is that the listing adds none of its own - a 46th `comment` used to ride along
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM information_schema.columns);
----
45

query I
ACL ROLE "analyst" SELECT count(*) FROM (DESCRIBE SELECT * FROM information_schema.columns);
----
45

query I
ACL ROLE "analyst" SELECT count(*) FROM (DESCRIBE SELECT * FROM information_schema.columns)
WHERE lower(column_name) = 'comment';
----
0

# --- what the rows say -----------------------------------------------------------------------------

# duckdb_tables() lists tables, duckdb_views() lists views - not both from one listing
query II
ACL ROLE "analyst" SELECT table_name, column_count FROM duckdb_tables() ORDER BY 1;
----
masked	2
orders	2

query II
ACL ROLE "analyst" SELECT view_name, column_count FROM duckdb_views();
----
recent	1

# the comment is the virtual object's own; the physical one is not the principal's business
query II
ACL ROLE "analyst" SELECT table_name, comment FROM duckdb_tables() ORDER BY 1;
----
masked	NULL
orders	orders a role may read

# --- nothing physical rides along -------------------------------------------------------------------

query I
ACL ROLE "analyst" SELECT count(*) FROM duckdb_tables()
WHERE estimated_size IS NOT NULL OR table_oid IS NOT NULL OR schema_oid IS NOT NULL
   OR database_oid IS NOT NULL OR index_count IS NOT NULL OR check_constraint_count IS NOT NULL
   OR has_primary_key IS NOT NULL OR internal OR temporary;
----
0

query I
ACL ROLE "analyst" SELECT count(*) FROM duckdb_databases()
WHERE path IS NOT NULL OR database_oid IS NOT NULL OR internal OR readonly OR encrypted;
----
0

query I
ACL ROLE "analyst" SELECT count(*) FROM duckdb_schemas()
WHERE oid IS NOT NULL OR database_oid IS NOT NULL OR sql IS NOT NULL OR internal;
----
0

# no DDL names the physical database, and the one whose grant hides `ssn` does not mention it either
# (`masked` legitimately has a column called `ssn` - it is the mask, which the role does read)
query I
ACL ROLE "analyst" SELECT count(*) FROM duckdb_tables()
WHERE sql LIKE '%phys%' OR (table_name = 'orders' AND sql LIKE '%ssn%');
----
0

query I
ACL ROLE "analyst" SELECT database_name FROM duckdb_databases();
----
c

# --- the synthesized DDL describes what the role reads, and binds ------------------------------------

query I
ACL ROLE "analyst" SELECT sql FROM duckdb_tables() WHERE table_name = 'orders';
----
CREATE TABLE "orders"("id" INTEGER, "tenant" VARCHAR);

# it is the same answer DESCRIBE gives: a grant that hides `ssn` hides it from the DDL too
query II
ACL ROLE "analyst" SELECT column_name, column_type FROM (DESCRIBE orders);
----
id	INTEGER
tenant	VARCHAR

query II
ACL ROLE "analyst" SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'orders' ORDER BY column_index;
----
id	INTEGER
tenant	VARCHAR

# a mask that changes a column's type is described by the mask, in every surface alike (spec 026)
query II
ACL ROLE "analyst" SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'masked' ORDER BY column_index;
----
id	INTEGER
ssn	"NULL"

query I
ACL ROLE "analyst" SELECT sql FROM duckdb_tables() WHERE table_name = 'masked';
----
CREATE TABLE "masked"("id" INTEGER, "ssn" "NULL");

# and the DDL a client would apply is a statement duckdb accepts
statement ok
CREATE TABLE phys.main.roundtrip("id" INTEGER, "tenant" VARCHAR);

query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'roundtrip' ORDER BY column_index;
----
id	INTEGER
tenant	VARCHAR

# --- duckdb_columns keeps duckdb's own conventions ----------------------------------------------------

query IIII
ACL ROLE "analyst" SELECT column_name, column_index, is_nullable, is_generated FROM duckdb_columns()
WHERE table_name = 'orders' ORDER BY column_index;
----
id	1	true	false
tenant	2	true	false

# --- a grant's own projection: three answers, one object ----------------------------------------------
# a computed column the object never had (spec 026) has to appear in the columns listing, in the
# synthesized DDL and in DESCRIBE - the whole point of building all three from one listing

statement ok
ACL ADMIN CREATE ROLE auditor;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (select) MAIN;

statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE auditor COLUMNS (id, initial = tenant[1]);

query II
ACL ROLE "auditor" SELECT column_name, data_type FROM duckdb_columns()
WHERE table_name = 'orders' ORDER BY column_index;
----
id	INTEGER
initial	VARCHAR

query II
ACL ROLE "auditor" SELECT sql, column_count FROM duckdb_tables() WHERE table_name = 'orders';
----
CREATE TABLE "orders"("id" INTEGER, "initial" VARCHAR);	2

query II
ACL ROLE "auditor" SELECT column_name, column_type FROM (DESCRIBE orders);
----
id	INTEGER
initial	VARCHAR

# and the role that cannot read `tenant` is not told it exists, in any of the three
query I
ACL ROLE "auditor" SELECT count(*) FROM duckdb_columns() WHERE column_name = 'tenant';
----
0

# --- visibility: a listing describes what a grant allows, and nothing else --------------------------
# the shapes are new, so the filters have to be pinned on them too - a listing that widened what a
# role sees would be the worst possible bug in a surface whose whole job is to describe a catalog

statement ok
CREATE TABLE phys.main.public_t(k INTEGER);

statement ok
CREATE TABLE phys.main.secret_t(k INTEGER, classified VARCHAR);

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG d;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE d.public_t AS phys.main.public_t;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE d.secret_t AS phys.main.secret_t;

statement ok
ACL ADMIN CREATE VIRTUAL VIEW d.shown AS 'SELECT 1 AS n';

statement ok
ACL ADMIN CREATE VIRTUAL VIEW d.unshown AS 'SELECT 1 AS n';

statement ok
ACL ADMIN GRANT CATALOG d TO ROLE analyst WITH (select);

# an explicit nothing on an object is not "no grant stated", it is "no access" (spec 012)
statement ok
ACL ADMIN GRANT OBJECT d.secret_t TO ROLE analyst CAPS '{}';

statement ok
ACL ADMIN GRANT OBJECT d.unshown TO ROLE analyst CAPS '{}';

# a catalog nobody was granted is in no listing at all
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG ungranted;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE ungranted.nothing AS phys.main.secret_t;

query II
ACL ROLE "analyst" SELECT database_name, table_name FROM duckdb_tables()
WHERE database_name <> 'c' ORDER BY 2;
----
d	public_t

query II
ACL ROLE "analyst" SELECT database_name, view_name FROM duckdb_views()
WHERE database_name <> 'c' ORDER BY 2;
----
d	shown

query I
ACL ROLE "analyst" SELECT count(*) FROM duckdb_columns() WHERE table_name IN ('secret_t', 'nothing')
   OR column_name = 'classified';
----
0

query I
ACL ROLE "analyst" SELECT string_agg(database_name, ',' ORDER BY database_name) FROM duckdb_databases();
----
c,d

query I
ACL ROLE "analyst" SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'ungranted';
----
0

# the columns of what it can see are all there, so the filter narrows rather than empties
query II
ACL ROLE "analyst" SELECT table_name, column_name FROM duckdb_columns()
WHERE database_name = 'd' ORDER BY 1, 2;
----
public_t	k
shown	n

# --- competing roles: one row per column, whatever the grants overlap on -------------------------
# a principal may hold several roles, and their column lists may overlap or project the same name at
# different positions. A duplicated row would make `column_count` wrong and the synthesized DDL
# invalid SQL - which is the one thing a client parses.

statement ok
SELECT acl_define_issuer('https://issuer.test/shapes',
    '{"keys":[{"kty":"oct","k":"YWNsLXRlc3QtaHMyNTYtc2VjcmV0"}]}',
    'api://acl-test', 'HS256', 'roles', '');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG m;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE m.orders AS phys.main.orders;

statement ok
ACL ADMIN CREATE ROLE r1;

statement ok
ACL ADMIN CREATE ROLE r2;

statement ok
ACL ADMIN GRANT CATALOG m TO ROLE r1 WITH (select) MAIN;

statement ok
ACL ADMIN GRANT CATALOG m TO ROLE r2 WITH (select) MAIN;

# overlapping plain lists (`id` in both) and the same projection at two different positions
statement ok
ACL ADMIN GRANT OBJECT m.orders TO ROLE r1 COLUMNS (id, tag = tenant);

statement ok
ACL ADMIN GRANT OBJECT m.orders TO ROLE r2 COLUMNS (id, ssn, tag = tenant);

# roles ["r1","r2"]
query II
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3NoYXBlcyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicjEiLCJyMiJdfQ.LZIn69DGDCUAENLaRnas2hSqkyZRGGgM08M6uROZbqU'
SELECT column_name, count(*) FROM duckdb_columns() WHERE database_name = 'm' GROUP BY 1 ORDER BY 1;
----
id	1
ssn	1
tag	1

query I
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3NoYXBlcyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicjEiLCJyMiJdfQ.LZIn69DGDCUAENLaRnas2hSqkyZRGGgM08M6uROZbqU'
SELECT column_count FROM duckdb_tables() WHERE database_name = 'm';
----
3

# --- and when the roles genuinely disagree, the object is unreadable ---------------------------------
# the read path refuses it outright (there is no order on expressions), so the listing must not print
# the column twice either - it stays one row, and reading still refuses

statement ok
ACL ADMIN CREATE ROLE r3;

statement ok
ACL ADMIN GRANT CATALOG m TO ROLE r3 WITH (select) MAIN;

statement ok
ACL ADMIN GRANT OBJECT m.orders TO ROLE r3 COLUMNS (id, tag = upper(tenant));

# roles ["r1","r3"]
query II
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3NoYXBlcyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicjEiLCJyMyJdfQ.kdyFjZ23Jtlnfh6aHtBtR4Y_D7gjpSDcMWPSxYXuorE'
SELECT column_name, count(*) FROM duckdb_columns() WHERE database_name = 'm' GROUP BY 1 ORDER BY 1;
----
id	1
tag	1

statement error
