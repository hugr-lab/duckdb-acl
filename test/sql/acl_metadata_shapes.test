# name: test/sql/acl_metadata_shapes.test
# description: every metadata surface answers in its own standard shape, and says nothing about the
#   physical object behind it (spec 035)
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR, ssn VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme', 'a-secret'), (2, 'globex', 'g-secret');

statement ok
COMMENT ON TABLE phys.main.orders IS 'physical comment, not the principal''s business';

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders COMMENT 'orders a role may read';

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.masked AS phys.main.orders COLUMNS (id, ssn = NULL);

statement ok
ACL ADMIN CREATE VIRTUAL VIEW c.recent AS 'SELECT 1 AS n';

statement ok
ACL ADMIN CREATE ROLE analyst;

# the grant hides `ssn` on the alias form: it must be missing from every surface alike
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN;

statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE analyst COLUMNS (id, tenant);

# --- the defect this spec exists for: the query a quack client runs when it attaches ---------------

query III
ACL ROLE "analyst" SELECT schema_name, sql, 'table' FROM duckdb_tables()
UNION ALL SELECT schema_name, view_name, 'view' FROM duckdb_views() ORDER BY 2;
----
main	CREATE TABLE "masked"("id" INTEGER, "ssn" "NULL");	table
main	CREATE TABLE "orders"("id" INTEGER, "tenant" VARCHAR);	table
main	recent	view

# --- shapes: each surface's own columns, compared with the real one ---------------------------------

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM duckdb_tables());
----
database_name	VARCHAR
database_oid	BIGINT
schema_name	VARCHAR
schema_oid	BIGINT
table_name	VARCHAR
table_oid	BIGINT
comment	VARCHAR
tags	MAP(VARCHAR, VARCHAR)
internal	BOOLEAN
temporary	BOOLEAN
has_primary_key	BOOLEAN
estimated_size	BIGINT
column_count	BIGINT
index_count	BIGINT
check_constraint_count	BIGINT
sql	VARCHAR

