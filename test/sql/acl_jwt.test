# --- the non-JWT dev stub still works ------------------------------------------------------------

statement ok
SELECT acl_define_token('tok-legacy', 'analyst', 'tenant=acme');

query I
ACL TOKEN 'tok-legacy' SELECT count(*) FROM orders;
----
2

# --- the issuer registry lives in the catalog too (spec 006 + 007) -------------------------------

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SELECT acl_grant_table('analyst', 'orders', 'phys.main.orders_physical', 'id,amount', 'tenant = acl_claim(''tenant'')', 'select');

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"], "attributes": {"tid": "tenant"}}}');

query I
SELECT count(*) FROM aclcat.acl.issuers;
----
1

query II
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id, amount FROM orders ORDER BY id;
