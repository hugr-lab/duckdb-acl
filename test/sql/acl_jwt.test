# name: test/sql/acl_jwt.test
# description: offline JWT verification (spec 007) - RS256/ES256/HS256, claim mapping, role mapping,
#   EntraID groups + overage, negatives. Tokens and keys are fixtures from
#   test/scripts/gen_jwt_fixtures.py; regenerate them together with this file.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders_physical(id INT, tenant VARCHAR, amount INT);

statement ok
INSERT INTO phys.main.orders_physical VALUES (1, 'acme', 100), (2, 'globex', 200), (3, 'acme', 300);

statement ok
CREATE TABLE phys.main.audit_physical(id INT, note VARCHAR);

statement ok
INSERT INTO phys.main.audit_physical VALUES (1, 'entry');

statement ok
SET allow_parser_override_extension='fallback';

statement ok
SELECT acl_grant_table('analyst', 'orders', 'phys.main.orders_physical', 'id,amount', 'tenant = acl_claim(''tenant'')', 'select');

statement ok
SELECT acl_grant_table('auditor', 'audit', 'phys.main.audit_physical', 'id,note', '', 'select');

# a JWT from an unregistered issuer is rejected before anything else
statement error
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L2hzIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InU4Iiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.GAd8icsdg891l7-NVJ8bBuz01d2M2nyNU6uGT6FradM' SELECT 1;
----
