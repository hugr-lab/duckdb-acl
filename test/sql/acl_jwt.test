# --- the keys and algorithms are the issuer's discovery's (spec 095) ------------------------------
# test/idp/hs publishes RS256 and ES256 keys: an HS256 token is refused for its algorithm before any
# key is looked at - a shared key is never read from a location, only pasted into a secret
# (test/cpp/test_acl_identity_secrets.cpp)

statement ok
SELECT acl_define_issuer('test/idp/hs', '{"url": "test/idp/hs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"], "attributes": {"tid": "tenant"}}}');

statement error
ACL TOKEN 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ0ZXN0L2lkcC9ocyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1OCIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.o-C5mdFA3rg52wS2iEwdPQlOzeRw7apM0y3sMYLIjt0' SELECT count(*) FROM orders;
----
<REGEX>:.*algorithm "HS256" is not allowed for this issuer.*

# --- EntraID-style groups: GUID -> role mapping, and the overage refusal -------------------------

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["groups"], "attributes": {"tid": "tenant"}}}');

statement ok
SELECT acl_map_role('issuer', 'test/idp/rs', 'group', '9f3a0000-0000-0000-0000-00000000beef', 'analyst');

