# name: test/sql/acl_jwt.test
# description: offline JWT verification (specs 007, 095) - RS256/ES256 keys found by the issuer's
#   discovery, claim mapping, role mapping, EntraID groups + overage, negatives. The issuers are the
#   fixtures under test/idp/ and the tokens are signed with the committed keys
#   (test/scripts/idp_fixtures.py mint); HS256 and pasted keys are test/cpp/test_acl_identity_secrets.cpp.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders_physical(id INT, tenant VARCHAR, amount INT);

statement ok
INSERT INTO phys.main.orders_physical VALUES (1, 'acme', 100), (2, 'globex', 200), (3, 'acme', 300);

statement ok
CREATE TABLE phys.main.audit_physical(id INT, note VARCHAR);

statement ok
INSERT INTO phys.main.audit_physical VALUES (1, 'entry');

statement ok
SET allow_parser_override_extension='fallback';

statement ok
SELECT acl_grant_table('analyst', 'orders', 'phys.main.orders_physical', 'id,amount', 'tenant = acl_claim(''tenant'')', 'select');

statement ok
SELECT acl_grant_table('auditor', 'audit', 'phys.main.audit_physical', 'id,note', '', 'select');

