# a schema grant on the live alias that may only insert: the role does not read the alias's objects (the caps chain
# judged per object)
statement ok
ACL ADMIN CREATE ROLE r_schw;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r_schw WITH (select) MAIN;

statement ok
ACL ADMIN GRANT SCHEMA c.raw TO ROLE r_schw WITH (insert);

