# two catalogs: the one where a role reads and another may only write is narrowed, the other is left as it is
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG d;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA d.raw AS phys.main;

statement ok
ACL ADMIN CREATE ROLE r_d;

statement ok
ACL ADMIN GRANT CATALOG d TO ROLE r_d WITH (select) COLUMNS (id, note);

query TT
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1OCIsInJvbGVzIjpbInJfY2F0Iiwicl93cml0ZXIiLCJyX2QiXX0.A-YeoKBQAiKaEi43SXOmHxHIcggwQWk34yNkgKcENcXnQtlkYSzlFlnweeinJYpeG07lNFmoco0ug9IIQBrLGQyeB4TyrHPydj5WWIBtBiPhxHGFR6Z3E9dWNr7dFSFtK-O3nFHDAriCa6daedJcvWTZRmj3ynEX132f8QNtwfvI9Naf6NWbex7_LjTsbQPX9nhFdQiT_oNa_QoYVUBiWFdVxgGVZY8MocjXy-3j49QcFibWwjaD6ksRYt8O2AU-i65k698d6VbogHHQZiZ0Cvyx4EPxQokYiq6aJo1UT_mMN9xRMpqZHkaTLWV-_tJXvso5msED8FO5hXj_9Erjcg' SELECT table_catalog, list(column_name ORDER BY ordinal_position) FROM information_schema.columns WHERE table_schema = 'raw' AND table_name = 'orders' GROUP BY 1 ORDER BY 1;
