# a write-only principal's list: an explicit '{}' beside it lifts nothing - as on a relation
statement ok
ACL ADMIN CREATE ROLE r_insl;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r_insl WITH (insert) MAIN COLUMNS (id);

statement ok
ACL ADMIN CREATE ROLE r_none;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r_none WITH () MAIN;

