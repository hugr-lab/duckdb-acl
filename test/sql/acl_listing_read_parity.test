ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1NCIsInJvbGVzIjpbInJfY2F0Iiwicl93cml0ZXIiXX0.CB5P6hikcIWw-jJz8wRfYATpZkNCF8KHllQ16PwvDvookXcZz9XFg4Fel8N9eEidE8zHoMvDm3_1vkoACbg-P-dfyrD_rudu_m0VBQpXZokzxj2GUDfqMDNbzis9O5i20heCKfKhKunH_iuXT8L2-fFUiyeDK3q4UkiBlG9SMsTKFnnO4IOUCVwD2uaSi6I5ae5rcVNPlGDqTXvmJ8JAXU3bY5T0NudSPDrWSTqocVs7gGSrcrf0JE7Ot1M3yVTdlVj1dMzWVKmBH_z1lWklBfIIoMaTelAq91r2l4tFsQgt67uocCTm9w-OiSlh72GVmkteVQOj-xCW-jIdf7UfxQ' SELECT list(column_name ORDER BY ordinal_position) FROM information_schema.columns WHERE table_schema = 'raw' AND table_name = 'orders';
