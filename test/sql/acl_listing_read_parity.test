# a write-only principal sees the columns it may write: every role's levels, as the columns surface reads them
query T
ACL ROLE 'r_writer' SELECT list(column_name ORDER BY ordinal_position) FROM information_schema.columns WHERE table_schema = 'raw' AND table_name = 'orders';
----
[id, amount, note, addr]

# ... and where an object grant states the caps (insert only on the alias's object, the catalog grant reading
# everything), the object's caps chain decides: the role does not read that object - r_cat's list is what is listed
statement ok
ACL ADMIN CREATE ROLE r_objw;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r_objw WITH (select) MAIN;

statement ok
ACL ADMIN GRANT TABLE c.raw.orders TO ROLE r_objw WITH (insert);

query II
