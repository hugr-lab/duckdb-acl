# name: test/sql/cluster/platform_rights_cluster.test
# description: the platform part's rights (spec 118 / 126): the cluster bundle's functions are never granted by
#   name, and passthrough implies the cluster bundle where the platform part is linked (moved from
#   platform_rights.test, which runs on an open node too)
# group: [cluster]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE ROLE helper;

statement ok
ACL ADMIN CREATE ROLE root;

statement ok
ACL ADMIN GRANT ADMIN passthrough TO ROLE root;

statement error
ACL ADMIN GRANT FUNCTION platform.cluster_setting TO ROLE helper;
----
<REGEX>:.*platform.cluster_setting is the cluster bundle's alone.*

query T
ACL ROLE "root" SELECT bundles FROM platform.console_info();
----
[observe, operate, cluster, passthrough]
