# name: test/sql/cluster/platform_views_cluster.test
# description: spec 117 / 118 for the platform part: the cluster profile's views - typed like every platform
#   view, read by passthrough, refused to the policy bundle (moved from platform_views.test, which runs on an
#   open node too)
# group: [cluster]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_deployment = 'cluster';

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE ROLE root;

statement ok
ACL ADMIN GRANT ADMIN passthrough TO ROLE root;

statement ok
ACL ADMIN CREATE ROLE pol;

statement ok
ACL ADMIN GRANT ADMIN policy TO ROLE pol;

# the platform part's views: 22 columns, each the column the view answers
query I
ACL ROLE "root" SELECT count(*) FROM information_schema.columns WHERE table_catalog = 'platform' AND table_schema = 'main' AND table_name IN ('cluster_items', 'cluster_effective', 'drift');
----
22

foreach view cluster_items cluster_effective drift

query I
ACL ROLE "root" SELECT (SELECT list(column_name || ' ' || data_type ORDER BY ordinal_position) FROM information_schema.columns WHERE table_catalog = 'platform' AND table_schema = 'main' AND table_name = '{view}') = (SELECT list(column_name || ' ' || column_type) FROM (DESCRIBE platform.{view}));
----
true

endloop

statement ok
ACL ADMIN CLUSTER SET threads = 2;

query TTTT
ACL ROLE "root" SELECT kind, name, spec['value'], typeof(spec) FROM platform.cluster_items;
----
setting	threads	2	MAP(VARCHAR, VARCHAR)

query TTT
ACL ROLE "root" SELECT kind, name, spec['value'] FROM platform.cluster_effective;
----
setting	threads	2

statement ok
ACL ADMIN CLUSTER RESET threads;

statement error
ACL ROLE "pol" SELECT * FROM platform.cluster_items;
----
<REGEX>:.*no access to object "platform.cluster_items".*

statement error
ACL ROLE "pol" SELECT * FROM platform.cluster_effective;
----
<REGEX>:.*no access to object "platform.cluster_effective".*

