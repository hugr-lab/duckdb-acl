# name: test/sql/cluster/acl_created_by_cluster.test
# description: spec 120.5 for the platform part's bundle: the cluster bundle is source-gated too, and its
#   definitions carry its roles (moved from acl_created_by.test, which runs on an open node too)
# group: [cluster]

require acl

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.t AS SELECT 1 AS id, 'acme' AS tenant;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

# the cluster bundle is source-gated too: its definitions carry its roles
statement ok
ACL ADMIN CREATE ROLE clu;

statement ok
ACL ADMIN GRANT ADMIN cluster TO ROLE clu;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE clu CAPS '{"manage": true}';

statement ok
ACL ADMIN GRANT SOURCE phys.main TO ROLE clu;

statement ok
ACL ROLE "clu" CREATE VIRTUAL TABLE c.by_clu AS phys.main.t;

query T
SELECT created_roles FROM store.acl.relations WHERE vname = 'by_clu';
----
clu

