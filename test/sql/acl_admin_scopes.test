statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3JzIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUxIiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.KmSqaoUsXoRtQrf9ca6zy3JpBQk2FoB_3eC2crZkekfKaJBx64k6CZsP30AM2KSKkTwkS0cV940DGfmRWZVtIqzfC53oARGLaIlUQzG3b-H_Bp3XFsE_3ypDnqQJkFx2DljqWXqRHPRwZFIE4Im96SSHaF-PRxxuRywZKTcv4uWSzsEsfLOT9bY4iozdblSMQdAvu6jmYYPbv2eRsWbHCLNa4SjwoONSBm4oU3UMjobW_pMqZVVFHgEdr8ErNa4tYBB6oMDHge6bYHAXh-2A3nxPAv3Bj1APMMRPl1mHMjHUsgcscl6Ch0oeglgmagi7i8kQ_be0KZ_vCS0RBFifBA' ACL CREATE ROLE from_token;
----
<REGEX>:.*no ACL administration scope.*

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE analyst CAPS '{"select": true, "manage": true}' MAIN;

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3JzIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUxIiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.KmSqaoUsXoRtQrf9ca6zy3JpBQk2FoB_3eC2crZkekfKaJBx64k6CZsP30AM2KSKkTwkS0cV940DGfmRWZVtIqzfC53oARGLaIlUQzG3b-H_Bp3XFsE_3ypDnqQJkFx2DljqWXqRHPRwZFIE4Im96SSHaF-PRxxuRywZKTcv4uWSzsEsfLOT9bY4iozdblSMQdAvu6jmYYPbv2eRsWbHCLNa4SjwoONSBm4oU3UMjobW_pMqZVVFHgEdr8ErNa4tYBB6oMDHge6bYHAXh-2A3nxPAv3Bj1APMMRPl1mHMjHUsgcscl6Ch0oeglgmagi7i8kQ_be0KZ_vCS0RBFifBA' ACL ADD TABLE phys.main.orders_physical AS sales.from_token;

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3JzIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjQxMDI0NDQ4MDAsInN1YiI6InUxIiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.KmSqaoUsXoRtQrf9ca6zy3JpBQk2FoB_3eC2crZkekfKaJBx64k6CZsP30AM2KSKkTwkS0cV940DGfmRWZVtIqzfC53oARGLaIlUQzG3b-H_Bp3XFsE_3ypDnqQJkFx2DljqWXqRHPRwZFIE4Im96SSHaF-PRxxuRywZKTcv4uWSzsEsfLOT9bY4iozdblSMQdAvu6jmYYPbv2eRsWbHCLNa4SjwoONSBm4oU3UMjobW_pMqZVVFHgEdr8ErNa4tYBB6oMDHge6bYHAXh-2A3nxPAv3Bj1APMMRPl1mHMjHUsgcscl6Ch0oeglgmagi7i8kQ_be0KZ_vCS0RBFifBA' ACL ADD TABLE phys.main.orders_physical AS hr.from_token;
----
<REGEX>:.*no manage scope for catalog "hr".*

# an invalid token is refused before any scope question
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJodHRwczovL2lzc3Vlci50ZXN0L3JzIiwiYXVkIjoiYXBpOi8vYWNsLXRlc3QiLCJleHAiOjk0NjY4NDgwMCwic3ViIjoidTUiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.d7QJzBvajOOZ4lrYQuLTFOoIdxTA2FU5laRThD0Kv3Hs4QEsDPRf00GiRsaORa9VQbyBefth45hhWpA8RSCLDX9CRFzVxxOO1ErQ84efuaXd-gvKTvqy9oa17vcL4FzUeYHH2-QbMEQZlXVfZQzvtMeR3WEwkZUJO-yhUYjofZB10aB7eWNg3G7jH0mOL6ZPP4UvOkYorJLiIiYZpt3oLWeUr31_b1e7mx6nhOfOEUPxgam4BAoG90lEIoIFzzPKuAlEYwWbURWJm_DhaS6fd6noCtH4SVqDMZHe8qKk3CRWTLc5WhopwLox754NTD7c6HMZ2N_HRzJB68f3Sk9IuQ' ACL CREATE ROLE nope;
----
<REGEX>:.*token expired.*

# --- ordinary queries are never mistaken for administration --------------------------------------

# a plain query keeps its virtual-catalog context even for a passthrough principal
statement ok
SELECT acl_grant_catalog('platform', 'sales', '{"select": true}', true);

query I
ACL ROLE "platform" SELECT count(*) FROM orders;
----
4

# the marker is the client's request, not a privilege: without a scope it is refused ('auditor' had
# its scope revoked above), and a manage scope still cannot leave the virtual catalog
statement error
ACL ROLE "auditor" ACL NATIVE SELECT 1;
----
<REGEX>:.*no ACL administration scope.*

statement error
ACL ROLE "analyst" ACL NATIVE SELECT 1;
----
<REGEX>:.*requires a passthrough scope.*

# and a physical name outside the catalog stays refused in the query context
statement error
ACL ROLE "platform" SELECT * FROM phys.main.orders_physical;
----
<REGEX>:.*no access to object.*

# --- a nested ACL prefix is text, never a second entry --------------------------------------------
# exactly one prefix is stripped (spec 001): the inner parse runs with the override disabled, so an
# `ACL ...` inside the remainder reaches duckdb's own parser and fails there - it cannot re-enter

statement error
ACL ROLE "platform" ACL NATIVE ACL ADMIN CREATE VIRTUAL CATALOG nested;
----
<REGEX>:.*(syntax|Parser).*

statement error
ACL ROLE "platform" ACL NATIVE ACL ROLE "analyst" SELECT 1;
----
<REGEX>:.*(syntax|Parser).*

query I
SELECT count(*) FROM aclcat.acl.catalogs WHERE vcat = 'nested';
----
0

# a doubled marker is not a marker either: the management parser sees "ACL" as a statement keyword
statement error
ACL ROLE "platform" ACL ACL NATIVE SELECT 1;
----
<REGEX>:.*unknown management statement "ACL".*

# and a manage scope is stopped by the scope check before any of that matters
statement error
ACL ROLE "sales_owner" ACL NATIVE ACL ADMIN CREATE VIRTUAL CATALOG nested2;
----
<REGEX>:.*requires a passthrough scope.*

# --- multi-statement batches ----------------------------------------------------------------------
# one prefix (and therefore one mode and one principal) covers the whole batch; management batches
# are authorized statement by statement AT PARSE TIME, so a refusal executes nothing at all

statement ok
ACL ROLE "platform" ACL CREATE VIRTUAL CATALOG batch; ADD TABLE phys.main.orders_physical AS batch.orders; GRANT CATALOG batch TO ROLE analyst CAPS '{"select": true}';

query I
ACL ROLE "analyst" SELECT count(*) FROM batch.orders;
----
4

# a batch that ends outside the granted catalog is refused whole - the first statement does not land
statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.batch_ok; ADD TABLE phys.main.orders_physical AS hr.batch_bad;
----
<REGEX>:.*no manage scope for catalog "hr".*

statement error
ACL ROLE "analyst" SELECT count(*) FROM sales.batch_ok;
----
<REGEX>:.*no access to object.*

# the same for an escalation hidden at the end of a batch
statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.batch_ok2; GRANT ADMIN passthrough TO ROLE sales_owner;
----
<REGEX>:.*requires a passthrough scope.*

statement error
ACL ROLE "analyst" SELECT count(*) FROM sales.batch_ok2;
----
<REGEX>:.*no access to object.*

# a management batch cannot smuggle plain SQL, and a native batch cannot smuggle management
statement error
ACL ROLE "platform" ACL CREATE ROLE mixed_a; SELECT 1;
----
<REGEX>:.*unknown management statement.*

statement error
ACL ROLE "platform" ACL NATIVE SELECT 1; CREATE ROLE mixed_b;
----
<REGEX>:.*(syntax|Parser).*

# the marker is read once, right after the prefix: a later `ACL NATIVE` is just text and fails to parse
statement error
ACL ROLE "analyst" SELECT 1; ACL NATIVE DROP TABLE phys.main.orders_physical;
----
<REGEX>:.*(syntax|Parser).*

query I
ACL ADMIN SELECT count(*) FROM phys.main.orders_physical;
----
4

# authorization is atomic, EXECUTION is not: a batch that passes the scope check but fails at
# runtime leaves the statements before the failure applied - plain SQL batch semantics
statement error
ACL ROLE "platform" ACL ADD TABLE phys.main.orders_physical AS batch.applied; ALTER VIRTUAL TABLE batch.nothere SET RLS 'true';
----
<REGEX>:.*relation "batch.nothere" does not exist.*

query I
ACL ROLE "analyst" SELECT count(*) FROM batch.applied;
----
4

# a native batch under a passthrough principal runs as ordinary SQL, all statements
statement ok
ACL ROLE "platform" ACL NATIVE CREATE TABLE phys.main.batch_native(x INT); INSERT INTO phys.main.batch_native VALUES (1), (2);

query I
ACL ADMIN SELECT count(*) FROM phys.main.batch_native;
----
2

# --- closing the anonymous hatch again ------------------------------------------------------------

statement ok
SET GLOBAL acl_allow_anonymous_admin=false;

statement error
ACL ADMIN CREATE ROLE after_close;
----
<REGEX>:.*bare ACL ADMIN is disabled.*

# the granted principals still administer
statement ok
ACL ROLE "platform" ACL CREATE ROLE after_close;
