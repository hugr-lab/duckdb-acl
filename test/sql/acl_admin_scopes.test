# name: test/sql/acl_admin_scopes.test
# description: ACL administration scopes (spec 009) - god mode by grant, not by connection: the
#   anonymous ACL ADMIN hatch is opt-in with a policy source, and a verified principal administers
#   the ACL only with a granted scope (manage, optionally per catalog, or passthrough).
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders_physical(id INT, tenant VARCHAR, amount INT);

statement ok
INSERT INTO phys.main.orders_physical VALUES (1, 'acme', 100), (2, 'globex', 200), (3, 'acme', 300);

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SET allow_parser_override_extension='fallback';

# --- in the in-memory dev mode the bare hatch keeps working -------------------------------------

statement ok
ACL ADMIN SELECT 1;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

# --- with a policy source it is closed until deliberately opened --------------------------------

statement error
ACL ADMIN SELECT 1;
----
<REGEX>:.*bare ACL ADMIN is disabled.*

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN SELECT 1;

# the gateway (still anonymous here) bootstraps the first administrators and a catalog
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG sales;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG hr;

statement ok
ACL ADMIN CREATE ROLE analyst CLAIMS 'tenant=acme';

statement ok
ACL ADMIN ADD TABLE phys.main.orders_physical AS sales.orders COLUMNS 'id,amount' RLS 'tenant = acl_claim(''tenant'')';

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE analyst CAPS '{"select": true}' MAIN;

statement ok
SELECT acl_grant_admin('platform', 'passthrough');

# managing one catalog is a capability of the catalog grant, so a role can manage several catalogs
# (and manage one without being able to read it)
statement ok
SELECT acl_grant_catalog('sales_owner', 'sales', '{"manage": true}', false);

# --- a principal without a scope cannot administer ----------------------------------------------

statement error
ACL ROLE "analyst" ACL NATIVE SELECT 1;
----
<REGEX>:.*no ACL administration scope.*

# ... while plain queries under the same role keep working
query II
ACL ROLE "analyst" SELECT id, amount FROM orders ORDER BY id;
----
1	100
3	300

# --- manage scope: the management grammar, restricted to its catalog -----------------------------

statement ok
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.all_orders;

statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS hr.people;
----
<REGEX>:.*no manage scope for catalog "hr".*

# not catalog-specific -> needs an unrestricted manage scope
statement error
ACL ROLE "sales_owner" ACL CREATE ROLE intruder;
----
<REGEX>:.*not catalog-specific.*

# a manage scope is the grammar, not arbitrary SQL
statement error
ACL ROLE "sales_owner" ACL NATIVE SELECT 1;
----
<REGEX>:.*requires a passthrough scope.*

statement error
ACL ROLE "sales_owner" ACL NATIVE CREATE TABLE phys.main.sneak(x INT);
----
<REGEX>:.*requires a passthrough scope.*

# and it can never hand out scopes (no privilege escalation)
statement error
ACL ROLE "sales_owner" ACL GRANT ADMIN passthrough TO ROLE sales_owner;
----
<REGEX>:.*requires a passthrough scope.*

# a second managed catalog for the same role - impossible while the scope lived in one admins row
statement ok
SELECT acl_grant_catalog('sales_owner', 'hr', '{"manage": true}', false);

statement ok
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS hr.owned_too;

statement ok
SELECT acl_revoke_catalog('sales_owner', 'hr');

statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS hr.owned_again;
----
<REGEX>:.*no manage scope for catalog "hr".*

# managing a catalog does not imply reading it
statement error
ACL ROLE "sales_owner" SELECT * FROM sales.orders;
----
<REGEX>:.*select on "sales.orders" is not allowed.*

# --- passthrough scope: god mode by grant --------------------------------------------------------

statement ok
ACL ROLE "platform" ACL CREATE ROLE auditor;

statement ok
ACL ROLE "platform" ACL ADD TABLE phys.main.orders_physical AS hr.people;

query I
ACL ROLE "platform" ACL NATIVE SELECT count(*) FROM phys.main.orders_physical;
----
3

statement ok
ACL ROLE "platform" ACL GRANT ADMIN manage TO ROLE auditor;

# an unrestricted manage scope may touch any catalog, but still only the grammar
statement ok
ACL ROLE "auditor" ACL CREATE ROLE analyst2;

statement ok
ACL ROLE "auditor" ACL ADD TABLE phys.main.orders_physical AS hr.headcount;

statement error
ACL ROLE "auditor" ACL NATIVE SELECT 1;
----
<REGEX>:.*requires a passthrough scope.*

# --- scopes through the grammar, and revocation ---------------------------------------------------

statement ok
ACL ROLE "platform" ACL REVOKE ADMIN FROM ROLE auditor;

statement error
ACL ROLE "auditor" ACL CREATE ROLE analyst3;
----
<REGEX>:.*no ACL administration scope.*

query I
SELECT count(*) FROM aclcat.acl.admins WHERE role = 'platform' AND scope = 'passthrough';
----
1

# --- the external door: the CLIENT writes the marker ---------------------------------------------
# the gateway only prepends the principal, so a client asking for anything beyond an ordinary query
# says so itself: `ACL <mgmt>` to manage the ACL, `ACL NATIVE <sql>` to leave the virtual catalog

statement ok
ACL ROLE "platform" ACL CREATE ROLE via_external_door;

statement ok
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.via_door;

statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS hr.via_door;
----
<REGEX>:.*no manage scope for catalog "hr".*

statement error
ACL ROLE "analyst" ACL CREATE ROLE sneaky;
----
<REGEX>:.*no ACL administration scope.*

# --- ALTER: partial change of an existing object -------------------------------------------------

statement ok
ACL ADMIN ALTER VIRTUAL TABLE sales.orders SET COLUMNS 'id,amount,tenant';

query III
ACL ROLE "analyst" SELECT id, amount, tenant FROM orders ORDER BY id;
----
1	100	acme
3	300	acme

# the RLS survived the column change; now relax it and the masking too
statement ok
ACL ADMIN ALTER VIRTUAL TABLE sales.orders SET RLS 'true';

query I
ACL ROLE "analyst" SELECT count(*) FROM orders;
----
3

statement ok
ACL ADMIN ALTER VIRTUAL CATALOG sales SET COMMENT 'renamed namespace';

statement ok
ACL ADMIN ALTER ROLE analyst SET CLAIMS 'tenant=globex';

statement ok
ACL ADMIN ALTER GRANT CATALOG sales TO ROLE analyst SET CAPS '{"select": true, "insert": true}';

statement ok
ACL ROLE "analyst" INSERT INTO all_orders VALUES (4, 'globex', 400);

# altering something that does not exist is an error (unlike ADD, which upserts)
statement error
ACL ADMIN ALTER VIRTUAL TABLE sales.nothere SET RLS 'true';
----
<REGEX>:.*relation "sales.nothere" does not exist.*

statement error
ACL ADMIN ALTER ROLE nobody SET CLAIMS 'x=1';
----
<REGEX>:.*role "nobody" does not exist.*

# a catalog-scoped manage may ALTER inside its catalog only
statement ok
ACL ROLE "sales_owner" ACL ALTER VIRTUAL TABLE sales.via_door SET RLS 'true';

statement error
ACL ROLE "sales_owner" ACL ALTER VIRTUAL TABLE hr.people SET RLS 'true';
----
<REGEX>:.*no manage scope for catalog "hr".*

# duckdb's own ALTER TABLE still passes through untouched
statement ok
ACL ADMIN CREATE TABLE phys.main.alterable(x INT);

statement ok
ACL ADMIN ALTER TABLE phys.main.alterable RENAME TO altered;

query I
ACL ADMIN SELECT count(*) FROM phys.main.altered;
----
0

# --- the same door for a JWT principal (quack/ADBC clients) --------------------------------------

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"], "attributes": {"tid": "tenant"}}}');

# the token's role is 'analyst' - no scope, so administering is refused
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' ACL CREATE ROLE from_token;
----
<REGEX>:.*no ACL administration scope.*

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE analyst CAPS '{"select": true, "manage": true}' MAIN;

# spec 095: a role that holds an administration scope is reached only through an explicit mapping of
# the client itself - not as an unmapped value of the same name, which is how the short form's
# client reaches every other role
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' ACL ADD TABLE phys.main.orders_physical AS sales.from_token;
----
<REGEX>:.*no recognized roles.*

statement ok
ACL ADMIN MAP CLAIM 'analyst' FROM CLIENT 'test/idp/rs' TO ROLE analyst;

statement ok
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' ACL ADD TABLE phys.main.orders_physical AS sales.from_token;

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' ACL ADD TABLE phys.main.orders_physical AS hr.from_token;
----
<REGEX>:.*no manage scope for catalog "hr".*

# an invalid token is refused before any scope question
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo5NDY2ODQ4MDAsInN1YiI6InU1Iiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.im4m1r-aCD0ez96m6at8Yz1y-AgP_5hFvh1NqEtI76S8AAFuR_FJjxmHiCUtrbH0Q_7hR8-CRqaegdvEu_iET9Dq2RR00o5ITEOuPELgWJTpAKuX-8Tu2MF8OANh_agU9_Ap3gbDU13A4mYTI0Pa3QOHIkBd26Kg00ECHbE8Gceo3fWvUNIKK9pPivW-4lIhIjrpH7ETgJY2iEM0uSiCXbKa86Pnls4d8KHvQS8F4cxboVDgPRjBNHroWDwP1FJQk4OMuZSet59LvUGhXAsrDG4xMz0Fw8riPskOYqoA4WrU9QC78IRH_O6SQBGasMXKu5ok3RdHBC_45Cf8TpeceQ' ACL CREATE ROLE nope;
----
<REGEX>:.*token expired.*

# --- ordinary queries are never mistaken for administration --------------------------------------

# a plain query keeps its virtual-catalog context even for a passthrough principal
statement ok
SELECT acl_grant_catalog('platform', 'sales', '{"select": true}', true);

query I
ACL ROLE "platform" SELECT count(*) FROM orders;
----
4

# the marker is the client's request, not a privilege: without a scope it is refused ('auditor' had
# its scope revoked above), and a manage scope still cannot leave the virtual catalog
statement error
ACL ROLE "auditor" ACL NATIVE SELECT 1;
----
<REGEX>:.*no ACL administration scope.*

statement error
ACL ROLE "analyst" ACL NATIVE SELECT 1;
----
<REGEX>:.*requires a passthrough scope.*

# and a physical name outside the catalog stays refused in the query context
statement error
ACL ROLE "platform" SELECT * FROM phys.main.orders_physical;
----
<REGEX>:.*no access to object.*

# --- a nested ACL prefix is text, never a second entry --------------------------------------------
# exactly one prefix is stripped (spec 001): the inner parse runs with the override disabled, so an
# `ACL ...` inside the remainder reaches duckdb's own parser and fails there - it cannot re-enter

statement error
ACL ROLE "platform" ACL NATIVE ACL ADMIN CREATE VIRTUAL CATALOG nested;
----
<REGEX>:.*(syntax|Parser).*

statement error
ACL ROLE "platform" ACL NATIVE ACL ROLE "analyst" SELECT 1;
----
<REGEX>:.*(syntax|Parser).*

query I
SELECT count(*) FROM aclcat.acl.catalogs WHERE vcat = 'nested';
----
0

# a doubled marker is not a marker either: the management parser sees "ACL" as a statement keyword
statement error
ACL ROLE "platform" ACL ACL NATIVE SELECT 1;
----
<REGEX>:.*unknown management statement "ACL".*

# and a manage scope is stopped by the scope check before any of that matters
statement error
ACL ROLE "sales_owner" ACL NATIVE ACL ADMIN CREATE VIRTUAL CATALOG nested2;
----
<REGEX>:.*requires a passthrough scope.*

# --- multi-statement batches ----------------------------------------------------------------------
# one prefix (and therefore one mode and one principal) covers the whole batch; management batches
# are authorized statement by statement AT PARSE TIME, so a refusal executes nothing at all

statement ok
ACL ROLE "platform" ACL CREATE VIRTUAL CATALOG batch; ADD TABLE phys.main.orders_physical AS batch.orders; GRANT CATALOG batch TO ROLE analyst CAPS '{"select": true}';

query I
ACL ROLE "analyst" SELECT count(*) FROM batch.orders;
----
4

# a batch that ends outside the granted catalog is refused whole - the first statement does not land
statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.batch_ok; ADD TABLE phys.main.orders_physical AS hr.batch_bad;
----
<REGEX>:.*no manage scope for catalog "hr".*

statement error
ACL ROLE "analyst" SELECT count(*) FROM sales.batch_ok;
----
<REGEX>:.*no access to object.*

# the same for an escalation hidden at the end of a batch
statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.batch_ok2; GRANT ADMIN passthrough TO ROLE sales_owner;
----
<REGEX>:.*requires a passthrough scope.*

statement error
ACL ROLE "analyst" SELECT count(*) FROM sales.batch_ok2;
----
<REGEX>:.*no access to object.*

# a management batch cannot smuggle plain SQL, and a native batch cannot smuggle management
statement error
ACL ROLE "platform" ACL CREATE ROLE mixed_a; SELECT 1;
----
<REGEX>:.*a batch mixing management statements and queries is refused.*

statement error
ACL ROLE "platform" ACL NATIVE SELECT 1; CREATE ROLE mixed_b;
----
<REGEX>:.*(syntax|Parser).*

# the marker is read once, right after the prefix: a later `ACL NATIVE` is just text and fails to parse
statement error
ACL ROLE "analyst" SELECT 1; ACL NATIVE DROP TABLE phys.main.orders_physical;
----
<REGEX>:.*(syntax|Parser).*

query I
ACL ADMIN SELECT count(*) FROM phys.main.orders_physical;
----
4

# authorization is atomic, EXECUTION is not: a batch that passes the scope check but fails at
# runtime leaves the statements before the failure applied - plain SQL batch semantics
statement error
ACL ROLE "platform" ACL ADD TABLE phys.main.orders_physical AS batch.applied; ALTER VIRTUAL TABLE batch.nothere SET RLS 'true';
----
<REGEX>:.*relation "batch.nothere" does not exist.*

query I
ACL ROLE "analyst" SELECT count(*) FROM batch.applied;
----
4

# a native batch under a passthrough principal runs as ordinary SQL, all statements
statement ok
ACL ROLE "platform" ACL NATIVE CREATE TABLE phys.main.batch_native(x INT); INSERT INTO phys.main.batch_native VALUES (1), (2);

query I
ACL ADMIN SELECT count(*) FROM phys.main.batch_native;
----
2

# --- regressions found by the PR review -----------------------------------------------------------

# 1. the extension's own functions are never callable from a principal's query - otherwise one
#    statement grants itself god mode
statement error
ACL ROLE "analyst" SELECT acl_grant_admin('analyst', 'passthrough');
----
<REGEX>:.*acl_grant_admin.*not allowed.*

statement error
ACL ROLE "analyst" SELECT acl_grant_table('analyst', 'x', 'phys.main.orders_physical', '', '', 'select');
----
<REGEX>:.*acl_grant_table.*not allowed.*

statement error
ACL ROLE "platform" SELECT acl_use_db('aclcat');
----
<REGEX>:.*acl_use_db.*not allowed.*

# ... but they still work in the native context
query I
ACL ADMIN SELECT acl_grant_admin('platform', 'passthrough');
----
true

# 2. managing a catalog does not include handing it out (no self-grant of read)
statement error
ACL ROLE "sales_owner" ACL GRANT CATALOG sales TO ROLE sales_owner CAPS '{"select": true, "manage": true}';
----
<REGEX>:.*granting access to a catalog requires an unrestricted manage scope.*

statement error
ACL ROLE "sales_owner" ACL ALTER GRANT CATALOG sales TO ROLE sales_owner SET CAPS '{"select": true}';
----
<REGEX>:.*requires an unrestricted manage scope.*

# 3. a catalog-scoped row in acl.admins stays catalog-scoped (it must not widen to global)
statement ok
ACL ADMIN CREATE ROLE scoped;

statement ok
ACL ADMIN INSERT INTO aclcat.acl.admins VALUES ('scoped', 'manage', 'sales');

statement ok
ACL ROLE "scoped" ACL ADD TABLE phys.main.orders_physical AS sales.scoped_ok;

statement error
ACL ROLE "scoped" ACL ADD TABLE phys.main.orders_physical AS hr.scoped_leak;
----
<REGEX>:.*no manage scope for catalog "hr".*

statement error
ACL ROLE "scoped" ACL CREATE ROLE scoped_role;
----
<REGEX>:.*not catalog-specific.*

# 4. an empty catalog name is not a catalog and never means "all of them"
statement error
ACL ADMIN GRANT CATALOG '' TO ROLE scoped CAPS '{"manage": true}';
----
<REGEX>:.*(expected a catalog name|needs a catalog name).*

# 5. catalog names compare case-insensitively, as duckdb's catalog does (spec 116): "Sales" is the
# catalog sales - declaring it again is refused, a grant on "SALES" lands on sales, and manage on it is
# manage on sales, never on a second catalog
statement error
ACL ADMIN CREATE VIRTUAL CATALOG Sales;
----
<REGEX>:.*catalog "Sales" differs only by case from the existing "sales".*

statement ok
ACL ADMIN CREATE ROLE caseowner;

statement ok
SELECT acl_grant_catalog('caseowner', 'SALES', '{"manage": true}', false);

query T
SELECT vcat FROM aclcat.acl.role_catalogs WHERE role = 'caseowner';
----
sales

statement ok
ACL ROLE "caseowner" ACL ADD TABLE phys.main.orders_physical AS SALES.injected;

query T
SELECT vcat || '.' || vname FROM aclcat.acl.relations WHERE vname = 'injected';
----
sales.injected

statement error
ACL ROLE "caseowner" ACL ADD TABLE phys.main.orders_physical AS hr.injected;
----
<REGEX>:.*no manage scope for catalog "hr".*

# 6. ALTER cannot silently change an object's kind (which would drop its RLS and projection)
statement error
ACL ADMIN ALTER VIRTUAL VIEW sales.orders SET AS 'SELECT * FROM phys.main.orders_physical';
----
<REGEX>:.*is a table - use ALTER VIRTUAL TABLE.*

# 7. SET MAIN takes true/false, not anything that is not "true"
statement error
ACL ADMIN ALTER GRANT CATALOG sales TO ROLE analyst SET MAIN 1;
----
<REGEX>:.*MAIN expects true or false.*

# 9. revoking administration removes the per-catalog manage capability as well
statement ok
ACL ADMIN REVOKE ADMIN FROM ROLE sales_owner;

statement error
ACL ROLE "sales_owner" ACL ADD TABLE phys.main.orders_physical AS sales.after_revoke;
----
<REGEX>:.*no ACL administration scope.*

# 11. an explicit ACL NATIVE marker is never re-routed into the management grammar
statement ok
ACL ADMIN ACL NATIVE CREATE TABLE phys.main.native_marker(x INT);

query I
ACL ADMIN SELECT count(*) FROM phys.main.native_marker;
----
0

# 12. an issuer cannot silently lose its audience check
statement ok
ACL ADMIN CREATE ISSUER 'test/idp/aud' AUDIENCES 'api://x';

statement error
ACL ADMIN ALTER ISSUER 'test/idp/aud' SET AUDIENCES '';
----
<REGEX>:.*accepts no audience - AUDIENCES is required.*

statement ok
ACL ADMIN ALTER ISSUER 'test/idp/aud' SET AUDIENCES ('api://x', 'api://y');

# --- closing the anonymous hatch again ------------------------------------------------------------

statement ok
SET GLOBAL acl_allow_anonymous_admin=false;

statement error
ACL ADMIN CREATE ROLE after_close;
----
<REGEX>:.*bare ACL ADMIN is disabled.*

# the granted principals still administer
statement ok
ACL ROLE "platform" ACL CREATE ROLE after_close;
