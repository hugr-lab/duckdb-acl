# name: test/sql/acl_secrets.test
# description: secrets through the ACL (spec 082) without a secrets service - the explicit `secrets`
#   capability, the refusals that say what to write, and (spec 118) a standalone node that keeps a
#   principal's secret itself by duckdb's own rule. The service itself (a catalog of type tresor) is
#   test/cpp/test_acl_secrets.cpp.
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INT, amount INT);

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SET allow_parser_override_extension='fallback';

# a persistent local secret is a file: kept in the test's own directory
statement ok
SET secret_directory='__TEST_DIR__/acl_secrets';

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders;

statement ok
ACL ADMIN CREATE ROLE keeper;

statement ok
ACL ADMIN CREATE ROLE plain;

statement ok
ACL ADMIN CREATE ROLE admin;

# `secrets` is explicit: written on the MAIN catalog grant, never part of the unstated default
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE keeper WITH (select, secrets) MAIN;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE plain MAIN;

# an unrestricted manage scope administers the ACL, not the node's secrets
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE admin WITH (select) MAIN;

statement ok
ACL ADMIN GRANT ADMIN manage TO ROLE admin;

# --- the capability ----------------------------------------------------------------------------------

statement error
ACL ROLE "plain" CREATE SECRET s (TYPE s3, KEY_ID 'k', SECRET 'v');
----
<REGEX>:.*creating a secret needs the secrets capability.*

statement error
ACL ROLE "plain" DROP SECRET s;
----
<REGEX>:.*dropping a secret needs the secrets capability.*

statement error
ACL ROLE "plain" ACL GRANT SECRET s TO ROLE analysts;
----
<REGEX>:.*managing secrets needs the secrets capability.*

statement error
ACL ROLE "admin" ACL GRANT SECRET s TO ROLE analysts;
----
<REGEX>:.*managing secrets needs the secrets capability.*

# --- with the capability and no service (spec 118): a standalone node keeps the secret itself -------
# duckdb's own rule: without a persistence keyword in memory, PERSISTENT in its files (type http: the
# core's own - this suite loads no httpfs)

statement ok
ACL ROLE "keeper" CREATE SECRET s (TYPE http, BEARER_TOKEN 'v');

statement ok
ACL ROLE "keeper" CREATE PERSISTENT SECRET p (TYPE http, BEARER_TOKEN 'v');

statement ok
ACL ROLE "keeper" CREATE TEMPORARY SECRET t (TYPE http, BEARER_TOKEN 'v');

query TT
SELECT name, storage FROM duckdb_secrets() ORDER BY name;
----
p	local_file
s	memory
t	memory

statement ok
ACL ROLE "keeper" DROP SECRET s;

statement ok
ACL ROLE "keeper" DROP TEMPORARY SECRET t;

statement ok
ACL ROLE "keeper" DROP PERSISTENT SECRET p;

query I
SELECT count(*) FROM duckdb_secrets();
----
0

# the grants on a secret are the service's: none here
statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO ROLE analysts;
----
<REGEX>:.*no secrets service is attached to this node.*

statement error
ACL ROLE "keeper" ACL REVOKE SECRET s FROM GROUP analysts;
----
<REGEX>:.*no secrets service is attached to this node.*

# a named storage must be a service: the local rule is for a statement that names none
statement error
ACL ROLE "keeper" CREATE SECRET s IN memory (TYPE s3, KEY_ID 'k', SECRET 'v');
----
<REGEX>:.*"memory" is not a secrets service attached to this node.*

statement error
ACL ROLE "keeper" CREATE SECRET s IN local_file (TYPE s3, KEY_ID 'k', SECRET 'v');
----
<REGEX>:.*"local_file" is not a secrets service attached to this node.*

statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO ROLE analysts FROM phys;
----
<REGEX>:.*"phys" is not a secrets service attached to this node.*

# a secret's parameters are constants: duckdb evaluates them on the node when it binds
statement error
ACL ROLE "keeper" CREATE SECRET s (TYPE s3, KEY_ID 'k', SECRET getenv('HOME'));
----
<REGEX>:.*a secret's parameters are constants.*

statement error
ACL ROLE "keeper" CREATE SECRET s (TYPE s3, KEY_ID 'k', SECRET current_setting('home_directory'));
----
<REGEX>:.*a secret's parameters are constants.*

statement error
ACL ROLE "keeper" CREATE SECRET s (TYPE s3, KEY_ID 'k', SCOPE [lower('S3://X')]);
----
<REGEX>:.*a secret's parameters are constants.*

# the grammar: a grant goes to a role or a group, never to one user; the batch holds nothing else
statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO USER alice;
----
<REGEX>:.*a role or a group, never one user.*

# ... a statement that is not a secrets one is the batch's refusal, whatever it is; a name is never ''
statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO ROLE analysts; SELECT 1;
----
<REGEX>:.*a GRANT / REVOKE SECRET batch holds GRANT / REVOKE SECRET statements only.*

statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO ROLE '';
----
<REGEX>:.*a secret and the role or group it goes to are named.*

statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO ROLE analysts IN '';
----
<REGEX>:.*FROM \| IN names a secrets service.*

statement error
ACL ROLE "keeper" ACL GRANT SECRET "" TO ROLE analysts;
----
<REGEX>:.*zero-length delimited identifier.*

statement error
ACL ROLE "keeper" ACL GRANT SECRET s TO ROLE analysts; CREATE ROLE other;
----
<REGEX>:.*a GRANT / REVOKE SECRET batch holds GRANT / REVOKE SECRET statements only.*

statement error
ACL ADMIN GRANT SECRET s TO ROLE analysts;
----
<REGEX>:.*no secrets service is attached to this node.*

# spec 150 3g-2: the statements are rules - a comment between their words is a space, a name quoted either way, the
# service named FROM or IN (here: no such service attached)
statement error
ACL ADMIN GRANT /* the analysts */ SECRET "s" TO GROUP 'g' -- a group
IN "corp";
----
<REGEX>:.*"corp" is not a secrets service attached to this node.*

statement error
ACL ADMIN REVOKE SECRET s FROM ROLE analysts FROM nosuch;
----
<REGEX>:.*"nosuch" is not a secrets service attached to this node.*

# ... a GRANT / REVOKE SECRET not read as its rule says how it is written; in a management batch it goes apart
statement error
ACL ADMIN REVOKE SECRET s TO ROLE analysts;
----
<REGEX>:.*write REVOKE SECRET <name> FROM ROLE.*

statement error
ACL ADMIN CREATE ROLE never_made; GRANT SECRET s TO ROLE analysts;
----
<REGEX>:.*GRANT / REVOKE SECRET goes in a batch of its own.*

statement error
ACL ADMIN CREATE ROLE never_made; GRANT /* c */ SECRET s TO USER u;
----
<REGEX>:.*GRANT / REVOKE SECRET goes in a batch of its own.*

statement ok
SET GLOBAL acl_allow_anonymous_admin=false;

statement error
ACL ADMIN GRANT SECRET s TO ROLE analysts;
----
<REGEX>:.*a bare ACL ADMIN is disabled.*

# the refused statements left nothing in the node's own secret manager
query I
SELECT count(*) FROM duckdb_secrets();
----
0
