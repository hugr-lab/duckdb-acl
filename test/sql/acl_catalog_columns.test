# name: test/sql/acl_catalog_columns.test
# description: spec 038's catalog-wide column list is gone with spec 158 - a catalog grant takes no
#   COLUMNS and no MASK (refused where written), and one an older build stored refuses every read under
#   that grant and is reported. What remains of the rest: an object grant's list and mask on a table
#   function, and the object's order for a union of roles.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR, ssn VARCHAR);

statement ok
CREATE TABLE phys.main.items(id INTEGER, sku VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme', 'secret');

statement ok
INSERT INTO phys.main.items VALUES (1, 'sku-1');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

# a plain alias, and one that states its own columns - the two paths the resolver has
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.items AS phys.main.items;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.shaped AS phys.main.items COLUMNS (id, sku);

statement ok
ACL ADMIN CREATE ROLE r;

# spec 158: the catalog-wide list (a bare name applying where an object has it, a mask refusing where it
# cannot be applied) is removed - which columns a role sees is said per object. What stays of it:

# --- a catalog grant takes no COLUMNS and no MASK, in either form -----------------------------------

statement error
SELECT acl_grant_catalog('r', 'c', '{"select": true}', true, '', 'ssn, id');
----
<REGEX>:.*a catalog grant takes no column list.*

statement error
ACL ADMIN GRANT CATALOG c TO ROLE r MAIN COLUMNS (ssn, id);
----
<REGEX>:.*a catalog grant takes no COLUMNS or MASK.*

statement error
SELECT acl_grant_catalog('r', 'c', '{"select": true}', true, '', 'id, NULL AS ssn');
----
<REGEX>:.*a catalog grant takes no column list.*

statement ok
SELECT acl_grant_catalog('r', 'c', '{"select": true}', true, '', '');

query III
ACL ROLE "r" SELECT * FROM orders;
----
1	acme	secret

# --- a list an older build stored refuses every read under the grant, and the check names it ---------

statement ok
SET GLOBAL acl_version_check_interval = 0;

statement ok
UPDATE store.acl.role_catalogs SET "columns" = 'ssn, id' WHERE role = 'r' AND vcat = 'c';

statement ok
UPDATE store.acl.meta SET "value" = (CAST("value" AS BIGINT) + 1)::VARCHAR WHERE "key" = 'policy_version';

statement error
ACL ROLE "r" SELECT * FROM orders;
----
<REGEX>:.*cannot be read: a catalog grant states COLUMNS \("ssn, id"\), which only an object grant states since spec 158.*

statement error
ACL ROLE "r" SELECT * FROM shaped;
----
<REGEX>:.*cannot be read: a catalog grant states COLUMNS \("ssn, id"\), which only an object grant states since spec 158.*

query II
SELECT object, problem FROM acl_check_catalog('c') WHERE role = 'r';
----
*	catalog_columns

statement ok
SELECT acl_alter_grant('r', 'c', 'columns', '');

query III
ACL ROLE "r" SELECT * FROM orders;
----
1	acme	secret

# --- an object grant narrows to the object's columns --------------------------------------------------

statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE r WITH (select) COLUMNS (id);

query I
ACL ROLE "r" SELECT * FROM orders;
----
1

# and the metadata says exactly what the read gives
query II
ACL ROLE "r" SELECT table_name, string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns()
GROUP BY 1 ORDER BY 1;
----
items	id,sku
orders	id
shaped	id,sku

# --- a table function: hide and mask, never rename or add --------------------------------------------

statement ok
SELECT acl_add_table_function('c', 'by_tenant',
    'SELECT id, tenant, ssn FROM phys.main.orders WHERE tenant = acl_arg(1)');

query III
ACL ROLE "r" SELECT * FROM by_tenant('acme');
----
1	acme	secret

# a grant hides and masks - and answers in the function's own order, not the grant's
statement ok
SELECT acl_grant_object('r', 'c', 'by_tenant', '{"select": true}', '', 'ssn, id', '', 'ssn AS ''***''');

query II
ACL ROLE "r" SELECT * FROM by_tenant('acme');
----
1	***

# spec 158: a name the function does not return, and a mask of one, are refused where written (it was: a name
# granted nothing, a mask refused the read); the grant before stands
statement error
SELECT acl_grant_object('r', 'c', 'by_tenant', '{"select": true}', '', 'id, nosuch');
----
<REGEX>:.*nosuch.*

statement error
SELECT acl_grant_object('r', 'c', 'orders', '{"select": true}', '', 'id, nosuch');
----
<REGEX>:.*nosuch.*

statement error
SELECT acl_grant_object('r', 'c', 'orders', '{"select": true}', '', 'id', '', 'ssn AS ''x''');
----
<REGEX>:.*ssn.*

statement error
SELECT acl_grant_object('r', 'c', 'by_tenant', '{"select": true}', '', 'id', '', 'nosuch AS 1');
----
<REGEX>:.*nosuch.*

query II
ACL ROLE "r" SELECT * FROM by_tenant('acme');
----
1	***

# --- the order a union of roles gets is the object's -------------------------------------------------

statement ok
ACL ADMIN CREATE ROLE r2;

statement ok
SELECT acl_grant_catalog('r2', 'c', '{"select": true}', true, '', '');

statement ok
SELECT acl_grant_object('r2', 'c', 'orders', '{"select": true}', '', 'ssn, id');

statement ok
ACL ADMIN CREATE ROLE r3;

statement ok
SELECT acl_grant_catalog('r3', 'c', '{"select": true}', true, '', '');

statement ok
SELECT acl_grant_object('r3', 'c', 'orders', '{"select": true}', '', 'tenant, id');

statement ok
SELECT acl_define_issuer('test/idp/cat', '{"url": "test/idp/cat", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"]}}');

# roles ["r2","r3"]: between them id, tenant and ssn - in the object's order
query III
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9jYXQiLCJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwic3ViIjoidSIsInJvbGVzIjpbInIyIiwicjMiXX0.gbclN0eqNn6oQMEqqNmvuER3MV-LsiPXb5zpYHs8UeLWc3LujPSuBctMwR1kfXiJzRw0wCJzQYJgG-uhtbtXfF-QPsNlQRS9gadDaMtKhIkC7pkffLQhfRPccROMN0ZrWZ2LMvAv6rnsPHh49GQxTg6gRvMvOlLICa9qoAU6NAYJMUnewfaIo2DQb81zSAvRkIfSnscXHqis070MqkGC3PDgTm0kEIrzTxJDmSmryucXIEE3OP8cHGzfzsS3Vh-ZzMsQLcfKmX1502lS5_Y6kmMnOoM8JVILngfhLkCdy0MlugJPCC7R633SJeGuLfoRDOf_HeXSpvPumkOeASmU2A'
SELECT * FROM orders;
