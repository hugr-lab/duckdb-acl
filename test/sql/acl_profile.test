statement ok
SELECT acl_audit_flush();

query III
SELECT truncated, (length(plan::VARCHAR) - length(replace(plan::VARCHAR, '"id":', ''))) / 5 <= 256,
       sources::VARCHAR LIKE '%"scans":300%'
FROM acl_audit_events() WHERE kind = 'profile' ORDER BY seq DESC LIMIT 1;
----
true	true	true

# --- off again: nothing more -------------------------------------------------------------------------

statement ok
SET GLOBAL acl_profile_level='off';

statement ok
ACL ROLE "analyst" SELECT count(*) FROM payroll;

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE kind = 'profile';
----
8

# --- the level is validated where it is set --------------------------------------------------------

statement error
SET GLOBAL acl_profile_level='verbose';
----
<REGEX>:.*acl_profile_level: unknown level.*
