# name: test/sql/acl_empty_grant_projection.test
# description: spec 156 - a grant whose column list leaves none of an object's declared columns reads no column,
#   whatever row filter applies; an empty projection beside an RLS used to read every physical column of the source
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.t (id INTEGER, ssn VARCHAR, b INTEGER);

statement ok
INSERT INTO phys.main.t VALUES (1, 'secret', 2);

statement ok
ATTACH ':memory:' AS store;

statement ok
SET acl_allow_anonymous_admin = true;

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c; CREATE ROLE r; CREATE ROLE o;

# `narrow` declares k and b, `wide` declares id: a catalog grant listing id reads `wide`'s id and nothing of `narrow`
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.narrow AS phys.main.t COLUMNS (k = id, b) RLS (id > 0);

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.wide AS phys.main.t COLUMNS (id);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r MAIN COLUMNS (id);

query I
ACL ROLE "r" SELECT * FROM wide;
----
1

# the object's own RLS beside a list narrowed to none: refused, never `SELECT *` over the source
statement error
ACL ROLE "r" SELECT * FROM narrow;
----
exposes no readable columns

statement error
ACL ROLE "r" SELECT count(*) FROM narrow WHERE ssn = 'secret';
----
exposes no readable columns

# the grant's own RLS, and a rename-only object (read as `* RENAME (...)` before)
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.ren AS phys.main.t COLUMNS (i = id, k = b);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE r MAIN COLUMNS (id) RLS 'id > 0';

statement error
ACL ROLE "r" SELECT * FROM narrow;
----
exposes no readable columns

statement error
ACL ROLE "r" SELECT * FROM ren;
----
exposes no readable columns

query I
ACL ROLE "r" SELECT * FROM wide;
----
1

# an object grant written over a list it matched, then the object's list changed under it: nothing re-judges the
# grant, and the read must not widen
statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.g AS phys.main.t COLUMNS (id, b);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE o MAIN; GRANT TABLE c.g TO ROLE o COLUMNS (id) RLS (id > 0);

query I
ACL ROLE "o" SELECT * FROM g;
----
1

statement ok
ACL ADMIN ALTER VIRTUAL TABLE c.g SET COLUMNS (k = id, b);

statement error
ACL ROLE "o" SELECT * FROM g;
----
exposes no readable columns

# a row-only grant (no list) still reads every declared column under its filter
statement ok
ACL ADMIN GRANT TABLE c.g TO ROLE o RLS (id > 0);

query II
ACL ROLE "o" SELECT * FROM g;
----
1	2

# a writable object (a rename-only list, no RLS) whose grants leave no column: every column set of a write was empty,
# which read as "no column policy" - the whole physical row written, read in WHERE and returned. No write at all now
statement ok
ACL ADMIN CREATE ROLE wr; CREATE VIRTUAL TABLE c.w AS phys.main.t COLUMNS (k = b);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE wr MAIN COLUMNS (id);

statement error
ACL ROLE "wr" SELECT * FROM w;
----
exposes no readable columns

statement error
ACL ROLE "wr" UPDATE w SET ssn = 'x' WHERE id = 1 RETURNING *;
----
exposes no column

statement error
ACL ROLE "wr" DELETE FROM w WHERE ssn = 'secret' RETURNING *;
----
exposes no column

statement error
ACL ROLE "wr" DELETE FROM w;
----
exposes no column

statement error
ACL ROLE "wr" INSERT INTO w VALUES (7, 'z', 7) RETURNING *;
----
exposes no column

statement error
ACL ROLE "wr" INSERT OR REPLACE INTO w (ssn) VALUES ('q');
----
exposes no column

statement error
ACL ROLE "wr" MERGE INTO w USING (SELECT 1 AS x) s ON w.id = s.x WHEN MATCHED THEN UPDATE SET ssn = 'm' RETURNING *;
----
exposes no column

query III
SELECT * FROM phys.main.t;
----
1	secret	2

# the same object under a grant that lists its column stays writable
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE wr MAIN COLUMNS (id, k);

statement ok
ACL ROLE "wr" UPDATE w SET k = 5 WHERE k = 2;

query I
SELECT b FROM phys.main.t;
----
5

# an object without a declared list: the catalog grant's list and the object grant's intersect to nothing - the read
# refuses in our words (duckdb's empty COLUMNS error before), a write before anything is written
statement ok
ACL ADMIN CREATE ROLE ix; CREATE VIRTUAL TABLE c.p AS phys.main.t;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE ix MAIN COLUMNS (id) RLS 'id > 0'; GRANT TABLE c.p TO ROLE ix COLUMNS (b);

statement error
ACL ROLE "ix" SELECT * FROM p;
----
exposes no readable columns

statement error
ACL ROLE "ix" UPDATE p SET ssn = 'x' RETURNING *;
----
exposes no column

# the check's repair of a grant's last broken item names a placeholder - the list without it would be empty, which
# reads every column, and a revoke would drop the grant's RLS (the catalog grant then decides)
statement ok
CREATE TABLE phys.main.d (id INTEGER, old INTEGER);

statement ok
ACL ADMIN CREATE ROLE dr; CREATE VIRTUAL TABLE c.dt AS phys.main.d COLUMNS (i = id, old);

statement ok
ACL ADMIN GRANT TABLE c.dt TO ROLE dr COLUMNS (old);

statement ok
ALTER TABLE phys.main.d DROP COLUMN old;

statement ok
ACL ADMIN REPAIR VIRTUAL TABLE c.dt DROP MISSING COLUMNS;

query I
SELECT repair FROM acl_check_catalog('c') WHERE object = 'dt' AND role = 'dr' AND problem = 'grant_column_missing';
----
SELECT acl_grant_object('dr', 'c', 'dt', '', '', '<columns>')  -- name what the role reads; an empty list reads every column

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE dr MAIN;

statement error
ACL ROLE "dr" SELECT * FROM dt;
----
exposes no readable columns

# INSERT OR REPLACE updates the row already there: under a role whose grants leave no column it is refused too (its
# empty column sets read as "no column policy")
statement ok
CREATE TABLE phys.main.k (id INTEGER PRIMARY KEY, ssn VARCHAR, b INTEGER);

statement ok
INSERT INTO phys.main.k VALUES (1, 'secret', 2);

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"]}}');

# the token carries analyst (insert) and auditor (update, its lists intersecting to nothing over kp)
statement ok
ACL ADMIN CREATE ROLE analyst; CREATE ROLE auditor; ADD TABLE phys.main.k AS c.kp;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (insert) MAIN; GRANT CATALOG c TO ROLE auditor WITH (update) MAIN COLUMNS (id);

statement ok
ACL ADMIN GRANT TABLE c.kp TO ROLE auditor COLUMNS (b);

statement error
ACL ROLE "auditor" UPDATE kp SET b = 1;
----
exposes no column

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' INSERT OR REPLACE INTO kp VALUES (1, 'pwn', 99);
----
exposes no column

query III
SELECT * FROM phys.main.k;
----
1	secret	2
