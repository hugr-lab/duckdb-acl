# name: test/sql/acl_struct_fields.test
# description: structured columns per role (spec 102, reshaped by spec 158) - spec 102's field paths are gone: a
#   grant hides or masks a struct's fields by masking its column with an expression (struct_update, list_transform),
#   whose type is the column's; an object's own list reads a field as a column of its own (`address.city` is a column
#   `city`, as in SELECT); the read, every listing and the DDL a quack client binds agree; a hidden value reaches
#   nothing; a write reads the target as the role does.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.c(id INTEGER, region VARCHAR,
    address STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER)),
    items STRUCT(price INTEGER, cost INTEGER)[], tags MAP(VARCHAR, VARCHAR));

statement ok
INSERT INTO phys.main.c VALUES
    (1, 'eu', {'city': 'Berlin', 'ssn': 'S1', 'zip': '10115', 'geo': {'lat': 52, 'lon': 13}}, [{'price': 10, 'cost': 7}], MAP {'k': 'v'}),
    (2, 'us', NULL, NULL, NULL);

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('test/idp/rs', '{"url": "test/idp/rs", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"]}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN ADD TABLE phys.main.c AS c.c;

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN CREATE ROLE auditor;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst WITH (select) MAIN;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor WITH (select) MAIN;

# --- one role: a mask hides fields, the column keeps its type ------------------------------------------
# spec 158: a grant lists names only (`address.city` / `items[].price` are refused); hiding a field is a mask of its
# struct column, cast to the column's type - the field stays, read as NULL

statement error
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, items[].price, address.geo.lat, address.city);
----
the grant's column list

statement ok
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, address, items) MASK (address AS struct_update(address, ssn := NULL::VARCHAR, zip := NULL::VARCHAR, geo := struct_update(address.geo, lon := NULL::INTEGER)), items AS list_transform(items, lambda x: struct_update(x, cost := NULL::INTEGER)));

# stored in the object's column order
query I
SELECT columns FROM store.acl.role_object_caps WHERE role = 'analyst';
----
id, address, items

query III
ACL ROLE "analyst" SELECT id, address, items FROM c ORDER BY id;
----
1	{'city': Berlin, 'ssn': NULL, 'zip': NULL, 'geo': {'lat': 52, 'lon': NULL}}	[{'price': 10, 'cost': NULL}]
2	{'city': NULL, 'ssn': NULL, 'zip': NULL, 'geo': {'lat': NULL, 'lon': NULL}}	NULL

query I
ACL ROLE "analyst" SELECT typeof(address) FROM c LIMIT 1;
----
STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))

# a hidden value reaches nothing: not the whole row as a value, not the field itself (it reads as its mask)
query I
ACL ROLE "analyst" SELECT count(*) FROM c AS x WHERE x::VARCHAR LIKE '%S1%' OR x::VARCHAR LIKE '%10115%' OR x::VARCHAR LIKE '%13%' OR x::VARCHAR LIKE '%7%';
----
0

query I
ACL ROLE "analyst" SELECT count(*) FROM c WHERE address.ssn IS NOT NULL OR address.zip IS NOT NULL;
----
0

# the hidden column is not there at all
statement error
ACL ROLE "analyst" SELECT region FROM c;
----
<REGEX>:.*region.*

# every listing and the DDL describe what the role reads: the column's own type, a mask never changes it
query II
ACL ROLE "analyst" SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'c' ORDER BY column_name;
----
address	STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))
id	INTEGER
items	STRUCT(price INTEGER, "cost" INTEGER)[]

query I
ACL ROLE "analyst" SELECT sql FROM duckdb_tables() WHERE table_name = 'c';
----
CREATE TABLE "c"("id" INTEGER, "address" STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER)), "items" STRUCT(price INTEGER, "cost" INTEGER)[]);

query II
ACL ROLE "analyst" SELECT column_name, column_type FROM (DESCRIBE c) WHERE column_name = 'address';
----
address	STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))

# --- the whole struct with one field masked --------------------------------------------------------

statement ok
ACL ADMIN GRANT TABLE c.c TO ROLE auditor COLUMNS (id, address) MASK (address AS struct_update(address, ssn := '***'));

query II
ACL ROLE "auditor" SELECT id, address FROM c ORDER BY id;
----
1	{'city': Berlin, 'ssn': ***, 'zip': 10115, 'geo': {'lat': 52, 'lon': 13}}
2	{'city': NULL, 'ssn': ***, 'zip': NULL, 'geo': NULL}

# --- two roles: a column one shows unmasked reads unmasked; one only masks reads its mask ------------------
# spec 158: masks unite per column, never per field (spec 102's field trees are gone)

statement ok
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id);

query II
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT typeof(address), address FROM c WHERE id = 1;
----
STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))	{'city': Berlin, 'ssn': ***, 'zip': 10115, 'geo': {'lat': 52, 'lon': 13}}

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT data_type FROM information_schema.columns WHERE table_name = 'c' AND column_name = 'address';
----
STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))

# two roles masking one column differently: refused, never picked
statement ok
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, address) MASK (address AS struct_update(address, ssn := 'xx'));

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT address FROM c;
----
<REGEX>:.*mask column "address" of "c" differently.*

# spec 158: a catalog grant takes no column list, so the section on levels (an object grant narrowing the catalog's
# fields) is gone

# --- what a grant may name: checked where it is written --------------------------------------------

statement error
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, address.city);
----
the grant's column list is `name, …`

statement error
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, address.city || 'x');
----
the grant's column list is `name, …`

statement error
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, address) MASK (address.ssn AS 'x');
----
<REGEX>:.*MASK.*

statement error
ACL ADMIN GRANT TABLE c.c TO ROLE analyst COLUMNS (id, address) MASK (address AS struct_update(address, nope := ssn));
----
<REGEX>:.*does not bind.*

# --- the object's own COLUMNS read a field as a column of its own, as SELECT does ------------------------

statement ok
ACL ADMIN ADD TABLE phys.main.c AS c.o COLUMNS (id, address.geo.lat, address.city);

query II
SELECT name, expr FROM store.acl.relation_columns WHERE vname = 'o' ORDER BY pos;
----
id	(empty)
lat	address.geo.lat
city	address.city

statement ok
ACL ADMIN GRANT TABLE c.o TO ROLE auditor COLUMNS (id, city);

query II
ACL ROLE "auditor" SELECT id, city FROM o ORDER BY id;
----
1	Berlin
2	NULL

query II
ACL ROLE "auditor" SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'o' ORDER BY column_name;
----
city	VARCHAR
id	INTEGER

# the field the grant does not show is no column of the read
statement error
ACL ROLE "auditor" SELECT lat FROM o;
----
<REGEX>:.*lat.*

# --- the catalog check binds a mask against the object ---------------------------------------------------

statement ok
ACL ADMIN GRANT TABLE c.c TO ROLE auditor COLUMNS (id, items) MASK (items AS list_transform(items, lambda x: struct_update(x, cost := x.cost * 0)));

statement ok
ALTER TABLE phys.main.c DROP COLUMN items;

statement ok
ALTER TABLE phys.main.c ADD COLUMN items STRUCT(price INTEGER)[];

query II
SELECT object, problem FROM acl_check_catalog('c') WHERE role = 'auditor' AND problem IN ('mask_broken', 'grant_column_missing');
----
c	mask_broken

# --- part B: writes through a struct column ----------------------------------------------------------
# spec 158: spec 102's field writes are gone - a visible unmasked column takes the written value whole, a column masked
# by a value is assigned its mask, never the client's; a column masked from the row is not writable; a column
# the grant does not show is not writable

statement ok
CREATE TABLE phys.main.w(id INTEGER, address STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR), tenant VARCHAR,
    items STRUCT(price INTEGER, cost INTEGER)[]);

statement ok
INSERT INTO phys.main.w VALUES (1, {'city': 'A', 'ssn': 'S1', 'zip': 'Z1'}, 'acme', [{'price': 1, 'cost': 9}]), (2, NULL, 'acme', NULL);

statement ok
ACL ADMIN ADD TABLE phys.main.w AS c.w;

statement ok
ACL ADMIN CREATE ROLE writer;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE writer WITH (select, insert, update, merge) MAIN;

statement ok
ACL ADMIN GRANT TABLE c.w TO ROLE writer COLUMNS (id, address, tenant) MASK (tenant AS 'acme');

statement ok
ACL ROLE "writer" UPDATE w SET address = {'city': 'B', 'ssn': 'S9', 'zip': 'Z9'} WHERE id = 1;

query II
SELECT address, tenant FROM phys.main.w WHERE id = 1;
----
{'city': B, 'ssn': S9, 'zip': Z9}	acme

statement ok
ACL ROLE "writer" INSERT INTO w(id, address) VALUES (3, {'city': 'E', 'ssn': NULL, 'zip': 'Z3'});

query II
SELECT address, tenant FROM phys.main.w WHERE id = 3;
----
{'city': E, 'ssn': NULL, 'zip': Z3}	acme

# the client's value for the masked column is never what is stored: the mask is assigned in its place (spec 024)
statement ok
ACL ROLE "writer" UPDATE w SET tenant = 'evil' WHERE id = 1;

statement ok
ACL ROLE "writer" INSERT INTO w(id, address, tenant) VALUES (4, NULL, 'evil');

query I
SELECT count(*) FROM phys.main.w WHERE tenant IS DISTINCT FROM 'acme';
----
0

# a column the grant does not show is not writable, and not readable back through RETURNING
statement error
ACL ROLE "writer" UPDATE w SET items = [{'price': 5, 'cost': 0}] WHERE id = 1;
----
<REGEX>:.*column "items" of "w" is not writable.*

statement error
ACL ROLE "writer" UPDATE w SET address = {'city': 'G', 'ssn': NULL, 'zip': 'Z'} WHERE id = 1 RETURNING items;
----
<REGEX>:.*items.*

# a mask computed from the row is a mask, not an assignment: the column is not writable
statement ok
ACL ADMIN GRANT TABLE c.w TO ROLE writer COLUMNS (id, address) MASK (address AS struct_update(address, ssn := NULL::VARCHAR));

statement error
ACL ROLE "writer" UPDATE w SET address = {'city': 'C', 'ssn': 'hack', 'zip': 'Z'} WHERE id = 1;
----
<REGEX>:.*column "address" of "w" is computed from the row, so it cannot be written.*

query I
SELECT address.ssn FROM phys.main.w WHERE id = 1;
----
S9

# the role reads back what it wrote, and never the masked field
query II
ACL ROLE "writer" SELECT id, address FROM w WHERE id IN (1, 3) ORDER BY id;
----
1	{'city': B, 'ssn': NULL, 'zip': Z9}
3	{'city': E, 'ssn': NULL, 'zip': Z3}

# --- review regressions (spec 102, reshaped by spec 158) -------------------------------------------------

statement ok
CREATE TABLE phys.main.r(id INTEGER, note VARCHAR, hidden VARCHAR, "odd.col" INTEGER,
    address STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER)),
    items STRUCT(price INTEGER, cost INTEGER)[]);

statement ok
INSERT INTO phys.main.r VALUES (1, 'n', 'H', 7, {'city': 'A', 'ssn': 'S1', 'zip': 'Z1', 'geo': {'lat': 1, 'lon': 2}}, [{'price': 1, 'cost': 9}]);

statement ok
ACL ADMIN ADD TABLE phys.main.r AS c.r;

statement ok
ACL ADMIN CREATE ROLE rv;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE rv WITH (select, update, delete, merge, insert) MAIN;

# spec 158: the section on the wider field item winning at every depth is gone with spec 102's field trees

# a column named with a dot is a column, and a grant spelled in another case lists it once
statement ok
ACL ADMIN GRANT TABLE c.r TO ROLE rv COLUMNS (id, "odd.col", NOTE, ADDRESS) MASK (ADDRESS AS struct_update(address, ssn := NULL::VARCHAR, zip := NULL::VARCHAR));

query II
ACL ROLE "rv" SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'r' ORDER BY column_name;
----
address	STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))
id	INTEGER
note	VARCHAR
odd.col	INTEGER

query I
ACL ROLE "rv" SELECT "odd.col" FROM r;
----
7

# a write statement reads the target as the role does: a masked field reads as its mask, a hidden column is not there
statement ok
ACL ROLE "rv" UPDATE r SET note = coalesce(address.ssn, 'masked') WHERE id = 1;

query I
SELECT note FROM phys.main.r WHERE id = 1;
----
masked

statement ok
ACL ROLE "rv" UPDATE r SET note = 'x' WHERE address.zip = 'Z1';

query I
SELECT note FROM phys.main.r WHERE id = 1;
----
masked

statement error
ACL ROLE "rv" UPDATE r SET note = hidden WHERE id = 1;
----
<REGEX>:.*column "hidden" of "r" is not readable.*

statement error
ACL ROLE "rv" DELETE FROM r WHERE hidden = 'H';
----
<REGEX>:.*column "hidden" of "r" is not readable.*

statement error
ACL ROLE "rv" UPDATE r SET note = hidden FROM (SELECT 1 AS k) s WHERE r.id = s.k;
----
<REGEX>:.*"hidden" in a write to "r" must be qualified.*

# a visible field reads as the role reads it
statement ok
ACL ROLE "rv" UPDATE r SET note = address.city WHERE id = 1;

query I
SELECT note FROM phys.main.r WHERE id = 1;
----
A

# a merge's update branch must name its columns under a column policy
statement error
ACL ROLE "rv" MERGE INTO r USING (SELECT 1 AS id, 'x' AS hidden) s ON r.id = s.id WHEN MATCHED THEN UPDATE SET *;
----
<REGEX>:.*the update branch of a merge into "r" must name its columns.*

statement error
ACL ROLE "rv" MERGE INTO r USING (SELECT 1 AS id, 'x' AS hidden) s ON r.id = s.id WHEN MATCHED THEN UPDATE BY NAME;
----
<REGEX>:.*must name its columns.*

# a mask that reads the row is a mask, not an assignment: the column is not writable
statement error
ACL ROLE "rv" UPDATE r SET address = {'city': 'B', 'ssn': NULL, 'zip': NULL, 'geo': NULL} WHERE id = 1;
----
<REGEX>:.*column "address" of "r" is computed from the row, so it cannot be written.*

query I
SELECT address.ssn FROM phys.main.r WHERE id = 1;
----
S1

# spec 158: the section on nested field writes (a hidden nested field kept) is gone with spec 102's field writes

# two roles masking one column differently: the read refuses, and the listing keeps the column's own type
statement ok
ACL ADMIN GRANT TABLE c.r TO ROLE analyst COLUMNS (id, address) MASK (address AS struct_update(address, ssn := 'a'));

statement ok
ACL ADMIN GRANT TABLE c.r TO ROLE auditor COLUMNS (id, address) MASK (address AS struct_update(address, ssn := 'b'));

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT address FROM r;
----
<REGEX>:.*mask column "address" of "r" differently.*

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT data_type FROM information_schema.columns WHERE table_name = 'r' AND column_name = 'address';
----
STRUCT(city VARCHAR, ssn VARCHAR, zip VARCHAR, geo STRUCT(lat INTEGER, lon INTEGER))

# spec 158: the check's section on paths into lost fields (and at the catalog level) is gone; a mask that no longer
# binds is part A's mask_broken

# an object's own list: `address.city` is a column `city` beside `address`; an expression needs a name
statement ok
ACL ADMIN ADD TABLE phys.main.r AS c.ro COLUMNS (id, address.city, address);

query I
SELECT string_agg(name, ',' ORDER BY pos) FROM store.acl.relation_columns WHERE vname = 'ro';
----
id,city,address

statement error
ACL ADMIN ADD TABLE phys.main.r AS c.rm COLUMNS (id, address.ssn = 'x');
----
<REGEX>:.*without a name.*

# --- re-review: correlated subqueries, a wholly hidden struct, a masked column read ---------------------

statement ok
ACL ADMIN GRANT TABLE c.r TO ROLE rv COLUMNS (id, note, address) MASK (address AS struct_update(address, ssn := NULL::VARCHAR, zip := NULL::VARCHAR));

statement ok
CREATE TABLE phys.main.s2 AS SELECT 1 AS k, 5 AS x;

statement ok
ACL ADMIN ADD TABLE phys.main.s2 AS c.s2;

statement error
ACL ROLE "rv" UPDATE r SET note = (SELECT hidden) WHERE id = 1;
----
<REGEX>:.*column "hidden" of "r" is not readable.*

# a correlated read of a masked column reads the mask
statement ok
ACL ROLE "rv" UPDATE r SET note = coalesce((SELECT address.ssn), 'm1') WHERE id = 1;

query I
SELECT note FROM phys.main.r WHERE id = 1;
----
m1

statement error
ACL ROLE "rv" UPDATE r SET note = 'p' WHERE EXISTS (SELECT 1 WHERE hidden = 'H');
----
<REGEX>:.*column "hidden" of "r" is not readable.*

statement error
ACL ROLE "rv" UPDATE r SET note = (SELECT max(s2.x) FROM s2 WHERE hidden = 'H') WHERE id = 1;
----
<REGEX>:.*"hidden" in a write to "r" must be qualified.*

statement ok
ACL ROLE "rv" UPDATE r SET note = coalesce((SELECT r.address.zip FROM s2 LIMIT 1), 'm2') WHERE id = 1;

query I
SELECT note FROM phys.main.r WHERE id = 1;
----
m2

statement error
ACL ROLE "rv" DELETE FROM r WHERE 'H' IN (SELECT hidden);
----
<REGEX>:.*column "hidden" of "r" is not readable.*

statement error
ACL ROLE "rv" MERGE INTO r USING (SELECT 1 AS k) s ON r.id = s.k AND EXISTS (SELECT 1 WHERE r.hidden = 'H') WHEN MATCHED THEN UPDATE SET note = 'm';
----
<REGEX>:.*column "hidden" of "r" is not readable.*

# a subquery over its own relation, qualified, still works
statement ok
ACL ROLE "rv" UPDATE r SET note = (SELECT max(s2.x)::VARCHAR FROM s2 WHERE s2.k = r.id) WHERE id = 1;

query I
SELECT note FROM phys.main.r WHERE id = 1;
----
5

# a struct column hidden whole: its fields are not there either
statement ok
ACL ADMIN GRANT TABLE c.r TO ROLE rv COLUMNS (id, note);

statement error
ACL ROLE "rv" UPDATE r SET note = address.ssn WHERE id = 1;
----
<REGEX>:.*column "address" of "r" is not readable.*

statement error
ACL ROLE "rv" UPDATE r SET note = 'q' WHERE address.zip = 'Z1';
----
<REGEX>:.*column "address" of "r" is not readable.*

# a masked column reads as its mask in a WHERE, even a mask computed from the row
statement ok
ACL ADMIN GRANT TABLE c.r TO ROLE rv COLUMNS (id, note, hidden) MASK (hidden AS left(hidden, 0) || '***');

statement ok
ACL ROLE "rv" UPDATE r SET note = 'masked-match' WHERE hidden = '***';

query I
