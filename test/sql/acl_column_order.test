# the DDL a client parses and then projects positionally against
query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9vcmRlciIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicmEiLCJyYiJdfQ.MH46abRthAGV7khkVQfbeFqEpOLXgB54l4tv4tWKl-nQPALtrBQaWmHyKAGS_f_G59noaTWj3Mhhr5SvKsVQHywqnRRWomG29rL1UzaLgbJefs_PYtAdJi_iaCVeTV_GBOrTTAYFUTyxJRYhCZ9DWmlFpJNM0I_jdvBKh4HcgCCmt_555RsPEvuHNC3gPMLuVB6QDU_jksrTqIxLmqkY8xbuS77tAT1lEOkvisZtl0_tgGjeYgUVNO6p6Ystvnt-b0SjZfNBc23iLnnpTdA0Xg3bZKvcFkBYLf-_VpHEhIH-VpKnfjzSlSYMsHP6kRC8owGjU6381vIzHPk4USEEhA'
