query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9vcmRlciIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1Iiwicm9sZXMiOlsicmIiLCJyYSJdfQ.KmBPS_C1OcnbSjayCcCWjpcluVzqUF7A3Zad0wDI7G13M-_FCE6oNUzr_fd1dAbDUddZ-jMa7Yqyo7oHkjAHijxdODa3aJPQ-ck0JmH1KY5yjxVSlf6gY_GnU4_zgfynrokeEA4cnlfEaXeng-NTwKXyTY_rV5zQK-dZirPBYdgUWW3GjUyBjLS9fmfjYPNQNizKoXkX62MHZ9xDDRLV21ppLndZDqqgDZ7kY0p-Wzct-3J-HypHvafr7TfS3JCCCycXMqhPzrjB9YoGJx5aYMikgDG0M-bG4tJONjDQce16VrTIH0aGeEX5aOGqrMuTCTtCMd8vEjUbcmdfGyWfOQ'
SELECT sql FROM duckdb_tables();
----
CREATE TABLE "orders"("id" INTEGER, "tag" VARCHAR, "amount" INTEGER);

# --- a single role keeps its own list order, including a reordering one ------------------------------

statement ok
ACL ADMIN CREATE ROLE solo;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE solo WITH (select) MAIN;

# written out of order on purpose: the object's order is the order (spec 037)
statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE solo COLUMNS (note, amount, id);

query III
ACL ROLE "solo" SELECT * FROM orders;
----
1	100	first

query I
ACL ROLE "solo" SELECT string_agg(column_name, ',') FROM (DESCRIBE orders);
----
id,amount,note

query I
ACL ROLE "solo" SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns();
----
id,amount,note

query I
ACL ROLE "solo" SELECT sql FROM duckdb_tables();
----
CREATE TABLE "orders"("id" INTEGER, "amount" INTEGER, "note" VARCHAR);

# --- one role without a column list lifts the other's projection entirely ----------------------------
# spec 011: a grant that states nothing does not narrow, so the principal reads the object's own
# columns - and then the other role's projection must not be listed either, or a client would be told
# about a column `SELECT *` never returns, at a position that collides with a real one.

statement ok
ACL ADMIN CREATE ROLE rc;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE rc WITH (select) MAIN;

statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE rc COLUMNS (id, tag);

statement ok
ACL ADMIN CREATE ROLE rd;

# rd states no column list at either level, so it lifts rc's restriction
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE rd WITH (select) MAIN;

