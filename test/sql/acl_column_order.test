# name: test/sql/acl_column_order.test
# description: a principal's columns come out in one order, whoever asks and whatever the token says
#   (spec 036) - the read path, the listings and the synthesized DDL agree, and role order in the
#   token does not change the answer
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';


statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR, amount INTEGER, note VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme', 100, 'first');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SELECT acl_define_issuer('test/idp/order', '{"url": "test/idp/order", "client": {"audiences": ["api://acl-test"], "roles_from": ["roles"]}}');

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders COLUMNS (id, tag = tenant, amount, note);

statement ok
ACL ADMIN CREATE ROLE ra;

statement ok
ACL ADMIN CREATE ROLE rb;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE ra WITH (select) MAIN;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE rb WITH (select) MAIN;

# `ra` lists (id, tag); `rb` lists (id, amount, tag) - overlapping, and `tag` sits at a different
# position in each. The merge rule: a column belongs where the first role naming it - roles in name
# order - put it. So: id, tag (from ra), then amount (new in rb).
statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE ra COLUMNS (id, tag);

statement ok
ACL ADMIN GRANT OBJECT c.orders TO ROLE rb COLUMNS (id, amount, tag);

# --- the read path ---------------------------------------------------------------------------------

