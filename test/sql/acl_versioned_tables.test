# every version won over a limited role whose slice differs: its slice read in history - audited (spec 146), beside the
# union of columns of the same roles, each its own event
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst MAIN VERSIONS CURRENT; GRANT TABLE c.t TO ROLE analyst RLS (region = 'us') COLUMNS (id);

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor MAIN VERSIONS ANY; GRANT TABLE c.t TO ROLE auditor RLS (region = 'eu');

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MiIsInJvbGVzIjpbImFuYWx5c3QiLCJhdWRpdG9yIl0sInRpZCI6ImFjbWUifQ.SPf0FiV3Her6HFT4awngyv27bHcGkGga5ptlaaDVdjmX6Y2PgaXLHbpnXXdPO0XO52kqA5BnoomOItvUxZtwFL1sQamV95sd4XTbhjXlrwtpzXzwKE-xaQYNHYprOsRZtET3o2x_L9nGzqU0ziCnDDiMsMjF_PZ4FB84C89dKJJVkDUdGMIM6OFQo-6GYrOAvVR0c7zbYjKgfO6XMRx1X_i9uSebASQvX8tv6ryTJyaCb5h9H4ETBCiyJO0EnYd8n2r-t0wQUQNIL8dP96C7agt6xkEqfEHNubCBQjWt4Ay7IdtkIJPdMEVwDc_8mZOf6OrnFb3gibgpPqxzgNBiFA' SELECT count(*) FROM t AT (VERSION => 3);
----
