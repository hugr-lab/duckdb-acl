query I
SELECT count(*) FROM lk.t;
----
1

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst MAIN; GRANT CATALOG c TO ROLE auditor MAIN;

# --- an object grant states its own, else the catalog grant's; a rewrite of another part keeps them ---------------

statement ok
ACL ADMIN GRANT TABLE c.t TO ROLE cur VERSIONS ANY;

query IT
ACL ROLE "cur" SELECT * FROM t AT (VERSION => 2);
----
1	eu

statement ok
ACL ADMIN ALTER GRANT CATALOG c TO ROLE win SET CAPS '{"select": true}';

statement error
ACL ROLE "win" SELECT * FROM t AT (TIMESTAMP => TIMESTAMP '1999-01-01');
----
the version asked for is outside it

# a re-grant states the grant whole: unstated is the current version again
statement ok
ACL ADMIN GRANT CATALOG c TO ROLE win MAIN;

statement error
ACL ROLE "win" SELECT * FROM t AT (VERSION => 2);
----
is read at its current version only

# --- what a grant's VERSIONS may be --------------------------------------------------------------------------------

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS AT (VERSION => random());
----
is not a constant

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS BETWEEN TIMESTAMP '2001-01-01' AND TIMESTAMP '2000-01-01';
----
its start is after its end

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS AT (VERSION => 1) VERSIONS ANY;
----
VERSIONS is written twice

statement error
SELECT acl_grant_object('pin', 'c', 't', '', '', '', 'AT (VERSION => (SELECT 1))');
----
is not a constant

statement error
SELECT acl_grant_object('pin', 'c', 't', '', '', '', 'AT (VERSION => 1) WHERE true');
----
does not read as AT

statement error
SELECT acl_grant_object('pin', 'c', 't', '', '', '', 'BETWEEN 1 AND 2 OR true');
----
does not read as BETWEEN

statement error
SELECT acl_grant_object('pin', 'c', 't', '', '', '', 'AT (VERSION => NULL)');
----
is NULL

statement error
SELECT acl_grant_object('pin', 'c', 't', '', '', '', 'LATEST');
----
is no VERSIONS clause

statement error
SELECT acl_grant_object('pin', 'c', 't', '', '', '', 'AT (VERSION => 5) GROUP BY ALL');
----
does not read as AT

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS AT (VERSION => 1.9);
----
a VERSION is an integer

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS AT (VERSION => true);
----
a VERSION is an integer

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS AT (VERSION => '42');
----
a VERSION is an integer

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS AT (TIMESTAMP => 'infinity');
----
a TIMESTAMP is finite

statement error
ACL ADMIN GRANT TABLE c.t TO ROLE pin VERSIONS BETWEEN 1 AND 2;
----
is no value of that kind

# an instant is stored in UTC, whatever time zone wrote it
statement ok
ACL ADMIN GRANT TABLE c.t TO ROLE old VERSIONS AT (TIMESTAMP => TIMESTAMPTZ '2026-06-30 09:00:00+09');

query T
SELECT versions FROM store.acl.role_object_caps WHERE role = 'old';
----
AT (TIMESTAMP => TIMESTAMPTZ '2026-06-30 00:00:00.000000+00')

# a stored row that is not constants (no writer of ours stores one) refuses the read
statement ok
UPDATE store.acl.role_object_caps SET versions = 'AT (VERSION => (SELECT 2))' WHERE role = 'old';

statement error
ACL ROLE "old" SELECT * FROM t;
----
do not read as a VERSIONS clause

# the pin stands: nothing refused changed it
query IT
ACL ROLE "pin" SELECT * FROM t;
----
1	eu
