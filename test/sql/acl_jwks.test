# a key read from a location is never a shared secret: an issuer that signs only with HS256 (or none)
# has nothing this node verifies by discovery
statement ok
ACL ADMIN CREATE ISSUER 'test/idp/hsonly' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles';

statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9oc29ubHkiLCJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwic3ViIjoidTEiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRpZCI6ImFjbWUifQ.axBPEf-BTD5fofDlsnaZpaBjoGTqsXbMoUoo9a7Y1EIqJynnRn85g2fg9E8NkHnDisdm5Y4ttUaraeVja_8sFy-bKV432uzxysRuqsx1_dYkQJlb4Txz6pyKcwWvGMOFp91aE-aLOVgGfLIbCOz58UM5H9e_pySdS40Pe8C3KFTU3AkQnfciA10rHko2dGnXrMwz1D2oPIlsiwB-Lpj-Qol1n5qDmmzMjn6zZPmRyR1V_rhbPdu3OW8SnS4FE_cxWIASH45yYdQ5tqoDDtnHhTbPxaUuBDtbfdD67u0Uzdibcqub0evmF7p3epPc2WGFy1Y_6lTXa6DnL8EBqaWmSg' SELECT 1;
----
<REGEX>:.*issuer "test/idp/hsonly" signs with HS256, none - this node verifies RS256 and ES256.*

# a document that lists no algorithms: RS256, the discovery default - and only that
statement ok
ACL ADMIN CREATE ISSUER 'test/idp/noalgs' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles' CLAIM MAP (tid => tenant);

