# name: test/sql/acl_jwks.test
# description: an issuer's keys found by its OIDC discovery (specs 023, 095) - the discovery document
#   names the JWKS, both are read through duckdb's filesystem and cached by location, a token re-uses
#   them, acl_jwks_refresh() drops them, and a document that is not the issuer's, names no keys or
#   signs only with algorithms this node does not verify from a location is refused. Pasted keys,
#   KEYS_FROM, rotation and staleness are a secret's: test/cpp/test_acl_identity_secrets.cpp.
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
SET allow_parser_override_extension='fallback';

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INT, tenant VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme'), (2, 'globex');

statement ok
SELECT acl_grant_table('analyst', 'orders', 'phys.main.orders', 'id', 'tenant = acl_claim(''tenant'')', 'select');

statement ok
SET GLOBAL acl_audit_level='all';

statement ok
ACL ADMIN CREATE ISSUER 'test/idp/rs' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles' CLAIM MAP (tid => tenant);

# nothing is read until a token needs it
query I
SELECT count(*) FROM acl_jwks_cache();
----
0

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
----
1

# the discovery document, then the JWKS it names: two locations, cached
query IIII
SELECT issuer, location, allowed, keys FROM acl_jwks_cache() ORDER BY location;
----
test/idp/rs	test/idp/rs/.well-known/openid-configuration	true	0
test/idp/rs	test/idp/rs/jwks.json	true	2

query I
SELECT kids FROM acl_jwks_cache() WHERE location LIKE '%jwks.json';
----
[test-key, test-ec]

# a second token reads nothing: still the two reads of the first
query I
ACL TOKEN 'eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3QtZWMifQ.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.JPVP5E5j7K46hdOBN72LvxFGU6Nz63VjpcSaJP6cb3gwrIrWVgH0hawJ7u_NXxOHgQpWp8k0kiZm1pInUOc6sw' SELECT id FROM orders;
----
1

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE kind = 'keys';
----
2

# acl_jwks_refresh drops what the issuer read; the next token reads it again
query I
SELECT acl_jwks_refresh('test/idp/rs');
----
2

query I
SELECT count(*) FROM acl_jwks_cache();
----
0

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.IfMyuOMYT0tZCxOA9LIT5oHOYJ6rH6FBoXWU8Ly-MQnMXKKj9baF0EMSGM367Od1_uqbhDOuY0HriUhQ_ItPtywx9K3l9atFiWinQ_HAIKI5JZM_wi4sMG8ME0PQkB0HbHp8dWGY7fiqzvdtxxCMyEYCgg9Iw6W3ONxFlhSIdKOJ4Natvo0oNJpz1sbphxExRBuZN2TCN4Ri-Z2xIGdr4abw52xF6PR3str8Zxyqy0eWO_P4dJyobV2j_sXNcFTZGKZ_F_geoqlc8y-aVnxkm-0AXsi8E38b9lm_1H7uAZPuLDJJt5yDKmtnJjkMeD0mj5S5RUR7LSWiEW0XMo1Maw' SELECT id FROM orders;
----
1

statement ok
SELECT acl_audit_flush();

query I
SELECT count(*) FROM acl_audit_events() WHERE kind = 'keys';
----
4

query I
SELECT acl_jwks_refresh();
----
2

# a key id the JWKS does not have: no key verifies it (one early re-read first, then the floor)
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJvdGF0ZWQtYXdheSJ9.eyJpc3MiOiJ0ZXN0L2lkcC9ycyIsImF1ZCI6ImFwaTovL2FjbC10ZXN0IiwiZXhwIjo0MTAyNDQ0ODAwLCJzdWIiOiJ1MSIsInJvbGVzIjpbImFuYWx5c3QiXSwidGlkIjoiYWNtZSJ9.KvxSa-3v5P31jc9YqmGPOTZJXnwFtmI9Moe9YP4d1pRa6NnYZIkNg0la1gSUMf_mYQvReVXB4EGtngTQILrLSH1siVUCJxidZaxZuDGVlQlkiUvoWnKNovjEozISxCwA1pFE5gzBREEiIpuQ4ZD3tEgRfcf1dU4Pbm6e-dfDXjGZUvack3KZKn8U1xMqo2q-GAFUv6aVGfM9DgKYe43GWs6r0GTpkzDNyBm-obn8k1U8e7thDgDI3aBlUMWCHCopAkDfFr5UV9PPPmY2Gl0tjJobFKpQCIQ234EfngYg3ry_D-5DVRpyGFi_g7j4dSzWaW2amtAyjhr5UjNWlY2eow' SELECT 1;
----
<REGEX>:.*no usable RS256 key for this issuer.*

# --- documents that are not good enough ---------------------------------------------------------------

# a discovery document of somebody else: its keys are not this issuer's
statement ok
