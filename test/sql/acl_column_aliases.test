# name: test/sql/acl_column_aliases.test
# description: column renames on a WRITABLE relation (spec 010, part 2b) - renaming is not
#   restricting, so the object keeps the alias form; reads rename by name, writes map the names back
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders_physical(id INT, tenant VARCHAR, amount INT);

statement ok
INSERT INTO phys.main.orders_physical VALUES (1, 'acme', 100), (2, 'globex', 200);

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
SET allow_parser_override_extension='fallback';

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG sales;

statement ok
ACL ADMIN CREATE ROLE analyst;

# a pure rename list keeps the relation writable (form stays 'alias')
statement ok
ACL ADMIN ADD TABLE phys.main.orders_physical AS sales.orders COLUMNS 'order_id=id,total=amount';

query I
SELECT form FROM aclcat.acl.relations WHERE vname = 'orders';
----
alias

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE analyst CAPS '{"select": true, "insert": true, "update": true, "delete": true, "merge": true}' MAIN;

# --- reads see the virtual names, and the columns that were not renamed keep theirs ---------------

query III
ACL ROLE "analyst" SELECT order_id, total, tenant FROM orders ORDER BY order_id;
----
1	100	acme
2	200	globex

# the physical name of a renamed column is gone from the virtual relation
statement error
ACL ROLE "analyst" SELECT id FROM orders;
----
<REGEX>:.*(id|Referenced column).*

# --- writes map the names back --------------------------------------------------------------------

statement ok
ACL ROLE "analyst" INSERT INTO orders(order_id, tenant, total) VALUES (3, 'acme', 300);

query II
ACL ADMIN SELECT id, amount FROM phys.main.orders_physical WHERE id = 3;
----
3	300

statement ok
ACL ROLE "analyst" UPDATE orders SET total = 350 WHERE order_id = 3;

query I
ACL ADMIN SELECT amount FROM phys.main.orders_physical WHERE id = 3;
----
350

query II
ACL ROLE "analyst" SELECT order_id, total FROM orders WHERE order_id = 3;
----
3	350

statement ok
ACL ROLE "analyst" DELETE FROM orders WHERE order_id = 3;

query I
ACL ADMIN SELECT count(*) FROM phys.main.orders_physical;
----
2

# writing a physical name that was renamed away is refused
statement error
ACL ROLE "analyst" INSERT INTO orders(id, tenant, amount) VALUES (9, 'acme', 900);
----
<REGEX>:.*has no column "id".*

statement error
ACL ROLE "analyst" UPDATE orders SET amount = 1 WHERE order_id = 1;
----
<REGEX>:.*has no column "amount".*

# --- a second relation in scope is refused rather than guessed ------------------------------------

statement ok
ACL ADMIN ADD TABLE phys.main.orders_physical AS sales.raw_orders;

statement error
ACL ROLE "analyst" UPDATE orders SET total = 1 FROM raw_orders WHERE orders.order_id = raw_orders.id;
----
<REGEX>:.*cannot be written with FROM/USING/MERGE yet.*

statement error
ACL ROLE "analyst" MERGE INTO orders AS t USING (SELECT 1 AS k) AS s ON t.order_id = s.k WHEN MATCHED THEN DELETE;
----
<REGEX>:.*cannot be written with FROM/USING/MERGE yet.*

# a relation without renames is unaffected by any of this
statement ok
ACL ROLE "analyst" INSERT INTO raw_orders VALUES (7, 'acme', 700);

query I
ACL ROLE "analyst" SELECT amount FROM raw_orders WHERE id = 7;
----
700

statement ok
ACL ROLE "analyst" DELETE FROM raw_orders WHERE id = 7;

# --- restricting columns still means read-only ----------------------------------------------------

statement ok
ACL ADMIN ADD TABLE phys.main.orders_physical AS sales.masked COLUMNS 'order_id=id,secret=NULL';

query I
SELECT form FROM aclcat.acl.relations WHERE vname = 'masked';
----
subquery

statement error
ACL ROLE "analyst" INSERT INTO masked(order_id) VALUES (5);
----
<REGEX>:.*read-only relation.*

# --- a column added to the physical table cannot shift an alias (renaming is by name) --------------

statement ok
ACL ADMIN ALTER TABLE phys.main.orders_physical ADD COLUMN note VARCHAR;

query III
ACL ROLE "analyst" SELECT order_id, total, note FROM orders ORDER BY order_id;
----
1	100	NULL
2	200	NULL
