# name: test/sql/acl_ddl_dbt.test
# description: dbt's own statements under the ACL (spec 113) - names `[<vcat>.]<schema path>.<object>`
#   in DDL, CREATE SCHEMA IF NOT EXISTS on a held schema, and RENAME inside a granted home, so a stock
#   dbt materialization (create tmp, rename old away, rename tmp in, drop old) runs unchanged
# group: [sql]

require acl

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE SCHEMA phys.home;

statement ok
CREATE SCHEMA phys.lake;

statement ok
CREATE SCHEMA phys.other;

statement ok
CREATE TABLE phys.main.orders AS SELECT 1 AS id, 10 AS amount;

statement ok
ATTACH ':memory:' AS aclcat;

statement ok
SELECT acl_use_db('aclcat', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG sales;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG mart;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE sales.orders AS phys.main.orders;

# a live alias (dbt's home), an expansion, and a schema of the second catalog
statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.dbt_home AS phys.home;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.vs FROM phys.lake;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA mart.out AS phys.other;

statement ok
ACL ADMIN CREATE ROLE dbt;

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE dbt WITH (select) MAIN;

statement ok
ACL ADMIN GRANT CATALOG mart TO ROLE dbt WITH (select);

statement ok
ACL ADMIN GRANT SCHEMA sales.dbt_home TO ROLE dbt WITH (select, insert, create, drop);

statement ok
ACL ADMIN GRANT SCHEMA sales.vs TO ROLE dbt WITH (select, insert, create, drop);

statement ok
ACL ADMIN GRANT SCHEMA mart.out TO ROLE dbt WITH (select, insert, create, drop);

# --- CREATE SCHEMA: a held schema exists already ---------------------------------------------------------

statement ok
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS "sales"."dbt_home";

statement ok
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS dbt_home;

statement error
ACL ROLE "dbt" CREATE SCHEMA dbt_home;
----
schema "dbt_home" already exists

statement error
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS somewhere_new;
----
a schema is the operator's to declare

query I
SELECT count(*) FROM duckdb_schemas() WHERE schema_name IN ('dbt_home', 'somewhere_new');
----
0

# a schema held with no capability (`CAPS '{}'`) is none of the principal's: no answer about it
statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.hidden AS phys.lake;

statement ok
ACL ADMIN GRANT SCHEMA sales.hidden TO ROLE dbt CAPS '{}';

statement error
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS hidden;
----
a schema is the operator's to declare

# a batch of no-ops still answers (the quack client refuses a statement with nothing to answer)
query I
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS dbt_home;
----

# --- names: the catalog in front, in the MAIN catalog and in another catalog of the role ------------------

statement ok
ACL ROLE "dbt" CREATE TABLE "sales"."dbt_home"."m" AS (SELECT id, amount FROM orders);

statement ok
ACL ROLE "dbt" CREATE TABLE "mart"."out"."m" AS (SELECT id FROM sales.orders);

query TT
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name = 'phys' AND table_name = 'm' ORDER BY 1;
----
home	m
other	m

statement ok
ACL ROLE "dbt" CREATE OR REPLACE TABLE sales.dbt_home.m AS SELECT id, amount * 2 AS amount FROM orders;

query II
ACL ROLE "dbt" SELECT id, amount FROM sales.dbt_home.m;
----
1	20

# a catalog the role holds no grant on is no catalog to it - even where another role may create
statement ok
ACL ADMIN CREATE VIRTUAL CATALOG secret;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA secret.dbt_home AS phys.home;

statement ok
ACL ADMIN CREATE ROLE other_team;

statement ok
ACL ADMIN GRANT CATALOG secret TO ROLE other_team WITH (select) MAIN;

statement ok
ACL ADMIN GRANT SCHEMA secret.dbt_home TO ROLE other_team WITH (select, create, drop);

statement error
ACL ROLE "dbt" CREATE TABLE secret.dbt_home.x AS SELECT 1 AS i;
----
no schema of the catalog allows creating "secret.dbt_home.x"

statement error
ACL ROLE "dbt" DROP TABLE secret.dbt_home.m;
----
no schema of the catalog allows dropping "secret.dbt_home.m"

statement error
ACL ROLE "dbt" ALTER TABLE secret.dbt_home.m RENAME TO m9;
----
no schema of the catalog allows renaming "secret.dbt_home.m"

# --- DROP: three-part, IF EXISTS; CASCADE is taken off (duckdb's own takes nothing more - a view over the
# table stays; the point is a home in another engine, where it would drop the dependents) ---------------

statement ok
ACL ROLE "dbt" DROP TABLE IF EXISTS "mart"."out"."m" CASCADE;

statement ok
ACL ROLE "dbt" DROP TABLE IF EXISTS "mart"."out"."m" CASCADE;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'phys' AND schema_name = 'other';
----
0

# --- RENAME: dbt's table swap, in the live alias ---------------------------------------------------------

statement ok
ACL ROLE "dbt" CREATE TABLE "sales"."dbt_home"."m__dbt_tmp" AS (SELECT id, amount * 3 AS amount FROM orders);

statement ok
ACL ROLE "dbt" ALTER TABLE "sales"."dbt_home"."m" RENAME TO "m__dbt_backup";

statement ok
ACL ROLE "dbt" ALTER TABLE "sales"."dbt_home"."m__dbt_tmp" RENAME TO "m";

statement ok
ACL ROLE "dbt" DROP TABLE IF EXISTS "sales"."dbt_home"."m__dbt_backup" CASCADE;

query II
ACL ROLE "dbt" SELECT id, amount FROM sales.dbt_home.m;
----
1	30

query T
SELECT string_agg(table_name, ',' ORDER BY table_name) FROM duckdb_tables() WHERE database_name = 'phys' AND schema_name = 'home';
----
m

# ... in an expansion the record follows the object
statement ok
ACL ROLE "dbt" CREATE TABLE vs.e AS SELECT id FROM orders;

statement ok
ACL ROLE "dbt" ALTER TABLE vs.e RENAME TO e2;

query TT
SELECT vname, phys FROM aclcat.acl.relations WHERE vcat = 'sales' AND vname LIKE 'vs.e%';
----
vs.e2	phys.lake.e2

query I
ACL ROLE "dbt" SELECT count(*) FROM vs.e2;
----
1

# ... and a view (a record, nothing physical)
statement ok
ACL ROLE "dbt" CREATE VIEW dbt_home.v__dbt_tmp AS SELECT id FROM orders;

statement ok
ACL ROLE "dbt" ALTER VIEW dbt_home.v__dbt_tmp RENAME TO v;

query I
ACL ROLE "dbt" SELECT count(*) FROM dbt_home.v;
----
1

statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.v RENAME TO v3;
----
is a view - ALTER VIEW renames it

# --- RENAME refusals --------------------------------------------------------------------------------------

# the new name is taken
statement ok
ACL ROLE "dbt" CREATE TABLE dbt_home.n AS SELECT 1 AS i;

statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.n RENAME TO m;
----
already exists

# ... and the swap works inside a client's transaction, as dbt runs it
statement ok
BEGIN;

statement ok
ACL ROLE "dbt" CREATE TABLE dbt_home.m__dbt_tmp AS SELECT id, amount * 4 AS amount FROM orders;

statement ok
ACL ROLE "dbt" ALTER TABLE dbt_home.m RENAME TO m__dbt_backup;

statement ok
ACL ROLE "dbt" ALTER TABLE dbt_home.m__dbt_tmp RENAME TO m;

statement ok
ACL ROLE "dbt" DROP TABLE dbt_home.m__dbt_backup;

statement ok
COMMIT;

query II
ACL ROLE "dbt" SELECT id, amount FROM dbt_home.m;
----
1	40

# a schema without create
statement ok
ACL ADMIN CREATE ROLE dropper;

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE dropper WITH (select) MAIN;

statement ok
ACL ADMIN GRANT SCHEMA sales.dbt_home TO ROLE dropper WITH (select, drop);

statement error
ACL ROLE "dropper" ALTER TABLE dbt_home.n RENAME TO n2;
----
create on schema "dbt_home" is not allowed

# across schemas: duckdb's grammar has no such RENAME
statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.n RENAME TO vs.n;
----
syntax error

# a schema without drop
statement ok
ACL ADMIN CREATE ROLE builder;

statement ok
ACL ADMIN GRANT CATALOG sales TO ROLE builder WITH (select) MAIN;

statement ok
ACL ADMIN GRANT SCHEMA sales.dbt_home TO ROLE builder WITH (select, create);

statement error
ACL ROLE "builder" ALTER TABLE dbt_home.n RENAME TO n2;
----
drop on schema "dbt_home" is not allowed

# an object the operator declared, with its own grant, keeps its name
statement ok
ACL ADMIN CREATE VIRTUAL TABLE sales.dbt_home.declared AS phys.home.n;

statement ok
ACL ADMIN GRANT TABLE sales.dbt_home.declared TO ROLE dbt WITH (select);

statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.declared RENAME TO declared2;
----
carries the operator's declarations

# onto a name the catalog declares
statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.n RENAME TO declared;
----
"dbt_home.declared" already exists

# a record the operator declared over another object: renaming the home's object of that name would
# re-point the record at it - refused (the review's finding)
statement ok
CREATE TABLE phys.home.rec AS SELECT 99 AS id;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE sales.dbt_home.rec AS phys.main.orders;

statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.rec RENAME TO rec2;
----
is declared over phys.main.orders

query I
ACL ROLE "dbt" SELECT id FROM dbt_home.rec;
----
1

# an operator's view in the home, with no declarations of its own, is the schema's like any object:
# drop already removes it, so a rename (drop + create) may move it
statement ok
ACL ADMIN CREATE VIRTUAL VIEW sales.dbt_home.opview AS SELECT id FROM phys.main.orders;

statement ok
ACL ROLE "dbt" ALTER VIEW dbt_home.opview RENAME TO opview2;

query I
ACL ROLE "dbt" SELECT count(*) FROM dbt_home.opview2;
----
1

# a relation outside every granted home
statement error
ACL ROLE "dbt" ALTER TABLE orders RENAME TO orders2;
----
no schema of the catalog allows renaming

# every other ALTER stays refused
statement error
ACL ROLE "dbt" ALTER TABLE dbt_home.m ADD COLUMN x INTEGER;
----
only RENAME TO inside a granted schema

# --- ambiguity: a first part that is a catalog of the role and a schema of its MAIN catalog -----------------

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.mart AS phys.lake;

statement ok
ACL ADMIN GRANT SCHEMA sales.mart TO ROLE dbt WITH (select, create, drop);

# the schema reading fits only a real parent: sales.mart's object would be `out.z`, so this is mart's
statement ok
ACL ROLE "dbt" CREATE TABLE mart.out.z AS SELECT 1 AS i;

# ... and a middle schema that does not exist is no home (not sales.mart's object `nope.z`)
statement error
ACL ROLE "dbt" CREATE TABLE mart.nope.z AS SELECT 1 AS i;
----
no schema of the catalog allows creating "mart.nope.z"

# a schema names itself whole: `mart.out` would be a nested schema of sales.mart only if one were
# declared, so it is mart's `out` - held, and a no-op
statement ok
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS mart.out;

# ... while a declared nested `sales.mart.out` makes it ambiguous
statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.mart.out AS phys.lake;

statement ok
ACL ADMIN GRANT SCHEMA sales.mart.out TO ROLE dbt WITH (select);

statement error
ACL ROLE "dbt" CREATE SCHEMA IF NOT EXISTS mart.out;
----
is ambiguous

statement error
ACL ROLE "dbt" CREATE TABLE mart.out.z9 AS SELECT 1 AS i;
----
is ambiguous

statement error
ACL ROLE "dbt" DROP TABLE mart.out.z;
----
is ambiguous

statement error
ACL ROLE "dbt" ALTER TABLE mart.out.z RENAME TO z2;
----
is ambiguous

# --- nested schemas: the home is the longest granted prefix ----------------------------------------------

statement ok
CREATE SCHEMA phys.deep;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.raw AS phys.other;

statement ok
ACL ADMIN CREATE VIRTUAL SCHEMA sales.raw.inner AS phys.deep;

statement ok
ACL ADMIN GRANT SCHEMA sales.raw TO ROLE dbt WITH (select, create, drop);

statement ok
ACL ADMIN GRANT SCHEMA sales.raw.inner TO ROLE dbt WITH (select, create, drop);

statement ok
ACL ROLE "dbt" CREATE TABLE sales.raw.inner.t AS SELECT 1 AS i;

statement ok
ACL ROLE "dbt" CREATE TABLE raw.t AS SELECT 2 AS i;

query TT
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name = 'phys' AND table_name = 't' ORDER BY 1;
----
deep	t
other	t

# --- a name part with a dot in it is ONE identifier (spec 116, lifting spec 113's refusal): "sub.t" is
# a table named so, never the nested sub.t - the review's finding (a RENAME to "sub.t" re-pointed a
# record at a hidden nested table) cannot happen, because the key keeps the part whole ---------------------

statement ok
CREATE SCHEMA phys.lake.sub;

statement ok
CREATE TABLE phys.lake.sub.t AS SELECT 'hidden' AS s;

statement ok
ACL ROLE "dbt" CREATE TABLE vs.mine AS SELECT 1 AS i;

statement ok
ACL ROLE "dbt" ALTER TABLE vs.mine RENAME TO "sub.t";

query I
ACL ROLE "dbt" SELECT * FROM vs."sub.t";
----
1

query I
SELECT i FROM phys.lake."sub.t";
----
1

statement ok
ACL ROLE "dbt" CREATE TABLE vs."sub.t2" AS SELECT 2 AS i;

query I
SELECT i FROM phys.lake."sub.t2";
----
2

statement ok
ACL ROLE "dbt" CREATE VIEW vs."sub.v" AS SELECT 3 AS i;

query I
ACL ROLE "dbt" SELECT * FROM vs."sub.v";
----
3

statement ok
ACL ROLE "dbt" DROP TABLE vs."sub.t";

statement ok
ACL ROLE "dbt" DROP TABLE vs."sub.t2";

statement ok
ACL ROLE "dbt" DROP VIEW vs."sub.v";

# the nested table was never touched
query T
SELECT s FROM phys.lake.sub.t;
----
hidden

# --- an unqualified name is a path in the MAIN catalog only ------------------------------------------------

# mart.out is mart's - written without its catalog it is no home of the MAIN catalog (sales)
statement error
ACL ROLE "dbt" CREATE TABLE out.z5 AS SELECT 1 AS i;
----
no schema of the catalog allows creating "out.z5"


# --- a RENAME the client rolls back: the physical rename goes back with the transaction, and the record
# it moved (written on the store's own connection) is moved back too ---------------------------------------

statement ok
ACL ROLE "dbt" CREATE TABLE vs.keep AS SELECT 7 AS i;

statement ok
BEGIN;

statement ok
ACL ROLE "dbt" ALTER TABLE vs.keep RENAME TO keep2;

statement ok
ROLLBACK;

query TT
SELECT vname, phys FROM aclcat.acl.relations WHERE vcat = 'sales' AND vname LIKE 'vs.keep%';
----
vs.keep	phys.lake.keep

query I
ACL ROLE "dbt" SELECT i FROM vs.keep;
----
7

# ... and a committed one stays
statement ok
BEGIN;

statement ok
ACL ROLE "dbt" ALTER TABLE vs.keep RENAME TO keep2;

statement ok
COMMIT;

query I
ACL ROLE "dbt" SELECT i FROM vs.keep2;
----
7
