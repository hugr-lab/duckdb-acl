# --- ALTER ----------------------------------------------------------------------------------------------

statement ok
ACL ADMIN ALTER CLIENT typed SET AUDIENCES ('api://typed', 'api://typed2') FLOWS (client_credentials) CLIENT ID 'typed-app';

query III
SELECT audiences, flows, client_id FROM acl_clients() WHERE name = 'typed';
----
["api://typed","api://typed2"]	["client_credentials"]	typed-app

# the implicit client is the issuer's: changed through ALTER ISSUER
statement error
ACL ADMIN ALTER CLIENT 'test/idp/a' SET FLOWS (password);
----
<REGEX>:.*is the client of issuer "test/idp/a"'s short form - ALTER ISSUER changes it.*

statement ok
ACL ADMIN ALTER ISSUER 'test/idp/a' SET FLOWS (password) UNMAPPED IGNORE;

query II
SELECT flows, unmapped FROM acl_clients() WHERE name = 'test/idp/a';
----
["password"]	ignore

statement error
ACL ADMIN ALTER ISSUER nosuch SET URL 'test/idp/x';
----
<REGEX>:.*issuer "nosuch" does not exist.*

