# --- grammar edges (review of spec 095) ------------------------------------------------------------------

# a boolean or numeric claim is compared without quotes
statement ok
ACL ADMIN CREATE CLIENT flagged ISSUER kc AUDIENCES ('api://flagged') REQUIRE (email_verified = true, level IN (1, 2)) ROLES FROM ('roles');

query I
SELECT requires FROM acl_clients() WHERE name = 'flagged';
----
[{"path":"email_verified","op":"eq","values":["true"]},{"path":"level","op":"in","values":["1","2"]}]

statement ok
ACL ADMIN DROP CLIENT flagged;

# a quoted CLAIM MAP is data, never spliced into the spec
statement error
ACL ADMIN ALTER ISSUER 'test/idp/a' SET CLAIM MAP '{"a":"t"}, "unmapped": "ignore"';
----
<REGEX>:.*CLAIM MAP is a JSON object.*

# an operator's FLOWS () stays empty through a later ALTER: defaults apply when the client is created
statement ok
ACL ADMIN ALTER ISSUER 'test/idp/a' SET FLOWS ();

statement ok
ACL ADMIN ALTER ISSUER 'test/idp/a' SET AUDIENCES ('api://acl-test', 'api://b');

query I
SELECT flows IS NULL FROM acl_clients() WHERE name = 'test/idp/a';
----
true

statement ok
ACL ADMIN ALTER ISSUER 'test/idp/a' SET AUDIENCES ('api://acl-test');

# --- a write is judged by what it changes (review of spec 095) -----------------------------------------

# a role mapped for every client of an issuer, then made an administrator: the mapping stops counting
# at use, and an unrelated write is not refused for it
statement ok
ACL ADMIN CREATE ROLE later_boss;

statement ok
ACL ADMIN MAP CLAIM 'lb' FROM ISSUER kc TO ROLE later_boss;

statement ok
SELECT acl_grant_admin('later_boss', 'manage');

statement ok
ACL ADMIN MAP CLAIM 'x' FROM CLIENT typed TO ROLE analyst;

# a client moved to another issuer leaves its mappings behind: a value means something at one IdP
statement ok
ACL ADMIN CREATE ISSUER other_idp URL 'test/idp/other';

statement ok
ACL ADMIN MAP GROUP 'g-ops' FROM CLIENT ops TO ROLE boss;

statement ok
ACL ADMIN CREATE OR REPLACE CLIENT ops ISSUER other_idp AUDIENCES ('api://ops') ROLES FROM ('roles');

query I
SELECT count(*) FROM acl_role_mappings() WHERE scope_name = 'ops';
----
0

statement ok
ACL ADMIN DROP CLIENT ops;

# a short form replaced by the long one takes what was mapped from its implicit client with it
statement ok
ACL ADMIN CREATE ISSUER 'test/idp/b' AUDIENCES ('api://b') ROLE CLAIM 'roles';

statement ok
ACL ADMIN MAP CLAIM 'v' FROM CLIENT 'test/idp/b' TO ROLE analyst;

statement ok
ACL ADMIN CREATE OR REPLACE ISSUER 'test/idp/b' URL 'test/idp/b';

query II
SELECT (SELECT count(*) FROM acl_clients() WHERE issuer = 'test/idp/b'),
       (SELECT count(*) FROM acl_role_mappings() WHERE scope_name = 'test/idp/b');
----
0	0

statement ok
ACL ADMIN DROP ISSUER 'test/idp/b';

statement ok
ACL ADMIN DROP ISSUER other_idp;

# --- DROP: what goes with what --------------------------------------------------------------------------

# an issuer with explicit clients stays until they go
statement error
ACL ADMIN DROP ISSUER kc;
----
<REGEX>:.*issuer "kc" still has client.*

# the implicit client is dropped with its issuer, not by itself
statement error
ACL ADMIN DROP CLIENT 'test/idp/a';
----
<REGEX>:.*DROP ISSUER removes it.*

# a client takes its mappings with it
statement ok
ACL ADMIN DROP CLIENT desktop;

query I
SELECT count(*) FROM acl_role_mappings() WHERE scope_name = 'desktop';
----
0

statement ok
ACL ADMIN DROP CLIENT IF EXISTS desktop;

# the short form's issuer takes its client and both scopes' mappings
statement ok
ACL ADMIN DROP ISSUER 'test/idp/a';

query II
SELECT (SELECT count(*) FROM acl_clients() WHERE issuer = 'test/idp/a'),
       (SELECT count(*) FROM acl_role_mappings() WHERE scope_name = 'test/idp/a');
----
0	0

