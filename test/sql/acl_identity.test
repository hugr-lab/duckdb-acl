# name: test/sql/acl_identity.test
# description: issuers and clients (spec 095) - the short form and its implicit client, explicit
#   clients told apart by azp, routing by specificity (ties refused at write or at use), REQUIRE,
#   ROLES CONSTANT, ATTRIBUTES with a constant ceiling, UNMAPPED, privileged roles reached only through
#   the client's own mapping, TOKEN TYPE, one issuer per URL, no key or credential in the policy, and
#   what DROP takes with it. Keys are found by the issuers' discovery under test/idp/; tokens are
#   signed with the committed fixture keys (test/scripts/idp_fixtures.py mint).
# group: [sql]

require acl

statement ok
SET GLOBAL acl_jwks_locations = 'test/idp/';

statement ok
ATTACH ':memory:' AS store;

statement ok
ATTACH ':memory:' AS phys;

statement ok
CREATE TABLE phys.main.orders(id INTEGER, tenant VARCHAR);

statement ok
INSERT INTO phys.main.orders VALUES (1, 'acme'), (2, 'acme'), (3, 'globex');

statement ok
SELECT acl_use_db('store', 'acl', true);

statement ok
SET GLOBAL acl_allow_anonymous_admin=true;

statement ok
ACL ADMIN CREATE VIRTUAL CATALOG c;

statement ok
ACL ADMIN CREATE VIRTUAL TABLE c.orders AS phys.main.orders RLS 'tenant = acl_claim(''tenant'')';

statement ok
ACL ADMIN CREATE ROLE analyst;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE analyst MAIN;

statement ok
ACL ADMIN CREATE ROLE auditor CLAIMS (tenant = 'globex');

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE auditor MAIN;

# a role that administers: reached only through an explicit mapping of a client
statement ok
ACL ADMIN CREATE ROLE boss;

statement ok
ACL ADMIN GRANT CATALOG c TO ROLE boss MAIN;

statement ok
SELECT acl_grant_admin('boss', 'manage');

# --- no key and no credential is ever written into the policy -------------------------------------

statement error
ACL ADMIN CREATE ISSUER 'test/idp/a' KEYS '{"keys":[]}' AUDIENCES ('api://acl-test');
----
<REGEX>:.*keys and algorithms are never written into the policy.*

statement error
ACL ADMIN CREATE ISSUER 'test/idp/a' AUDIENCES ('api://acl-test') CLIENT ID 'door-app' CLIENT SECRET 'super-secret-value';
----
<REGEX>:.*a client secret is never written into the policy.*

# --- the short form: one issuer, one application -----------------------------------------------------

statement ok
ACL ADMIN CREATE ISSUER 'test/idp/a' AUDIENCES ('api://acl-test') ROLE CLAIM 'roles' CLAIM MAP (tid => tenant) CLIENT ID 'door-app';

query IIII
SELECT name, url, secret_service, secret FROM acl_issuers();
----
test/idp/a	test/idp/a	NULL	NULL

# its implicit client: named after the issuer, unmapped values that name a role are that role, and a
# public client id runs the drivers' flows - the password flow is only ever written
query IIIIIII
SELECT name, issuer, audiences, roles_from, unmapped, flows, implicit FROM acl_clients();
----
test/idp/a	test/idp/a	["api://acl-test"]	["roles"]	as_role	["authcode","device"]	true

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwiaXNzIjoidGVzdC9pZHAvYSIsInN1YiI6InMxIiwicm9sZXMiOlsiYW5hbHlzdCJdLCJ0aWQiOiJhY21lIn0.WvNonDgH9hYONICXqRDNLUmUJEF7tXZe64mVd3kfess-S9uFPYCsMNlnTAUhPMxan35AtoSW-cKRuRDSWr-vHCeGjailX8MCmHVHP8PAB3cHKxChyemxR5LPsNp1pVuAzTISGZBKSa2X11DPicMj4IxeBJ1LHxAUgafrYPWrHZlzdQMSAKMNdEWLuD5A3JTwhOStxmUbvVLpHCojCp8yyCcl2GKXA4AKFe5CfpKmz3QuSM0uhXTZzqjEE3dfE6ybn42qHarCw3IgDpq6qJSCnzdgk71CHc6P937EIYy6r2z8MmCTY3EyI2eVS47JzXb9EJW4tvU257JFFf28uk19eQ' SELECT count(*) FROM orders;
----
2

# CREATE refuses to overwrite; OR REPLACE and IF NOT EXISTS say what they do (spec 013)
statement error
ACL ADMIN CREATE ISSUER 'test/idp/a' AUDIENCES ('api://acl-test');
----
<REGEX>:.*issuer "test/idp/a" already exists.*

statement ok
ACL ADMIN CREATE ISSUER IF NOT EXISTS 'test/idp/a' AUDIENCES ('api://other');

query I
SELECT audiences FROM acl_clients() WHERE name = 'test/idp/a';
----
["api://acl-test"]

# a bare name needs its URL
statement error
ACL ADMIN CREATE ISSUER kc AUDIENCES ('api://acl-test');
----
<REGEX>:.*issuer "kc" needs its URL.*

# a role that administers is never an unmapped value of the same name - not even for the short form
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwiaXNzIjoidGVzdC9pZHAvYSIsInN1YiI6ImIyIiwicm9sZXMiOlsiYm9zcyJdLCJ0aWQiOiJhY21lIn0.PI_ECEOC0ZzM0jYABKq1VqFq58ucvLIgaXLkYanQQZipAFmDSMdVubxClZDoFLP5rdgZvJicb4UOvMqig17AkUP6edzbJxoobKpRbPKLz8wN0gs7ZbFr2Q_dcNJFZouiqAFj95Yn7WKyeWFpf318sqxXCsoyhozajmNL8cEaRUuFw4MGQEc9ITEbGTBijNk3Gf7zRadkYo9dZRahH2R8iLyO_j3x6U7XPTjt5yvapYUkOAoFgbDNfQXzyBUahI2hjh5sd3J3zY9gGYl7XNzgMhxS2TCd_ihpbSYX4kDhelRitmvJW27m66wosQmQn6OGDq021WN0hmSrBEWdukty-Q' SELECT count(*) FROM orders;
----
<REGEX>:.*no recognized roles.*

# nor is it mapped for every client of an issuer
statement error
ACL ADMIN MAP CLAIM 'boss' FROM ISSUER 'test/idp/a' TO ROLE boss;
----
<REGEX>:.*holds an administration scope, so it is mapped FROM CLIENT only.*

# the client's own mapping is the one way
statement ok
ACL ADMIN MAP CLAIM 'boss' FROM CLIENT 'test/idp/a' TO ROLE boss;

query I
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwiaXNzIjoidGVzdC9pZHAvYSIsInN1YiI6ImIyIiwicm9sZXMiOlsiYm9zcyJdLCJ0aWQiOiJhY21lIn0.PI_ECEOC0ZzM0jYABKq1VqFq58ucvLIgaXLkYanQQZipAFmDSMdVubxClZDoFLP5rdgZvJicb4UOvMqig17AkUP6edzbJxoobKpRbPKLz8wN0gs7ZbFr2Q_dcNJFZouiqAFj95Yn7WKyeWFpf318sqxXCsoyhozajmNL8cEaRUuFw4MGQEc9ITEbGTBijNk3Gf7zRadkYo9dZRahH2R8iLyO_j3x6U7XPTjt5yvapYUkOAoFgbDNfQXzyBUahI2hjh5sd3J3zY9gGYl7XNzgMhxS2TCd_ihpbSYX4kDhelRitmvJW27m66wosQmQn6OGDq021WN0hmSrBEWdukty-Q' SELECT count(*) FROM orders;
----
2

# --- an explicit issuer and two applications of it --------------------------------------------------

statement ok
ACL ADMIN CREATE ISSUER kc URL 'test/idp/two';

# one IdP is one issuer
statement error
ACL ADMIN CREATE ISSUER kc_again URL 'test/idp/two';
----
<REGEX>:.*have the same URL "test/idp/two" - one IdP is one issuer.*

statement error
ACL ADMIN CREATE CLIENT nowhere ISSUER kc ROLES FROM ('roles');
----
<REGEX>:.*accepts no audience - AUDIENCES is required.*

statement ok
ACL ADMIN CREATE CLIENT desktop ISSUER kc AUDIENCES ('api://acl-test') AZP ('acl-desktop')
    ROLES FROM ('realm_access.roles') ATTRIBUTES (tenant = 'tenant', mail = ('upn', 'email'))
    SUBJECT ('email', 'sub') CLIENT ID 'acl-desktop' FLOWS (authcode, device);

statement ok
ACL ADMIN CREATE CLIENT door ISSUER kc AUDIENCES ('api://acl-test') AZP ('acl-door')
    ROLES FROM ('groups') ATTRIBUTES (tenant = CONSTANT 'globex');

# an explicit client keeps unmapped values out (UNMAPPED IGNORE): `analyst` is a role here, but the
# client maps nothing yet
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwiaXNzIjoidGVzdC9pZHAvdHdvIiwic3ViIjoiZDEiLCJhenAiOiJhY2wtZGVza3RvcCIsInJlYWxtX2FjY2VzcyI6eyJyb2xlcyI6WyJhbmFseXN0Il19LCJ0ZW5hbnQiOiJhY21lIiwiZW1haWwiOiJkMUBhY21lLnRlc3QifQ.WLGOGKm2ToWTfkOdtd2iwtUAQpFStL7EIVxL49X-iseG3h-kXy0r-PKZ6eXM0IoyWXaAEquteRi-3WcodM0l0yks0LvLmkbl21cKyvzEGkoAqMgRxygru-fFf_oZAii2MNtVccN3-tohOFKHU7jg45Jy37RUpYivdV9giFIYJKhU-K8DHNBahPS4ma1phfZqGqgRqLvLiWOYYJZNbYIcOitp46mab7U6l3pcbiFPeQ3GjqcQpplcjvC6OKavusBXRrfO_569mK2SF78iZpiXp5J0Dn6JN-CMq311SUeGHeimrxg1rh1WDtbQ9Lsm98HRPNSBNkxSLepOaAZtV1fQpw' SELECT count(*) FROM orders;
