# the subject is the client's first path present - the audit's and the session's identity, never a
# grant's; the issuer beside it is the IdP's URL
statement ok
SET GLOBAL acl_audit_level='all';

statement ok
SELECT acl_session_open('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwiaXNzIjoidGVzdC9pZHAvdHdvIiwic3ViIjoiZDEiLCJhenAiOiJhY2wtZGVza3RvcCIsInJlYWxtX2FjY2VzcyI6eyJyb2xlcyI6WyJhbmFseXN0Il19LCJ0ZW5hbnQiOiJhY21lIiwiZW1haWwiOiJkMUBhY21lLnRlc3QifQ.WLGOGKm2ToWTfkOdtd2iwtUAQpFStL7EIVxL49X-iseG3h-kXy0r-PKZ6eXM0IoyWXaAEquteRi-3WcodM0l0yks0LvLmkbl21cKyvzEGkoAqMgRxygru-fFf_oZAii2MNtVccN3-tohOFKHU7jg45Jy37RUpYivdV9giFIYJKhU-K8DHNBahPS4ma1phfZqGqgRqLvLiWOYYJZNbYIcOitp46mab7U6l3pcbiFPeQ3GjqcQpplcjvC6OKavusBXRrfO_569mK2SF78iZpiXp5J0Dn6JN-CMq311SUeGHeimrxg1rh1WDtbQ9Lsm98HRPNSBNkxSLepOaAZtV1fQpw');

statement ok
SELECT acl_audit_flush();

query II
SELECT subject, issuer FROM acl_audit_events() WHERE kind = 'session' AND detail = 'opened';
----
d1@acme.test	test/idp/two

statement ok
SET GLOBAL acl_audit_level='denied';

# a mapping names a client or an issuer that exists
statement error
ACL ADMIN MAP CLAIM 'x' FROM CLIENT nosuch TO ROLE analyst;
----
<REGEX>:.*client "nosuch" does not exist.*

# --- routing: the most specific client, never two -----------------------------------------------------

# two clients that would accept the same tokens are refused where they are written
statement error
ACL ADMIN CREATE CLIENT desktop2 ISSUER kc AUDIENCES ('api://acl-test') AZP ('acl-desktop', 'more') ROLES FROM ('roles');
----
<REGEX>:.*clients "desktop" and "desktop2" of issuer "kc" would accept the same tokens.*

# no client accepts a token of another application
statement error
ACL TOKEN 'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InRlc3Qta2V5In0.eyJhdWQiOiJhcGk6Ly9hY2wtdGVzdCIsImV4cCI6NDEwMjQ0NDgwMCwiaXNzIjoidGVzdC9pZHAvdHdvIiwic3ViIjoibzEiLCJhenAiOiJzb21lb25lLWVsc2UiLCJyb2xlcyI6WyJhbmFseXN0Il0sInRlbmFudCI6ImFjbWUifQ.Oe5EOQ2cXhBO8eA9DUvGTg4OsHkJDM5cbmZD7dDK6Jq1mV5aMbEdgMJtPxNS4vzRJGxOxPaG-9C7KaBpMmCy6WnTFyZnaFtjfXZg0yDgLNN4BUs2TcoU6gMPngHsT0yAtebAWRx_5LWPJYJtEVDQn6xy1wvyqWIMLosIi6tBVem0IXUoOUHykfTwb47QovxOlS3Y3qXTRNdQDGT6u4hzVjmRzr83-7XRLl8V9FSVDbAAoVUpg19Yb5UVdz5ZrC19tUC_whvmX3XfY1DbZmtKu0hdEuNSFxfYxstVAsiV0he-xaMDfbfhHfnCR6iulqWdyx_Tu-EFzGZbntL2gGouUw' SELECT count(*) FROM orders;
