# conditions cannot be compared where they are written: two clients whose REQUIRE both hold for one
# token are refused where the token is judged
statement ok
ACL ADMIN CREATE CLIENT svc_by_sub ISSUER kc AUDIENCES ('api://svc') REQUIRE (sub LIKE 'svc-%') ROLES FROM ('roles') UNMAPPED AS ROLE;

statement ok
ACL ADMIN CREATE CLIENT svc_by_tenant ISSUER kc AUDIENCES ('api://svc') REQUIRE (tenant = 'acme') ROLES CONSTANT ('auditor');

