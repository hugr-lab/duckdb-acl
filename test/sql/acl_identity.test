# --- REQUIRE: =, IN, contains, LIKE --------------------------------------------------------------------

statement ok
ACL ADMIN CREATE CLIENT ops ISSUER kc AUDIENCES ('api://ops')
    REQUIRE (tid IN ('t1', 't2'), 'admin' IN groups, sub LIKE '%@acme.test') ROLES CONSTANT ('auditor');

# ROLES CONSTANT: every token of the client is that role (whose default claims follow it)
query I
